import os;
import binary;
import gfx;
import math;
import gfx.linalg;
import gfx.gltf;
import gfx.motion;
import gfx.scene3d;
import spring;
struct Fabric { name byte[>..], sim bool, cell f32, gain f32, swing f32, bend f32, damp f32, grav f32 }
var fabrics Fabric[>..];
var f_sim bool[>..];
var f_cell f32[>..];
var f_gain f32[>..];
var f_swing f32[>..];
var f_bend f32[>..];
var f_damp f32[>..];
var f_grav f32[>..];
fn build_fabrics() {
	let fr = fabric_rows();
	fabrics = copy(fr);
	f_sim.clear();
	f_cell.clear();
	f_gain.clear();
	f_swing.clear();
	f_bend.clear();
	f_damp.clear();
	f_grav.clear();
	for f in fr {
		f_sim.push(f.sim);
		f_cell.push(f.cell);
		f_gain.push(f.gain);
		f_swing.push(f.swing);
		f_bend.push(f.bend);
		f_damp.push(f.damp);
		f_grav.push(f.grav);
	}
}
fn class_row(name const byte[:]) int {
	var i = 0;
	for f in fabrics {
		if f.name == name { return i; }
		i++;
	}
	return -1;
}
fn fabric_rows() Fabric[>..] {
	var r Fabric[>..] = [];
	r.push(Fabric{"rigid", false, 0, 0, 0, 0, 0, 0});
	r.push(Fabric{"tight", false, 0, 0, 0, 0, 0, 0});
	r.push(Fabric{"close", true, 0.04, 2.0, 0.04, 0.3, 0.98, 1.0});
	r.push(Fabric{"loose", true, 0.025, 3.0, 0.15, 0.15, 0.985, 1.0});
	r
}
struct Wear { mesh byte[>..], group byte[>..], class byte[>..] }
var wears Wear[>..];
fn build_wears(path const byte[:]) {
	var data byte[>..] = [];
	if !read_file(path, data) { data.clear(); }
	let lines = split(data, '\n');
	let base = wear_rows();
	var out Wear[>..] = [];
	for b in base {
		var n = 0;
		for line in lines {
			let ws = words(trim(line));
			if ws.len >= 3 && ws[0] == b.mesh { n += 1; }
		}
		if n == 0 {
			out.push(Wear { b.mesh, b.group, b.class });
		} else {
			var k = 0;
			for line in lines {
				let ws = words(trim(line));
				if ws.len >= 3 && ws[0] == b.mesh {
					k += 1;
					if k == n { out.push(Wear { ws[0], ws[1], ws[2] }); }
				}
			}
		}
	}
	var li = 0;
	for line in lines {
		let ws = words(trim(line));
		if ws.len >= 3 {
			var inbase = false;
			for b in base {
				if b.mesh == ws[0] { inbase = true; }
			}
			if !inbase {
				var later = false;
				var lj = 0;
				for line2 in lines {
					if lj > li {
						let ws2 = words(trim(line2));
						if ws2.len >= 3 && ws2[0] == ws[0] { later = true; }
					}
					lj += 1;
				}
				if !later { out.push(Wear { ws[0], ws[1], ws[2] }); }
			}
		}
		li += 1;
	}
	wears = copy(out);
}
fn wear_rows() Wear[>..] {
	var r Wear[>..] = [];
	r.push(Wear{"skirt", "skirt", "loose"});
	r.push(Wear{"tank", "tank", "tight"});
	r.push(Wear{"tank_hem", "tank", "close"});
	r.push(Wear{"shorts", "shorts", "tight"});
	r.push(Wear{"shorts_lace", "shorts", "tight"});
	r.push(Wear{"socks", "socks", "tight"});
	r.push(Wear{"stripes", "socks", "tight"});
	r.push(Wear{"gloves", "gloves", "tight"});
	r.push(Wear{"belt", "belt", "rigid"});
	r.push(Wear{"buckle", "belt", "rigid"});
	r.push(Wear{"choker", "choker", "rigid"});
	r.push(Wear{"plate", "choker", "rigid"});
	r.push(Wear{"chain", "chain", "rigid"});
	r.push(Wear{"shoes", "shoes", "rigid"});
	r.push(Wear{"glasses", "glasses", "rigid"});
	r.push(Wear{"outfit", "outfit", "tight"});
	r.push(Wear{"hoodie", "hoodie", "close"});
	r.push(Wear{"hood", "hoodie", "loose"});
	r.push(Wear{"hood_hem", "hoodie", "loose"});
	r.push(Wear{"pocket", "hoodie", "close"});
	r.push(Wear{"seam", "hoodie", "close"});
	r.push(Wear{"collar", "hoodie", "close"});
	r
}
var npts = 0;
var item = -1;
var sk = -1;
var ready = false;
var wind = float3 { 0.0, 0.0, 0.0 };
var p_node int[>..];
var p_j int[>..];
var p_w f32[>..];
var p_md f32[>..];
var p_damp f32[>..];
var p_grav f32[>..];
var p_rest float3[>..];
var p_x float3[>..];
var p_prev float3[>..];
var p_anc float3[>..];
var p_q linalg::Quat[>..];
var p_im f32[>..];
var p_g int[>..];
var p_y f32[>..];
var p_tie int[>..];
var p_tl f32[>..];
var p_cap int[>..];
var p_hv int[>..];
var h_v int[>..];
var h_p float3[>..];
var h_n float3[>..];
var ngar = 0;
var cl_asset = -1;
var cur_asset = -1;
var nb_first int[>..];
var nbr int[>..];
var e_a int[>..];
var e_b int[>..];
var e_l f32[>..];
var e_k f32[>..];
var c_a int[>..];
var c_b int[>..];
var c_r0 f32[>..];
var c_r1 f32[>..];
var pal gfx::mat4[>..];
fn vpos(g int) float3 {
	let b = g * gltf::VERTEX_FLOATS;
	float3 { gltf::verts[b], gltf::verts[b + 1], gltf::verts[b + 2] }
}
fn vnorm(g int) float3 {
	let b = g * gltf::VERTEX_FLOATS;
	float3 { gltf::verts[b + 3], gltf::verts[b + 4], gltf::verts[b + 5] }
}
fn mesh_verts(mesh int, out int[>..]&) {
	if mesh < 0 { return; }
	let ms = gltf::meshes[mesh];
	for pi in ms.prims.count {
		let pr = gltf::prims[ms.prims.first + pi];
		for v in pr.vcount { out.push(pr.vfirst + v); }
	}
}
fn hv_add(v int) int {
	for k in h_v.len {
		if h_v[k] == v { return k; }
	}
	h_v.push(v);
	h_p.push(float3 { 0.0, 0.0, 0.0 });
	h_n.push(float3 { 0.0, 0.0, 0.0 });
	h_v.len - 1
}
fn setup_group(asset int, sim int[:], sim_class int[:], still int[:]) {
	let base = p_rest.len;
	var gv int[>..] = [];
	var gc int[>..] = [];
	var tri int[>..] = [];
	for k in sim.len {
		let mesh = gltf::nodes[sim[k]].mesh;
		if mesh >= 0 {
			let ms = gltf::meshes[mesh];
			for pi in ms.prims.count {
				let pr = gltf::prims[ms.prims.first + pi];
				let off = gv.len;
				for v in pr.vcount {
					gv.push(pr.vfirst + v);
					gc.push(sim_class[k]);
				}
				for t in pr.icount {
					let li = gltf::indices[pr.ifirst + t] as int;
					tri.push(off + li);
				}
			}
		}
	}
	if gv.len == 0 { return; }
	var seeds int[>..] = [];
	for i in gv.len {
		let cell = f_cell[gc[i]];
		let pi = vpos(gv[i]);
		var ok = true;
		for s in seeds {
			if linalg::length3(vpos(gv[s]) - pi) < cell { ok = false; break; }
		}
		if ok { seeds.push(i); }
	}
	let m = seeds.len;
	var sp float3[>..] = [];
	for s in seeds { sp.push(vpos(gv[s])); }
	let ncls = f_sim.len;
	var lab int[>..] = [];
	var csum float3[>..] = [];
	var ccnt int[>..] = [];
	var votes int[>..] = [];
	csum.resize(m, float3 { 0.0, 0.0, 0.0 });
	ccnt.resize(m, 0);
	votes.resize(m * ncls, 0);
	for i in gv.len {
		let p = vpos(gv[i]);
		var best = 0;
		var bd f32 = 1000000000.0;
		for s in m {
			let d = linalg::length3(sp[s] - p);
			if d < bd { bd = d; best = s; }
		}
		lab.push(best);
		csum[best] = csum[best] + p;
		ccnt[best] += 1;
		votes[best * ncls + gc[i]] += 1;
	}
	var crest float3[>..] = [];
	var pc int[>..] = [];
	for i in m {
		crest.push(csum[i] / (max(ccnt[i], 1) as f32));
		var bc = 0;
		var bv = -1;
		for c in ncls {
			if votes[i * ncls + c] > bv { bv = votes[i * ncls + c]; bc = c; }
		}
		pc.push(bc);
	}
	var adj bool[>..] = [];
	adj.resize(m * m, false);
	for t in tri.len / 3 {
		let o = t * 3;
		let a = lab[tri[o]];
		let b = lab[tri[o + 1]];
		let c = lab[tri[o + 2]];
		if a != b { adj[a * m + b] = true; adj[b * m + a] = true; }
		if b != c { adj[b * m + c] = true; adj[c * m + b] = true; }
		if c != a { adj[c * m + a] = true; adj[a * m + c] = true; }
	}
	var la int[>..] = [];
	var lb int[>..] = [];
	var ll f32[>..] = [];
	var lk f32[>..] = [];
	for i in m {
		for j in i + 1..m {
			if adj[i * m + j] {
				la.push(i);
				lb.push(j);
				ll.push(linalg::length3(crest[i] - crest[j]));
				lk.push(1.0);
			}
		}
	}
	var dn bool[>..] = [];
	dn.resize(m * m, false);
	for i in m {
		for j in m {
			if adj[i * m + j] {
				for k in m {
					if k > i && adj[j * m + k] && !adj[i * m + k] && !dn[i * m + k] {
						dn[i * m + k] = true;
						la.push(i);
						lb.push(k);
						ll.push(linalg::length3(crest[i] - crest[k]));
						lk.push((f_bend[pc[i]] + f_bend[pc[k]]) * 0.5);
					}
				}
			}
		}
	}
	let jc = gltf::skins[sk].joints.count;
	var wacc f32[>..] = [];
	wacc.resize(m * jc, 0.0);
	for i in gv.len {
		let bs = gv[i] * gltf::VERTEX_FLOATS;
		let l = lab[i];
		for q in 4 {
			let ji = gltf::verts[bs + 18 + q] as int;
			if ji >= 0 && ji < jc { wacc[l * jc + ji] += gltf::verts[bs + 22 + q]; }
		}
	}
	let pelj = joint_index(gltf::find_node(asset, "pelvis"));
	var aj int[>..] = [];
	var aw f32[>..] = [];
	for i in m {
		var tot f32 = 0.0;
		let o = aj.len;
		for q in 4 {
			var bi = -1;
			var bw f32 = 0.0;
			for j in jc {
				if wacc[i * jc + j] > bw { bw = wacc[i * jc + j]; bi = j; }
			}
			if bi < 0 {
				aj.push(0);
				aw.push(0.0);
			} else {
				aj.push(bi);
				aw.push(bw);
				wacc[i * jc + bi] = 0.0;
				tot += bw;
			}
		}
		if tot <= 0.0 {
			aj[o] = max(pelj, 0);
			aw[o] = 1.0;
		} else {
			for q in 4 { aw[o + q] = aw[o + q] / tot; }
		}
	}
	var sv int[>..] = [];
	var ov int[>..] = [];
	let sn = gltf::find_node(asset, "skin");
	if sn >= 0 { mesh_verts(gltf::nodes[sn].mesh, sv); }
	for n in still { mesh_verts(gltf::nodes[n].mesh, ov); }
	var gp f32[>..] = [];
	var nsa int[>..] = [];
	var md f32[>..] = [];
	for i in m {
		var g f32 = 1000000000.0;
		var ns = -1;
		for v in sv {
			let d = linalg::length3(vpos(v) - crest[i]);
			if d < g { g = d; ns = v; }
		}
		for v in ov {
			let d = linalg::length3(vpos(v) - crest[i]);
			if d < g { g = d; }
		}
		gp.push(g);
		nsa.push(ns);
		let c = pc[i];
		md.push(min(f_swing[c], f_gain[c] * max(g - 0.01, 0.0)));
	}
	var dist f32[>..] = [];
	var src int[>..] = [];
	var sdone bool[>..] = [];
	sdone.resize(m, false);
	for i in m {
		if md[i] < 0.0001 { dist.push(0.0); src.push(i); }
		else { dist.push(1000000000.0); src.push(-1); }
	}
	for it in m {
		var u = -1;
		var ub f32 = 500000000.0;
		for i in m {
			if !sdone[i] && dist[i] < ub { ub = dist[i]; u = i; }
		}
		if u < 0 { break; }
		sdone[u] = true;
		for j in m {
			if adj[u * m + j] {
				let nd = dist[u] + linalg::length3(crest[u] - crest[j]);
				if nd < dist[j] { dist[j] = nd; src[j] = src[u]; }
			}
		}
	}
	let pv = gltf::find_node(asset, "pelvis");
	let ib = ibm_of(pv);
	let nbase = gltf::nodes.len;
	for k in m {
		gltf::nodes.push(gltf::Node {
			parent: pv,
			mesh: -1,
			skin: -1,
			children: gltf::Span { 0, 0 },
			t: linalg::point(ib, crest[k]),
			r: mquat(ib),
			s: float3 { 1.0, 1.0, 1.0 },
			matrix: gfx::mat4_identity,
			has_matrix: false,
			weights: gltf::Span { 0, 0 },
			name: gltf::Span { 0, 0 },
			..
		});
	}
	var oldc int[>..] = [];
	let pch = gltf::nodes[pv].children;
	for k in pch.count { oldc.push(gltf::ints[pch.first + k]); }
	let cfirst = gltf::ints.len;
	for x in oldc { gltf::ints.push(x); }
	for k in m { gltf::ints.push(nbase + k); }
	gltf::nodes[pv].children = gltf::Span { cfirst, oldc.len + m };
	var oldj int[>..] = [];
	let skn = gltf::skins[sk];
	for k in skn.joints.count { oldj.push(gltf::ints[skn.joints.first + k]); }
	let jfirst = gltf::ints.len;
	for x in oldj { gltf::ints.push(x); }
	for k in m { gltf::ints.push(nbase + k); }
	var oldb gfx::mat4[>..] = [];
	for k in skn.inverse_binds.count { oldb.push(gltf::matrices[skn.inverse_binds.first + k]); }
	let bfirst = gltf::matrices.len;
	for x in oldb { gltf::matrices.push(x); }
	for k in m { gltf::matrices.push(gfx::translate(float3 { 0.0, 0.0, 0.0 } - crest[k])); }
	gltf::skins[sk].joints = gltf::Span { jfirst, jc + m };
	gltf::skins[sk].inverse_binds = gltf::Span { bfirst, jc + m };
	gltf::assets[asset].nodes.count += m;
	for i in gv.len {
		let p = vpos(gv[i]);
		var bi int[4] = [-1, -1, -1, -1];
		var bd f32[4] = [1000000000.0; 4];
		for k in m {
			let d = linalg::length3(crest[k] - p);
			var ws = 0;
			for q in 1..4 {
				if bd[q] > bd[ws] { ws = q; }
			}
			if d < bd[ws] { bd[ws] = d; bi[ws] = k; }
		}
		var wt f32[4] = [0.0; 4];
		var tot f32 = 0.0;
		for q in 4 {
			if bi[q] >= 0 {
				let dd = max(bd[q], 0.0001);
				wt[q] = 1.0 / (dd * dd);
				tot += wt[q];
			}
		}
		let bs = gv[i] * gltf::VERTEX_FLOATS;
		for q in 4 {
			gltf::verts[bs + 18 + q] = (jc + max(bi[q], 0)) as f32;
			gltf::verts[bs + 22 + q] = if tot > 0.0 { wt[q] / tot } else { 0.0 };
		}
	}
	var top f32 = -1000000000.0;
	var bot f32 = 1000000000.0;
	for g in gv {
		let y = vpos(g).y;
		if y > top { top = y; }
		if y < bot { bot = y; }
	}
	for i in m {
		let c = pc[i];
		p_g.push(ngar);
		p_y.push((crest[i].y - bot) / max(top - bot, 0.000001));
		p_node.push(nbase + i);
		for q in 4 {
			p_j.push(aj[4 * i + q]);
			p_w.push(aw[4 * i + q]);
		}
		p_md.push(md[i]);
		p_damp.push(f_damp[c]);
		p_grav.push(f_grav[c]);
		p_rest.push(crest[i]);
		p_x.push(crest[i]);
		p_prev.push(crest[i]);
		p_anc.push(crest[i]);
		p_q.push(linalg::Quat { 0.0, 0.0, 0.0, 1.0 });
		p_im.push(if md[i] < 0.0001 { 0.0 } else { 1.0 });
		if md[i] >= 0.0001 && src[i] >= 0 {
			p_tie.push(base + src[i]);
			p_tl.push(dist[i]);
		} else {
			p_tie.push(-1);
			p_tl.push(0.0);
		}
		p_cap.push(-1);
		p_cap.push(-1);
		var c0 = -1;
		var c1 = -1;
		let ns = nsa[i];
		if ns >= 0 {
			c0 = hv_add(ns);
			let rest = crest[i];
			let nn = if gp[i] < 0.00001 { vnorm(ns) } else { linalg::unit3(rest - vpos(ns)) };
			var hp = -1;
			var hb f32 = -1000000000.0;
			for v in sv {
				let pw = vpos(v);
				if linalg::length3(pw - rest) < 0.07 {
					let dd = linalg::dot3(pw - rest, nn);
					if dd > hb { hb = dd; hp = v; }
				}
			}
			if hp >= 0 && hp != ns { c1 = hv_add(hp); }
		}
		p_hv.push(c0);
		p_hv.push(c1);
	}
	for k in la.len {
		e_a.push(base + la[k]);
		e_b.push(base + lb[k]);
		e_l.push(ll[k]);
		e_k.push(lk[k]);
	}
	ngar += 1;
}
fn ibm_of(node int) gfx::mat4 {
	let skin = gltf::skins[sk];
	for k in skin.joints.count {
		if gltf::ints[skin.joints.first + k] == node {
			return gltf::matrices[skin.inverse_binds.first + k];
		}
	}
	return gfx::mat4_identity;
}
fn joint_index(node int) int {
	let skin = gltf::skins[sk];
	for k in skin.joints.count {
		if gltf::ints[skin.joints.first + k] == node { return k; }
	}
	return -1;
}
fn quant(xs f32[>..]&, k f32) f32 {
	if xs.len == 0 { return 0.07; }
	for i in 1..xs.len {
		let v = xs[i];
		var j = i - 1;
		while j >= 0 && xs[j] > v { xs[j + 1] = xs[j]; j -= 1; }
		xs[j + 1] = v;
	}
	var idx = floor(xs.len as real * k as real) as int;
	idx = clamp(idx, 0, xs.len - 1);
	xs[idx]
}
fn cap_r_on(wa int, wb int, a int, b int, k f32) float2 {
	let A = pos(linalg::inverse(ibm_of(a)));
	let B = pos(linalg::inverse(ibm_of(b)));
	let ab = B - A;
	let ja = joint_index(wa);
	let jb = joint_index(wb);
	let sn = gltf::find_node(cur_asset, "skin");
	var lo f32[>..] = [];
	var hi f32[>..] = [];
	if sn < 0 { return float2 { 0.07, 0.07 }; }
	var gv int[>..] = [];
	mesh_verts(gltf::nodes[sn].mesh, gv);
	for gi in gv.len {
		let g = gv[gi];
		let bs = g * gltf::VERTEX_FLOATS;
		var wsum f32 = 0.0;
		var ca = false;
		var cb = false;
		for q in 4 {
			let ji = gltf::verts[bs + 18 + q] as int;
			let w = gltf::verts[bs + 22 + q];
			if ji == ja && !ca { wsum += w; ca = true; }
			else if ji == jb && jb != ja && !cb { wsum += w; cb = true; }
		}
		if wsum >= 0.6 {
			let p = vpos(g);
			let t = linalg::dot3(p - A, ab) / max(linalg::dot3(ab, ab), 0.000001);
			if t >= 0.0 && t <= 1.0 {
				let r = linalg::length3(p - (A + ab * t));
				if t < 0.35 { lo.push(r); }
				if t > 0.65 { hi.push(r); }
			}
		}
	}
	let qh = quant(hi, k);
	let ql = quant(lo, k);
	float2 { min(ql, qh * 1.1), qh }
}
fn cap_r(a int, b int, k f32) float2 { cap_r_on(a, b, a, b, k) }
fn node_of_mesh(asset int, name const byte[:]) int {
	let g = gltf::find_node(asset, name);
	if g >= 0 && gltf::nodes[g].mesh >= 0 { return g; }
	return -1;
}
fn add_cap(asset int, na const byte[:], nb const byte[:], k f32) {
	let a = gltf::find_node(asset, na);
	let b = gltf::find_node(asset, nb);
	if a >= 0 && b >= 0 {
		let r = cap_r(a, b, k);
		c_a.push(a);
		c_b.push(b);
		c_r0.push(r.x);
		c_r1.push(r.y);
	}
}
fn cloth_setup(path const byte[:], asset int) int {
	cl_asset = asset;
	cur_asset = asset;
	build_fabrics();
	build_wears(path);
	sk = -1;
	let sn = gltf::find_node(asset, "skin");
	if sn >= 0 && gltf::nodes[sn].mesh >= 0 && gltf::nodes[sn].skin >= 0 {
		sk = gltf::nodes[sn].skin;
	} else {
		let a = gltf::assets[asset].nodes;
		for n in a.count {
			let g = a.first + n;
			if sk < 0 && gltf::nodes[g].mesh >= 0 && gltf::nodes[g].skin >= 0 { sk = gltf::nodes[g].skin; }
		}
	}
	if sk < 0 { return 0; }
	var wi = 0;
	for w in wears {
		var first = true;
		var wj = 0;
		for w2 in wears {
			if wj < wi && w2.group == w.group { first = false; }
			wj++;
		}
		if first {
			var sim int[>..] = [];
			var scl int[>..] = [];
			var still int[>..] = [];
			for w3 in wears {
				if w3.group == w.group {
					let n = node_of_mesh(asset, w3.mesh);
					if n >= 0 {
						let c = class_row(w3.class);
						if c >= 0 && f_sim[c] {
							sim.push(n);
							scl.push(c);
						} else {
							still.push(n);
						}
					}
				}
			}
			if sim.len > 0 { setup_group(asset, sim, scl, still); }
		}
		wi++;
	}
	if p_x.len > 0 {
		add_cap(asset, "thigh_l", "calf_l", 0.99);
		add_cap(asset, "thigh_r", "calf_r", 0.99);
		add_cap(asset, "calf_l", "foot_l", 0.99);
		add_cap(asset, "calf_r", "foot_r", 0.99);
		add_cap(asset, "upperarm_l", "lowerarm_l", 0.99);
		add_cap(asset, "upperarm_r", "lowerarm_r", 0.99);
		add_cap(asset, "lowerarm_l", "hand_l", 0.99);
		add_cap(asset, "lowerarm_r", "hand_r", 0.99);
		add_cap(asset, "spine_01", "spine_03", 0.8);
		add_cap(asset, "spine_03", "neck_01", 0.8);
		let pel = gltf::find_node(asset, "pelvis");
		let tl = gltf::find_node(asset, "thigh_l");
		let tr = gltf::find_node(asset, "thigh_r");
		if pel >= 0 && tl >= 0 && tr >= 0 {
			let r = cap_r_on(pel, pel, tl, tr, 0.95);
			c_a.push(tl);
			c_b.push(tr);
			c_r0.push(r.y);
			c_r1.push(r.y);
		}
		var ca float3[>..] = [];
		var cb float3[>..] = [];
		for z in c_a.len {
			ca.push(pos(linalg::inverse(ibm_of(c_a[z]))));
			cb.push(pos(linalg::inverse(ibm_of(c_b[z]))));
		}
		for i in p_x.len {
			let p = p_rest[i];
			var b0 = -1;
			var b1 = -1;
			var d0 f32 = 1000000000.0;
			var d1 f32 = 1000000000.0;
			for z in c_a.len {
				let ab = cb[z] - ca[z];
				let t = clamp01(linalg::dot3(p - ca[z], ab) / max(linalg::dot3(ab, ab), 0.000001));
				let d = linalg::length3(p - (ca[z] + ab * t)) - max(c_r0[z], c_r1[z]);
				if d < d0 {
					d1 = d0;
					b1 = b0;
					d0 = d;
					b0 = z;
				} else if d < d1 {
					d1 = d;
					b1 = z;
				}
			}
			p_cap[2 * i] = b0;
			p_cap[2 * i + 1] = b1;
		}
	}
	let n = p_x.len;
	var cnt int[>..] = [];
	cnt.resize(n, 0);
	for k in e_a.len {
		if e_k[k] >= 0.99 {
			cnt[e_a[k]] += 1;
			cnt[e_b[k]] += 1;
		}
	}
	nb_first.clear();
	nbr.clear();
	var tot = 0;
	for i in n {
		nb_first.push(tot);
		tot += cnt[i];
	}
	nb_first.push(tot);
	nbr.resize(tot, 0);
	var cur int[>..] = [];
	for i in n { cur.push(nb_first[i]); }
	for k in e_a.len {
		if e_k[k] >= 0.99 {
			nbr[cur[e_a[k]]] = e_b[k];
			cur[e_a[k]] += 1;
			nbr[cur[e_b[k]]] = e_a[k];
			cur[e_b[k]] += 1;
		}
	}
	npts = n;
	return npts;
}
fn cloth_open(it int) { item = it; }
fn anchors() {
	motion::joints(sk, pal);
	contacts();
	for i in npts {
		var a = float3 { 0.0, 0.0, 0.0 };
		for c in 4 {
			a = a + linalg::point(pal[p_j[4 * i + c]], p_rest[i]) * p_w[4 * i + c];
		}
		p_anc[i] = a;
	}
}
fn contacts() {
	for k in h_v.len {
		let b = h_v[k] * gltf::VERTEX_FLOATS;
		let ps = float3 { gltf::verts[b], gltf::verts[b + 1], gltf::verts[b + 2] };
		let nr = float3 { gltf::verts[b + 3], gltf::verts[b + 4], gltf::verts[b + 5] };
		var sp = float3 { 0.0, 0.0, 0.0 };
		var sn = float3 { 0.0, 0.0, 0.0 };
		for q in 4 {
			let j = gltf::verts[b + 18 + q] as int;
			let w = gltf::verts[b + 22 + q];
			sp = sp + linalg::point(pal[j], ps) * w;
			sn = sn + linalg::qrotate(mquat(pal[j]), nr) * w;
		}
		h_p[k] = sp;
		h_n[k] = linalg::unit3(sn);
	}
}
fn collide(i int, s f32) {
	var x = p_x[i];
	for q in 2 {
		let z = p_cap[2 * i + q];
		if z >= 0 {
			let A = pos(motion::world[c_a[z]]);
			let B = pos(motion::world[c_b[z]]);
			let ab = B - A;
			let t = clamp01(linalg::dot3(x - A, ab) / max(linalg::dot3(ab, ab), 0.000001));
			let c = A + ab * t;
			let r = (c_r0[z] + (c_r1[z] - c_r0[z]) * t + 0.006) * s;
			let d = x - c;
			let l = linalg::length3(d);
			if l < r {
				x = c + (if l > 0.000001 { d / l } else { linalg::unit3(p_anc[i] - c) }) * r;
			}
		}
	}
	for q in 2 {
		let h = p_hv[2 * i + q];
		if h >= 0 && linalg::length3(x - h_p[h]) < 0.07 * s {
			let e = linalg::dot3(x - h_p[h], h_n[h]);
			if e < 0.004 * s {
				x = x + h_n[h] * (0.004 * s - e);
			}
		}
	}
	p_x[i] = x;
}
fn tether(i int, s f32) {
	if p_tie[i] >= 0 {
		let e = p_x[i] - p_x[p_tie[i]];
		let l = linalg::length3(e);
		let m = p_tl[i] * s * 1.02;
		if l > m {
			p_x[i] = p_x[p_tie[i]] + e * (m / l);
		}
	}
}
fn limit(i int, s f32) {
	let e = p_x[i] - p_anc[i];
	let l = linalg::length3(e);
	let m = p_md[i] * s;
	if l > m {
		p_x[i] = p_anc[i] + (if l > 0.000001 { e * (m / l) } else { e });
	}
}
fn rotations(its int) {
	for i in npts {
		var a0 = float3 { 0.0, 0.0, 0.0 };
		var a1 = float3 { 0.0, 0.0, 0.0 };
		var a2 = float3 { 0.0, 0.0, 0.0 };
		for n in nb_first[i]..nb_first[i + 1] {
			let j = nbr[n];
			let dx = p_x[j] - p_x[i];
			let dr = p_rest[j] - p_rest[i];
			a0 = a0 + dx * dr.x;
			a1 = a1 + dx * dr.y;
			a2 = a2 + dx * dr.z;
		}
		for step in its {
			let q = p_q[i];
			let r0 = linalg::qrotate(q, float3 { 1.0, 0.0, 0.0 });
			let r1 = linalg::qrotate(q, float3 { 0.0, 1.0, 0.0 });
			let r2 = linalg::qrotate(q, float3 { 0.0, 0.0, 1.0 });
			let om = (linalg::cross3(r0, a0) + linalg::cross3(r1, a1) + linalg::cross3(r2, a2)) * (1.0 / (abs(linalg::dot3(r0, a0) + linalg::dot3(r1, a1) + linalg::dot3(r2, a2)) + 0.000000001));
			let w = linalg::length3(om);
			if w < 0.000000001 { break; }
			p_q[i] = linalg::qnorm(linalg::qmul(linalg::qaxis(om / w, w), q));
		}
	}
}
fn cloth_step(dt f32) {
	if npts == 0 { return; }
	let c0 = s3d::items[item].place.c0;
	let s = linalg::length3(float3 { c0.x, c0.y, c0.z });
	if s < 0.001 { return; }
	anchors();
	if !ready || dt <= 0.0 {
		for i in npts {
			p_x[i] = p_anc[i];
			p_prev[i] = p_anc[i];
		}
		if !ready {
			for i in npts { p_q[i] = mquat(motion::world[p_node[i]]); }
			rotations(20);
			ready = true;
		}
	} else {
		let h = min(dt, 1.0 / 30.0);
		let hs = h / 3.0;
		for sub in 3 {
			for i in npts {
				if p_im[i] == 0.0 {
					p_prev[i] = p_x[i];
					p_x[i] = p_anc[i];
				} else {
					let v = (p_x[i] - p_prev[i]) * p_damp[i];
					p_prev[i] = p_x[i];
					p_x[i] = p_x[i] + v + (float3 { 0.0, -9.81, 0.0 } * p_grav[i] + wind) * (s * hs * hs);
				}
			}
			for iter in 7 {
				for k in e_a.len {
					let a = e_a[k];
					let b = e_b[k];
					let wa = p_im[a];
					let wb = p_im[b];
					let sw = wa + wb;
					if sw == 0.0 { continue; }
					let d = p_x[b] - p_x[a];
					let l = linalg::length3(d);
					if l < 0.000000001 { continue; }
					let c = d * ((l - e_l[k] * s) / l * e_k[k] / sw);
					p_x[a] = p_x[a] + c * wa;
					p_x[b] = p_x[b] - c * wb;
				}
				for i in npts {
					if p_im[i] > 0.0 {
						tether(i, s);
						collide(i, s);
						limit(i, s);
					}
				}
			}
		}
		rotations(3);
	}
	for i in npts {
		let n = p_node[i];
		let pn = gltf::nodes[n].parent;
		if pn < 0 { continue; }
		let wp = motion::world[pn];
		let iw = linalg::inverse(wp);
		let ps = linalg::length3(float3 { wp.c0.x, wp.c0.y, wp.c0.z });
		s3d::set_node(item, n, linalg::point(iw, p_x[i]), linalg::qnorm(linalg::qmul(qconj(mquat(wp)), p_q[i])), float3 { s / ps, s / ps, s / ps });
	}
}
fn cloth_stats(out f32[:]) {
	if out.len < 1 { return; }
	out[0] = ngar as f32;
	var s f32 = 1.0;
	if item >= 0 {
		let c0 = s3d::items[item].place.c0;
		s = linalg::length3(float3 { c0.x, c0.y, c0.z });
	}
	if s < 0.000001 { s = 1.0; }
	let pv = gltf::find_node(cl_asset, "pelvis");
	var c = float3 { 0.0, 0.0, 0.0 };
	if pv >= 0 { c = pos(motion::world[pv]); }
	for g in ngar {
		let o = 1 + 4 * g;
		if o + 3 >= out.len { break; }
		var count = 0;
		var nlow = 0;
		var sx f32 = 0.0;
		var sa f32 = 0.0;
		var ninside = 0;
		var deepest f32 = 0.0;
		for i in npts {
			if p_g[i] != g { continue; }
			count += 1;
			if p_y[i] < 0.15 {
				nlow += 1;
				sx += linalg::length3(float3 { p_x[i].x - c.x, 0.0, p_x[i].z - c.z });
				sa += linalg::length3(float3 { p_anc[i].x - c.x, 0.0, p_anc[i].z - c.z });
			}
			let x = p_x[i];
			var inside = false;
			var depth f32 = 0.0;
			for z in c_a.len {
				let A = pos(motion::world[c_a[z]]);
				let B = pos(motion::world[c_b[z]]);
				let ab = B - A;
				let t = clamp01(linalg::dot3(x - A, ab) / max(linalg::dot3(ab, ab), 0.000001));
				let cc = A + ab * t;
				let r = (c_r0[z] + (c_r1[z] - c_r0[z]) * t) * s;
				let l = linalg::length3(x - cc);
				if l < r {
					inside = true;
					depth = max(depth, (r - l) / s);
				}
			}
			for q in 2 {
				let h = p_hv[2 * i + q];
				if h >= 0 && linalg::length3(x - h_p[h]) < 0.07 * s {
					let e = linalg::dot3(x - h_p[h], h_n[h]);
					if e < 0.0 {
						inside = true;
						depth = max(depth, -e / s);
					}
				}
			}
			if inside {
				ninside += 1;
				deepest = max(deepest, depth);
			}
		}
		var flare f32 = 1.0;
		if nlow > 0 && sa > 0.0 { flare = (sx / (nlow as f32)) / (sa / (nlow as f32)); }
		out[o] = count as f32;
		out[o + 1] = flare;
		out[o + 2] = ninside as f32;
		out[o + 3] = deepest;
	}
}
fn cloth_wind(x f32, y f32, z f32) { wind = float3 { x, y, z }; }
