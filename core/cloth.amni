import os;
import binary;
import gfx;
import math;
import gfx.linalg;
import gfx.gltf;
import gfx.motion;
import gfx.scene3d;
import spring;
let DEFAULT_CFG = "skirt 0.025 0.01 0.15\ntank,tank_hem 0.03 0.01 0.04\nhoodie,hood,hood_hem,pocket,seam,collar 0.03 0.01 0.05\noutfit 0.03 0.01 0.03";
var npts = 0;
var item = -1;
var sk = -1;
var ready = false;
var cur_asset = -1;
var p_node int[>..];
var p_j int[>..];
var p_w f32[>..];
var p_md f32[>..];
var p_rest float3[>..];
var p_x float3[>..];
var p_prev float3[>..];
var p_anc float3[>..];
var p_q linalg::Quat[>..];
var p_im f32[>..];
var nb_first int[>..];
var nbr int[>..];
var e_a int[>..];
var e_b int[>..];
var e_l f32[>..];
var e_k f32[>..];
var c_a int[>..];
var c_b int[>..];
var c_r0 f32[>..];
var c_r1 f32[>..];
var pal gfx::mat4[>..];
fn v3(x f32, y f32, z f32) float3 { float3 { x, y, z } }
fn dot3(a float3, b float3) f32 { a.x * b.x + a.y * b.y + a.z * b.z }
fn cross3(a float3, b float3) float3 { float3 { a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x } }
fn length3(a float3) f32 { sqrt(dot3(a, a) as real) as f32 }
fn vpos(g int) float3 {
	let bs = g * gltf::VERTEX_FLOATS;
	float3 { gltf::verts[bs], gltf::verts[bs + 1], gltf::verts[bs + 2] }
}
fn mesh_verts(mesh int, out int[>..]&) {
	if mesh < 0 { return; }
	let me = gltf::meshes[mesh];
	let nv = gltf::verts.len / gltf::VERTEX_FLOATS;
	var seen bool[>..] = [];
	for i in nv { seen.push(false); }
	for pi in me.prims.count {
		let prim = gltf::prims[me.prims.first + pi];
		for n in prim.icount {
			let g = prim.vfirst + gltf::indices[prim.ifirst + n] as int;
			if g >= 0 && g < nv && !seen[g] {
				seen[g] = true;
				out.push(g);
			}
		}
	}
}
fn setup_garment(asset int, gnodes int[:], cell f32, snug f32, free f32) {
	cur_asset = asset;
	let nf = gltf::assets[asset].nodes.first;
	var gv int[>..] = [];
	var tmp int[>..] = [];
	for g in gnodes {
		tmp.clear();
		mesh_verts(gltf::nodes[nf + g].mesh, tmp);
		gv.append(tmp);
	}
	var seeds float3[>..] = [];
	for gi in gv.len {
		let p = vpos(gv[gi]);
		var ok = true;
		for s in seeds.len {
			if length3(seeds[s] - p) < cell { ok = false; break; }
		}
		if ok { seeds.push(p); }
	}
	let m = seeds.len;
	if m == 0 { return; }
	let pv = gltf::find_node(asset, "pelvis");
	if pv < 0 { return; }
	var lab int[>..] = [];
	var sum float3[>..] = [];
	var cnt int[>..] = [];
	for k in m { sum.push(v3(0.0, 0.0, 0.0)); cnt.push(0); }
	let nv = gltf::verts.len / gltf::VERTEX_FLOATS;
	var glab int[>..] = [];
	for i in nv { glab.push(-1); }
	for gi in gv.len {
		let p = vpos(gv[gi]);
		var best = 0;
		var bd f32 = 1000000000.0;
		for k in m {
			let d = length3(seeds[k] - p);
			if d < bd { bd = d; best = k; }
		}
		lab.push(best);
		glab[gv[gi]] = best;
		sum[best] = sum[best] + p;
		cnt[best] += 1;
	}
	var C float3[>..] = [];
	for k in m { C.push(sum[k] * (1.0 / max(cnt[k] as f32, 1.0))); }
	var adj bool[>..] = [];
	for i in m * m { adj.push(false); }
	for g in gnodes {
		let mesh = gltf::meshes[gltf::nodes[nf + g].mesh];
		for pi in mesh.prims.count {
			let prim = gltf::prims[mesh.prims.first + pi];
			for t in prim.icount / 3 {
				let a = glab[prim.vfirst + gltf::indices[prim.ifirst + 3 * t] as int];
				let b = glab[prim.vfirst + gltf::indices[prim.ifirst + 3 * t + 1] as int];
				let c = glab[prim.vfirst + gltf::indices[prim.ifirst + 3 * t + 2] as int];
				if a >= 0 && b >= 0 && a != b { adj[a * m + b] = true; adj[b * m + a] = true; }
				if b >= 0 && c >= 0 && b != c { adj[b * m + c] = true; adj[c * m + b] = true; }
				if c >= 0 && a >= 0 && c != a { adj[c * m + a] = true; adj[a * m + c] = true; }
			}
		}
	}
	var la int[>..] = [];
	var lb int[>..] = [];
	var lk f32[>..] = [];
	for i in m {
		for j in i + 1..m {
			if adj[i * m + j] { la.push(i); lb.push(j); lk.push(1.0); }
		}
	}
	var done bool[>..] = [];
	for i in m * m { done.push(false); }
	for i in m {
		for j in m {
			if !adj[i * m + j] { continue; }
			for k in m {
				if !adj[j * m + k] { continue; }
				if k > i && !adj[i * m + k] && !done[i * m + k] {
					done[i * m + k] = true;
					la.push(i);
					lb.push(k);
					lk.push(0.15);
				}
			}
		}
	}
	let oj = gltf::skins[sk].joints.count;
	var aw f32[>..] = [];
	for i in m * oj { aw.push(0.0); }
	for gi in gv.len {
		let bs = gv[gi] * gltf::VERTEX_FLOATS;
		let k = lab[gi];
		for q in 4 {
			let ji = gltf::verts[bs + 18 + q] as int;
			let w = gltf::verts[bs + 22 + q];
			if ji >= 0 && ji < oj { aw[k * oj + ji] += w; }
		}
	}
	let jp = joint_index(pv);
	let sn = gltf::find_node(asset, "skin");
	var sv int[>..] = [];
	if sn >= 0 { mesh_verts(gltf::nodes[sn].mesh, sv); }
	let off = npts;
	for k in m {
		let base = k * oj;
		var tj int[4] = [0; 4];
		var tw f32[4] = [0.0; 4];
		var tot f32 = 0.0;
		for r in 4 {
			var bi = -1;
			var bv f32 = -1.0;
			for j in oj {
				if aw[base + j] > bv { bv = aw[base + j]; bi = j; }
			}
			if bi >= 0 {
				tj[r] = bi;
				tw[r] = bv;
				tot += bv;
				aw[base + bi] = -2.0;
			}
		}
		if tot <= 0.0 {
			tj[0] = max(jp, 0);
			tw[0] = 1.0;
			tot = 1.0;
		}
		for r in 4 {
			p_j.push(tj[r]);
			p_w.push(tw[r] / tot);
		}
		var gap f32 = 1000000000.0;
		for si in sv.len {
			let d = length3(vpos(sv[si]) - C[k]);
			if d < gap { gap = d; }
		}
		let md = min(free, 3.0 * max(gap - snug, 0.0));
		p_node.push(0);
		p_md.push(md);
		p_rest.push(C[k]);
		p_x.push(C[k]);
		p_prev.push(C[k]);
		p_anc.push(C[k]);
		p_q.push(linalg::quat_identity());
		p_im.push(if md < 0.0001 { 0.0 } else { 1.0 });
	}
	let ib = ibm_of(pv);
	let nbase = gltf::nodes.len;
	for k in m {
		gltf::nodes.push(gltf::Node { parent: pv, mesh: -1, skin: -1, children: gltf::Span { 0, 0 }, t: linalg::point(ib, C[k]), r: mquat(ib), s: v3(1.0, 1.0, 1.0), matrix: gfx::mat4_identity, has_matrix: false, weights: gltf::Span { 0, 0 }, name: gltf::Span { 0, 0 }, .. });
		p_node[off + k] = nbase + k;
	}
	let ch = gltf::nodes[pv].children;
	let cfirst = gltf::ints.len;
	for c in ch.count { gltf::ints.push(gltf::ints[ch.first + c]); }
	for k in m { gltf::ints.push(nbase + k); }
	gltf::nodes[pv].children = gltf::Span { cfirst, ch.count + m };
	let sj = gltf::skins[sk].joints;
	let jfirst = gltf::ints.len;
	for c in sj.count { gltf::ints.push(gltf::ints[sj.first + c]); }
	for k in m { gltf::ints.push(nbase + k); }
	gltf::skins[sk].joints = gltf::Span { jfirst, sj.count + m };
	let sb = gltf::skins[sk].inverse_binds;
	let bfirst = gltf::matrices.len;
	for c in sb.count { gltf::matrices.push(gltf::matrices[sb.first + c]); }
	for k in m { gltf::matrices.push(gfx::translate(C[k] * -1.0)); }
	gltf::skins[sk].inverse_binds = gltf::Span { bfirst, sb.count + m };
	gltf::assets[asset].nodes.count += m;
	for k in la.len {
		e_a.push(la[k] + off);
		e_b.push(lb[k] + off);
		e_l.push(length3(C[la[k]] - C[lb[k]]));
		e_k.push(lk[k]);
	}
	for gi in gv.len {
		let g = gv[gi];
		let p = vpos(g);
		var bi int[4] = [-1; 4];
		var bd f32[4] = [1000000000.0; 4];
		for k in m {
			let d = length3(C[k] - p);
			var wi = 0;
			for q in 1..4 {
				if bd[q] > bd[wi] { wi = q; }
			}
			if d < bd[wi] { bd[wi] = d; bi[wi] = k; }
		}
		var ws f32[4] = [0.0; 4];
		var tot f32 = 0.0;
		for q in 4 {
			if bi[q] >= 0 {
				let dd = max(bd[q], 0.0001);
				ws[q] = 1.0 / (dd * dd);
				tot += ws[q];
			}
		}
		let bs = g * gltf::VERTEX_FLOATS;
		for q in 4 {
			gltf::verts[bs + 18 + q] = (oj + max(bi[q], 0)) as f32;
			gltf::verts[bs + 22 + q] = ws[q] / max(tot, 0.000001);
		}
	}
	npts = off + m;
}
fn ibm_of(node int) gfx::mat4 {
	let skin = gltf::skins[sk];
	for k in skin.joints.count {
		if gltf::ints[skin.joints.first + k] == node {
			return gltf::matrices[skin.inverse_binds.first + k];
		}
	}
	return gfx::mat4_identity;
}
fn joint_index(node int) int {
	let skin = gltf::skins[sk];
	for k in skin.joints.count {
		if gltf::ints[skin.joints.first + k] == node { return k; }
	}
	return -1;
}
fn quant(xs f32[>..]&, k f32) f32 {
	if xs.len == 0 { return 0.07; }
	for i in 1..xs.len {
		let v = xs[i];
		var j = i - 1;
		while j >= 0 && xs[j] > v { xs[j + 1] = xs[j]; j -= 1; }
		xs[j + 1] = v;
	}
	var idx = floor(xs.len as real * k as real) as int;
	idx = clamp(idx, 0, xs.len - 1);
	xs[idx]
}
fn cap_r_on(wa int, wb int, a int, b int, k f32) float2 {
	let A = pos(linalg::inverse(ibm_of(a)));
	let B = pos(linalg::inverse(ibm_of(b)));
	let ab = B - A;
	let ja = joint_index(wa);
	let jb = joint_index(wb);
	let sn = gltf::find_node(cur_asset, "skin");
	var lo f32[>..] = [];
	var hi f32[>..] = [];
	if sn < 0 { return float2 { 0.07, 0.07 }; }
	var gv int[>..] = [];
	mesh_verts(gltf::nodes[sn].mesh, gv);
	for gi in gv.len {
		let g = gv[gi];
		let bs = g * gltf::VERTEX_FLOATS;
		var wsum f32 = 0.0;
		var ca = false;
		var cb = false;
		for q in 4 {
			let ji = gltf::verts[bs + 18 + q] as int;
			let w = gltf::verts[bs + 22 + q];
			if ji == ja && !ca { wsum += w; ca = true; }
			else if ji == jb && jb != ja && !cb { wsum += w; cb = true; }
		}
		if wsum >= 0.6 {
			let p = vpos(g);
			let t = dot3(p - A, ab) / max(dot3(ab, ab), 0.000001);
			if t >= 0.0 && t <= 1.0 {
				let r = length3(p - (A + ab * t));
				if t < 0.35 { lo.push(r); }
				if t > 0.65 { hi.push(r); }
			}
		}
	}
	let qh = quant(hi, k);
	let ql = quant(lo, k);
	float2 { min(ql, qh * 1.1), qh }
}
fn cap_r(a int, b int, k f32) float2 { cap_r_on(a, b, a, b, k) }
fn mesh_name_is(m int, name const byte[:]) bool {
	let sp = gltf::meshes[m].name;
	gltf::names[sp.first..sp.first + sp.count] == name
}
fn cloth_setup(path const byte[:], asset int) int {
	cur_asset = asset;
	var data byte[>..] = [];
	if !read_file(path, data) {
		data.clear();
		data.append("skirt 0.025 0.02 0.15");
	}
	let nf = gltf::assets[asset].nodes.first;
	let ncount = gltf::assets[asset].nodes.count;
	let sn = gltf::find_node(asset, "skin");
	if sn >= 0 && gltf::nodes[sn].mesh >= 0 && gltf::nodes[sn].skin >= 0 {
		sk = gltf::nodes[sn].skin;
	} else {
		var found = -1;
		for i in ncount {
			let n = nf + i;
			if gltf::nodes[n].mesh >= 0 && gltf::nodes[n].skin >= 0 { found = gltf::nodes[n].skin; break; }
		}
		if found < 0 { return 0; }
		sk = found;
	}
	for line in split(data, '\n') {
		var fc = 0;
		var f0 const byte[:] = "";
		var cell f32 = 0.0;
		var snug f32 = 0.0;
		var fr f32 = 0.0;
		for w, wi in words(line) {
			fc += 1;
			if wi == 0 { f0 = w; }
			if wi == 1 { let v, ok = parse_flt(w); cell = v as f32; }
			if wi == 2 { let v, ok = parse_flt(w); snug = v as f32; }
			if wi == 3 { let v, ok = parse_flt(w); fr = v as f32; }
		}
		if fc != 4 { continue; }
		var gn int[>..] = [];
		for nm in split(f0, ',') {
			for i in ncount {
				let mi = gltf::nodes[nf + i].mesh;
				if mi >= 0 && mesh_name_is(mi, nm) { gn.push(i); break; }
			}
		}
		if gn.len == 0 { continue; }
		setup_garment(asset, gn, cell, snug, fr);
	}
	if npts > 0 {
		fn add_cap(an const byte[:], bn const byte[:], k f32) {
			let a = gltf::find_node(asset, an);
			let b = gltf::find_node(asset, bn);
			if a < 0 || b < 0 { return; }
			let r = cap_r(a, b, k);
			c_a.push(a);
			c_b.push(b);
			c_r0.push(r.x);
			c_r1.push(r.y);
		}
		add_cap("thigh_l", "calf_l", 0.99);
		add_cap("thigh_r", "calf_r", 0.99);
		add_cap("calf_l", "foot_l", 0.99);
		add_cap("calf_r", "foot_r", 0.99);
		add_cap("upperarm_l", "lowerarm_l", 0.99);
		add_cap("upperarm_r", "lowerarm_r", 0.99);
		add_cap("lowerarm_l", "hand_l", 0.99);
		add_cap("lowerarm_r", "hand_r", 0.99);
		add_cap("spine_01", "spine_03", 0.8);
		add_cap("spine_03", "neck_01", 0.8);
		let tl = gltf::find_node(asset, "thigh_l");
		let tr = gltf::find_node(asset, "thigh_r");
		let pe = gltf::find_node(asset, "pelvis");
		if tl >= 0 && tr >= 0 && pe >= 0 {
			let r = cap_r_on(pe, pe, tl, tr, 0.95);
			c_a.push(tl);
			c_b.push(tr);
			c_r0.push(r.y);
			c_r1.push(r.y);
		}
	}
	nb_first.clear();
	nbr.clear();
	var cn int[>..] = [];
	for i in npts { cn.push(0); }
	for k in e_a.len {
		if e_k[k] >= 0.99 {
			cn[e_a[k]] += 1;
			cn[e_b[k]] += 1;
		}
	}
	var acc = 0;
	for i in npts {
		nb_first.push(acc);
		acc += cn[i];
	}
	nb_first.push(acc);
	var cur int[>..] = [];
	for i in npts { cur.push(nb_first[i]); }
	for i in acc { nbr.push(0); }
	for k in e_a.len {
		if e_k[k] >= 0.99 {
			let a = e_a[k];
			let b = e_b[k];
			nbr[cur[a]] = b;
			cur[a] += 1;
			nbr[cur[b]] = a;
			cur[b] += 1;
		}
	}
	npts
}
fn cloth_open(it int) { item = it; }
fn anchors() {
	motion::joints(sk, pal);
	for i in npts {
		var a = v3(0.0, 0.0, 0.0);
		for c in 4 {
			a = a + linalg::point(pal[p_j[4 * i + c]], p_rest[i]) * p_w[4 * i + c];
		}
		p_anc[i] = a;
	}
}
fn collide(i int, s f32) {
	var x = p_x[i];
	for z in c_a.len {
		let A = pos(motion::world[c_a[z]]);
		let B = pos(motion::world[c_b[z]]);
		let ab = B - A;
		let t = clamp01(dot3(x - A, ab) / max(dot3(ab, ab), 0.000001));
		let c = A + ab * t;
		let r = (c_r0[z] + (c_r1[z] - c_r0[z]) * t + 0.006) * s;
		let d = x - c;
		let l = length3(d);
		if l < r {
			x = c + (if l > 0.000001 { d / l } else { linalg::unit3(p_anc[i] - c) }) * r;
		}
	}
	p_x[i] = x;
}
fn limit(i int, s f32) {
	let e = p_x[i] - p_anc[i];
	let l = length3(e);
	let m = p_md[i] * s;
	if l > m {
		p_x[i] = p_anc[i] + (if l > 0.000001 { e * (m / l) } else { e });
	}
}
fn rotations(its int) {
	for i in npts {
		var a0 = v3(0.0, 0.0, 0.0);
		var a1 = v3(0.0, 0.0, 0.0);
		var a2 = v3(0.0, 0.0, 0.0);
		for n in nb_first[i]..nb_first[i + 1] {
			let j = nbr[n];
			let dx = p_x[j] - p_x[i];
			let dr = p_rest[j] - p_rest[i];
			a0 = a0 + dx * dr.x;
			a1 = a1 + dx * dr.y;
			a2 = a2 + dx * dr.z;
		}
		for step in its {
			let q = p_q[i];
			let r0 = linalg::qrotate(q, v3(1.0, 0.0, 0.0));
			let r1 = linalg::qrotate(q, v3(0.0, 1.0, 0.0));
			let r2 = linalg::qrotate(q, v3(0.0, 0.0, 1.0));
			let om = (cross3(r0, a0) + cross3(r1, a1) + cross3(r2, a2)) * (1.0 / (abs(dot3(r0, a0) + dot3(r1, a1) + dot3(r2, a2)) + 0.000000001));
			let w = length3(om);
			if w < 0.000000001 { break; }
			p_q[i] = linalg::qnorm(linalg::qmul(linalg::qaxis(om / w, w), q));
		}
	}
}
fn cloth_step(dt f32) {
	if npts == 0 { return; }
	let c0 = s3d::items[item].place.c0;
	let s = length3(v3(c0.x, c0.y, c0.z));
	if s < 0.001 { return; }
	anchors();
	if !ready || dt <= 0.0 {
		for i in npts { p_x[i] = p_anc[i]; p_prev[i] = p_anc[i]; }
		if !ready {
			for i in npts { p_q[i] = mquat(motion::world[p_node[i]]); }
			rotations(20);
			ready = true;
		}
	} else {
		let h = min(dt, 1.0 / 30.0);
		let hs = h / 3.0;
		for sub in 3 {
			for i in npts {
				if p_im[i] == 0.0 {
					p_prev[i] = p_x[i];
					p_x[i] = p_anc[i];
				} else {
					let v = (p_x[i] - p_prev[i]) * 0.985;
					p_prev[i] = p_x[i];
					p_x[i] = p_x[i] + v + v3(0.0, -9.81, 0.0) * (hs * hs);
				}
			}
			for iter in 7 {
				for k in e_a.len {
					let a = e_a[k];
					let b = e_b[k];
					let wa = p_im[a];
					let wb = p_im[b];
					let sw = wa + wb;
					if sw == 0.0 { continue; }
					let d = p_x[b] - p_x[a];
					let l = length3(d);
					if l < 0.000000001 { continue; }
					let c = d * ((l - e_l[k] * s) / l * e_k[k] / sw);
					p_x[a] = p_x[a] + c * wa;
					p_x[b] = p_x[b] - c * wb;
				}
				for i in npts {
					if p_im[i] > 0.0 {
						collide(i, s);
						limit(i, s);
					}
				}
			}
		}
		rotations(3);
	}
	for i in npts {
		let n = p_node[i];
		let pn = gltf::nodes[n].parent;
		if pn < 0 { continue; }
		let wp = motion::world[pn];
		let iw = linalg::inverse(wp);
		let ps = length3(v3(wp.c0.x, wp.c0.y, wp.c0.z));
		s3d::set_node(item, n, linalg::point(iw, p_x[i]), linalg::qnorm(linalg::qmul(qconj(mquat(wp)), p_q[i])), v3(s / ps, s / ps, s / ps));
	}
}
