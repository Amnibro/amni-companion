import os;
import binary;
import gfx;
import math;
import gfx.linalg;
import gfx.gltf;
import gfx.motion;
import gfx.scene3d;
import spring;
struct Fabric { name byte[>..], sim bool, cell f32, gain f32, swing f32, bend f32, damp f32, grav f32 }
var fabrics Fabric[>..];
var f_sim bool[>..];
var f_cell f32[>..];
var f_gain f32[>..];
var f_swing f32[>..];
var f_bend f32[>..];
var f_damp f32[>..];
var f_grav f32[>..];
fn build_fabrics() {
	let fr = fabric_rows();
	fabrics = copy(fr);
	f_sim.clear();
	f_cell.clear();
	f_gain.clear();
	f_swing.clear();
	f_bend.clear();
	f_damp.clear();
	f_grav.clear();
	for f in fr {
		f_sim.push(f.sim);
		f_cell.push(f.cell);
		f_gain.push(f.gain);
		f_swing.push(f.swing);
		f_bend.push(f.bend);
		f_damp.push(f.damp);
		f_grav.push(f.grav);
	}
}
fn class_row(name const byte[:]) int {
	var i = 0;
	for f in fabrics {
		if f.name == name { return i; }
		i++;
	}
	return -1;
}
fn fabric_rows() Fabric[>..] {
	var r Fabric[>..] = [];
	r.push(Fabric{"rigid", false, 0, 0, 0, 0, 0, 0});
	r.push(Fabric{"tight", false, 0, 0, 0, 0, 0, 0});
	r.push(Fabric{"close", true, 0.04, 2.0, 0.04, 0.3, 0.98, 1.0});
	r.push(Fabric{"loose", true, 0.025, 3.0, 0.15, 0.15, 0.985, 1.0});
	r
}
struct Wear { mesh byte[>..], group byte[>..], class byte[>..] }
var wears Wear[>..];
fn build_wears(path const byte[:]) {
	var data byte[>..] = [];
	if !read_file(path, data) { data.clear(); }
	let lines = split(data, '\n');
	let base = wear_rows();
	var out Wear[>..] = [];
	for b in base {
		var n = 0;
		for line in lines {
			let ws = words(trim(line));
			if ws.len >= 3 && ws[0] == b.mesh { n += 1; }
		}
		if n == 0 {
			out.push(Wear { b.mesh, b.group, b.class });
		} else {
			var k = 0;
			for line in lines {
				let ws = words(trim(line));
				if ws.len >= 3 && ws[0] == b.mesh {
					k += 1;
					if k == n { out.push(Wear { ws[0], ws[1], ws[2] }); }
				}
			}
		}
	}
	var li = 0;
	for line in lines {
		let ws = words(trim(line));
		if ws.len >= 3 {
			var inbase = false;
			for b in base {
				if b.mesh == ws[0] { inbase = true; }
			}
			if !inbase {
				var later = false;
				var lj = 0;
				for line2 in lines {
					if lj > li {
						let ws2 = words(trim(line2));
						if ws2.len >= 3 && ws2[0] == ws[0] { later = true; }
					}
					lj += 1;
				}
				if !later { out.push(Wear { ws[0], ws[1], ws[2] }); }
			}
		}
		li += 1;
	}
	wears = copy(out);
}
fn wear_rows() Wear[>..] {
	var r Wear[>..] = [];
	r.push(Wear{"skirt", "skirt", "loose"});
	r.push(Wear{"tank", "tank", "tight"});
	r.push(Wear{"tank_hem", "tank", "close"});
	r.push(Wear{"shorts", "shorts", "tight"});
	r.push(Wear{"shorts_lace", "shorts", "tight"});
	r.push(Wear{"socks", "socks", "tight"});
	r.push(Wear{"stripes", "socks", "tight"});
	r.push(Wear{"gloves", "gloves", "tight"});
	r.push(Wear{"belt", "belt", "rigid"});
	r.push(Wear{"buckle", "belt", "rigid"});
	r.push(Wear{"choker", "choker", "rigid"});
	r.push(Wear{"plate", "choker", "rigid"});
	r.push(Wear{"chain", "chain", "rigid"});
	r.push(Wear{"shoes", "shoes", "rigid"});
	r.push(Wear{"glasses", "glasses", "rigid"});
	r.push(Wear{"outfit", "outfit", "tight"});
	r.push(Wear{"hoodie", "hoodie", "close"});
	r.push(Wear{"hood", "hoodie", "loose"});
	r.push(Wear{"hood_hem", "hoodie", "loose"});
	r.push(Wear{"pocket", "hoodie", "close"});
	r.push(Wear{"seam", "hoodie", "close"});
	r.push(Wear{"collar", "hoodie", "close"});
	r
}
var npts = 0;
var item = -1;
var sk = -1;
var ready = false;
var wind = float3 { 0.0, 0.0, 0.0 };
var p_node int[>..];
var p_j int[>..];
var p_w f32[>..];
var p_md f32[>..];
var p_damp f32[>..];
var p_grav f32[>..];
var p_rest float3[>..];
var p_x float3[>..];
var p_prev float3[>..];
var p_anc float3[>..];
var p_q linalg::Quat[>..];
var p_im f32[>..];
var p_g int[>..];
var p_y f32[>..];
var p_tie int[>..];
var p_tl f32[>..];
var p_cap int[>..];
var p_hv int[>..];
var h_v int[>..];
var h_p float3[>..];
var h_n float3[>..];
var ngar = 0;
var cl_asset = -1;
var cur_asset = -1;
var nb_first int[>..];
var nbr int[>..];
var e_a int[>..];
var e_b int[>..];
var e_l f32[>..];
var e_k f32[>..];
var c_a int[>..];
var c_b int[>..];
var c_r0 f32[>..];
var c_r1 f32[>..];
var pal gfx::mat4[>..];
fn vpos(g int) float3 {
	let b = g * gltf::VERTEX_FLOATS;
	float3 { gltf::verts[b], gltf::verts[b + 1], gltf::verts[b + 2] }
}
fn vnorm(g int) float3 {
	let b = g * gltf::VERTEX_FLOATS;
	float3 { gltf::verts[b + 3], gltf::verts[b + 4], gltf::verts[b + 5] }
}
fn mesh_verts(mesh int, out int[>..]&) {
	if mesh < 0 { return; }
	let ms = gltf::meshes[mesh];
	for pi in ms.prims.count {
		let pr = gltf::prims[ms.prims.first + pi];
		for v in pr.vcount { out.push(pr.vfirst + v); }
	}
}
fn col3(v) float3 { float3 { v.x, v.y, v.z } }
fn contact_slot(v int) int {
	for k in h_v.len {
		if h_v[k] == v { return k; }
	}
	h_v.push(v);
	h_p.push(float3 { 0.0, 0.0, 0.0 });
	h_n.push(float3 { 0.0, 0.0, 0.0 });
	return h_v.len - 1;
}
fn setup_group(asset int, sim int[:], sim_class int[:], still int[:]) {
	var gv int[>..] = [];
	var gc int[>..] = [];
	for k in sim.len {
		let before = gv.len;
		mesh_verts(gltf::nodes[sim[k]].mesh, gv);
		for v in before..gv.len { gc.push(sim_class[k]); }
	}
	let n = gv.len;
	if n == 0 { return; }
	let pv = gltf::find_node(asset, "pelvis");
	if pv < 0 { return; }
	let VF = gltf::VERTEX_FLOATS;
	let ncl = fabrics.len;
	var gp float3[>..] = [];
	for i in n { gp.push(vpos(gv[i])); }
	var seeds int[>..] = [];
	for i in n {
		let cell = f_cell[gc[i]];
		var ok = true;
		for s in seeds {
			if linalg::length3(gp[s] - gp[i]) < cell { ok = false; break; }
		}
		if ok { seeds.push(i); }
	}
	let m = seeds.len;
	var lab int[>..] = [];
	for i in n {
		var best = 0;
		var bd f32 = 1.0e30;
		for c in m {
			let d = linalg::length3(gp[seeds[c]] - gp[i]);
			if d < bd { bd = d; best = c; }
		}
		lab.push(best);
	}
	var csum float3[>..] = [];
	var ccnt int[>..] = [];
	var cvote int[>..] = [];
	for c in m {
		csum.push(float3 { 0.0, 0.0, 0.0 });
		ccnt.push(0);
		for q in ncl { cvote.push(0); }
	}
	for i in n {
		let c = lab[i];
		csum[c] = csum[c] + gp[i];
		ccnt[c] += 1;
		cvote[c * ncl + gc[i]] += 1;
	}
	var C float3[>..] = [];
	var cls int[>..] = [];
	for c in m {
		C.push(csum[c] / (max(ccnt[c], 1) as f32));
		var bc = 0;
		var bv = -1;
		for q in ncl {
			if cvote[c * ncl + q] > bv { bv = cvote[c * ncl + q]; bc = q; }
		}
		cls.push(bc);
	}
	var adj bool[>..] = [];
	for q in m * m { adj.push(false); }
	var base = 0;
	for k in sim.len {
		let mi = gltf::nodes[sim[k]].mesh;
		if mi >= 0 {
			let ms = gltf::meshes[mi];
			for pi in ms.prims.count {
				let pr = gltf::prims[ms.prims.first + pi];
				for t in pr.icount / 3 {
					for e in 3 {
						let a = lab[base + (gltf::indices[pr.ifirst + 3 * t + e] as int)];
						let b = lab[base + (gltf::indices[pr.ifirst + 3 * t + (e + 1) % 3] as int)];
						if a != b {
							adj[a * m + b] = true;
							adj[b * m + a] = true;
						}
					}
				}
				base += pr.vcount;
			}
		}
	}
	var la int[>..] = [];
	var lb int[>..] = [];
	var ll f32[>..] = [];
	var lk f32[>..] = [];
	for i in m {
		for j in i + 1..m {
			if adj[i * m + j] {
				la.push(i);
				lb.push(j);
				ll.push(linalg::length3(C[i] - C[j]));
				lk.push(1.0);
			}
		}
	}
	let nst = la.len;
	var seen bool[>..] = [];
	for q in m * m { seen.push(false); }
	for i in m {
		for j in m {
			if adj[i * m + j] {
				for k in m {
					if k > i && adj[j * m + k] && !adj[i * m + k] && !seen[i * m + k] {
						seen[i * m + k] = true;
						la.push(i);
						lb.push(k);
						ll.push(linalg::length3(C[i] - C[k]));
						lk.push((f_bend[cls[i]] + f_bend[cls[k]]) * 0.5);
					}
				}
			}
		}
	}
	let nj = gltf::skins[sk].joints.count;
	let tl = gltf::find_node(asset, "thigh_l");
	let tr = gltf::find_node(asset, "thigh_r");
	var isleg bool[>..] = [];
	for k in nj {
		var nd = gltf::ints[gltf::skins[sk].joints.first + k];
		var leg = false;
		while nd >= 0 {
			if nd == tl || nd == tr { leg = true; break; }
			nd = gltf::nodes[nd].parent;
		}
		isleg.push(leg);
	}
	var jw f32[>..] = [];
	for q in m * nj { jw.push(0.0); }
	for i in n {
		let c = lab[i];
		let b = gv[i] * VF;
		for q in 4 {
			let ji = gltf::verts[b + 18 + q] as int;
			if ji >= 0 && ji < nj { jw[c * nj + ji] += gltf::verts[b + 22 + q]; }
		}
	}
	let pj = joint_index(pv);
	var aj int[>..] = [];
	var aw f32[>..] = [];
	for c in m {
		var keep f32 = 0.0;
		for k in nj {
			if !isleg[k] { keep += jw[c * nj + k]; }
		}
		if keep > 0.0 {
			for k in nj {
				if isleg[k] { jw[c * nj + k] = 0.0; }
			}
		}
		var bj int[4] = [-1; 4];
		var bw f32[4] = [0.0; 4];
		var tot f32 = 0.0;
		for q in 4 {
			var best = -1;
			var bv f32 = 0.0;
			for k in nj {
				let w = jw[c * nj + k];
				if w > bv { bv = w; best = k; }
			}
			if best >= 0 {
				bj[q] = best;
				bw[q] = bv;
				jw[c * nj + best] = 0.0;
				tot += bv;
			}
		}
		if tot > 0.0 {
			for q in 4 { bw[q] = bw[q] / tot; }
		} else {
			bj[0] = pj;
			bw[0] = 1.0;
		}
		for q in 4 {
			aj.push(if bj[q] < 0 { max(pj, 0) } else { bj[q] });
			aw.push(bw[q]);
		}
	}
	var sv int[>..] = [];
	let sn = gltf::find_node(asset, "skin");
	if sn >= 0 { mesh_verts(gltf::nodes[sn].mesh, sv); }
	var stv int[>..] = [];
	for k in still.len { mesh_verts(gltf::nodes[still[k]].mesh, stv); }
	var md f32[>..] = [];
	var hv int[>..] = [];
	for c in m {
		let r = C[c];
		var nsd f32 = 1.0e30;
		var ns = -1;
		for v in sv {
			let d = linalg::length3(vpos(v) - r);
			if d < nsd { nsd = d; ns = v; }
		}
		var gap = nsd;
		for v in stv {
			let d = linalg::length3(vpos(v) - r);
			if d < gap { gap = d; }
		}
		let cl = cls[c];
		md.push(min(f_swing[cl], f_gain[cl] * max(gap - 0.01, 0.0)));
		var h0 = -1;
		var h1 = -1;
		if ns >= 0 {
			let dv = r - vpos(ns);
			let nn = if gap < 0.00001 { vnorm(ns) } else { dv / max(linalg::length3(dv), 0.000001) };
			var hp = -1;
			var hb f32 = -1.0e30;
			for v in sv {
				let d = vpos(v) - r;
				if linalg::length3(d) < 0.07 {
					let e = linalg::dot3(d, nn);
					if e > hb { hb = e; hp = v; }
				}
			}
			h0 = contact_slot(ns);
			if hp >= 0 && hp != ns { h1 = contact_slot(hp); }
		}
		hv.push(h0);
		hv.push(h1);
	}
	var dist f32[>..] = [];
	var src int[>..] = [];
	var done bool[>..] = [];
	for c in m {
		let pinned = md[c] < 0.0001;
		dist.push(if pinned { 0.0 } else { 1.0e30 });
		src.push(if pinned { c } else { -1 });
		done.push(false);
	}
	for it in m {
		var u = -1;
		var ud f32 = 1.0e30;
		for c in m {
			if !done[c] && dist[c] < ud { ud = dist[c]; u = c; }
		}
		if u < 0 { break; }
		done[u] = true;
		for k in nst {
			let o = if la[k] == u { lb[k] } else if lb[k] == u { la[k] } else { -1 };
			if o >= 0 && !done[o] && ud + ll[k] < dist[o] {
				dist[o] = ud + ll[k];
				src[o] = src[u];
			}
		}
	}
	var top f32 = -1.0e30;
	var bot f32 = 1.0e30;
	for i in n {
		top = max(top, gp[i].y);
		bot = min(bot, gp[i].y);
	}
	let ib = ibm_of(pv);
	let n0 = gltf::nodes.len;
	for k in m {
		gltf::nodes.push(gltf::Node { parent: pv, mesh: -1, skin: -1, children: gltf::Span { 0, 0 }, t: linalg::point(ib, C[k]), r: mquat(ib), s: float3 { 1.0, 1.0, 1.0 }, matrix: gfx::mat4_identity, has_matrix: false, weights: gltf::Span { 0, 0 }, name: gltf::Span { 0, 0 }, .. });
	}
	let ch = gltf::nodes[pv].children;
	let cf = gltf::ints.len;
	for q in ch.count {
		let t = gltf::ints[ch.first + q];
		gltf::ints.push(t);
	}
	for k in m { gltf::ints.push(n0 + k); }
	gltf::nodes[pv].children = gltf::Span { cf, ch.count + m };
	let sjs = gltf::skins[sk].joints;
	let sib = gltf::skins[sk].inverse_binds;
	let jf = gltf::ints.len;
	for q in sjs.count {
		let t = gltf::ints[sjs.first + q];
		gltf::ints.push(t);
	}
	for k in m { gltf::ints.push(n0 + k); }
	gltf::skins[sk].joints = gltf::Span { jf, sjs.count + m };
	let mf = gltf::matrices.len;
	for q in sib.count {
		let t = gltf::matrices[sib.first + q];
		gltf::matrices.push(t);
	}
	for k in m { gltf::matrices.push(gfx::translate(C[k] * -1.0)); }
	gltf::skins[sk].inverse_binds = gltf::Span { mf, sib.count + m };
	gltf::assets[asset].nodes.count = gltf::assets[asset].nodes.count + m;
	for i in n {
		var bi int[4] = [-1; 4];
		var bd f32[4] = [1.0e30; 4];
		for c in m {
			let d = linalg::length3(gp[i] - C[c]);
			if d < bd[3] {
				var pi = 3;
				while pi > 0 && d < bd[pi - 1] {
					bd[pi] = bd[pi - 1];
					bi[pi] = bi[pi - 1];
					pi -= 1;
				}
				bd[pi] = d;
				bi[pi] = c;
			}
		}
		var ws f32[4] = [0.0; 4];
		var tw f32 = 0.0;
		for q in 4 {
			if bi[q] >= 0 {
				let dd = max(bd[q], 0.0001);
				ws[q] = 1.0 / (dd * dd);
				tw += ws[q];
			}
		}
		let b = gv[i] * VF;
		for q in 4 {
			let ci = if bi[q] >= 0 { bi[q] } else { 0 };
			gltf::verts[b + 18 + q] = (nj + ci) as f32;
			gltf::verts[b + 22 + q] = ws[q] / tw;
		}
	}
	let p0 = p_x.len;
	for k in m {
		let cl = cls[k];
		p_g.push(ngar);
		p_y.push((C[k].y - bot) / max(top - bot, 0.000001));
		p_node.push(n0 + k);
		for q in 4 {
			p_j.push(aj[4 * k + q]);
			p_w.push(aw[4 * k + q]);
		}
		p_md.push(md[k]);
		p_damp.push(f_damp[cl]);
		p_grav.push(f_grav[cl]);
		p_rest.push(C[k]);
		p_x.push(C[k]);
		p_prev.push(C[k]);
		p_anc.push(C[k]);
		p_q.push(linalg::qaxis(float3 { 0.0, 1.0, 0.0 }, 0.0));
		p_im.push(if md[k] < 0.0001 { 0.0 } else { 1.0 });
		if md[k] >= 0.0001 && src[k] >= 0 {
			p_tie.push(p0 + src[k]);
			p_tl.push(dist[k]);
		} else {
			p_tie.push(-1);
			p_tl.push(0.0);
		}
		p_hv.push(hv[2 * k]);
		p_hv.push(hv[2 * k + 1]);
		p_cap.push(-1);
		p_cap.push(-1);
	}
	for k in la.len {
		e_a.push(p0 + la[k]);
		e_b.push(p0 + lb[k]);
		e_l.push(ll[k]);
		e_k.push(lk[k]);
	}
	ngar += 1;
}
fn ibm_of(node int) gfx::mat4 {
	let skin = gltf::skins[sk];
	for k in skin.joints.count {
		if gltf::ints[skin.joints.first + k] == node {
			return gltf::matrices[skin.inverse_binds.first + k];
		}
	}
	return gfx::mat4_identity;
}
fn joint_index(node int) int {
	let skin = gltf::skins[sk];
	for k in skin.joints.count {
		if gltf::ints[skin.joints.first + k] == node { return k; }
	}
	return -1;
}
fn quant(xs f32[>..]&, k f32) f32 {
	if xs.len == 0 { return 0.07; }
	for i in 1..xs.len {
		let v = xs[i];
		var j = i - 1;
		while j >= 0 && xs[j] > v { xs[j + 1] = xs[j]; j -= 1; }
		xs[j + 1] = v;
	}
	var idx = floor(xs.len as real * k as real) as int;
	idx = clamp(idx, 0, xs.len - 1);
	xs[idx]
}
fn cap_r_on(wa int, wb int, a int, b int, k f32) float2 {
	let A = pos(linalg::inverse(ibm_of(a)));
	let B = pos(linalg::inverse(ibm_of(b)));
	let ab = B - A;
	let ja = joint_index(wa);
	let jb = joint_index(wb);
	let sn = gltf::find_node(cur_asset, "skin");
	var lo f32[>..] = [];
	var hi f32[>..] = [];
	if sn < 0 { return float2 { 0.07, 0.07 }; }
	var gv int[>..] = [];
	mesh_verts(gltf::nodes[sn].mesh, gv);
	for gi in gv.len {
		let g = gv[gi];
		let bs = g * gltf::VERTEX_FLOATS;
		var wsum f32 = 0.0;
		var ca = false;
		var cb = false;
		for q in 4 {
			let ji = gltf::verts[bs + 18 + q] as int;
			let w = gltf::verts[bs + 22 + q];
			if ji == ja && !ca { wsum += w; ca = true; }
			else if ji == jb && jb != ja && !cb { wsum += w; cb = true; }
		}
		if wsum >= 0.6 {
			let p = vpos(g);
			let t = linalg::dot3(p - A, ab) / max(linalg::dot3(ab, ab), 0.000001);
			if t >= 0.0 && t <= 1.0 {
				let r = linalg::length3(p - (A + ab * t));
				if t < 0.35 { lo.push(r); }
				if t > 0.65 { hi.push(r); }
			}
		}
	}
	let qh = quant(hi, k);
	let ql = quant(lo, k);
	float2 { min(ql, qh * 1.1), qh }
}
fn cap_r(a int, b int, k f32) float2 { cap_r_on(a, b, a, b, k) }
fn add_cap(asset int, an const byte[:], bn const byte[:]) {
	let a = gltf::find_node(asset, an);
	let b = gltf::find_node(asset, bn);
	if a < 0 || b < 0 { return; }
	let r = cap_r(a, b, 0.99);
	c_a.push(a);
	c_b.push(b);
	c_r0.push(r.x);
	c_r1.push(r.y);
}
fn cloth_setup(path const byte[:], asset int) int {
	cl_asset = asset;
	cur_asset = asset;
	build_fabrics();
	build_wears(path);
	sk = -1;
	let nf = gltf::assets[asset].nodes.first;
	let nc = gltf::assets[asset].nodes.count;
	let sn = gltf::find_node(asset, "skin");
	if sn >= 0 && gltf::nodes[sn].mesh >= 0 && gltf::nodes[sn].skin >= 0 {
		sk = gltf::nodes[sn].skin;
	} else {
		for k in nc {
			let nd = nf + k;
			if sk < 0 && gltf::nodes[nd].mesh >= 0 && gltf::nodes[nd].skin >= 0 {
				sk = gltf::nodes[nd].skin;
			}
		}
	}
	if sk < 0 { return 0; }
	for w, wi in wears {
		var seen = false;
		for r, ri in wears {
			if ri < wi && r.group == w.group { seen = true; }
		}
		if !seen {
			var sim int[>..] = [];
			var simc int[>..] = [];
			var still int[>..] = [];
			for r in wears {
				if r.group == w.group {
					let nd = gltf::find_node(asset, r.mesh);
					let cr = class_row(r.class);
					if nd >= 0 && cr >= 0 && gltf::nodes[nd].mesh >= 0 {
						if f_sim[cr] {
							sim.push(nd);
							simc.push(cr);
						} else {
							still.push(nd);
						}
					}
				}
			}
			if sim.len > 0 { setup_group(asset, sim, simc, still); }
		}
	}
	let np = p_x.len;
	if np > 0 {
		add_cap(asset, "thigh_l", "calf_l");
		add_cap(asset, "thigh_r", "calf_r");
		add_cap(asset, "calf_l", "foot_l");
		add_cap(asset, "calf_r", "foot_r");
		add_cap(asset, "upperarm_l", "lowerarm_l");
		add_cap(asset, "upperarm_r", "lowerarm_r");
		add_cap(asset, "lowerarm_l", "hand_l");
		add_cap(asset, "lowerarm_r", "hand_r");
		let pel = gltf::find_node(asset, "pelvis");
		let tl = gltf::find_node(asset, "thigh_l");
		let tr = gltf::find_node(asset, "thigh_r");
		if pel >= 0 && tl >= 0 && tr >= 0 {
			let r = cap_r_on(pel, pel, tl, tr, 0.95);
			c_a.push(tl);
			c_b.push(tr);
			c_r0.push(r.y);
			c_r1.push(r.y);
		}
		var ca float3[>..] = [];
		var cb float3[>..] = [];
		for z in c_a.len {
			ca.push(pos(linalg::inverse(ibm_of(c_a[z]))));
			cb.push(pos(linalg::inverse(ibm_of(c_b[z]))));
		}
		for i in np {
			var b1 = -1;
			var d1 f32 = 1.0e30;
			var b2 = -1;
			var d2 f32 = 1.0e30;
			for z in c_a.len {
				let A = ca[z];
				let B = cb[z];
				let ab = B - A;
				let t = clamp01(linalg::dot3(p_rest[i] - A, ab) / max(linalg::dot3(ab, ab), 0.000001));
				let d = linalg::length3(p_rest[i] - (A + ab * t)) - max(c_r0[z], c_r1[z]);
				if d < d1 {
					b2 = b1;
					d2 = d1;
					b1 = z;
					d1 = d;
				} else if d < d2 {
					b2 = z;
					d2 = d;
				}
			}
			p_cap[2 * i] = b1;
			p_cap[2 * i + 1] = b2;
		}
	}
	var deg int[>..] = [];
	for i in np { deg.push(0); }
	for k in e_a.len {
		if e_k[k] >= 0.99 {
			deg[e_a[k]] += 1;
			deg[e_b[k]] += 1;
		}
	}
	nb_first.clear();
	nbr.clear();
	var acc = 0;
	for i in np {
		nb_first.push(acc);
		acc += deg[i];
	}
	nb_first.push(acc);
	var fillp int[>..] = [];
	for i in np { fillp.push(nb_first[i]); }
	for q in acc { nbr.push(0); }
	for k in e_a.len {
		if e_k[k] >= 0.99 {
			let a = e_a[k];
			let b = e_b[k];
			nbr[fillp[a]] = b;
			fillp[a] += 1;
			nbr[fillp[b]] = a;
			fillp[b] += 1;
		}
	}
	npts = np;
	return np;
}
fn cloth_open(it int) { item = it; }
fn anchors() {
	motion::joints(sk, pal);
	contacts();
	for i in npts {
		var a = float3 { 0.0, 0.0, 0.0 };
		for c in 4 {
			a = a + linalg::point(pal[p_j[4 * i + c]], p_rest[i]) * p_w[4 * i + c];
		}
		p_anc[i] = a;
	}
}
fn contacts() {
	for k in h_v.len {
		let b = h_v[k] * gltf::VERTEX_FLOATS;
		let ps = float3 { gltf::verts[b], gltf::verts[b + 1], gltf::verts[b + 2] };
		let nr = float3 { gltf::verts[b + 3], gltf::verts[b + 4], gltf::verts[b + 5] };
		var sp = float3 { 0.0, 0.0, 0.0 };
		var sn = float3 { 0.0, 0.0, 0.0 };
		for q in 4 {
			let j = gltf::verts[b + 18 + q] as int;
			let w = gltf::verts[b + 22 + q];
			sp = sp + linalg::point(pal[j], ps) * w;
			sn = sn + linalg::qrotate(mquat(pal[j]), nr) * w;
		}
		h_p[k] = sp;
		h_n[k] = linalg::unit3(sn);
	}
}
fn collide(i int, s f32) {
	var x = p_x[i];
	for q in 2 {
		let z = p_cap[2 * i + q];
		if z >= 0 {
			let A = pos(motion::world[c_a[z]]);
			let B = pos(motion::world[c_b[z]]);
			let ab = B - A;
			let t = clamp01(linalg::dot3(x - A, ab) / max(linalg::dot3(ab, ab), 0.000001));
			let c = A + ab * t;
			let r = (c_r0[z] + (c_r1[z] - c_r0[z]) * t + 0.006) * s;
			let d = x - c;
			let l = linalg::length3(d);
			if l < r {
				x = c + (if l > 0.000001 { d / l } else { linalg::unit3(p_anc[i] - c) }) * r;
			}
		}
	}
	for q in 2 {
		let h = p_hv[2 * i + q];
		if h >= 0 && linalg::length3(x - h_p[h]) < 0.07 * s {
			let e = linalg::dot3(x - h_p[h], h_n[h]);
			if e < 0.004 * s {
				x = x + h_n[h] * (0.004 * s - e);
			}
		}
	}
	p_x[i] = x;
}
fn tether(i int, s f32) {
	if p_tie[i] >= 0 {
		let e = p_x[i] - p_x[p_tie[i]];
		let l = linalg::length3(e);
		let m = p_tl[i] * s * 1.02;
		if l > m {
			p_x[i] = p_x[p_tie[i]] + e * (m / l);
		}
	}
}
fn limit(i int, s f32) {
	let e = p_x[i] - p_anc[i];
	let l = linalg::length3(e);
	let m = p_md[i] * s;
	if l > m {
		p_x[i] = p_anc[i] + (if l > 0.000001 { e * (m / l) } else { e });
	}
}
fn rotations(its int) {
	for i in npts {
		var a0 = float3 { 0.0, 0.0, 0.0 };
		var a1 = float3 { 0.0, 0.0, 0.0 };
		var a2 = float3 { 0.0, 0.0, 0.0 };
		for n in nb_first[i]..nb_first[i + 1] {
			let j = nbr[n];
			let dx = p_x[j] - p_x[i];
			let dr = p_rest[j] - p_rest[i];
			a0 = a0 + dx * dr.x;
			a1 = a1 + dx * dr.y;
			a2 = a2 + dx * dr.z;
		}
		for step in its {
			let q = p_q[i];
			let r0 = linalg::qrotate(q, float3 { 1.0, 0.0, 0.0 });
			let r1 = linalg::qrotate(q, float3 { 0.0, 1.0, 0.0 });
			let r2 = linalg::qrotate(q, float3 { 0.0, 0.0, 1.0 });
			let om = (linalg::cross3(r0, a0) + linalg::cross3(r1, a1) + linalg::cross3(r2, a2)) * (1.0 / (abs(linalg::dot3(r0, a0) + linalg::dot3(r1, a1) + linalg::dot3(r2, a2)) + 0.000000001));
			let w = linalg::length3(om);
			if w < 0.000000001 { break; }
			p_q[i] = linalg::qnorm(linalg::qmul(linalg::qaxis(om / w, w), q));
		}
	}
}
fn cloth_step(dt f32) {
	if npts == 0 { return; }
	let s = linalg::length3(col3(s3d::items[item].place.c0));
	if s < 0.001 { return; }
	anchors();
	if !ready || dt <= 0.0 {
		for i in npts {
			p_x[i] = p_anc[i];
			p_prev[i] = p_anc[i];
		}
		if !ready {
			for i in npts { p_q[i] = mquat(motion::world[p_node[i]]); }
			rotations(20);
			ready = true;
		}
	} else {
		let h = min(dt, 1.0 / 30.0);
		let hs = h / 3.0;
		for sub in 3 {
			for i in npts {
				if p_im[i] == 0.0 {
					p_prev[i] = p_x[i];
					p_x[i] = p_anc[i];
				} else {
					let v = (p_x[i] - p_prev[i]) * p_damp[i];
					p_prev[i] = p_x[i];
					p_x[i] = p_x[i] + v + (float3 { 0.0, -9.81, 0.0 } * p_grav[i] + wind) * (s * hs * hs);
				}
			}
			for it in 7 {
				for k in e_a.len {
					let a = e_a[k];
					let b = e_b[k];
					let wa = p_im[a];
					let wb = p_im[b];
					let sw = wa + wb;
					if sw == 0.0 { continue; }
					let d = p_x[b] - p_x[a];
					let l = linalg::length3(d);
					if l < 0.000000001 { continue; }
					let c = d * ((l - e_l[k] * s) / l * e_k[k] / sw);
					p_x[a] = p_x[a] + c * wa;
					p_x[b] = p_x[b] - c * wb;
				}
				for i in npts {
					if p_im[i] > 0.0 {
						tether(i, s);
						limit(i, s);
						collide(i, s);
					}
				}
			}
		}
		rotations(3);
	}
	for i in npts {
		let n = p_node[i];
		let pn = gltf::nodes[n].parent;
		if pn < 0 { continue; }
		let wp = motion::world[pn];
		let iw = linalg::inverse(wp);
		let ps = linalg::length3(col3(wp.c0));
		s3d::set_node(item, n, linalg::point(iw, p_x[i]), linalg::qnorm(linalg::qmul(qconj(mquat(wp)), p_q[i])), float3 { s / ps, s / ps, s / ps });
	}
}
fn cloth_stats(out f32[:]) {
	out[0] = ngar as f32;
	var s f32 = 1.0;
	if item >= 0 { s = linalg::length3(col3(s3d::items[item].place.c0)); }
	if s < 0.000001 { s = 1.0; }
	let pelvis = gltf::find_node(cl_asset, "pelvis");
	let havep = pelvis >= 0;
	let c = if havep { pos(motion::world[pelvis]) } else { float3 { 0.0, 0.0, 0.0 } };
	for g in ngar {
		var cnt = 0;
		var nlow = 0;
		var m1 f32 = 0.0;
		var m2 f32 = 0.0;
		var ninside = 0;
		var deepest f32 = 0.0;
		for i in npts {
			if p_g[i] == g {
				cnt += 1;
				if p_y[i] < 0.15 {
					nlow += 1;
					let dx = p_x[i].x - c.x;
					let dz = p_x[i].z - c.z;
					m1 += sqrt(dx * dx + dz * dz);
					let ax = p_anc[i].x - c.x;
					let az = p_anc[i].z - c.z;
					m2 += sqrt(ax * ax + az * az);
				}
				let x = p_x[i];
				var inside = false;
				var depth f32 = 0.0;
				for q in 2 {
					let z = p_cap[2 * i + q];
					if z >= 0 {
						let A = pos(motion::world[c_a[z]]);
						let B = pos(motion::world[c_b[z]]);
						let ab = B - A;
						let t = clamp01(linalg::dot3(x - A, ab) / max(linalg::dot3(ab, ab), 0.000001));
						let cp = A + ab * t;
						let r = (c_r0[z] + (c_r1[z] - c_r0[z]) * t) * s;
						let l = linalg::length3(x - cp);
						if l < r {
							inside = true;
							depth = max(depth, (r - l) / s);
						}
					}
				}
				for q in 2 {
					let h = p_hv[2 * i + q];
					if h >= 0 && linalg::length3(x - h_p[h]) < 0.07 * s {
						let e = linalg::dot3(x - h_p[h], h_n[h]);
						if e < 0.0 {
							inside = true;
							depth = max(depth, (0.0 - e) / s);
						}
					}
				}
				if inside {
					ninside += 1;
					deepest = max(deepest, depth);
				}
			}
		}
		var flare f32 = 1.0;
		if havep && nlow > 0 && m2 > 0.0 {
			flare = (m1 / (nlow as f32)) / (m2 / (nlow as f32));
		}
		let b = 1 + 4 * g;
		out[b] = cnt as f32;
		out[b + 1] = flare;
		out[b + 2] = ninside as f32;
		out[b + 3] = deepest;
	}
}
fn cloth_wind(x f32, y f32, z f32) { wind = float3 { x, y, z }; }
