into unpose.amni

```amni
import os;
import math;
import gfx.linalg;
import gfx.gltf;
import bake;
fn up_under(n int, a int) bool {
	var k = n;
	while k >= 0 { if k == a { return true; } k = gltf::nodes[k].parent; }
	false
}
fn up_node(asset int, name const byte[:]) int {
	for i in gltf::assets[asset].nodes.count { if gltf::text_of(gltf::nodes[gltf::assets[asset].nodes.first + i].name) == name { return gltf::assets[asset].nodes.first + i; } }
	-1
}
fn up_mesh(asset int, name const byte[:]) int {
	for i in gltf::assets[asset].meshes.count { if gltf::text_of(gltf::meshes[gltf::assets[asset].meshes.first + i].name) == name { return gltf::assets[asset].meshes.first + i; } }
	-1
}
fn up_vp(v int, k int) float3 {
	let o = v * gltf::VERTEX_FLOATS + k;
	float3 { gltf::verts[o], gltf::verts[o + 1], gltf::verts[o + 2] }
}
fn up_set(v int, k int, p float3) {
	let o = v * gltf::VERTEX_FLOATS + k;
	gltf::verts[o] = p.x;
	gltf::verts[o + 1] = p.y;
	gltf::verts[o + 2] = p.z;
}
fn up_fade(y f32, hi f32, lo f32) f32 {
	let s = clamp((hi - y) / max(hi - lo, 0.0001), 0.0, 1.0);
	s * s * (3.0 - 2.0 * s)
}
fn up_same(ma int, mb int) bool {
	if mb < 0 || gltf::meshes[ma].prims.count != gltf::meshes[mb].prims.count { return false; }
	for j in gltf::meshes[ma].prims.count { if gltf::prims[gltf::meshes[ma].prims.first + j].vcount != gltf::prims[gltf::meshes[mb].prims.first + j].vcount { return false; } }
	true
}
fn unpose_arms(asset int, dl f32, dr f32) int {
	if gltf::assets[asset].skins.count < 1 { return 0; }
	let sk = gltf::skins[gltf::assets[asset].skins.first];
	var pv float3[>..] = [];
	var an int[>..] = [];
	for side in 2 {
		let a = up_node(asset, if side == 0 { "upperarm_l" } else { "upperarm_r" });
		an.push(a);
		var q = float3 { 0.0, 0.0, 0.0 };
		for j in sk.joints.count { if gltf::ints[sk.joints.first + j] == a { let bw = linalg::inverse(gltf::matrices[sk.inverse_binds.first + j]); q = float3 { bw.c3.x, bw.c3.y, bw.c3.z }; } }
		pv.push(q);
	}
	if an[0] < 0 || an[1] < 0 { return 0; }
	let cx = (pv[0].x + pv[1].x) * 0.5;
	var moved = 0;
	for rs in 2 {
		let side = 1 - rs;
		let deg = if side == 0 { dl } else { dr };
		if deg == 0.0 { continue; }
		let ang = deg * 0.0174533 * (if pv[side].x > cx { -1.0 } else { 1.0 });
		let c = linalg::f(cos(ang as real));
		let sn = linalg::f(sin(ang as real));
		var mark bool[>..] = [];
		for j in sk.joints.count { mark.push(up_under(gltf::ints[sk.joints.first + j], an[side])); }
		for i in gltf::assets[asset].nodes.count {
			let n = gltf::assets[asset].nodes.first + i;
			if gltf::nodes[n].mesh < 0 || gltf::nodes[n].skin < 0 { continue; }
			let me = gltf::nodes[n].mesh;
			for pp in gltf::meshes[me].prims.first..gltf::meshes[me].prims.first + gltf::meshes[me].prims.count {
				let pm = gltf::prims[pp];
				for v in pm.vfirst..pm.vfirst + pm.vcount {
					let o = v * gltf::VERTEX_FLOATS;
					var ws f32 = 0.0;
					for k in 4 { let jj = gltf::verts[o + gltf::AT_JOINT + k] as int; if jj >= 0 && jj < mark.len && mark[jj] { ws += gltf::verts[o + gltf::AT_WEIGHT + k]; } }
					if ws <= 0.0 { continue; }
					moved += 1;
					let ma = 1.0 - ws + ws * c;
					let mb = ws * sn;
					let dt = 1.0 / (ma * ma + mb * mb);
					let qx = gltf::verts[o + gltf::AT_POS] - pv[side].x;
					let qy = gltf::verts[o + gltf::AT_POS + 1] - pv[side].y;
					gltf::verts[o + gltf::AT_POS] = pv[side].x + (ma * qx + mb * qy) * dt;
					gltf::verts[o + gltf::AT_POS + 1] = pv[side].y + (ma * qy - mb * qx) * dt;
					let nx = gltf::verts[o + gltf::AT_NRM];
					let ny = gltf::verts[o + gltf::AT_NRM + 1];
					up_set(v, gltf::AT_NRM, linalg::unit3(float3 { (ma * nx + mb * ny) * dt, (ma * ny - mb * nx) * dt, gltf::verts[o + gltf::AT_NRM + 2] }));
				}
			}
		}
	}
	moved
}
fn up_idw(sp const float3[:], sd const float3[:], p float3, eps real) float3 {
	var wx real = 0.0;
	var wy real = 0.0;
	var wz real = 0.0;
	var wt real = 0.0;
	for k in sp.len {
		let e = sp[k] - p;
		let d2 = (e.x * e.x + e.y * e.y + e.z * e.z) as real + eps;
		let w = 1.0 / (d2 * d2 * d2 * d2);
		wx += w * (sd[k].x as real);
		wy += w * (sd[k].y as real);
		wz += w * (sd[k].z as real);
		wt += w;
	}
	if wt <= 0.0 { float3 { 0.0, 0.0, 0.0 } } else { float3 { linalg::f(wx / wt), linalg::f(wy / wt), linalg::f(wz / wt) } }
}
fn rebody(asset int, src int, hi f32, lo f32) int {
	let sa = up_mesh(asset, "skin");
	let sb = up_mesh(src, "skin");
	if sa < 0 || !up_same(sa, sb) { return 0; }
	var sp float3[>..] = [];
	var sd float3[>..] = [];
	for j in gltf::meshes[sa].prims.count {
		let pa = gltf::prims[gltf::meshes[sa].prims.first + j];
		let pb = gltf::prims[gltf::meshes[sb].prims.first + j];
		for v in pa.vcount {
			let q = up_vp(pb.vfirst + v, gltf::AT_POS);
			let p = up_vp(pa.vfirst + v, gltf::AT_POS);
			sp.push(p);
			sd.push((q - p) * up_fade(p.y, hi, lo));
		}
	}
	var moved = 0;
	for i in gltf::assets[asset].meshes.count {
		let ma = gltf::assets[asset].meshes.first + i;
		let mb = up_mesh(src, gltf::text_of(gltf::meshes[ma].name));
		let same = up_same(ma, mb);
		for j in gltf::meshes[ma].prims.count {
			let pa = gltf::prims[gltf::meshes[ma].prims.first + j];
			for v in pa.vcount {
				let p = up_vp(pa.vfirst + v, gltf::AT_POS);
				if same {
					let pb = gltf::prims[gltf::meshes[mb].prims.first + j];
					let q = up_vp(pb.vfirst + v, gltf::AT_POS);
					let f = up_fade(p.y, hi, lo);
					if f <= 0.0 { continue; }
					up_set(pa.vfirst + v, gltf::AT_POS, p + (q - p) * f);
					let n = up_vp(pa.vfirst + v, gltf::AT_NRM);
					up_set(pa.vfirst + v, gltf::AT_NRM, linalg::unit3(n + (up_vp(pb.vfirst + v, gltf::AT_NRM) - n) * f));
					moved += 1;
				} else {
					if p.y > hi + 0.05 { continue; }
					up_set(pa.vfirst + v, gltf::AT_POS, p + up_idw(sp[..], sd[..], p, 0.000001));
					moved += 1;
				}
			}
		}
	}
	moved
}
fn up_area(asset int, rep const int[:], nn float3[>..]&) {
	nn.clear();
	nn.resize(gltf::verts.len / gltf::VERTEX_FLOATS, float3 { 0.0, 0.0, 0.0 });
	for i in gltf::assets[asset].meshes.count {
		let m = gltf::meshes[gltf::assets[asset].meshes.first + i];
		for j in m.prims.count {
			let pr = gltf::prims[m.prims.first + j];
			for t in pr.icount / 3 {
				let a = pr.vfirst + gltf::indices[pr.ifirst + t * 3] as int;
				let b = pr.vfirst + gltf::indices[pr.ifirst + t * 3 + 1] as int;
				let c = pr.vfirst + gltf::indices[pr.ifirst + t * 3 + 2] as int;
				let pa = up_vp(a, gltf::AT_POS);
				let n = linalg::cross3(up_vp(b, gltf::AT_POS) - pa, up_vp(c, gltf::AT_POS) - pa) * 1000000.0;
				nn[rep[a]] = nn[rep[a]] + n;
				nn[rep[b]] = nn[rep[b]] + n;
				nn[rep[c]] = nn[rep[c]] + n;
			}
		}
	}
}
fn up_gate(v f32, a f32, b f32) f32 { if b > a { 1.0 - up_fade(v, b, a) } else { up_fade(v, a, b) } }
fn up_band(p float3, b const f32[:], o int) f32 { up_gate(p.y, b[o + 4], b[o + 5]) * up_gate(p.y, b[o + 7], b[o + 6]) * up_gate(abs(p.x), b[o + 8], b[o + 9]) * up_gate(p.z, b[o + 10], b[o + 11]) }
fn up_head(asset int, src int, lo f32, hi f32, band const f32[:]) int {
	let nv = gltf::verts.len / gltf::VERTEX_FLOATS;
	var rep int[>..] = [];
	var mv bool[>..] = [];
	for v in nv { rep.push(v); }
	mv.resize(nv, false);
	var rg int[>..] = [];
	for i in gltf::assets[asset].meshes.count {
		let m = gltf::meshes[gltf::assets[asset].meshes.first + i];
		for j in m.prims.count {
			let pr = gltf::prims[m.prims.first + j];
			if pr.vcount > 12000 { continue; }
			rg.clear();
			for v in pr.vcount {
				let p = up_vp(pr.vfirst + v, gltf::AT_POS);
				if p.y > lo - 0.06 && abs(p.x) < 0.16 { rg.push(pr.vfirst + v); }
			}
			for x in rg.len {
				let p = up_vp(rg[x], gltf::AT_POS);
				for y in x {
					let q = up_vp(rg[y], gltf::AT_POS);
					if p.x == q.x && p.y == q.y && p.z == q.z { rep[rg[x]] = rep[rg[y]]; break; }
				}
			}
		}
	}
	var nb float3[>..] = [];
	up_area(asset, rep[..], nb);
	var sp float3[>..] = [];
	var sd float3[>..] = [];
	var sv int[>..] = [];
	var gp float3[>..] = [];
	var gc float3[>..] = [];
	var moved = 0;
	for i in gltf::assets[asset].meshes.count {
		let ma = gltf::assets[asset].meshes.first + i;
		let nm = gltf::text_of(gltf::meshes[ma].name);
		let mb = up_mesh(src, nm);
		if !up_same(ma, mb) || nm == "hair" || nm == "braid_hair" { continue; }
		let outer = nm == "face" || nm == "skin" || nm == "scalp";
		sp.clear();
		sd.clear();
		sv.clear();
		for j in gltf::meshes[ma].prims.count {
			let pa = gltf::prims[gltf::meshes[ma].prims.first + j];
			let pb = gltf::prims[gltf::meshes[mb].prims.first + j];
			for v in pa.vcount {
				let q = up_vp(pb.vfirst + v, gltf::AT_POS);
				if q.y < lo - 0.03 || abs(q.x) > 0.13 { continue; }
				sp.push(q);
				sd.push(up_vp(pa.vfirst + v, gltf::AT_POS) - q);
				sv.push(pa.vfirst + v);
			}
		}
		for k in sp.len {
			let q = sp[k];
			let m = up_idw(sp[..], sd[..], float3 { -q.x, q.y, q.z }, 0.0000001);
			let c = (float3 { -m.x, m.y, m.z } - sd[k]) * (0.5 * (1.0 - up_fade(q.y, hi, lo)));
			let p = q + sd[k];
			up_set(sv[k], gltf::AT_POS, p + c);
			mv[sv[k]] = true;
			if outer { gp.push(p); gc.push(c); }
			moved += 1;
		}
	}
	for i in gltf::assets[asset].meshes.count {
		let ma = gltf::assets[asset].meshes.first + i;
		let nm = gltf::text_of(gltf::meshes[ma].name);
		if gp.len == 0 || (up_same(ma, up_mesh(src, nm)) && nm != "hair" && nm != "braid_hair") { continue; }
		for j in gltf::meshes[ma].prims.count {
			let pa = gltf::prims[gltf::meshes[ma].prims.first + j];
			for v in pa.vcount {
				let p = up_vp(pa.vfirst + v, gltf::AT_POS);
				if p.y < lo - 0.03 || abs(p.x) > 0.13 { continue; }
				up_set(pa.vfirst + v, gltf::AT_POS, p + up_idw(gp[..], gc[..], p, 0.000001));
				mv[pa.vfirst + v] = true;
				moved += 1;
			}
		}
	}
	for r in band.len / 12 {
		let o = r * 12;
		if band[o] > 1.5 { continue; }
		let back = band[o] > 0.5;
		let k = float3 { band[o + 1], band[o + 2], band[o + 3] };
		let wide = band[o + 4] < lo - 0.03;
		gp.clear();
		gc.clear();
		for pass in 2 {
			for i in gltf::assets[asset].meshes.count {
				let ma = gltf::assets[asset].meshes.first + i;
				let nm = gltf::text_of(gltf::meshes[ma].name);
				let mb = up_mesh(src, nm);
				let outer = back && up_same(ma, mb) && (nm == "face" || nm == "skin" || nm == "scalp");
				if (if back { (pass == 1) == outer } else { pass == 1 || (wide && (nm == "hair" || nm == "braid_hair")) }) { continue; }
				for j in gltf::meshes[ma].prims.count {
					let pa = gltf::prims[gltf::meshes[ma].prims.first + j];
					for v in pa.vcount {
						let g = pa.vfirst + v;
						let p = up_vp(g, gltf::AT_POS);
						if !wide && (p.y < lo - 0.03 || abs(p.x) > 0.13) { continue; }
						var c = float3 { 0.0, 0.0, 0.0 };
						if outer {
							let q = up_vp(gltf::prims[gltf::meshes[mb].prims.first + j].vfirst + v, gltf::AT_POS);
							let w = up_band(q, band, o);
							c = float3 { (q.x - p.x) * k.x * w, (q.y - p.y) * k.y * w, (q.z - p.z) * k.z * w };
							gp.push(p);
							gc.push(c);
						} else if back {
							c = up_idw(gp[..], gc[..], p, 0.000001);
						} else {
							let w = up_band(p, band, o);
							c = float3 { (if p.x < 0.0 { -k.x } else { k.x }) * w, k.y * w, k.z * w };
						}
						if linalg::length3(c) <= 0.0 { continue; }
						up_set(g, gltf::AT_POS, p + c);
						mv[g] = true;
					}
				}
			}
		}
	}
	var na float3[>..] = [];
	up_area(asset, rep[..], na);
	for i in gltf::assets[asset].meshes.count {
		let m = gltf::meshes[gltf::assets[asset].meshes.first + i];
		for j in m.prims.count {
			let pr = gltf::prims[m.prims.first + j];
			if pr.vcount > 12000 { continue; }
			for v in pr.vcount {
				let g = pr.vfirst + v;
				let a = nb[rep[g]];
				let b = na[rep[g]];
				if !mv[g] || linalg::length3(a) <= 0.0 || linalg::length3(b) <= 0.0 { continue; }
				up_set(g, gltf::AT_NRM, linalg::unit3(up_vp(g, gltf::AT_NRM) + linalg::unit3(b) - linalg::unit3(a)));
			}
		}
	}
	moved
}
fn up_num(s const byte[:]) f32 {
	let v, ok = parse_flt(s);
	v as f32
}
fn up_image(asset int, name const byte[:]) int {
	for i in gltf::assets[asset].materials.count {
		let m = gltf::materials[gltf::assets[asset].materials.first + i];
		if gltf::text_of(m.name) == name && m.base_tex.texture >= 0 { return gltf::textures[m.base_tex.texture].image as int; }
	}
	-1
}
fn up_box(a f32[:], t f32[:], w int, h int, r int) {
	for y in h {
		var s real = 0.0;
		var n = 0;
		for x in min(r, w) { s += a[y * w + x] as real; n += 1; }
		for x in w {
			if x + r < w { s += a[y * w + x + r] as real; n += 1; }
			if x - r - 1 >= 0 { s -= a[y * w + x - r - 1] as real; n -= 1; }
			t[y * w + x] = (s / (n as real)) as f32;
		}
	}
	for x in w {
		var s real = 0.0;
		var n = 0;
		for y in min(r, h) { s += t[y * w + x] as real; n += 1; }
		for y in h {
			if y + r < h { s += t[(y + r) * w + x] as real; n += 1; }
			if y - r - 1 >= 0 { s -= t[(y - r - 1) * w + x] as real; n -= 1; }
			a[y * w + x] = (s / (n as real)) as f32;
		}
	}
}
fn retone(asset int, src int, name const byte[:]) int {
	let ia = up_image(asset, name);
	let ib = up_image(src, name);
	if ia < 0 || ib < 0 || gltf::images[ia].width != gltf::images[ib].width || gltf::images[ia].height != gltf::images[ib].height { return 0; }
	let w = gltf::images[ia].width;
	let h = gltf::images[ia].height;
	let pa = gltf::images[ia].pixels.first;
	let pb = gltf::images[ib].pixels.first;
	let n = w * h;
	var m f32[>..] = [];
	var t f32[>..] = [];
	var e f32[>..] = [];
	var r f32[>..] = [];
	m.resize(n, 0.0);
	t.resize(n, 0.0);
	e.resize(n, 0.0);
	r.resize(n * 3, 0.0);
	for i in n {
		var d = 0;
		for c in 3 {
			let dd = gltf::pixels[pa + i * 4 + c] as int - gltf::pixels[pb + i * 4 + c] as int;
			d = max(d, if dd < 0 { -dd } else { dd });
		}
		m[i] = if d > 14 { 1.0 } else { 0.0 };
	}
	up_box(m, t, w, h, 4);
	var sa real[3] = [0.0, 0.0, 0.0];
	var sb real[3] = [0.0, 0.0, 0.0];
	var cnt = 0;
	for i in n {
		m[i] = if m[i] > 0.5 { 1.0 } else { 0.0 };
		e[i] = m[i];
		if m[i] > 0.5 {
			cnt += 1;
			for c in 3 {
				let av = gltf::pixels[pa + i * 4 + c] as f32;
				let sv = max(gltf::pixels[pb + i * 4 + c] as f32, 7.0);
				r[c * n + i] = av / sv;
				sa[c] += av as real;
				sb[c] += sv as real;
			}
		}
	}
	if cnt * 200 < n { return 0; }
	let rad = max(w / 40, 8);
	for k in 3 {
		up_box(e, t, w, h, rad);
		for c in 3 { up_box(r[c * n..c * n + n], t, w, h, rad); }
	}
	for k in 2 { up_box(m, t, w, h, 7); }
	var done = 0;
	for i in n {
		let u = up_fade(m[i], 0.65, 0.35);
		if u > 0.0 {
			let wl = clamp(e[i] / 0.08, 0.0, 1.0);
			for c in 3 {
				let g = (sa[c] / sb[c]) as f32;
				let f = g + (r[c * n + i] / max(e[i], 0.0001) - g) * wl;
				let av = gltf::pixels[pa + i * 4 + c] as f32;
				let sv = gltf::pixels[pb + i * 4 + c] as f32;
				gltf::pixels[pa + i * 4 + c] = clamp(av + (sv * f - av) * u + 0.5, 0.0, 255.0) as int as byte;
			}
			done += 1;
		}
	}
	if bk_changed.len < gltf::images.len { bk_changed.resize(gltf::images.len, 0); }
	bk_changed[ia] = 1;
	print("unpose: ", name, " tone ", (sa[0] / sb[0]) as f32, " ", (sa[1] / sb[1]) as f32, " ", (sa[2] / sb[2]) as f32, " painted ", cnt, " of ", n);
	done
}
fn up_tone(asset int, name const byte[:], band const f32[:]) int {
	let mi = up_mesh(asset, name);
	let ia = up_image(asset, name);
	var any = false;
	let top = if name == "skin" { 3.5 } else { 2.5 };
	for r in band.len / 12 { if band[r * 12] > 1.5 && band[r * 12] < top { any = true; } }
	if mi < 0 || ia < 0 || !any { return 0; }
	let w = gltf::images[ia].width;
	let h = gltf::images[ia].height;
	let pf = gltf::images[ia].pixels.first;
	var f f32[>..] = [];
	var hit byte[>..] = [];
	f.resize(w * h * 3, 1.0);
	hit.resize(w * h, 0);
	for j in gltf::meshes[mi].prims.count {
		let pr = gltf::prims[gltf::meshes[mi].prims.first + j];
		for t in pr.icount / 3 {
			let i0 = pr.vfirst + gltf::indices[pr.ifirst + t * 3] as int;
			let i1 = pr.vfirst + gltf::indices[pr.ifirst + t * 3 + 1] as int;
			let i2 = pr.vfirst + gltf::indices[pr.ifirst + t * 3 + 2] as int;
			let a = up_vp(i0, gltf::AT_POS);
			let b = up_vp(i1, gltf::AT_POS);
			let c = up_vp(i2, gltf::AT_POS);
			var near = false;
			for r in band.len / 12 { if band[r * 12] > 1.5 && band[r * 12] < top && up_band(a, band, r * 12) + up_band(b, band, r * 12) + up_band(c, band, r * 12) > 0.0 { near = true; } }
			if !near { continue; }
			let ua = up_vp(i0, gltf::AT_UV0);
			let ub = up_vp(i1, gltf::AT_UV0);
			let uc = up_vp(i2, gltf::AT_UV0);
			let ax = ua.x * w as f32;
			let ay = ua.y * h as f32;
			let bx = ub.x * w as f32;
			let by = ub.y * h as f32;
			let cx = uc.x * w as f32;
			let cy = uc.y * h as f32;
			let ar = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
			if abs(ar) < 1e-9 { continue; }
			let y0 = clamp(floor(min(ay, min(by, cy)) - 0.5), 0.0, (h - 1) as f32) as int;
			let y1 = clamp(ceil(max(ay, max(by, cy)) - 0.5), 0.0, (h - 1) as f32) as int;
			let x0 = clamp(floor(min(ax, min(bx, cx)) - 0.5), 0.0, (w - 1) as f32) as int;
			let x1 = clamp(ceil(max(ax, max(bx, cx)) - 0.5), 0.0, (w - 1) as f32) as int;
			for y in y0..y1 + 1 {
				for x in x0..x1 + 1 {
					let px = x as f32 + 0.5;
					let py = y as f32 + 0.5;
					let w0 = ((bx - px) * (cy - py) - (by - py) * (cx - px)) / ar;
					let w1 = ((cx - px) * (ay - py) - (cy - py) * (ax - px)) / ar;
					let w2 = 1.0 - w0 - w1;
					if w0 < -0.03 || w1 < -0.03 || w2 < -0.03 { continue; }
					let p = float3 { a.x * w0 + b.x * w1 + c.x * w2, a.y * w0 + b.y * w1 + c.y * w2, a.z * w0 + b.z * w1 + c.z * w2 };
					let i = y * w + x;
					for k in 3 { f[i * 3 + k] = 1.0; }
					for r in band.len / 12 {
						let o = r * 12;
						if band[o] > 1.5 && band[o] < top {
							let s = up_band(p, band, o);
							for k in 3 { f[i * 3 + k] *= 1.0 + (band[o + 1 + k] - 1.0) * s; }
						}
					}
					hit[i] = 1;
				}
			}
		}
	}
	for k in 4 {
		for y in 1..h - 1 {
			for x in 1..w - 1 {
				let i = y * w + x;
				if hit[i] != 0 { continue; }
				var m = 0;
				var s float3 = float3 { 0.0, 0.0, 0.0 };
				for d in 4 {
					let q = i + (if d == 0 { -1 } else if d == 1 { 1 } else if d == 2 { -w } else { w });
					if hit[q] != 0 && hit[q] as int <= k + 1 { m += 1; s = float3 { s.x + f[q * 3], s.y + f[q * 3 + 1], s.z + f[q * 3 + 2] }; }
				}
				if m > 0 {
					f[i * 3] = s.x / m as f32;
					f[i * 3 + 1] = s.y / m as f32;
					f[i * 3 + 2] = s.z / m as f32;
					hit[i] = (k + 2) as byte;
				}
			}
		}
	}
	var done = 0;
	for i in w * h {
		if hit[i] != 0 && (f[i * 3] != 1.0 || f[i * 3 + 1] != 1.0 || f[i * 3 + 2] != 1.0) {
			for k in 3 { gltf::pixels[pf + i * 4 + k] = clamp(gltf::pixels[pf + i * 4 + k] as f32 * f[i * 3 + k] + 0.5, 0.0, 255.0) as int as byte; }
			done += 1;
		}
	}
	if done > 0 {
		if bk_changed.len < gltf::images.len { bk_changed.resize(gltf::images.len, 0); }
		bk_changed[ia] = 1;
	}
	done
}
fn main() {
	let a = args();
	if a.len < 8 { print("usage: unpose <baked.glb> <source.glb> <out.glb> <left degrees> <right degrees> <fade top y, 0 skips body and tone> <fade bottom y> [head <fade bottom y> <fade top y>] [push <dx> <dy> <dz> | back <fx> <fy> <fz> | tone <r> <g> <b> | neck <r> <g> <b>, then <y0> <y1> <y2> <y3> <x0> <x1> <z0> <z1>]..."); return; }
	let asset = gltf::load(a[1]);
	if asset < 0 { print("unpose: ", gltf::error()); return; }
	let src = gltf::load(a[2]);
	if src < 0 { print("unpose: ", gltf::error()); return; }
	let top = up_num(a[6]);
	let arms = unpose_arms(asset, up_num(a[4]), up_num(a[5]));
	let body = if top > 0.0 { rebody(asset, src, top, up_num(a[7])) } else { 0 };
	let tone = if top > 0.0 { retone(asset, src, "skin") } else { 0 };
	var bd f32[>..] = [];
	let at = if a.len > 10 && a[8] == "head" { 11 } else { 8 };
	for i in at..a.len { bd.push(if a[i] == "push" { 0.0 } else if a[i] == "back" { 1.0 } else if a[i] == "tone" { 2.0 } else if a[i] == "neck" { 3.0 } else { up_num(a[i]) }); }
	let head = if at > 8 { up_head(asset, src, up_num(a[9]), up_num(a[10]), bd[..]) } else { 0 };
	let paint = up_tone(asset, "face", bd[..]) + up_tone(asset, "skin", bd[..]);
	bk_shape = true;
	print("unpose: arms ", arms, " vertices, body ", body, " vertices, tone ", tone, " texels, head ", head, " vertices, paint ", paint, " texels, saved ", bake_glb(asset, a[1], a[3], ""));
}
```
