```amni
import os;
import math;
import binary;
import json;
import gfx.linalg;
import gfx.gltf;
import bake;
var up_dj float3[>..];
var up_jk int[>..];
var up_pv = float3 { 0.0, 0.0, 0.0 };
fn up_under(n int, a int) bool {
	var k = n;
	while k >= 0 { if k == a { return true; } k = gltf::nodes[k].parent; }
	false
}
fn up_node(asset int, name const byte[:]) int {
	for i in gltf::assets[asset].nodes.count { if gltf::text_of(gltf::nodes[gltf::assets[asset].nodes.first + i].name) == name { return gltf::assets[asset].nodes.first + i; } }
	-1
}
fn up_mesh(asset int, name const byte[:]) int {
	for i in gltf::assets[asset].meshes.count { if gltf::text_of(gltf::meshes[gltf::assets[asset].meshes.first + i].name) == name { return gltf::assets[asset].meshes.first + i; } }
	-1
}
fn up_vp(v int, k int) float3 {
	let o = v * gltf::VERTEX_FLOATS + k;
	float3 { gltf::verts[o], gltf::verts[o + 1], gltf::verts[o + 2] }
}
fn up_set(v int, k int, p float3) {
	let o = v * gltf::VERTEX_FLOATS + k;
	gltf::verts[o] = p.x;
	gltf::verts[o + 1] = p.y;
	gltf::verts[o + 2] = p.z;
}
fn up_fade(y f32, hi f32, lo f32) f32 {
	let s = clamp((hi - y) / max(hi - lo, 0.0001), 0.0, 1.0);
	s * s * (3.0 - 2.0 * s)
}
fn up_same(ma int, mb int) bool {
	if mb < 0 || gltf::meshes[ma].prims.count != gltf::meshes[mb].prims.count { return false; }
	for j in gltf::meshes[ma].prims.count { if gltf::prims[gltf::meshes[ma].prims.first + j].vcount != gltf::prims[gltf::meshes[mb].prims.first + j].vcount { return false; } }
	true
}
fn unpose_arms(asset int, dl f32, dr f32) int {
	if gltf::assets[asset].skins.count < 1 { return 0; }
	let sk = gltf::skins[gltf::assets[asset].skins.first];
	var pv float3[>..] = [];
	var an int[>..] = [];
	for side in 2 {
		let a = up_node(asset, if side == 0 { "upperarm_l" } else { "upperarm_r" });
		an.push(a);
		var q = float3 { 0.0, 0.0, 0.0 };
		for j in sk.joints.count { if gltf::ints[sk.joints.first + j] == a { let bw = linalg::inverse(gltf::matrices[sk.inverse_binds.first + j]); q = float3 { bw.c3.x, bw.c3.y, bw.c3.z }; } }
		pv.push(q);
	}
	if an[0] < 0 || an[1] < 0 { return 0; }
	let cx = (pv[0].x + pv[1].x) * 0.5;
	var moved = 0;
	for rs in 2 {
		let side = 1 - rs;
		let deg = if side == 0 { dl } else { dr };
		if deg == 0.0 { continue; }
		let ang = deg * 0.0174533 * (if pv[side].x > cx { -1.0 } else { 1.0 });
		let c = linalg::f(cos(ang as real));
		let sn = linalg::f(sin(ang as real));
		var mark bool[>..] = [];
		for j in sk.joints.count { mark.push(up_under(gltf::ints[sk.joints.first + j], an[side])); }
		for i in gltf::assets[asset].nodes.count {
			let n = gltf::assets[asset].nodes.first + i;
			if gltf::nodes[n].mesh < 0 || gltf::nodes[n].skin < 0 { continue; }
			let me = gltf::nodes[n].mesh;
			for pp in gltf::meshes[me].prims.first..gltf::meshes[me].prims.first + gltf::meshes[me].prims.count {
				let pm = gltf::prims[pp];
				for v in pm.vfirst..pm.vfirst + pm.vcount {
					let o = v * gltf::VERTEX_FLOATS;
					var ws f32 = 0.0;
					for k in 4 { let jj = gltf::verts[o + gltf::AT_JOINT + k] as int; if jj >= 0 && jj < mark.len && mark[jj] { ws += gltf::verts[o + gltf::AT_WEIGHT + k]; } }
					if ws <= 0.0 { continue; }
					moved += 1;
					let ma = 1.0 - ws + ws * c;
					let mb = ws * sn;
					let dt = 1.0 / (ma * ma + mb * mb);
					let qx = gltf::verts[o + gltf::AT_POS] - pv[side].x;
					let qy = gltf::verts[o + gltf::AT_POS + 1] - pv[side].y;
					gltf::verts[o + gltf::AT_POS] = pv[side].x + (ma * qx + mb * qy) * dt;
					gltf::verts[o + gltf::AT_POS + 1] = pv[side].y + (ma * qy - mb * qx) * dt;
					let nx = gltf::verts[o + gltf::AT_NRM];
					let ny = gltf::verts[o + gltf::AT_NRM + 1];
					up_set(v, gltf::AT_NRM, linalg::unit3(float3 { (ma * nx + mb * ny) * dt, (ma * ny - mb * nx) * dt, gltf::verts[o + gltf::AT_NRM + 2] }));
				}
			}
		}
	}
	moved
}
fn up_idw(sp const float3[:], sd const float3[:], p float3, eps real) float3 {
	var wx real = 0.0;
	var wy real = 0.0;
	var wz real = 0.0;
	var wt real = 0.0;
	for k in sp.len {
		let e = sp[k] - p;
		let d2 = (e.x * e.x + e.y * e.y + e.z * e.z) as real + eps;
		let w = 1.0 / (d2 * d2 * d2 * d2);
		wx += w * (sd[k].x as real);
		wy += w * (sd[k].y as real);
		wz += w * (sd[k].z as real);
		wt += w;
	}
	if wt <= 0.0 { float3 { 0.0, 0.0, 0.0 } } else { float3 { linalg::f(wx / wt), linalg::f(wy / wt), linalg::f(wz / wt) } }
}
fn rebody(asset int, src int, hi f32, lo f32) int {
	let sa = up_mesh(asset, "skin");
	let sb = up_mesh(src, "skin");
	if sa < 0 || !up_same(sa, sb) { return 0; }
	var sp float3[>..] = [];
	var sd float3[>..] = [];
	for j in gltf::meshes[sa].prims.count {
		let pa = gltf::prims[gltf::meshes[sa].prims.first + j];
		let pb = gltf::prims[gltf::meshes[sb].prims.first + j];
		for v in pa.vcount {
			let q = up_vp(pb.vfirst + v, gltf::AT_POS);
			let p = up_vp(pa.vfirst + v, gltf::AT_POS);
			sp.push(p);
			sd.push((q - p) * up_fade(p.y, hi, lo));
		}
	}
	var moved = 0;
	for i in gltf::assets[asset].meshes.count {
		let ma = gltf::assets[asset].meshes.first + i;
		let mb = up_mesh(src, gltf::text_of(gltf::meshes[ma].name));
		let same = up_same(ma, mb);
		for j in gltf::meshes[ma].prims.count {
			let pa = gltf::prims[gltf::meshes[ma].prims.first + j];
			for v in pa.vcount {
				let p = up_vp(pa.vfirst + v, gltf::AT_POS);
				if same {
					let pb = gltf::prims[gltf::meshes[mb].prims.first + j];
					let q = up_vp(pb.vfirst + v, gltf::AT_POS);
					let f = up_fade(p.y, hi, lo);
					if f <= 0.0 { continue; }
					up_set(pa.vfirst + v, gltf::AT_POS, p + (q - p) * f);
					let n = up_vp(pa.vfirst + v, gltf::AT_NRM);
					up_set(pa.vfirst + v, gltf::AT_NRM, linalg::unit3(n + (up_vp(pb.vfirst + v, gltf::AT_NRM) - n) * f));
					moved += 1;
				} else {
					if p.y > hi + 0.05 { continue; }
					up_set(pa.vfirst + v, gltf::AT_POS, p + up_idw(sp[..], sd[..], p, 0.000001));
					moved += 1;
				}
			}
		}
	}
	moved
}
fn up_area(asset int, rep const int[:], nn float3[>..]&) {
	nn.clear();
	nn.resize(gltf::verts.len / gltf::VERTEX_FLOATS, float3 { 0.0, 0.0, 0.0 });
	for i in gltf::assets[asset].meshes.count {
		let m = gltf::meshes[gltf::assets[asset].meshes.first + i];
		for j in m.prims.count {
			let pr = gltf::prims[m.prims.first + j];
			for t in pr.icount / 3 {
				let a = pr.vfirst + gltf::indices[pr.ifirst + t * 3] as int;
				let b = pr.vfirst + gltf::indices[pr.ifirst + t * 3 + 1] as int;
				let c = pr.vfirst + gltf::indices[pr.ifirst + t * 3 + 2] as int;
				let pa = up_vp(a, gltf::AT_POS);
				let n = linalg::cross3(up_vp(b, gltf::AT_POS) - pa, up_vp(c, gltf::AT_POS) - pa) * 1000000.0;
				nn[rep[a]] = nn[rep[a]] + n;
				nn[rep[b]] = nn[rep[b]] + n;
				nn[rep[c]] = nn[rep[c]] + n;
			}
		}
	}
}
fn up_gate(v f32, a f32, b f32) f32 { if b > a { 1.0 - up_fade(v, b, a) } else { up_fade(v, a, b) } }
fn up_band(p float3, b const f32[:], o int) f32 { up_gate(p.y, b[o + 4], b[o + 5]) * up_gate(p.y, b[o + 7], b[o + 6]) * up_gate(abs(p.x), b[o + 8], b[o + 9]) * up_gate(if b[o] > 3.5 { abs(p.x) } else { p.z }, b[o + 10], b[o + 11]) }
fn up_polar(p float3, cz f32) int, int, f32 {
	let r = sqrt((p.x * p.x + (p.z - cz) * (p.z - cz)) as real) as f32;
	return min(179, max(0, floor((atan2(p.x as real, (p.z - cz) as real) + 3.14159265) * 28.6478898) as int)), floor(((p.y - 0.7) * 250.0) as real) as int, r;
}
fn up_peak(t const f32[:], ab int, yb int, wa int, wy int) f32 {
	var m f32 = 0.0;
	for dy in 2 * wy + 1 {
		let y = yb + dy - wy;
		if y < 0 || y >= 100 { continue; }
		for da in 2 * wa + 1 { m = max(m, t[y * 180 + (ab + da - wa + 180) % 180]); }
	}
	m
}
fn up_yoke(asset int, band const f32[:], o int, mv bool[>..]&) int {
	let ms = up_mesh(asset, "skirt");
	if ms < 0 { return 0; }
	var e f32[>..] = [];
	var u f32[>..] = [];
	e.resize(18000, 0.0);
	u.resize(18000, 0.0);
	var sz f32 = 0.0;
	var sn = 0;
	for j in gltf::meshes[ms].prims.count {
		let pr = gltf::prims[gltf::meshes[ms].prims.first + j];
		for v in pr.vcount {
			let p = up_vp(pr.vfirst + v, gltf::AT_POS);
			if up_band(p, band, o) > 0.5 { sz += p.z; sn += 1; }
		}
	}
	let cz = sz / max(sn, 1) as f32;
	for i in gltf::assets[asset].meshes.count {
		let ma = gltf::assets[asset].meshes.first + i;
		let nm = gltf::text_of(gltf::meshes[ma].name);
		if nm == "belt" || nm == "buckle" { continue; }
		for j in gltf::meshes[ma].prims.count {
			let pr = gltf::prims[gltf::meshes[ma].prims.first + j];
			for v in pr.vcount {
				let ab, yb, r = up_polar(up_vp(pr.vfirst + v, gltf::AT_POS), cz);
				if yb < 0 || yb >= 100 || r > 0.26 { continue; }
				if ma == ms { e[yb * 180 + ab] = max(e[yb * 180 + ab], r); } else { u[yb * 180 + ab] = max(u[yb * 180 + ab], r); }
			}
		}
	}
	let wa = max(1, (band[o + 2] / 4.0) as int);
	var n = 0;
	for j in gltf::meshes[ms].prims.count {
		let pr = gltf::prims[gltf::meshes[ms].prims.first + j];
		for v in pr.vcount {
			let g = pr.vfirst + v;
			let p = up_vp(g, gltf::AT_POS);
			let w = up_band(p, band, o);
			let ab, yb, r = up_polar(p, cz);
			if w <= 0.0 || yb < 0 || yb >= 100 || r <= 0.0 { continue; }
			let un = up_peak(u[..], ab, yb, 6, 5);
			let rn = max(r + max(0.0, up_peak(e[..], ab, yb, wa, 2) - r) * w * up_gate(p.y, band[o + 3] - 0.04, band[o + 3]), r + max(0.0, (if un > 0.0 { un + band[o + 1] } else { 0.0 }) - r) * w);
			if rn <= r { continue; }
			up_set(g, gltf::AT_POS, float3 { p.x * rn / r, p.y, cz + (p.z - cz) * rn / r });
			mv[g] = true;
			n += 1;
		}
	}
	n
}
fn up_head(asset int, src int, lo f32, hi f32, band const f32[:]) int {
	let nv = gltf::verts.len / gltf::VERTEX_FLOATS;
	var rep int[>..] = [];
	var mv bool[>..] = [];
	for v in nv { rep.push(v); }
	mv.resize(nv, false);
	var rg int[>..] = [];
	for i in gltf::assets[asset].meshes.count {
		let m = gltf::meshes[gltf::assets[asset].meshes.first + i];
		for j in m.prims.count {
			let pr = gltf::prims[m.prims.first + j];
			if pr.vcount > 12000 { continue; }
			rg.clear();
			for v in pr.vcount {
				let p = up_vp(pr.vfirst + v, gltf::AT_POS);
				if p.y > lo - 0.06 && abs(p.x) < 0.16 { rg.push(pr.vfirst + v); }
			}
			for x in rg.len {
				let p = up_vp(rg[x], gltf::AT_POS);
				for y in x {
					let q = up_vp(rg[y], gltf::AT_POS);
					if p.x == q.x && p.y == q.y && p.z == q.z { rep[rg[x]] = rep[rg[y]]; break; }
				}
			}
		}
	}
	var nb float3[>..] = [];
	up_area(asset, rep[..], nb);
	var sp float3[>..] = [];
	var sd float3[>..] = [];
	var sv int[>..] = [];
	var gp float3[>..] = [];
	var gc float3[>..] = [];
	var moved = 0;
	for i in gltf::assets[asset].meshes.count {
		let ma = gltf::assets[asset].meshes.first + i;
		let nm = gltf::text_of(gltf::meshes[ma].name);
		let mb = up_mesh(src, nm);
		if !up_same(ma, mb) || nm == "hair" || nm == "braid_hair" { continue; }
		let outer = nm == "face" || nm == "skin" || nm == "scalp";
		sp.clear();
		sd.clear();
		sv.clear();
		for j in gltf::meshes[ma].prims.count {
			let pa = gltf::prims[gltf::meshes[ma].prims.first + j];
			let pb = gltf::prims[gltf::meshes[mb].prims.first + j];
			for v in pa.vcount {
				let q = up_vp(pb.vfirst + v, gltf::AT_POS);
				if q.y < lo - 0.03 || abs(q.x) > 0.13 { continue; }
				sp.push(q);
				sd.push(up_vp(pa.vfirst + v, gltf::AT_POS) - q);
				sv.push(pa.vfirst + v);
			}
		}
		for k in sp.len {
			let q = sp[k];
			let m = up_idw(sp[..], sd[..], float3 { -q.x, q.y, q.z }, 0.0000001);
			let c = (float3 { -m.x, m.y, m.z } - sd[k]) * (0.5 * (1.0 - up_fade(q.y, hi, lo)));
			let p = q + sd[k];
			up_set(sv[k], gltf::AT_POS, p + c);
			mv[sv[k]] = true;
			if outer { gp.push(p); gc.push(c); }
			moved += 1;
		}
	}
	for i in gltf::assets[asset].meshes.count {
		let ma = gltf::assets[asset].meshes.first + i;
		let nm = gltf::text_of(gltf::meshes[ma].name);
		if gp.len == 0 || (up_same(ma, up_mesh(src, nm)) && nm != "hair" && nm != "braid_hair") { continue; }
		for j in gltf::meshes[ma].prims.count {
			let pa = gltf::prims[gltf::meshes[ma].prims.first + j];
			for v in pa.vcount {
				let p = up_vp(pa.vfirst + v, gltf::AT_POS);
				if p.y < lo - 0.03 || abs(p.x) > 0.13 { continue; }
				up_set(pa.vfirst + v, gltf::AT_POS, p + up_idw(gp[..], gc[..], p, 0.000001));
				mv[pa.vfirst + v] = true;
				moved += 1;
			}
		}
	}
	for r in band.len / 12 {
		let o = r * 12;
		moved += if band[o] > 5.5 { up_yoke(asset, band, o, mv) } else { 0 };
		if (band[o] > 1.5 && band[o] < 3.5) || band[o] > 4.5 { continue; }
		let back = band[o] > 0.5 && band[o] < 1.5;
		let k = float3 { band[o + 1], band[o + 2], band[o + 3] };
		let wide = band[o + 4] < lo - 0.03;
		gp.clear();
		gc.clear();
		for pass in 2 {
			for i in gltf::assets[asset].meshes.count {
				let ma = gltf::assets[asset].meshes.first + i;
				let nm = gltf::text_of(gltf::meshes[ma].name);
				let mb = up_mesh(src, nm);
				let outer = back && up_same(ma, mb) && (nm == "face" || nm == "skin" || nm == "scalp");
				if (if back { (pass == 1) == outer } else { pass == 1 || (wide && (nm == "hair" || nm == "braid_hair")) }) { continue; }
				for j in gltf::meshes[ma].prims.count {
					let pa = gltf::prims[gltf::meshes[ma].prims.first + j];
					for v in pa.vcount {
						let g = pa.vfirst + v;
						let p = up_vp(g, gltf::AT_POS);
						if !wide && (p.y < lo - 0.03 || abs(p.x) > 0.13) { continue; }
						var c = float3 { 0.0, 0.0, 0.0 };
						if outer {
							let q = up_vp(gltf::prims[gltf::meshes[mb].prims.first + j].vfirst + v, gltf::AT_POS);
							let w = up_band(q, band, o);
							c = float3 { (q.x - p.x) * k.x * w, (q.y - p.y) * k.y * w, (q.z - p.z) * k.z * w };
							gp.push(p);
							gc.push(c);
						} else if back {
							c = up_idw(gp[..], gc[..], p, 0.000001);
						} else {
							let w = up_band(p, band, o);
							c = float3 { (if p.x < 0.0 { -k.x } else { k.x }) * w, k.y * w, k.z * w };
						}
						if linalg::length3(c) <= 0.0 { continue; }
						up_set(g, gltf::AT_POS, p + c);
						mv[g] = true;
					}
				}
			}
		}
	}
	var na float3[>..] = [];
	up_area(asset, rep[..], na);
	for i in gltf::assets[asset].meshes.count {
		let m = gltf::meshes[gltf::assets[asset].meshes.first + i];
		for j in m.prims.count {
			let pr = gltf::prims[m.prims.first + j];
			if pr.vcount > 12000 { continue; }
			for v in pr.vcount {
				let g = pr.vfirst + v;
				let a = nb[rep[g]];
				let b = na[rep[g]];
				if !mv[g] || linalg::length3(a) <= 0.0 || linalg::length3(b) <= 0.0 { continue; }
				up_set(g, gltf::AT_NRM, linalg::unit3(up_vp(g, gltf::AT_NRM) + linalg::unit3(b) - linalg::unit3(a)));
			}
		}
	}
	moved
}
fn up_num(s const byte[:]) f32 {
	let v, ok = parse_flt(s);
	v as f32
}
fn up_image(asset int, name const byte[:]) int {
	for i in gltf::assets[asset].materials.count {
		let m = gltf::materials[gltf::assets[asset].materials.first + i];
		if gltf::text_of(m.name) == name && m.base_tex.texture >= 0 { return gltf::textures[m.base_tex.texture].image as int; }
	}
	-1
}
fn up_box(a f32[:], t f32[:], w int, h int, r int) {
	for y in h {
		var s real = 0.0;
		var n = 0;
		for x in min(r, w) { s += a[y * w + x] as real; n += 1; }
		for x in w {
			if x + r < w { s += a[y * w + x + r] as real; n += 1; }
			if x - r - 1 >= 0 { s -= a[y * w + x - r - 1] as real; n -= 1; }
			t[y * w + x] = (s / (n as real)) as f32;
		}
	}
	for x in w {
		var s real = 0.0;
		var n = 0;
		for y in min(r, h) { s += t[y * w + x] as real; n += 1; }
		for y in h {
			if y + r < h { s += t[(y + r) * w + x] as real; n += 1; }
			if y - r - 1 >= 0 { s -= t[(y - r - 1) * w + x] as real; n -= 1; }
			a[y * w + x] = (s / (n as real)) as f32;
		}
	}
}
fn retone(asset int, src int, name const byte[:]) int {
	let ia = up_image(asset, name);
	let ib = up_image(src, name);
	if ia < 0 || ib < 0 || gltf::images[ia].width != gltf::images[ib].width || gltf::images[ia].height != gltf::images[ib].height { return 0; }
	let w = gltf::images[ia].width;
	let h = gltf::images[ia].height;
	let pa = gltf::images[ia].pixels.first;
	let pb = gltf::images[ib].pixels.first;
	let n = w * h;
	var m f32[>..] = [];
	var t f32[>..] = [];
	var e f32[>..] = [];
	var r f32[>..] = [];
	m.resize(n, 0.0);
	t.resize(n, 0.0);
	e.resize(n, 0.0);
	r.resize(n * 3, 0.0);
	for i in n {
		var d = 0;
		for c in 3 {
			let dd = gltf::pixels[pa + i * 4 + c] as int - gltf::pixels[pb + i * 4 + c] as int;
			d = max(d, if dd < 0 { -dd } else { dd });
		}
		m[i] = if d > 14 { 1.0 } else { 0.0 };
	}
	up_box(m, t, w, h, 4);
	var sa real[3] = [0.0, 0.0, 0.0];
	var sb real[3] = [0.0, 0.0, 0.0];
	var cnt = 0;
	for i in n {
		m[i] = if m[i] > 0.5 { 1.0 } else { 0.0 };
		e[i] = m[i];
		if m[i] > 0.5 {
			cnt += 1;
			for c in 3 {
				let av = gltf::pixels[pa + i * 4 + c] as f32;
				let sv = max(gltf::pixels[pb + i * 4 + c] as f32, 7.0);
				r[c * n + i] = av / sv;
				sa[c] += av as real;
				sb[c] += sv as real;
			}
		}
	}
	if cnt * 200 < n { return 0; }
	let rad = max(w / 40, 8);
	for k in 3 {
		up_box(e, t, w, h, rad);
		for c in 3 { up_box(r[c * n..c * n + n], t, w, h, rad); }
	}
	for k in 2 { up_box(m, t, w, h, 7); }
	var done = 0;
	for i in n {
		let u = up_fade(m[i], 0.65, 0.35);
		if u > 0.0 {
			let wl = clamp(e[i] / 0.08, 0.0, 1.0);
			for c in 3 {
				let g = (sa[c] / sb[c]) as f32;
				let f = g + (r[c * n + i] / max(e[i], 0.0001) - g) * wl;
				let av = gltf::pixels[pa + i * 4 + c] as f32;
				let sv = gltf::pixels[pb + i * 4 + c] as f32;
				gltf::pixels[pa + i * 4 + c] = clamp(av + (sv * f - av) * u + 0.5, 0.0, 255.0) as int as byte;
			}
			done += 1;
		}
	}
	if bk_changed.len < gltf::images.len { bk_changed.resize(gltf::images.len, 0); }
	bk_changed[ia] = 1;
	print("unpose: ", name, " tone ", (sa[0] / sb[0]) as f32, " ", (sa[1] / sb[1]) as f32, " ", (sa[2] / sb[2]) as f32, " painted ", cnt, " of ", n);
	done
}
fn up_paint(kd f32, skin bool) bool { (kd > 1.5 && kd < 2.5) || (skin && ((kd > 2.5 && kd < 3.5) || (kd > 4.5 && kd < 5.5))) }
fn up_tone(asset int, src int, name const byte[:], band const f32[:]) int {
	let mi = up_mesh(asset, name);
	let ia = up_image(asset, name);
	var any = false;
	let skin = name == "skin";
	for r in band.len / 12 { if up_paint(band[r * 12], skin) { any = true; } }
	if mi < 0 || ia < 0 || !any { return 0; }
	let w = gltf::images[ia].width;
	let h = gltf::images[ia].height;
	let pf = gltf::images[ia].pixels.first;
	let ib = up_image(src, name);
	let pb = if ib >= 0 && gltf::images[ib].width == w && gltf::images[ib].height == h { gltf::images[ib].pixels.first } else { -1 };
	var f f32[>..] = [];
	var hit byte[>..] = [];
	var cw f32[>..] = [];
	var cg f32[3] = [1.0, 1.0, 1.0];
	cw.resize(w * h, 0.0);
	f.resize(w * h * 3, 1.0);
	hit.resize(w * h, 0);
	for j in gltf::meshes[mi].prims.count {
		let pr = gltf::prims[gltf::meshes[mi].prims.first + j];
		for t in pr.icount / 3 {
			let i0 = pr.vfirst + gltf::indices[pr.ifirst + t * 3] as int;
			let i1 = pr.vfirst + gltf::indices[pr.ifirst + t * 3 + 1] as int;
			let i2 = pr.vfirst + gltf::indices[pr.ifirst + t * 3 + 2] as int;
			let a = up_vp(i0, gltf::AT_POS);
			let b = up_vp(i1, gltf::AT_POS);
			let c = up_vp(i2, gltf::AT_POS);
			var near = false;
			for r in band.len / 12 { if up_paint(band[r * 12], skin) && up_band(a, band, r * 12) + up_band(b, band, r * 12) + up_band(c, band, r * 12) > 0.0 { near = true; } }
			if !near { continue; }
			let ua = up_vp(i0, gltf::AT_UV0);
			let ub = up_vp(i1, gltf::AT_UV0);
			let uc = up_vp(i2, gltf::AT_UV0);
			let ax = ua.x * w as f32;
			let ay = ua.y * h as f32;
			let bx = ub.x * w as f32;
			let by = ub.y * h as f32;
			let cx = uc.x * w as f32;
			let cy = uc.y * h as f32;
			let ar = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
			if abs(ar) < 1e-9 { continue; }
			let y0 = clamp(floor(min(ay, min(by, cy)) - 0.5), 0.0, (h - 1) as f32) as int;
			let y1 = clamp(ceil(max(ay, max(by, cy)) - 0.5), 0.0, (h - 1) as f32) as int;
			let x0 = clamp(floor(min(ax, min(bx, cx)) - 0.5), 0.0, (w - 1) as f32) as int;
			let x1 = clamp(ceil(max(ax, max(bx, cx)) - 0.5), 0.0, (w - 1) as f32) as int;
			for y in y0..y1 + 1 {
				for x in x0..x1 + 1 {
					let px = x as f32 + 0.5;
					let py = y as f32 + 0.5;
					let w0 = ((bx - px) * (cy - py) - (by - py) * (cx - px)) / ar;
					let w1 = ((cx - px) * (ay - py) - (cy - py) * (ax - px)) / ar;
					let w2 = 1.0 - w0 - w1;
					if w0 < -0.03 || w1 < -0.03 || w2 < -0.03 { continue; }
					let p = float3 { a.x * w0 + b.x * w1 + c.x * w2, a.y * w0 + b.y * w1 + c.y * w2, a.z * w0 + b.z * w1 + c.z * w2 };
					let i = y * w + x;
					for k in 3 { f[i * 3 + k] = 1.0; }
					cw[i] = 0.0;
					for r in band.len / 12 {
						let o = r * 12;
						if up_paint(band[o], skin) {
							let s = up_band(p, band, o);
							if band[o] > 4.5 { cw[i] = max(cw[i], s); }
							for k in 3 { if band[o] > 4.5 { cg[k] = band[o + 1 + k]; } else { f[i * 3 + k] *= 1.0 + (band[o + 1 + k] - 1.0) * s; } }
						}
					}
					hit[i] = 1;
				}
			}
		}
	}
	for k in 4 {
		for y in 1..h - 1 {
			for x in 1..w - 1 {
				let i = y * w + x;
				if hit[i] != 0 { continue; }
				var m = 0;
				var s float3 = float3 { 0.0, 0.0, 0.0 };
				var sc f32 = 0.0;
				for d in 4 {
					let q = i + (if d == 0 { -1 } else if d == 1 { 1 } else if d == 2 { -w } else { w });
					if hit[q] != 0 && hit[q] as int <= k + 1 { m += 1; sc += cw[q]; s = float3 { s.x + f[q * 3], s.y + f[q * 3 + 1], s.z + f[q * 3 + 2] }; }
				}
				if m > 0 {
					f[i * 3] = s.x / m as f32;
					f[i * 3 + 1] = s.y / m as f32;
					f[i * 3 + 2] = s.z / m as f32;
					cw[i] = sc / m as f32;
					hit[i] = (k + 2) as byte;
				}
			}
		}
	}
	var done = 0;
	for i in w * h {
		let cl = if pb >= 0 { cw[i] } else { 0.0 };
		if hit[i] != 0 && (f[i * 3] != 1.0 || f[i * 3 + 1] != 1.0 || f[i * 3 + 2] != 1.0 || cl > 0.0) {
			for k in 3 { gltf::pixels[pf + i * 4 + k] = clamp(gltf::pixels[pf + i * 4 + k] as f32 * f[i * 3 + k] * (1.0 - cl) + (if cl > 0.0 { gltf::pixels[pb + i * 4 + k] as f32 * cg[k] * cl } else { 0.0 }) + 0.5, 0.0, 255.0) as int as byte; }
			done += 1;
		}
	}
	if done > 0 {
		if bk_changed.len < gltf::images.len { bk_changed.resize(gltf::images.len, 0); }
		bk_changed[ia] = 1;
	}
	done
}
fn up_rig(asset int, k f32, d f32, dy f32) int {
	if gltf::assets[asset].skins.count < 1 { return 0; }
	let sk = gltf::skins[gltf::assets[asset].skins.first];
	let hn = up_node(asset, "head");
	let ln = up_node(asset, "upperarm_l");
	let rn = up_node(asset, "upperarm_r");
	if hn < 0 || ln < 0 || rn < 0 { return 0; }
	var lx f32 = 0.0;
	var ly f32 = 0.0;
	up_jk.clear();
	up_dj.clear();
	for j in sk.joints.count {
		let n = gltf::ints[sk.joints.first + j];
		let bw = linalg::inverse(gltf::matrices[sk.inverse_binds.first + j]);
		up_jk.push(if up_under(n, hn) { 1 } else if up_under(n, ln) { 2 } else if up_under(n, rn) { 3 } else { 0 });
		if n == hn { up_pv = float3 { bw.c3.x, bw.c3.y, bw.c3.z }; }
		if n == ln { lx = bw.c3.x; ly = bw.c3.y; }
	}
	let sg = if lx > up_pv.x { 1.0 } else { -1.0 };
	for j in sk.joints.count {
		let bw = linalg::inverse(gltf::matrices[sk.inverse_binds.first + j]);
		up_dj.push(if up_jk[j] == 1 { float3 { (bw.c3.x - up_pv.x) * (k - 1.0), (bw.c3.y - up_pv.y) * (k - 1.0), (bw.c3.z - up_pv.z) * (k - 1.0) } } else if up_jk[j] == 2 { float3 { sg * d, dy, 0.0 } } else if up_jk[j] == 3 { float3 { -sg * d, dy, 0.0 } } else { float3 { 0.0, 0.0, 0.0 } });
	}
	var moved = 0;
	for i in gltf::assets[asset].meshes.count {
		let m = gltf::meshes[gltf::assets[asset].meshes.first + i];
		for pp in m.prims.first..m.prims.first + m.prims.count {
			let pm = gltf::prims[pp];
			for v in pm.vfirst..pm.vfirst + pm.vcount {
				let o = v * gltf::VERTEX_FLOATS;
				var wh f32 = 0.0;
				var wx f32 = 0.0;
				var wa f32 = 0.0;
				for c in 4 {
					let jj = gltf::verts[o + gltf::AT_JOINT + c] as int;
					let w = gltf::verts[o + gltf::AT_WEIGHT + c];
					if jj >= 0 && jj < up_jk.len { if up_jk[jj] == 1 { wh += w; } else if up_jk[jj] == 2 { wx += w * sg; wa += w; } else if up_jk[jj] == 3 { wx -= w * sg; wa += w; } }
				}
				let p = up_vp(v, gltf::AT_POS);
				let dn = dy * (wa + (1.0 - min(wa, 1.0)) * (1.0 - min(wh, 1.0)) * up_gate(abs(p.x - up_pv.x), 0.05, abs(lx - up_pv.x)) * up_gate(p.y, ly - 0.14, ly - 0.02));
				if wh <= 0.0 && wx == 0.0 && dn == 0.0 { continue; }
				moved += 1;
				let e = (k - 1.0) * wh;
				up_set(v, gltf::AT_POS, float3 { p.x + (p.x - up_pv.x) * e + d * wx, p.y + (p.y - up_pv.y) * e + dn, p.z + (p.z - up_pv.z) * e });
			}
		}
	}
	moved
}
fn up_getf(b const byte[:], at int) f32 { binary::f32_from_bits(bk_u32(b, at) as u32) }
fn up_putf(b byte[>..]&, at int, x f32) {
	var t f32[1] = [x];
	let q = bytes_of(t);
	for i in 4 { b[at + i] = q[i]; }
}
fn up_acc(d json::Doc&, root int, ai int) int, int {
	let accs = bk_mem(d, root, "accessors");
	let views = bk_mem(d, root, "bufferViews");
	if ai < 0 || accs < 0 || views < 0 || ai >= json::count(d, accs) { return -1, 0; }
	let a = json::element(d, accs, ai);
	let bv = bk_int(d, bk_mem(d, a, "bufferView"), -1);
	if bv < 0 || bv >= json::count(d, views) { return -1, 0; }
	return bk_int(d, bk_mem(d, json::element(d, views, bv), "byteOffset"), 0) + bk_int(d, bk_mem(d, a, "byteOffset"), 0), bk_int(d, bk_mem(d, a, "count"), 0);
}
fn up_emit_tr(d json::Doc&, n int, t float3, out byte[>..]&) {
	out.push('{');
	var first = true;
	var seen = false;
	json::each(d, n) { c =>
		let nm = json::name_of(d, c);
		if !first { out.push(','); }
		first = false;
		json::format_key(out, nm);
		if nm == "translation" {
			bk_vec3(out, t);
			seen = true;
		} else {
			emit(d, c, out);
		}
	};
	if !seen {
		if !first { out.push(','); }
		json::format_key(out, "translation");
		bk_vec3(out, t);
	}
	out.push('}');
}
fn up_rig_file(asset int, path const byte[:], k f32) int {
	var data byte[>..] = [];
	read_file(path, data);
	if data.len < 28 || up_dj.len == 0 { return 0; }
	let jl = bk_u32(data, 12);
	var jt byte[>..] = [];
	jt.append(data[20..20 + jl]);
	var d json::Doc;
	let root, err = json::parse(jt[..], d);
	if root < 0 { return 0; }
	let b0 = 20 + jl + 8;
	let bl = bk_u32(data, 20 + jl);
	let sk = gltf::skins[gltf::assets[asset].skins.first];
	let n0 = gltf::assets[asset].nodes.first;
	let nn = gltf::assets[asset].nodes.count;
	let skins = bk_mem(d, root, "skins");
	if skins < 0 { return 0; }
	let at, cnt = up_acc(d, root, bk_int(d, bk_mem(d, json::element(d, skins, 0), "inverseBindMatrices"), -1));
	if at < 0 || cnt != sk.joints.count { return 0; }
	var tr float3[>..] = [];
	var has bool[>..] = [];
	var jo int[>..] = [];
	tr.resize(nn, float3 { 0.0, 0.0, 0.0 });
	has.resize(nn, false);
	jo.resize(nn, -1);
	for j in sk.joints.count { jo[gltf::ints[sk.joints.first + j] - n0] = j; }
	var done = 0;
	for j in sk.joints.count {
		let n = gltf::ints[sk.joints.first + j];
		let pn = gltf::nodes[n].parent;
		let pj = if pn >= n0 { jo[pn - n0] } else { -1 };
		let dj = up_dj[j];
		let dp = if pj >= 0 { up_dj[pj] } else { float3 { 0.0, 0.0, 0.0 } };
		let v = float3 { dj.x - dp.x, dj.y - dp.y, dj.z - dp.z };
		if v.x != 0.0 || v.y != 0.0 || v.z != 0.0 {
			let pw = if pj >= 0 { linalg::inverse(gltf::matrices[sk.inverse_binds.first + pj]) } else { gfx::mat4_identity };
			let t = gltf::nodes[n].t;
			tr[n - n0] = float3 { t.x + pw.c0.x * v.x + pw.c0.y * v.y + pw.c0.z * v.z, t.y + pw.c1.x * v.x + pw.c1.y * v.y + pw.c1.z * v.z, t.z + pw.c2.x * v.x + pw.c2.y * v.y + pw.c2.z * v.z };
			has[n - n0] = true;
		}
		if dj.x != 0.0 || dj.y != 0.0 || dj.z != 0.0 {
			let ib = gltf::matrices[sk.inverse_binds.first + j];
			let o = b0 + at + j * 64 + 48;
			up_putf(data, o, ib.c3.x - (ib.c0.x * dj.x + ib.c1.x * dj.y + ib.c2.x * dj.z));
			up_putf(data, o + 4, ib.c3.y - (ib.c0.y * dj.x + ib.c1.y * dj.y + ib.c2.y * dj.z));
			up_putf(data, o + 8, ib.c3.z - (ib.c0.z * dj.x + ib.c1.z * dj.y + ib.c2.z * dj.z));
			done += 1;
		}
	}
	var used int[>..] = [];
	let meshes = bk_mem(d, root, "meshes");
	for i in min(json::count(d, meshes), gltf::assets[asset].meshes.count) {
		let m = gltf::meshes[gltf::assets[asset].meshes.first + i];
		let ps = bk_mem(d, json::element(d, meshes, i), "primitives");
		for j in min(json::count(d, ps), m.prims.count) {
			let tg = bk_mem(d, json::element(d, ps, j), "targets");
			if tg < 0 { continue; }
			let pm = gltf::prims[m.prims.first + j];
			var wh f32 = 0.0;
			for v in pm.vfirst..pm.vfirst + pm.vcount { for c in 4 { let jj = gltf::verts[v * gltf::VERTEX_FLOATS + gltf::AT_JOINT + c] as int; if jj >= 0 && jj < up_jk.len && up_jk[jj] == 1 { wh += gltf::verts[v * gltf::VERTEX_FLOATS + gltf::AT_WEIGHT + c]; } } }
			if wh < 0.5 * pm.vcount as f32 { continue; }
			for x in json::count(d, tg) {
				let ai = bk_int(d, bk_mem(d, json::element(d, tg, x), "POSITION"), -1);
				var dup = ai < 0;
				for u in used { if u == ai { dup = true; } }
				if dup { continue; }
				used.push(ai);
				let ta, tc = up_acc(d, root, ai);
				if ta < 0 { continue; }
				for q in tc * 3 { up_putf(data, b0 + ta + q * 4, up_getf(data[..], b0 + ta + q * 4) * k); }
			}
		}
	}
	var js byte[>..] = [];
	js.push('{');
	var first = true;
	json::each(d, root) { c =>
		let nm = json::name_of(d, c);
		if !first { js.push(','); }
		first = false;
		json::format_key(js, nm);
		if nm == "nodes" {
			js.push('[');
			for i in json::count(d, c) {
				if i > 0 { js.push(','); }
				if i < nn && has[i] { up_emit_tr(d, json::element(d, c, i), tr[i], js); } else { emit(d, json::element(d, c, i), js); }
			}
			js.push(']');
		} else {
			emit(d, c, js);
		}
	};
	js.push('}');
	while js.len % 4 != 0 { js.push(' '); }
	var o byte[>..] = [];
	o.append("glTF");
	bk_put32(o, 2);
	bk_put32(o, 12 + 8 + js.len + 8 + bl);
	bk_put32(o, js.len);
	o.append("JSON");
	o.append(js);
	bk_put32(o, bl);
	o.append("BIN");
	o.push(0);
	o.append(data[b0..b0 + bl]);
	write_file(path, o);
	done
}
fn up_hair(src const byte[:], out const byte[:], k f32) int {
	var h byte[>..] = [];
	read_file(src, h);
	if h.len < 16 { return 0; }
	let np = bk_u32(h, 8);
	if 16 + np * 48 > h.len { return 0; }
	for i in np {
		let o = 16 + i * 48;
		up_putf(h, o, up_pv.x + (up_getf(h[..], o) - up_pv.x) * k);
		up_putf(h, o + 4, up_pv.y + (up_getf(h[..], o + 4) - up_pv.y) * k);
		up_putf(h, o + 8, up_pv.z + (up_getf(h[..], o + 8) - up_pv.z) * k);
		for c in 3 { up_putf(h, o + 16 + c * 4, up_getf(h[..], o + 16 + c * 4) * k); }
	}
	write_file(out, h);
	np
}
fn main() {
	let a = args();
	if a.len < 8 { print("usage: unpose <baked.glb> <source.glb> <out.glb> <left degrees> <right degrees> <fade top y, 0 skips body and tone> <fade bottom y> [head <fade bottom y> <fade top y>] [push <dx> <dy> <dz> | back <fx> <fy> <fz> | tone <r> <g> <b> | neck <r> <g> <b>, then <y0> <y1> <y2> <y3> <x0> <x1> <z0> <z1> | span <dx> <dy> <dz> <y0> <y1> <y2> <y3> <x0> <x1> <x2> <x3> | clean <r> <g> <b> <y0> <y1> <y2> <y3> <x0> <x1> <x2> <x3> | yoke <clearance over what the skirt covers> <pleat window degrees> <pleats start below y> <y0> <y1> <y2> <y3> <x0> <x1> <x2> <x3>]...; put rig <head scale> <shoulder shift out> <shoulder shift up> <hair in or -> <hair out> before head to resize the head and move the shoulders last"); return; }
	let asset = gltf::load(a[1]);
	if asset < 0 { print("unpose: ", gltf::error()); return; }
	let src = gltf::load(a[2]);
	if src < 0 { print("unpose: ", gltf::error()); return; }
	let top = up_num(a[6]);
	let arms = unpose_arms(asset, up_num(a[4]), up_num(a[5]));
	let body = if top > 0.0 { rebody(asset, src, top, up_num(a[7])) } else { 0 };
	let tone = if top > 0.0 { retone(asset, src, "skin") } else { 0 };
	var bd f32[>..] = [];
	let rg = a.len > 13 && a[8] == "rig";
	let a0 = if rg { 14 } else { 8 };
	let at = if a.len > a0 + 2 && a[a0] == "head" { a0 + 3 } else { a0 };
	for i in at..a.len { bd.push(if a[i] == "push" { 0.0 } else if a[i] == "back" { 1.0 } else if a[i] == "tone" { 2.0 } else if a[i] == "neck" { 3.0 } else if a[i] == "span" { 4.0 } else if a[i] == "clean" { 5.0 } else if a[i] == "yoke" { 6.0 } else { up_num(a[i]) }); }
	let head = if at > a0 { up_head(asset, src, up_num(a[a0 + 1]), up_num(a[a0 + 2]), bd[..]) } else { 0 };
	let paint = up_tone(asset, src, "face", bd[..]) + up_tone(asset, src, "skin", bd[..]);
	let rig = if rg { up_rig(asset, up_num(a[9]), up_num(a[10]), up_num(a[11])) } else { 0 };
	bk_shape = true;
	let saved = bake_glb(asset, a[1], a[3], "");
	let fix = if rg && saved { up_rig_file(asset, a[3], up_num(a[9])) } else { 0 };
	let strands = if rg && a[12] != "-" { up_hair(a[12], a[13], up_num(a[9])) } else { 0 };
	print("unpose: arms ", arms, " vertices, body ", body, " vertices, tone ", tone, " texels, head ", head, " vertices, paint ", paint, " texels, rig ", rig, " vertices, ", fix, " joints, ", strands, " hair points, saved ", saved);
}
```
