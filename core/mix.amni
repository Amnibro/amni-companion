import os;
import json;
import gfx;
import math;
import gfx.linalg;
import gfx.gltf;
import gfx.motion;
import gfx.scene3d;
import spring;
var item = -1;
var asset = -1;
var slot_node int[22] = [-1; 22];
var rest_q linalg::Quat[22] = [linalg::quat_identity(); 22];
var cur_q linalg::Quat[22] = [linalg::quat_identity(); 22];
var hips_t = float3 { 0.0, 0.0, 0.0 };
var frames f32[>..];
var clip_first int[>..];
var clip_nf int[>..];
var clip_loop bool[>..];
var act_clip int[>..];
var act_t f32[>..];
var act_w f32[>..];
var act_dw f32[>..];
var act_done bool[>..];
var cur = -1;
var pose_q linalg::Quat[22] = [linalg::quat_identity(); 22];
var pose_pq linalg::Quat[22] = [linalg::quat_identity(); 22];
var pose_h = float3 { 0.0, 0.0, 0.0 };
var pose_ph = float3 { 0.0, 0.0, 0.0 };
var last_dt f32 = 0.0;
var in_ax float3[22] = [float3 { 0.0, 0.0, 0.0 }; 22];
var in_x0 f32[22] = [0.0; 22];
var in_v0 f32[22] = [0.0; 22];
var in_t1 f32[22] = [0.0; 22];
var in_hd = float3 { 0.0, 0.0, 0.0 };
var in_hx0 f32 = 0.0;
var in_hv0 f32 = 0.0;
var in_ht1 f32 = 0.0;
var in_t f32 = 0.0;
var in_on = false;
fn inert_x(x0 f32, v0 f32, t1 f32, t f32) f32 {
	if t1 <= 0.0 || t >= t1 || x0 <= 1.0e-6 { return 0.0; }
	let t2 = t1 * t1;
	let t3 = t2 * t1;
	let t4 = t3 * t1;
	let t5 = t4 * t1;
	var a0 f32 = (-8.0 * v0 * t1 - 20.0 * x0) / t2;
	if a0 < 0.0 { a0 = 0.0; }
	let A = -(a0 * t2 + 6.0 * v0 * t1 + 12.0 * x0) / (2.0 * t5);
	let B = (3.0 * a0 * t2 + 16.0 * v0 * t1 + 30.0 * x0) / (2.0 * t4);
	let C = -(3.0 * a0 * t2 + 12.0 * v0 * t1 + 20.0 * x0) / (2.0 * t3);
	let s2 = t * t;
	let s3 = s2 * t;
	let s4 = s3 * t;
	let s5 = s4 * t;
	return A * s5 + B * s4 + C * s3 + a0 * s2 / 2.0 + v0 * t + x0;
}
fn inert_fit(x0 f32, xp f32, t1 f32, k int) {
	var v0 f32 = 0.0;
	if last_dt > 0.0 {
		v0 = (x0 - xp) / last_dt;
	}
	if v0 > 0.0 { v0 = 0.0; }
	var t = t1;
	if v0 < 0.0 {
		t = min(t1, -5.0 * x0 / v0);
	}
	if k == 22 {
		in_hx0 = x0;
		in_hv0 = v0;
		in_ht1 = t;
	} else {
		in_x0[k] = x0;
		in_v0[k] = v0;
		in_t1[k] = t;
	}
}
fn mix_open(a int, it int, slots i32[:]) {
	asset = a;
	item = it;
	for k in 22 {
		let q = slots[k] as int;
		if q >= 0 && q < gltf::assets[a].nodes.count {
			slot_node[k] = gltf::assets[a].nodes.first + q;
			rest_q[k] = gltf::nodes[slot_node[k]].r;
		} else {
			slot_node[k] = -1;
			rest_q[k] = linalg::quat_identity();
		}
		cur_q[k] = rest_q[k];
		pose_q[k] = rest_q[k];
		pose_pq[k] = rest_q[k];
		in_x0[k] = 0.0;
	}
	if slot_node[0] >= 0 {
		hips_t = gltf::nodes[slot_node[0]].t;
	} else {
		hips_t = float3 { 0.0, 0.0, 0.0 };
	}
	pose_h = hips_t;
	pose_ph = hips_t;
	last_dt = 0.0;
	in_on = false;
	frames.clear();
	clip_first.clear();
	clip_nf.clear();
	clip_loop.clear();
	act_clip.clear();
	act_t.clear();
	act_w.clear();
	act_dw.clear();
	act_done.clear();
	cur = -1;
	psd_node.clear();
	psd_k.clear();
	psd_slot.clear();
	psd_td.clear();
	psd_ui.clear();
	psd_w.clear();
	for k in 22 {
		psd_n[k] = 0;
	}
}
fn mix_clip(nf int, looping bool, src f32[:]) int {
	clip_first.push(frames.len);
	clip_nf.push(nf);
	clip_loop.push(looping);
	frames.append(src[..nf * 91]);
	return clip_first.len - 1;
}
fn dur(c int) f32 {
	(clip_nf[c] - 1) as f32 / 30.0
}
fn mix_play(c int, fade f32) bool {
	if c < 0 || c >= clip_first.len { return false; }
	if cur >= 0 && act_clip[cur] == c && !act_done[cur] { return true; }
	let fd f32 = max(fade, 0.0001);
	for i in act_clip.len {
		act_dw[i] = -act_w[i] / fd;
	}
	var idx = -1;
	for i in act_clip.len {
		if act_clip[i] == c {
			idx = i;
			break;
		}
	}
	if idx >= 0 {
		act_t[idx] = 0.0;
		act_w[idx] = 0.0;
		act_done[idx] = false;
	} else {
		act_clip.push(c);
		act_t.push(0.0);
		act_w.push(0.0);
		act_dw.push(0.0);
		act_done.push(false);
		idx = act_clip.len - 1;
	}
	for i in act_clip.len {
		if i == idx {
			act_w[i] = 1.0;
		} else {
			act_w[i] = 0.0;
		}
		act_dw[i] = 0.0;
	}
	if fade <= 0.0001 {
		in_on = false;
	} else {
		for k in 22 {
			if slot_node[k] < 0 { continue; }
			let s = sample(c, 0.0, k);
			var o = linalg::qmul(pose_q[k], qconj(s));
			if o.w < 0.0 {
				o = linalg::Quat { -o.x, -o.y, -o.z, -o.w };
			}
			let l = linalg::length3(float3 { o.x, o.y, o.z });
			if l < 1.0e-7 {
				in_x0[k] = 0.0;
			} else {
				in_ax[k] = float3 { o.x, o.y, o.z } / l;
				let x0 = (2.0 * atan2(l as real, o.w as real)) as f32;
				var op = linalg::qmul(pose_pq[k], qconj(s));
				if op.w < 0.0 {
					op = linalg::Quat { -op.x, -op.y, -op.z, -op.w };
				}
				let xp = (2.0 * atan2(linalg::dot3(float3 { op.x, op.y, op.z }, in_ax[k]) as real, op.w as real)) as f32;
				inert_fit(x0, xp, fade, k);
			}
		}
		if slot_node[0] >= 0 {
			let h0 = sample_hips(c, 0.0);
			let d = pose_h - h0;
			let l = linalg::length3(d);
			if l < 1.0e-6 {
				in_hx0 = 0.0;
			} else {
				in_hd = d / l;
				inert_fit(l, linalg::dot3(pose_ph - h0, in_hd), fade, 22);
			}
		}
		in_t = 0.0;
		in_on = true;
	}
	cur = idx;
	return true;
}
fn sample(c int, t f32, k int) linalg::Quat {
	let x = clamp(t * 30.0, 0.0, (clip_nf[c] - 1) as f32);
	let i0 = floor(x) as int;
	let i1 = min(i0 + 1, clip_nf[c] - 1);
	let u = x - (i0 as f32);
	let o0 = clip_first[c] + i0 * 91 + k * 4;
	let o1 = clip_first[c] + i1 * 91 + k * 4;
	let a = linalg::Quat { frames[o0], frames[o0 + 1], frames[o0 + 2], frames[o0 + 3] };
	let b = linalg::Quat { frames[o1], frames[o1 + 1], frames[o1 + 2], frames[o1 + 3] };
	return linalg::qslerp(a, b, u);
}
fn sample_hips(c int, t f32) float3 {
	let x = clamp(t * 30.0, 0.0, (clip_nf[c] - 1) as f32);
	let i0 = floor(x) as int;
	let i1 = min(i0 + 1, clip_nf[c] - 1);
	let u = x - (i0 as f32);
	let o0 = clip_first[c] + i0 * 91 + 88;
	let o1 = clip_first[c] + i1 * 91 + 88;
	let a = float3 { frames[o0], frames[o0 + 1], frames[o0 + 2] };
	let b = float3 { frames[o1], frames[o1 + 1], frames[o1 + 2] };
	return linalg::mix3(a, b, u);
}
fn mix_advance(dt f32) int {
	last_dt = dt;
	if in_on {
		in_t += dt;
	}
	var res = -1;
	for i in act_clip.len {
		act_t[i] += dt;
		let d = dur(act_clip[i]);
		if clip_loop[act_clip[i]] {
			if d > 0.0 {
				while act_t[i] >= d {
					act_t[i] -= d;
				}
			}
		} else if act_t[i] >= d {
			act_t[i] = d;
			if !act_done[i] {
				act_done[i] = true;
				if i == cur {
					res = act_clip[i];
				}
			}
		}
		act_w[i] = clamp(act_w[i] + act_dw[i] * dt, 0.0, 1.0);
		if act_w[i] <= 0.0 || act_w[i] >= 1.0 {
			act_dw[i] = 0.0;
		}
	}
	let na = act_clip.len;
	var j = 0;
	var ncur = -1;
	for i in na {
		if i != cur && act_w[i] <= 0.0 && act_dw[i] <= 0.0 { continue; }
		if i == cur {
			ncur = j;
		}
		act_clip[j] = act_clip[i];
		act_t[j] = act_t[i];
		act_w[j] = act_w[i];
		act_dw[j] = act_dw[i];
		act_done[j] = act_done[i];
		j += 1;
	}
	if j < na {
		act_clip.pop_n(na - j);
		act_t.pop_n(na - j);
		act_w.pop_n(na - j);
		act_dw.pop_n(na - j);
		act_done.pop_n(na - j);
	}
	cur = ncur;
	for k in 22 {
		if slot_node[k] < 0 { continue; }
		var cum f32 = 0.0;
		var q = rest_q[k];
		for i in act_clip.len {
			if act_w[i] > 0.0 {
				cum += act_w[i];
				let s = sample(act_clip[i], act_t[i], k);
				q = if cum == act_w[i] { s } else { linalg::qslerp(q, s, act_w[i] / cum) };
			}
		}
		if cum < 1.0 && cum > 0.0 {
			q = linalg::qslerp(rest_q[k], q, cum);
		}
		cur_q[k] = q;
	}
	if slot_node[0] >= 0 {
		let base = gltf::nodes[slot_node[0]].t;
		var cum f32 = 0.0;
		var h = base;
		for i in act_clip.len {
			if act_w[i] > 0.0 {
				cum += act_w[i];
				let s = sample_hips(act_clip[i], act_t[i]);
				h = if cum == act_w[i] { s } else { linalg::mix3(h, s, act_w[i] / cum) };
			}
		}
		if cum < 1.0 && cum > 0.0 {
			h = linalg::mix3(base, h, cum);
		}
		hips_t = h;
	}
	if in_on {
		var done = in_t >= in_ht1;
		for k in 22 {
			if slot_node[k] < 0 { continue; }
			let x = inert_x(in_x0[k], in_v0[k], in_t1[k], in_t);
			if x > 0.0 {
				cur_q[k] = linalg::qmul(linalg::qaxis(in_ax[k], x), cur_q[k]);
			}
			if in_t < in_t1[k] {
				done = false;
			}
		}
		if slot_node[0] >= 0 {
			hips_t = hips_t + in_hd * inert_x(in_hx0, in_hv0, in_ht1, in_t);
		}
		if done {
			in_on = false;
		}
	}
	for k in 22 {
		pose_pq[k] = pose_q[k];
		pose_q[k] = cur_q[k];
	}
	pose_ph = pose_h;
	pose_h = hips_t;
	push();
	return res;
}
fn push() {
	for k in 22 {
		if slot_node[k] >= 0 {
			let n = gltf::nodes[slot_node[k]];
			s3d::set_node(item, slot_node[k], if k == 0 { hips_t } else { n.t }, cur_q[k], n.s);
		}
	}
	mix_drive();
}
fn mix_apply(ov f32[:]) {
	for k in 22 {
		if slot_node[k] >= 0 {
			let w = ov[k * 5 + 4];
			if w > 0.0 {
				cur_q[k] = linalg::qslerp(cur_q[k], linalg::Quat { ov[k * 5], ov[k * 5 + 1], ov[k * 5 + 2], ov[k * 5 + 3] }, min(w, 1.0));
			}
		}
	}
	push();
}
fn mix_rest() {
	for k in 22 {
		cur_q[k] = rest_q[k];
		pose_q[k] = rest_q[k];
		pose_pq[k] = rest_q[k];
	}
	if slot_node[0] >= 0 {
		let t = gltf::nodes[slot_node[0]].t;
		hips_t = t;
		pose_h = t;
		pose_ph = t;
	}
	in_on = false;
	push();
}
fn mix_live(out f32[:]) {
	s3d::pose(item);
	for k in 22 {
		if slot_node[k] < 0 {
			out[12 * k + 11] = 0.0;
		} else {
			let node = slot_node[k];
			let wq = mquat(motion::world[node]);
			let wp = pos(motion::world[node]);
			let par = gltf::nodes[node].parent;
			var pq = linalg::quat_identity();
			if par >= 0 {
				pq = mquat(motion::world[par]);
			}
			out[12 * k] = wq.x;
			out[12 * k + 1] = wq.y;
			out[12 * k + 2] = wq.z;
			out[12 * k + 3] = wq.w;
			out[12 * k + 4] = wp.x;
			out[12 * k + 5] = wp.y;
			out[12 * k + 6] = wp.z;
			out[12 * k + 7] = pq.x;
			out[12 * k + 8] = pq.y;
			out[12 * k + 9] = pq.z;
			out[12 * k + 10] = pq.w;
			out[12 * k + 11] = 1.0;
		}
	}
	if slot_node[5] >= 0 {
		let hp = pos(motion::world[slot_node[5]]);
		out[264] = hp.x;
		out[265] = hp.y;
		out[266] = hp.z;
	}
}
let PSD_SIGMA = 0.5;
let PSD_CHILD int[22] = [1, 2, 3, 4, 5, -1, 7, 8, 9, -1, 11, 12, 13, -1, 15, 16, 17, -1, 19, 20, 21, -1];
var psd_node int[>..];
var psd_k int[>..];
var psd_slot int[>..];
var psd_td float3[>..];
var psd_ui int[>..];
var psd_w f32[>..];
var psd_n int[22] = [0; 22];
var psd_off int[22] = [0; 22];
var psd_coff int[22] = [0; 22];
var psd_D float3[22] = [float3 { 0.0, 0.0, 0.0 }; 22];
var psd_F float3[22] = [float3 { 0.0, 0.0, 0.0 }; 22];
var psd_O float3[22] = [float3 { 0.0, 0.0, 0.0 }; 22];
var psd_a float3[22] = [float3 { 0.0, 0.0, 0.0 }; 22];
var psd_pq linalg::Quat[22] = [linalg::quat_identity(); 22];
var psd_ud float3[>..];
var psd_cm f32[>..];
var psd_gw f32[>..];
fn psd_dir(flex f32, abd f32) float3 {
	let f = (flex as real) * PI / 180.0;
	let b = (abd as real) * PI / 180.0;
	return float3 { (cos(f) * cos(b)) as f32, (sin(f) * cos(b)) as f32, sin(b) as f32 };
}
fn psd_basis() {
	motion::rest(asset);
	motion::update(asset, gfx::mat4_identity);
	var L = float3 { 1.0, 0.0, 0.0 };
	if slot_node[14] >= 0 && slot_node[18] >= 0 {
		L = linalg::unit3(pos(motion::world[slot_node[14]]) - pos(motion::world[slot_node[18]]));
	} else if slot_node[7] >= 0 && slot_node[11] >= 0 {
		L = linalg::unit3(pos(motion::world[slot_node[7]]) - pos(motion::world[slot_node[11]]));
	}
	let U = float3 { 0.0, 1.0, 0.0 };
	let Fg = linalg::unit3(linalg::cross3(L, U));
	for k in 22 {
		if slot_node[k] < 0 { continue; }
		let c = PSD_CHILD[k];
		if c < 0 { continue; }
		if slot_node[c] < 0 { continue; }
		let pk = pos(motion::world[slot_node[k]]);
		let pc = pos(motion::world[slot_node[c]]);
		let dv = pc - pk;
		if linalg::dot3(dv, dv) <= 1.0e-10 { continue; }
		let D = linalg::unit3(dv);
		psd_a[k] = linalg::qrotate(qconj(mquat(motion::world[slot_node[k]])), D);
		let pn = gltf::nodes[slot_node[k]].parent;
		if pn >= 0 {
			psd_pq[k] = mquat(motion::world[pn]);
		} else {
			psd_pq[k] = linalg::quat_identity();
		}
		var F = Fg - D * linalg::dot3(D, Fg);
		if linalg::dot3(F, F) < 0.04 {
			F = U - D * linalg::dot3(D, U);
		}
		F = linalg::unit3(F);
		var O = linalg::unit3(linalg::cross3(D, F));
		var s f32 = 0.0;
		if (k >= 6 && k <= 9) || (k >= 14 && k <= 17) {
			s = 1.0;
		} else if (k >= 10 && k <= 13) || (k >= 18 && k <= 21) {
			s = -1.0;
		}
		if s != 0.0 && linalg::dot3(O, L) * s < 0.0 {
			O = float3 { -O.x, -O.y, -O.z };
		}
		psd_D[k] = D;
		psd_F[k] = F;
		psd_O[k] = O;
	}
}
fn mix_psd_add(node int, k int, slot int, dir float3) {
	psd_node.push(node);
	psd_k.push(k);
	psd_slot.push(slot);
	psd_td.push(dir);
	psd_ui.push(0);
	psd_w.push(0.0);
}
fn mix_psd_ready() {
	psd_ud.clear();
	psd_cm.clear();
	psd_gw.clear();
	for k in 22 {
		psd_n[k] = 0;
		if !contains(psd_slot, k) { continue; }
		psd_off[k] = psd_ud.len;
		psd_ud.push(float3 { 1.0, 0.0, 0.0 });
		for t in psd_slot.len {
			if psd_slot[t] != k { continue; }
			var j = psd_off[k];
			while j < psd_ud.len && linalg::dot3(psd_ud[j], psd_td[t]) <= 0.9999 {
				j += 1;
			}
			if j == psd_ud.len {
				psd_ud.push(psd_td[t]);
			}
			psd_ui[t] = j - psd_off[k];
		}
		let o = psd_off[k];
		let n = psd_ud.len - o;
		let w = 2 * n;
		var m real[>..] = [];
		m.resize(n * w, 0.0);
		for i in n {
			for j in n {
				let th = acos(clamp(linalg::dot3(psd_ud[o + i], psd_ud[o + j]), -1.0, 1.0));
				m[i * w + j] = exp(-(th * th) / (PSD_SIGMA * PSD_SIGMA));
			}
			m[i * w + n + i] = 1.0;
		}
		var ok = true;
		for col in n {
			var p = col;
			var r = col + 1;
			while r < n {
				if abs(m[r * w + col]) > abs(m[p * w + col]) { p = r; }
				r += 1;
			}
			if abs(m[p * w + col]) < 1.0e-12 {
				ok = false;
				break;
			}
			if p != col {
				for j in w {
					let tmp = m[col * w + j];
					m[col * w + j] = m[p * w + j];
					m[p * w + j] = tmp;
				}
			}
			let pv = m[col * w + col];
			for j in w {
				m[col * w + j] /= pv;
			}
			for rr in n {
				if rr != col {
					let f = m[rr * w + col];
					if f != 0.0 {
						for j in w {
							m[rr * w + j] -= f * m[col * w + j];
						}
					}
				}
			}
		}
		if !ok {
			psd_ud.pop_n(psd_ud.len - o);
			continue;
		}
		psd_n[k] = n;
		psd_coff[k] = psd_cm.len;
		for i in n {
			for j in n {
				psd_cm.push(m[i * w + n + j] as f32);
			}
		}
		for i in n {
			psd_gw.push(0.0);
		}
	}
}
fn mix_psd_dir(k int) float3 {
	let v = linalg::qrotate(psd_pq[k], linalg::qrotate(cur_q[k], psd_a[k]));
	return float3 { linalg::dot3(v, psd_D[k]), linalg::dot3(v, psd_F[k]), linalg::dot3(v, psd_O[k]) };
}
fn mix_drive() {
	for k in 22 {
		if psd_n[k] <= 0 || psd_n[k] > 32 { continue; }
		let u = mix_psd_dir(k);
		let n = psd_n[k];
		let o = psd_off[k];
		var phi real[32] = [0.0; 32];
		for b in n {
			let th = acos(clamp(linalg::dot3(u, psd_ud[o + b]), -1.0, 1.0));
			phi[b] = exp(-(th * th) / (PSD_SIGMA * PSD_SIGMA));
		}
		let co = psd_coff[k];
		for a in n {
			var sum = 0.0;
			for b in n {
				sum += (psd_cm[co + a * n + b] as real) * phi[b];
			}
			psd_gw[o + a] = sum as f32;
		}
	}
	for t in psd_slot.len {
		let k = psd_slot[t];
		var w f32 = 0.0;
		if psd_n[k] > 0 {
			w = clamp(psd_gw[psd_off[k] + psd_ui[t]], 0.0, 1.0);
		}
		psd_w[t] = w;
		if item >= 0 && psd_node[t] >= 0 {
			s3d::set_weight(item, psd_node[t], psd_k[t], w);
		}
	}
}
fn mix_swing(k int, dir float3) linalg::Quat {
	let s = linalg::unit3(psd_D[k] * dir.x + psd_F[k] * dir.y + psd_O[k] * dir.z);
	let c = linalg::dot3(psd_D[k], s);
	if c > 0.999999 { return rest_q[k]; }
	var axis = linalg::cross3(psd_D[k], s);
	if linalg::dot3(axis, axis) < 1.0e-12 {
		axis = psd_F[k];
	}
	let qw = linalg::qaxis(linalg::unit3(axis), acos(clamp(c, -1.0, 1.0)) as f32);
	return linalg::qnorm(linalg::qmul(qconj(psd_pq[k]), linalg::qmul(qw, linalg::qmul(psd_pq[k], rest_q[k]))));
}
fn mix_set(k int, q linalg::Quat) {
	if k >= 0 && k < 22 {
		cur_q[k] = q;
	}
}
fn psd_jws(s const byte[:], i0 int) int {
	var i = i0;
	while i < s.len && (s[i] == ' ' || s[i] == '\n' || s[i] == '\r' || s[i] == '\t') { i += 1; }
	i
}
fn psd_jstr_end(s const byte[:], i0 int) int {
	var i = i0 + 1;
	while i < s.len && s[i] != '"' {
		if s[i] == '\\' { i += 1; }
		i += 1;
	}
	min(i + 1, s.len)
}
fn psd_jskip(s const byte[:], i0 int) int {
	var i = psd_jws(s, i0);
	if i >= s.len { return i; }
	if s[i] == '"' { return psd_jstr_end(s, i); }
	if s[i] == '{' || s[i] == '[' {
		var depth = 0;
		while i < s.len {
			let c = s[i];
			if c == '"' {
				i = psd_jstr_end(s, i);
				continue;
			}
			if c == '{' || c == '[' {
				depth += 1;
			} else if c == '}' || c == ']' {
				depth -= 1;
				if depth == 0 { return i + 1; }
			}
			i += 1;
		}
		return i;
	}
	while i < s.len && s[i] != ',' && s[i] != '}' && s[i] != ']' { i += 1; }
	i
}
fn psd_jkey(s const byte[:], o0 int, key const byte[:]) int {
	if o0 < 0 { return -1; }
	var i = psd_jws(s, o0);
	if i >= s.len || s[i] != '{' { return -1; }
	i = psd_jws(s, i + 1);
	while i < s.len && s[i] == '"' {
		let e = psd_jstr_end(s, i);
		let same = e - i - 2 == key.len && s[i + 1..e - 1] == key;
		i = psd_jws(s, e);
		if i >= s.len || s[i] != ':' { return -1; }
		let v = psd_jws(s, i + 1);
		if same { return v; }
		i = psd_jws(s, psd_jskip(s, v));
		if i < s.len && s[i] == ',' {
			i = psd_jws(s, i + 1);
		} else {
			return -1;
		}
	}
	-1
}
fn psd_jarr(s const byte[:], a0 int, out int[>..]&) bool {
	out.clear();
	if a0 < 0 { return false; }
	var i = psd_jws(s, a0);
	if i >= s.len || s[i] != '[' { return false; }
	i = psd_jws(s, i + 1);
	if i < s.len && s[i] == ']' { return true; }
	while i < s.len {
		out.push(i);
		i = psd_jws(s, psd_jskip(s, i));
		if i < s.len && s[i] == ',' {
			i = psd_jws(s, i + 1);
		} else {
			break;
		}
	}
	true
}
fn psd_jtext(s const byte[:], i0 int, out byte[>..]&) bool {
	out.clear();
	if i0 < 0 || i0 >= s.len || s[i0] != '"' { return false; }
	var i = i0 + 1;
	while i < s.len && s[i] != '"' {
		var c = s[i];
		if c == '\\' && i + 1 < s.len {
			i += 1;
			c = s[i];
			if c == 'n' {
				c = '\n';
			} else if c == 't' {
				c = '\t';
			} else if c == 'r' {
				c = '\r';
			}
		}
		out.push(c);
		i += 1;
	}
	true
}
fn mix_psd_load(path const byte[:]) int {
	if asset < 0 { return 0; }
	var bytes byte[>..] = [];
	if !read_file(path, bytes) { return 0; }
	psd_node.clear();
	psd_k.clear();
	psd_slot.clear();
	psd_td.clear();
	psd_ui.clear();
	psd_w.clear();
	if bytes.len < 20 { return 0; }
	let len = (bytes[12] as int) | ((bytes[13] as int) << 8) | ((bytes[14] as int) << 16) | ((bytes[15] as int) << 24);
	if 20 + len > bytes.len { return 0; }
	let text = bytes[20..20 + len];
	var doc = json::Doc {};
	let root, perr = json::parse(text, doc);
	if perr.len > 0 { return 0; }
	var mlist int[>..] = [];
	var nlist int[>..] = [];
	var name byte[>..] = [];
	let meshes = psd_jkey(text, 0, "meshes");
	if psd_jarr(text, meshes, mlist) {
		for mo, mi in mlist {
			let extras = psd_jkey(text, mo, "extras");
			if extras < 0 { continue; }
			let names = psd_jkey(text, extras, "targetNames");
			if names < 0 { continue; }
			if !psd_jarr(text, names, nlist) { continue; }
			for so, t in nlist {
				if !psd_jtext(text, so, name) { continue; }
				if !starts_with(name, "psd:") { continue; }
				let rest = name[4..];
				let parts = split(rest, ':');
				var cnt = 0;
				var joint byte[>..] = [];
				var flex = 0.0;
				var abd = 0.0;
				var okf = true;
				for p in parts {
					if cnt == 0 {
						joint.append(p);
					} else if cnt == 1 {
						let v, o = parse_flt(p);
						flex = v;
						okf = okf && o;
					} else if cnt == 2 {
						let v, o = parse_flt(p);
						abd = v;
						okf = okf && o;
					}
					cnt += 1;
				}
				if cnt != 3 || !okf { continue; }
				let jn = gltf::find_node(asset, joint);
				if jn < 0 { continue; }
				var k = -1;
				for s in 22 {
					if slot_node[s] == jn {
						k = s;
						break;
					}
				}
				if k < 0 { continue; }
				let first = gltf::assets[asset].nodes.first;
				let count = gltf::assets[asset].nodes.count;
				let mesh_id = gltf::assets[asset].meshes.first + mi;
				for nd in first..first + count {
					if gltf::nodes[nd].mesh == mesh_id {
						mix_psd_add(nd, t, k, psd_dir(flex as f32, abd as f32));
					}
				}
			}
		}
	}
	if psd_node.len > 0 {
		psd_basis();
		mix_psd_ready();
	}
	return psd_node.len;
}
