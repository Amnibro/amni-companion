import cv.life;
import math;
var inp real[11] = [0.0; 11];
var out real[33] = [0.0; 33];
fn run(n int) {
	for i in n {
		inp[0] = 1.0 / 60.0;
		life::life_step(inp, out);
	}
}
fn report(name const byte[:], c bool) {
	print(name, if c { " ok" } else { " bad" });
}
fn main() {
	life::life_reset(7);
	inp[1] = 1.0;
	inp[2] = 0.0;
	inp[3] = 0.0;
	inp[4] = 0.8;
	inp[5] = 0.0;
	inp[6] = 1.0;
	var blinks = 0;
	var prev = out[0];
	for f in 7200 {
		run(1);
		if prev < 0.5 && out[0] >= 0.5 { blinks++; }
		prev = out[0];
	}
	report("blinks", blinks >= 16 && blinks <= 48);
	life::life_reset(7);
	run(60);
	inp[2] = 0.5;
	var cnt = 0;
	while cnt < 60 {
		run(1);
		cnt++;
		if abs(out[14] - 0.5) < 0.06 { break; }
	}
	report("saccade", cnt >= 4 && cnt <= 9);
	var lim = true;
	for f in 90 {
		run(1);
		if abs(out[12]) > 0.21 + 1e-9 { lim = false; }
	}
	report("eye limit", lim && out[10] > 0.25);
	life::life_reset(7);
	inp[2] = 0.0;
	run(120);
	inp[2] = 0.6;
	run(7);
	let h0 = out[10];
	var dev = 0.0;
	for f in 23 {
		run(1);
		dev = max(dev, abs(out[14] - 0.6));
	}
	report("vor", out[10] - h0 > 0.03 && dev <= 0.08);
	life::life_reset(7);
	inp[2] = 0.0;
	inp[4] = 0.3;
	run(120);
	let v1 = out[30];
	inp[4] = 3.0;
	run(120);
	let v2 = out[30];
	report("vergence", v1 > 0.08 && v2 < 0.03);
	life::life_reset(7);
	life::life_say("map", 0.0, 1.0);
	inp[7] = 0.0325;
	run(1);
	report("closure", out[19] >= 0.45 && out[16] <= 0.12);
	inp[7] = 0.114;
	run(1);
	report("open", out[16] >= 0.4);
	life::life_say("oo", 0.5, 1.0);
	inp[7] = 0.42;
	run(1);
	let a = out[18];
	inp[7] = 0.2;
	run(1);
	let b = out[18];
	report("anticipation", a > 0.1 && a < 0.8 && b < 0.05);
	inp[7] = 3.0;
	run(1);
	var quiet = true;
	for k in 16..28 {
		if out[k] >= 0.01 { quiet = false; }
	}
	report("rest", quiet);
	var p real[1512] = [0.0; 1512];
	var d real[1512] = [0.0; 1512];
	var idx = 0;
	for i in 21 {
		for j in 24 {
			let pa = 1.92 * i / 20.0;
			let pb = 2.0 * PI * j / 24.0;
			let x = 0.012 * sin(pa) * cos(pb);
			let y = 0.012 * sin(pa) * sin(pb);
			let z = 0.012 * cos(pa);
			p[3 * idx] = 0.03 + x;
			p[3 * idx + 1] = 1.5 + y;
			p[3 * idx + 2] = 0.1 + z;
			let ry = y * cos(0.25) + z * sin(0.25);
			let rz = z * cos(0.25) - y * sin(0.25);
			d[3 * idx] = 0.0;
			d[3 * idx + 1] = ry - y;
			d[3 * idx + 2] = rz - z;
			idx++;
		}
	}
	let u = life::life_eye_cal(p, d, 504, 1);
	for k in 1512 { d[k] = -d[k]; }
	let w = life::life_eye_cal(p, d, 504, 1);
	report("calibration", abs(u - 0.25) < 0.02 && abs(w + 0.25) < 0.02);
	life::life_reset(7);
	inp[1] = 1.0;
	inp[2] = 0.0;
	inp[3] = 0.0;
	inp[4] = 0.8;
	inp[5] = 0.0;
	inp[7] = 0.0;
	var breaths = 0;
	var lo = 1e30;
	var hi = -1e30;
	var bp = out[32];
	for f in 3600 {
		run(1);
		if bp < 0.5 && out[32] >= 0.5 { breaths++; }
		bp = out[32];
		lo = min(lo, out[32]);
		hi = max(hi, out[32]);
	}
	report("breath idle", breaths >= 10 && breaths <= 18 && lo >= 0.0 && hi <= 1.25);
	life::life_reset(7);
	inp[5] = 1.0;
	life::life_say("one two three four, five six seven eight.", 0.5, 1.0);
	var pause = false;
	var mid = false;
	for f in 1..301 {
		inp[7] = f / 60.0;
		let before = out[32];
		run(1);
		if out[32] > before {
			if inp[7] >= 1.52 && inp[7] <= 1.76 { pause = true; }
			if inp[7] >= 0.75 && inp[7] <= 1.2 { mid = true; }
		}
	}
	report("breath speech", pause && !mid);
}
