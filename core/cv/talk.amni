namespace talk;
fn lower_byte(c byte) byte {
	if c >= 'A' && c <= 'Z' { c + 32 } else { c }
}
fn is_alpha(c byte) bool {
	(c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}
fn is_alnum(c byte) bool {
	is_alpha(c) || (c >= '0' && c <= '9')
}
fn put_b(dst byte[:], n int&, c byte) {
	if n < dst.len {
		dst[n] = c;
		n += 1;
	}
}
fn put_str(dst byte[:], n int&, s const byte[:]) {
	for c in s { put_b(dst, n, c); }
}
fn index_sub(s const byte[:], sub const byte[:]) int {
	if sub.len > s.len { return -1; }
	for i in s.len - sub.len + 1 {
		var ok = true;
		for j in sub.len {
			if s[i + j] != sub[j] {
				ok = false;
				break;
			}
		}
		if ok { return i; }
	}
	-1
}
fn has_sub(s const byte[:], sub const byte[:]) bool {
	index_sub(s, sub) >= 0
}
fn action_tag(s const byte[:]) const byte[:] {
	var low byte[..48] = [];
	for ch in s {
		if low.len < low.cap { low.push(lower_byte(ch)); }
	}
	let t const byte[:] = low[..];
	if has_sub(t, "wave") { return "emote:wave"; }
	if has_sub(t, "danc") { return "anim:dance"; }
	if has_sub(t, "nod") { return "emote:nod"; }
	if has_sub(t, "laugh") || has_sub(t, "giggl") { return "emote:laugh"; }
	if has_sub(t, "bow") { return "emote:bow"; }
	if has_sub(t, "jump") { return "anim:jump"; }
	if has_sub(t, "spin") || has_sub(t, "twirl") { return "anim:spin"; }
	if has_sub(t, "sit") { return "anim:sit"; }
	if has_sub(t, "wink") { return "face:wink"; }
	if has_sub(t, "smil") || has_sub(t, "grin") { return "face:smile"; }
	if has_sub(t, "think") || has_sub(t, "ponder") { return "emote:think"; }
	if has_sub(t, "shrug") { return "emote:shrug"; }
	if has_sub(t, "clap") { return "emote:clap"; }
	""
}
fn tags_split(text const byte[:], clean byte[:], tags byte[:], lens i32[:]) int {
	var cn = 0;
	var tn = 0;
	var count = 0;
	var i = 0;
	while i < text.len {
		let c = text[i];
		if c == '[' && i + 1 < text.len && text[i + 1] == '[' {
			let ks = i + 2;
			var j = ks;
			while j < text.len && (is_alpha(text[j]) || text[j] == '_') { j++; }
			let klen = j - ks;
			var end = -1;
			var a0 = 0;
			var a1 = 0;
			if klen >= 1 && klen <= 17 {
				if j + 1 < text.len && text[j] == ']' && text[j + 1] == ']' {
					end = j + 2;
				} else if j < text.len && text[j] == ':' {
					a0 = j + 1;
					a1 = a0;
					while a1 < text.len && text[a1] != ']' && a1 - a0 < 81 { a1++; }
					if a1 - a0 <= 80 && a1 + 1 < text.len && text[a1] == ']' && text[a1 + 1] == ']' {
						end = a1 + 2;
					}
				}
			}
			if end >= 0 {
				for q in klen { put_b(tags, tn, lower_byte(text[ks + q])); }
				if a1 > a0 {
					put_b(tags, tn, ':');
					for q in a1 - a0 { put_b(tags, tn, text[a0 + q]); }
				}
				put_b(tags, tn, '\n');
				count++;
				i = end;
				continue;
			}
		}
		if c == '*' {
			var e = i + 1;
			while e < text.len && text[e] != '*' && text[e] != '\n' && e - (i + 1) <= 40 { e++; }
			if e < text.len && text[e] == '*' && e - i - 1 >= 1 && e - i - 1 <= 40 {
				let t = action_tag(text[i + 1..e]);
				if t.len > 0 {
					put_str(tags, tn, t);
					put_b(tags, tn, '\n');
					count++;
				}
				i = e + 1;
				continue;
			}
		}
		put_b(clean, cn, c);
		i++;
	}
	var w = 0;
	var prev_space = false;
	for k in cn {
		let ch = clean[k];
		if ch == ' ' {
			if w > 0 && !prev_space {
				clean[w] = ch;
				w++;
			}
			prev_space = true;
		} else {
			clean[w] = ch;
			w++;
			prev_space = false;
		}
	}
	if w > 0 && clean[w - 1] == ' ' { w--; }
	if lens.len > 0 { lens[0] = w as i32; }
	if lens.len > 1 { lens[1] = tn as i32; }
	count
}
