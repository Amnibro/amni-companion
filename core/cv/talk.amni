fn count_lines(ls const Line[:], intent const byte[:], persona const byte[:]) int {
	var n = 0;
	for &l in ls {
		if l.intent == intent && l.persona == persona { n++; }
	}
	n
}
fn pick_line(intent const byte[:], persona const byte[:], seed int) const byte[:] {
	let ls = LINES();
	var per = persona;
	var n = count_lines(ls, intent, per);
	if n == 0 {
		per = "*";
		n = count_lines(ls, intent, per);
	}
	if n == 0 { return ""; }
	let k = seed % n;
	var idx = 0;
	for &l in ls {
		if l.intent == intent && l.persona == per {
			if idx == k { return l.text; }
			idx++;
		}
	}
	""
}
fn object_intent(label const byte[:]) const byte[:] {
	if label == "banana" || label == "apple" || label == "sandwich" || label == "orange" || label == "broccoli" || label == "carrot" || label == "hot dog" || label == "pizza" || label == "donut" || label == "cake" || label == "cup" || label == "bottle" || label == "wine glass" || label == "bowl" { return "ev_object_food"; }
	if label == "dog" || label == "cat" || label == "bird" || label == "horse" || label == "teddy bear" { return "ev_object_pet"; }
	if label == "cell phone" || label == "laptop" || label == "keyboard" || label == "mouse" || label == "remote" || label == "tv" { return "ev_object_tech"; }
	if label == "book" { return "ev_object_book"; }
	"ev_object"
}
fn wb(u const byte[:], k int) byte {
	if k <= 0 || k > u.len { return ' '; }
	let c = lower_byte(u[k - 1]);
	if is_alnum(c) { c } else { ' ' }
}
fn find_ph(u const byte[:], p const byte[:]) int {
	let total = u.len + 2;
	let need = p.len + 2;
	if total < need { return -1; }
	for k in total - need + 1 {
		if wb(u, k) != ' ' { continue; }
		var ok = true;
		for j in p.len {
			if wb(u, k + 1 + j) != p[j] {
				ok = false;
				break;
			}
		}
		if ok && wb(u, k + 1 + p.len) == ' ' { return k; }
	}
	-1
}
fn has_ph(u const byte[:], p const byte[:]) bool {
	find_ph(u, p) >= 0
}
fn is_whole(u const byte[:], p const byte[:]) bool {
	let total = u.len + 2;
	var s = 0;
	while s < total && wb(u, s) == ' ' { s++; }
	var e = total;
	while e > s && wb(u, e - 1) == ' ' { e--; }
	if e - s != p.len { return false; }
	for j in p.len {
		if wb(u, s + j) != p[j] { return false; }
	}
	true
}
fn word_after(u const byte[:], p const byte[:], arg byte[..64]&) bool {
	let k = find_ph(u, p);
	if k < 0 { return false; }
	let total = u.len + 2;
	var s = k + p.len + 2;
	while s < total && wb(u, s) == ' ' { s++; }
	var n = 0;
	while s + n < total && n < 24 && is_alpha(wb(u, s + n)) { n++; }
	if n == 0 { return false; }
	arg.clear();
	for j in n {
		let ch = wb(u, s + j);
		if j == 0 { arg.push(ch - 32); } else { arg.push(ch); }
	}
	true
}
fn intent_of(u const byte[:], arg byte[..64]&) const byte[:] {
	arg.clear();
	if u.len > 0 && u[0] == '@' {
		var e = 1;
		while e < u.len && u[e] != ' ' { e++; }
		let name = u[1..e];
		let rest = trim(u[e..]);
		for ch in rest {
			if arg.len < arg.cap { arg.push(ch); }
		}
		if name == "object" { return object_intent(rest); }
		if name == "open_palm" { return ""; }
		if name.len > 40 { return ""; }
		var buf byte[..48] = [];
		for ch in "ev_" { buf.push(ch); }
		for ch in name { buf.push(ch); }
		let ls = LINES();
		for &l in ls {
			if l.intent == buf { return l.intent; }
		}
		return "";
	}
	if word_after(u, "my name is", arg) || word_after(u, "my name s", arg) || word_after(u, "call me", arg) || word_after(u, "i m called", arg) { return "name_set"; }
	if has_ph(u, "what is my name") || has_ph(u, "what s my name") || has_ph(u, "do you know my name") || has_ph(u, "who am i") { return "name_ask"; }
	let greet = has_ph(u, "hi") || has_ph(u, "hello") || has_ph(u, "hey") || has_ph(u, "yo") || has_ph(u, "hiya") || has_ph(u, "howdy") || has_ph(u, "good morning") || has_ph(u, "good afternoon") || has_ph(u, "good evening");
	if has_ph(u, "how are you") || has_ph(u, "how r u") || has_ph(u, "how s it going") || has_ph(u, "how are things") || has_ph(u, "what s up") || has_ph(u, "whats up") || has_ph(u, "sup") { return "how_are_you"; }
	if has_ph(u, "who are you") || has_ph(u, "what is your name") || has_ph(u, "what s your name") || has_ph(u, "your name") || has_ph(u, "what are you") { return "who_are_you"; }
	if has_ph(u, "what time") || has_ph(u, "the time") { return "time"; }
	if has_ph(u, "what day") || has_ph(u, "the date") || has_ph(u, "today s date") { return "day"; }
	if has_ph(u, "joke") || has_ph(u, "make me laugh") || has_ph(u, "something funny") { return "joke"; }
	if has_ph(u, "what can you do") || has_ph(u, "help") || has_ph(u, "commands") { return "help"; }
	if has_ph(u, "what do you see") || has_ph(u, "can you see") || has_ph(u, "see me") || has_ph(u, "look at this") || has_ph(u, "what is this") || has_ph(u, "what s this") { return "see"; }
	if has_ph(u, "dance") { return "cmd_dance"; }
	if has_ph(u, "sit") || has_ph(u, "sit down") { return "cmd_sit"; }
	if has_ph(u, "stand up") || has_ph(u, "get up") { return "cmd_stand"; }
	if has_ph(u, "jump") { return "cmd_jump"; }
	if has_ph(u, "wave") { return "cmd_wave"; }
	if has_ph(u, "spin") || has_ph(u, "turn around") { return "cmd_spin"; }
	if has_ph(u, "come here") || has_ph(u, "come closer") || has_ph(u, "come to me") || has_ph(u, "follow me") { return "cmd_come"; }
	if has_ph(u, "go back") || has_ph(u, "go home") || has_ph(u, "back up") { return "cmd_home"; }
	if has_ph(u, "walk around") || has_ph(u, "explore") || has_ph(u, "wander") { return "cmd_roam"; }
	if has_ph(u, "stop") || has_ph(u, "stay") || has_ph(u, "freeze") { return "cmd_stop"; }
	if has_ph(u, "look at me") { return "cmd_look"; }
	if has_ph(u, "punch") || has_ph(u, "fight") { return "cmd_punch"; }
	if has_ph(u, "bow") { return "cmd_bow"; }
	if has_ph(u, "thank you") || has_ph(u, "thanks") || has_ph(u, "thx") || has_ph(u, "ty") { return "thanks"; }
	if has_ph(u, "love you") || has_ph(u, "like you") || has_ph(u, "you re cute") || has_ph(u, "you re pretty") || has_ph(u, "you re cool") || has_ph(u, "you re awesome") || has_ph(u, "you re smart") || has_ph(u, "good job") || has_ph(u, "nice") { return "compliment"; }
	if has_ph(u, "stupid") || has_ph(u, "dumb") || has_ph(u, "hate you") || has_ph(u, "useless") || has_ph(u, "shut up") { return "insult"; }
	if has_ph(u, "bye") || has_ph(u, "goodbye") || has_ph(u, "good night") || has_ph(u, "goodnight") || has_ph(u, "see you") || has_ph(u, "gotta go") { return "bye"; }
	if has_ph(u, "weather") || has_ph(u, "news") || has_ph(u, "search") || has_ph(u, "google") || has_ph(u, "look up") { return "needs_brain"; }
	if greet { return "greet"; }
	if is_whole(u, "yes") || is_whole(u, "yeah") || is_whole(u, "yep") || is_whole(u, "sure") || is_whole(u, "ok") || is_whole(u, "okay") || is_whole(u, "no") || is_whole(u, "nope") || is_whole(u, "nah") { return "ack"; }
	var q = u.len;
	while q > 0 && u[q - 1] == ' ' { q--; }
	if q > 0 && u[q - 1] == '?' { return "fallback_q"; }
	"fallback"
}
fn put_num2(dst byte[:], n int&, v int) {
	if v >= 10 { put_b(dst, n, ('0' + (v / 10) % 10) as byte); }
	put_b(dst, n, ('0' + v % 10) as byte);
}
fn put_time(dst byte[:], n int&, hour int, minute int) {
	let h = hour % 24;
	var h12 = h % 12;
	if h12 == 0 { h12 = 12; }
	put_num2(dst, n, h12);
	put_b(dst, n, ':');
	let m = minute % 60;
	put_b(dst, n, ('0' + m / 10) as byte);
	put_b(dst, n, ('0' + m % 10) as byte);
	put_b(dst, n, ' ');
	if h >= 12 { put_str(dst, n, "PM"); } else { put_str(dst, n, "AM"); }
}
fn brain_reply(input const byte[:], out byte[:]) int {
	var persona const byte[:] = "";
	var name const byte[:] = "";
	var cname const byte[:] = "";
	var day const byte[:] = "";
	var seen const byte[:] = "";
	var person const byte[:] = "";
	var hour = 0;
	var minute = 0;
	var seed = 0;
	var pos = 0;
	while pos < input.len {
		var e = pos;
		while e < input.len && input[e] != '\n' { e++; }
		var hdr = input[pos..e];
		if hdr.len > 0 && hdr[hdr.len - 1] == '\r' { hdr = hdr[..hdr.len - 1]; }
		pos = e + 1;
		if hdr.len == 0 { break; }
		var eq = 0;
		while eq < hdr.len && hdr[eq] != '=' { eq++; }
		if eq >= hdr.len { continue; }
		let key = hdr[..eq];
		let val = hdr[eq + 1..];
		if key == "persona" {
			persona = val;
		} else if key == "name" {
			name = val;
		} else if key == "cname" {
			cname = val;
		} else if key == "day" {
			day = val;
		} else if key == "seen" {
			seen = val;
		} else if key == "person" {
			person = val;
		} else if key == "hour" {
			let n, ok = parse_int(trim(val));
			if ok { hour = n; }
		} else if key == "minute" {
			let n, ok = parse_int(trim(val));
			if ok { minute = n; }
		} else if key == "seed" {
			let n, ok = parse_int(trim(val));
			if ok { seed = n; }
		}
	}
	if pos > input.len { pos = input.len; }
	let utt = trim(input[pos..]);
	var arg byte[..64] = [];
	var intent = intent_of(utt, arg);
	if intent == "name_ask" && name.len == 0 { intent = "name_unknown"; }
	if intent == "see" {
		if seen.len > 0 {
			intent = "see_obj";
		} else if person == "1" {
			intent = "see_person";
		} else {
			intent = "see_none";
		}
	}
	if intent.len == 0 { return 0; }
	let line = pick_line(intent, persona, seed);
	if line.len == 0 { return 0; }
	var first = 0;
	while first < seen.len && seen[first] != ',' { first++; }
	let seen1 = seen[..first];
	var n = 0;
	var i = 0;
	while i < line.len {
		let c = line[i];
		if c == '{' {
			var j = i + 1;
			while j < line.len && line[j] != '}' { j++; }
			if j < line.len {
				let key = line[i + 1..j];
				var known = true;
				if key == "name" {
					if intent == "name_set" {
						put_str(out, n, arg);
					} else if name.len == 0 {
						put_str(out, n, "friend");
					} else {
						put_str(out, n, name);
					}
				} else if key == "cname" {
					if cname.len == 0 { put_str(out, n, "your companion"); } else { put_str(out, n, cname); }
				} else if key == "time" {
					put_time(out, n, hour, minute);
				} else if key == "day" {
					put_str(out, n, day);
				} else if key == "tod" {
					if hour < 12 {
						put_str(out, n, "morning");
					} else if hour < 17 {
						put_str(out, n, "afternoon");
					} else {
						put_str(out, n, "evening");
					}
				} else if key == "seen" {
					put_str(out, n, seen1);
				} else if key == "arg" {
					put_str(out, n, arg);
				} else {
					known = false;
				}
				if known {
					i = j + 1;
					continue;
				}
			}
		}
		put_b(out, n, c);
		i++;
	}
	n
}
