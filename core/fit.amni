var tw = 0;
var th = 0;
var nview = 0;
var cur = 0;
var v_px byte[>..];
var v_mask f32[>..];
var v_bg float3[>..];
var pcell = 4;
var v_fix bool[>..];
var v_yaw f32[>..];
var v_d f32[>..];
var v_cy f32[>..];
var v_cx f32[>..];
var g_off int[>..];
var g_w int[>..];
var g_r f32[>..];
var g_g f32[>..];
var g_b f32[>..];
var g_c int[>..];
var c_p float3[>..];
var c_m float3[>..];
var tpx byte[>..];
var tmask f32[>..];
var rpx byte[>..];
var rmask f32[>..];
var bg = float3 { 0.0, 0.0, 0.0 };
var cam_eye = float3 { 0.0, 0.0, 0.0 };
var cam_look = float3 { 0.0, 0.0, 0.0 };
var hit_img int[>..];
var hit_u f32[>..];
var hit_v f32[>..];
var zb f32[>..];
var pal gfx::mat4[>..];
