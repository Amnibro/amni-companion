import json;
var tw = 0;
var th = 0;
var nview = 0;
var cur = 0;
var v_px byte[>..];
var v_mask f32[>..];
var v_bg float3[>..];
var pcell = 4;
var v_fix bool[>..];
var v_yaw f32[>..];
var v_d f32[>..];
var v_cy f32[>..];
var v_cx f32[>..];
var g_off int[>..];
var g_w int[>..];
var g_r f32[>..];
var g_g f32[>..];
var g_b f32[>..];
var g_c int[>..];
var c_p float3[>..];
var c_m float3[>..];
var tpx byte[>..];
var tmask f32[>..];
var rpx byte[>..];
var rmask f32[>..];
var bg = float3 { 0.0, 0.0, 0.0 };
var cam_eye = float3 { 0.0, 0.0, 0.0 };
var cam_look = float3 { 0.0, 0.0, 0.0 };
var hit_img int[>..];
var hit_u f32[>..];
var hit_v f32[>..];
var zb f32[>..];
var pal gfx::mat4[>..];
var fast = false;
var shape_changed = false;
var vx f32[>..];
var vy f32[>..];
var vz f32[>..];
var vw f32[>..];
var vis bool[>..];
var vrot linalg::Quat[>..];
var sm f32[>..];
var pose_n int[>..];
var pose_a f32[>..];
var img_changed int[>..];
var key_k f32 = 1.0;
var fill_k f32 = 1.0;
var amb_k f32 = 1.0;
var sun_az f32 = 0.0;
var sun_el f32 = 0.0;
var clear_c = float3 { 0.0, 0.0, 0.0 };
var item = -1;
var asset = -1;
var big = gfx::Texture { id: 0, .. };
var fov f32 = 0.5;
fn num(s const byte[:]) f32 {
	let v, ok = parse_flt(s);
	v as f32
}
fn at(px const byte[:], i int, c int) f32 {
	px[i * 4 + c] as f32
}
fn gray_bg() {
	let n = tw * th;
	if n == 0 { return; }
	var cr f32[>..] = [];
	var cg f32[>..] = [];
	var cb f32[>..] = [];
	for i in n {
		let x = i % tw;
		let y = i / tw;
		if x == 0 || x == tw - 1 || y == 0 || y == th - 1 {
			cr.push(at(tpx, i, 0));
			cg.push(at(tpx, i, 1));
			cb.push(at(tpx, i, 2));
		}
	}
	sort(cr) { a, b => a < b };
	sort(cg) { a, b => a < b };
	sort(cb) { a, b => a < b };
	bg = float3 { cr[cr.len / 2], cg[cg.len / 2], cb[cb.len / 2] };
	var smo float3[>..] = [];
	smo.resize(n, float3 { 0.0, 0.0, 0.0 });
	for y in th {
		for x in tw {
			var s0 f32 = 0.0;
			var s1 f32 = 0.0;
			var s2 f32 = 0.0;
			for dy in -2..3 {
				for dx in -2..3 {
					let j = clamp(y + dy, 0, th - 1) * tw + clamp(x + dx, 0, tw - 1);
					s0 += at(tpx, j, 0);
					s1 += at(tpx, j, 1);
					s2 += at(tpx, j, 2);
				}
			}
			smo[y * tw + x] = float3 { s0 / 25.0, s1 / 25.0, s2 / 25.0 };
		}
	}
	if tmask.len != n { tmask.resize(n, 1.0); }
	for i in n { tmask[i] = 1.0; }
	var seen byte[>..] = [];
	seen.resize(n, 0);
	var st int[>..<] = [];
	fn joins(i int, from int) bool {
		let p = smo[i];
		let q = smo[from];
		let dq = max(max(abs(p.x - q.x), abs(p.y - q.y)), abs(p.z - q.z));
		let db = max(max(abs(p.x - bg.x), abs(p.y - bg.y)), abs(p.z - bg.z));
		let sat = max(max(p.x, p.y), p.z) - min(min(p.x, p.y), p.z);
		dq <= 4.0 && db <= 48.0 && sat <= 20.0
	}
	for i in n {
		let x = i % tw;
		let y = i / tw;
		if x == 0 || x == tw - 1 || y == 0 || y == th - 1 {
			if seen[i] == 0 && joins(i, i) {
				seen[i] = 1;
				st.push(i);
			}
		}
	}
	let dxs int[4] = [1, -1, 0, 0];
	let dys int[4] = [0, 0, 1, -1];
	while st.len > 0 {
		let i = st.pop();
		tmask[i] = 0.0;
		let x = i % tw;
		let y = i / tw;
		for d in 4 {
			let nx = x + dxs[d];
			let ny = y + dys[d];
			if nx < 0 || ny < 0 || nx >= tw || ny >= th { continue; }
			let j = ny * tw + nx;
			if seen[j] != 0 { continue; }
			if joins(j, i) {
				seen[j] = 1;
				st.push(j);
			}
		}
	}
}
fn right_of(k int) float3 {
	let y = v_yaw[k] as real;
	float3 { cos(y) as f32, 0.0, (-sin(y)) as f32 }
}
fn fwd_of(k int) float3 {
	let y = v_yaw[k] as real;
	float3 { sin(y) as f32, 0.0, cos(y) as f32 }
}
fn use_view(k int) {
	cur = k;
	let n = tw * th;
	tpx.clear();
	tpx.append(v_px[k * n * 4..(k + 1) * n * 4]);
	tmask.clear();
	tmask.append(v_mask[k * n..(k + 1) * n]);
	bg = v_bg[k];
	let r = right_of(k);
	let f = fwd_of(k);
	cam_look = float3 { r.x * v_cx[k], r.y * v_cx[k] + v_cy[k], r.z * v_cx[k] };
	cam_eye = float3 { cam_look.x + f.x * v_d[k], cam_look.y + f.y * v_d[k], cam_look.z + f.z * v_d[k] };
	set_lights();
}
fn cam_fit(k int, iters int) bool {
	use_view(k);
	if v_fix[k] { return true; }
	let ty0, ty1, tcx = bbox(tmask);
	if ty1 <= ty0 { return false; }
	for i in iters {
		shot(cam_eye, cam_look);
		let my0, my1, mcx = bbox(rmask);
		if my1 <= my0 { return false; }
		let wpp = (2.0 * (v_d[k] as real) * tan((fov as real) / 2.0) / (th as real)) as f32;
		v_cy[k] -= ((((my0 + my1) as f32) - ((ty0 + ty1) as f32)) / 2.0) * wpp;
		v_cx[k] += (mcx - tcx) * wpp;
		v_d[k] *= ((my1 - my0) as f32) / ((ty1 - ty0) as f32);
		use_view(k);
	}
	return true;
}
fn load_pose(path const byte[:]) {
	var data byte[>..] = [];
	if !read_file(path, data) { return; }
	let lines = split(data, '\n');
	for ln in lines {
		let t = trim(ln);
		if t.len == 0 { continue; }
		let fields = split(t, ' ');
		var name const byte[:] = "";
		var vals f32[..10] = [];
		for w, k in fields {
			if k == 0 { name = w; } else if vals.len < 10 { vals.push(num(w)); }
		}
		if vals.len < 10 { continue; }
		let node = gltf::find_node(asset, name);
		if node >= 0 {
			s3d::set_node(item, node, float3 { vals[0], vals[1], vals[2] }, linalg::Quat { vals[3], vals[4], vals[5], vals[6] }, float3 { vals[7], vals[8], vals[9] });
		}
	}
}
fn shot(eye float3, look float3) {
	s3d::view = s3d::Camera { eye: eye, target: look, up: float3 { 0.0, 1.0, 0.0 }, fov_y: fov, near: 0.05, far: 100.0 };
	if fast {
		s3d::render(big);
	} else {
		s3d::render(big);
		s3d::render(big);
		s3d::render(big);
	}
	let px = gfx::read_pixels(big);
	let n = tw * th;
	rmask.resize(n, 0.0);
	rpx.resize(n * 4, 0);
	let bw = tw * 2;
	for y in th {
		for x in tw {
			var cnt = 0;
			var s0 f32 = 0.0;
			var s1 f32 = 0.0;
			var s2 f32 = 0.0;
			for v in 2 {
				for u in 2 {
					let bi = ((2 * y + v) * bw + 2 * x + u) * 4;
					let r = px[bi] as f32;
					let g = px[bi + 1] as f32;
					let b = px[bi + 2] as f32;
					let empty = abs(r - clear_c.x) <= 1.0 && abs(g - clear_c.y) <= 1.0 && abs(b - clear_c.z) <= 1.0;
					if empty {
						s0 += bg.x;
						s1 += bg.y;
						s2 += bg.z;
					} else {
						cnt++;
						s0 += r;
						s1 += g;
						s2 += b;
					}
				}
			}
			let i = y * tw + x;
			rmask[i] = (cnt as f32) / 4.0;
			rpx[i * 4] = clamp(round((s0 / 4.0) as real), 0.0, 255.0) as byte;
			rpx[i * 4 + 1] = clamp(round((s1 / 4.0) as real), 0.0, 255.0) as byte;
			rpx[i * 4 + 2] = clamp(round((s2 / 4.0) as real), 0.0, 255.0) as byte;
			rpx[i * 4 + 3] = 255;
		}
	}
}
fn bbox(m const f32[:]) int, int, f32 {
	var y0 = -1;
	var y1 = -1;
	var sx f32 = 0.0;
	var n = 0;
	for y in th {
		for x in tw {
			if m[y * tw + x] >= 0.5 {
				if y0 < 0 { y0 = y; }
				y1 = y;
				sx += x as f32;
				n++;
			}
		}
	}
	if n == 0 { return 0, 0, 0.0; }
	return y0, y1, sx / (n as f32);
}
fn srgb_lin(c f32) real {
	let v = (c as real) / 255.0;
	if v <= 0.04045 { v / 12.92 } else { pow((v + 0.055) / 1.055, 2.4) }
}
fn lab_f(t real) real {
	if t > 0.008856 { pow(t, 1.0 / 3.0) } else { 7.787 * t + 16.0 / 116.0 }
}
fn lab(r f32, g f32, b f32) float3 {
	let lr = srgb_lin(r);
	let lg = srgb_lin(g);
	let lb = srgb_lin(b);
	let x = (0.4124564 * lr + 0.3575761 * lg + 0.1804375 * lb) / 0.95047;
	let y = 0.2126729 * lr + 0.7151522 * lg + 0.0721750 * lb;
	let z = (0.0193339 * lr + 0.1191920 * lg + 0.9503041 * lb) / 1.08883;
	let fx = lab_f(x);
	let fy = lab_f(y);
	let fz = lab_f(z);
	float3 { (116.0 * fy - 16.0) as f32, (500.0 * (fx - fy)) as f32, (200.0 * (fy - fz)) as f32 }
}
fn de2000(p float3, q float3) f32 {
	let l1 = p.x as real;
	let a1 = p.y as real;
	let b1 = p.z as real;
	let l2 = q.x as real;
	let a2 = q.y as real;
	let b2 = q.z as real;
	let rad = PI / 180.0;
	let c1 = sqrt(a1 * a1 + b1 * b1);
	let c2 = sqrt(a2 * a2 + b2 * b2);
	let cb = (c1 + c2) / 2.0;
	let cb7 = pow(cb, 7.0);
	let p25 = pow(25.0, 7.0);
	let g = 0.5 * (1.0 - sqrt(cb7 / (cb7 + p25)));
	let ap1 = (1.0 + g) * a1;
	let ap2 = (1.0 + g) * a2;
	let cp1 = sqrt(ap1 * ap1 + b1 * b1);
	let cp2 = sqrt(ap2 * ap2 + b2 * b2);
	let hp1 = if ap1 == 0.0 && b1 == 0.0 { 0.0 } else { let h = atan2(b1, ap1) / rad; if h < 0.0 { h + 360.0 } else { h } };
	let hp2 = if ap2 == 0.0 && b2 == 0.0 { 0.0 } else { let h = atan2(b2, ap2) / rad; if h < 0.0 { h + 360.0 } else { h } };
	let dl = l2 - l1;
	let dc = cp2 - cp1;
	var dh = 0.0;
	if cp1 * cp2 != 0.0 {
		dh = hp2 - hp1;
		if dh > 180.0 { dh -= 360.0; } else if dh < -180.0 { dh += 360.0; }
	}
	let dhh = 2.0 * sqrt(cp1 * cp2) * sin(dh * rad / 2.0);
	let lbar = (l1 + l2) / 2.0;
	let cbar = (cp1 + cp2) / 2.0;
	let hbar = if cp1 * cp2 == 0.0 { hp1 + hp2 } else if abs(hp1 - hp2) <= 180.0 { (hp1 + hp2) / 2.0 } else if hp1 + hp2 < 360.0 { (hp1 + hp2 + 360.0) / 2.0 } else { (hp1 + hp2 - 360.0) / 2.0 };
	let t = 1.0 - 0.17 * cos((hbar - 30.0) * rad) + 0.24 * cos(2.0 * hbar * rad) + 0.32 * cos((3.0 * hbar + 6.0) * rad) - 0.20 * cos((4.0 * hbar - 63.0) * rad);
	let hh = (hbar - 275.0) / 25.0;
	let dtheta = 30.0 * exp(-(hh * hh));
	let cbar7 = pow(cbar, 7.0);
	let rc = 2.0 * sqrt(cbar7 / (cbar7 + p25));
	let lm = (lbar - 50.0) * (lbar - 50.0);
	let sl = 1.0 + 0.015 * lm / sqrt(20.0 + lm);
	let sc = 1.0 + 0.045 * cbar;
	let sh = 1.0 + 0.015 * cbar * t;
	let rt = -sin(2.0 * dtheta * rad) * rc;
	let x1 = dl / sl;
	let x2 = dc / sc;
	let x3 = dhh / sh;
	sqrt(x1 * x1 + x2 * x2 + x3 * x3 + rt * x2 * x3) as f32
}
fn metrics(heat byte[>..]&) f32, f32, f32, f32 {
	let n = tw * th;
	heat.resize(n * 4, 0);
	var inter f32 = 0.0;
	var uni f32 = 0.0;
	var sumd f32 = 0.0;
	var cnt = 0;
	var good = 0;
	var lt f32[>..] = [];
	var lr f32[>..] = [];
	lt.resize(n, 0.0);
	lr.resize(n, 0.0);
	var x0 = tw;
	var x1 = -1;
	var y0 = th;
	var y1 = -1;
	for i in n {
		let tm = tmask[i];
		let rm = rmask[i];
		inter += min(tm, rm);
		uni += max(tm, rm);
		lt[i] = 0.299 * at(tpx, i, 0) + 0.587 * at(tpx, i, 1) + 0.114 * at(tpx, i, 2);
		lr[i] = 0.299 * at(rpx, i, 0) + 0.587 * at(rpx, i, 1) + 0.114 * at(rpx, i, 2);
		if max(tm, rm) > 0.0 {
			let x = i % tw;
			let y = i / tw;
			x0 = min(x0, x);
			x1 = max(x1, x);
			y0 = min(y0, y);
			y1 = max(y1, y);
			let d = de2000(lab(at(tpx, i, 0), at(tpx, i, 1), at(tpx, i, 2)), lab(at(rpx, i, 0), at(rpx, i, 1), at(rpx, i, 2)));
			sumd += d;
			cnt++;
			if d < 3.0 { good++; }
			heat[i * 4] = (min(d / 10.0, 1.0) * 255.0) as byte;
			heat[i * 4 + 1] = (clamp((d - 10.0) / 10.0, 0.0, 1.0) * 255.0) as byte;
			heat[i * 4 + 2] = (clamp((d - 10.0) / 10.0, 0.0, 1.0) * 255.0) as byte;
			heat[i * 4 + 3] = 255;
		} else {
			heat[i * 4] = tpx[i * 4] / 4;
			heat[i * 4 + 1] = tpx[i * 4 + 1] / 4;
			heat[i * 4 + 2] = tpx[i * 4 + 2] / 4;
			heat[i * 4 + 3] = 255;
		}
	}
	let c1 = 6.5025;
	let c2 = 58.5225;
	var ssum = 0.0;
	var wc = 0;
	var wy = y0;
	while wy + 7 <= y1 + 1 {
		var wx = x0;
		while wx + 7 <= x1 + 1 {
			var sx = 0.0;
			var sy = 0.0;
			var sxx = 0.0;
			var syy = 0.0;
			var sxy = 0.0;
			var has = false;
			for v in 7 {
				for u in 7 {
					let i = (wy + v) * tw + wx + u;
					let a = lt[i] as real;
					let b = lr[i] as real;
					sx += a;
					sy += b;
					sxx += a * a;
					syy += b * b;
					sxy += a * b;
					if max(tmask[i], rmask[i]) > 0.0 { has = true; }
				}
			}
			if has {
				let mx = sx / 49.0;
				let my = sy / 49.0;
				let vx = sxx / 49.0 - mx * mx;
				let vy = syy / 49.0 - my * my;
				let cxy = sxy / 49.0 - mx * my;
				ssum += ((2.0 * mx * my + c1) * (2.0 * cxy + c2)) / ((mx * mx + my * my + c1) * (vx + vy + c2));
				wc++;
			}
			wx += 2;
		}
		wy += 2;
	}
	let iou = if uni > 0.0 { inter / uni } else { 0.0 };
	let ssim = if wc > 0 { (ssum / (wc as real)) as f32 } else { 0.0 };
	let de = if cnt > 0 { sumd / (cnt as f32) } else { 0.0 };
	let gs = if cnt > 0 { (good as f32) / (cnt as f32) } else { 0.0 };
	return iou, ssim, de, gs;
}
var vpw f32[>..];
fn project() {
	s3d::pose(item);
	let nv = gltf::verts.len / gltf::VERTEX_FLOATS;
	vx.clear();
	vy.clear();
	vz.clear();
	vw.clear();
	vpw.clear();
	vrot.clear();
	vx.resize(nv, 0.0);
	vy.resize(nv, 0.0);
	vz.resize(nv, 0.0);
	vw.resize(nv, 0.0);
	vpw.resize(nv * 3, 0.0);
	vrot.resize(nv, linalg::Quat { 0.0, 0.0, 0.0, 1.0 });
	let view = gfx::look_at(cam_eye, cam_look, float3 { 0.0, 1.0, 0.0 });
	let tf = tan((fov as real) / 2.0) as f32;
	let aspect = (tw as f32) / (th as f32);
	let zn f32 = 0.05;
	let zf f32 = 100.0;
	let za = (zf + zn) / (zn - zf);
	let zc = 2.0 * zf * zn / (zn - zf);
	let an = gltf::assets[asset].nodes;
	for n in an.first..an.first + an.count {
		let mi = gltf::nodes[n].mesh;
		if mi < 0 { continue; }
		let skin = gltf::nodes[n].skin;
		if skin >= 0 { motion::joints(skin, pal); }
		let mesh = gltf::meshes[mi];
		for pi in mesh.prims.count {
			let prim = gltf::prims[mesh.prims.first + pi];
			for v in prim.vcount {
				let g = prim.vfirst + v;
				let o = g * gltf::VERTEX_FLOATS;
				let pos = float3 { gltf::verts[o], gltf::verts[o + 1], gltf::verts[o + 2] };
				var wp = float3 { 0.0, 0.0, 0.0 };
				if skin >= 0 {
					var bestw f32 = -1.0;
					var bestj = 0;
					for c in 4 {
						let wt = gltf::verts[o + 22 + c];
						let j = gltf::verts[o + 18 + c] as int;
						let q = linalg::point(pal[j], pos);
						wp = float3 { wp.x + wt * q.x, wp.y + wt * q.y, wp.z + wt * q.z };
						if wt > bestw {
							bestw = wt;
							bestj = j;
						}
					}
					vrot[g] = qconj(mquat(pal[bestj]));
				} else {
					wp = linalg::point(motion::world[n], pos);
					vrot[g] = qconj(mquat(motion::world[n]));
				}
				vpw[g * 3] = wp.x;
				vpw[g * 3 + 1] = wp.y;
				vpw[g * 3 + 2] = wp.z;
				let q = linalg::point(view, wp);
				let cx = q.x / (aspect * tf);
				let cy = q.y / tf;
				let cz = za * q.z + zc;
				let cw = -q.z;
				vw[g] = cw;
				if cw > 0.0 {
					vx[g] = (cx / cw * 0.5 + 0.5) * (tw as f32);
					vy[g] = (0.5 - cy / cw * 0.5) * (th as f32);
					vz[g] = cz / cw;
				}
			}
		}
	}
}
var hit_f f32[>..];
fn raster() {
	project();
	let n = tw * th;
	hit_img.clear();
	hit_u.clear();
	hit_v.clear();
	hit_f.clear();
	zb.clear();
	hit_img.resize(n, -1);
	hit_u.resize(n, 0.0);
	hit_v.resize(n, 0.0);
	hit_f.resize(n, 0.0);
	zb.resize(n, 1e30);
	let an = gltf::assets[asset].nodes;
	for ni in an.first..an.first + an.count {
		let mi = gltf::nodes[ni].mesh;
		if mi < 0 { continue; }
		let mesh = gltf::meshes[mi];
		for pi in mesh.prims.count {
			let prim = gltf::prims[mesh.prims.first + pi];
			var img = -1;
			if prim.material >= 0 {
				let m = gltf::materials[prim.material];
				if m.base_tex.texture >= 0 {
					img = gltf::textures[m.base_tex.texture].image;
				}
			}
			for t in prim.icount / 3 {
				let ga = prim.vfirst + (gltf::indices[prim.ifirst + 3 * t] as int);
				let gb = prim.vfirst + (gltf::indices[prim.ifirst + 3 * t + 1] as int);
				let gc = prim.vfirst + (gltf::indices[prim.ifirst + 3 * t + 2] as int);
				if vw[ga] <= 0.0 || vw[gb] <= 0.0 || vw[gc] <= 0.0 { continue; }
				let ax = vx[ga];
				let ay = vy[ga];
				let bx = vx[gb];
				let by = vy[gb];
				let cx = vx[gc];
				let cy = vy[gc];
				let area = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
				if abs(area) < 1e-12 { continue; }
				var facing f32 = 0.0;
				if img >= 0 {
					let p0 = float3 { vpw[ga * 3], vpw[ga * 3 + 1], vpw[ga * 3 + 2] };
					let p1 = float3 { vpw[gb * 3], vpw[gb * 3 + 1], vpw[gb * 3 + 2] };
					let p2 = float3 { vpw[gc * 3], vpw[gc * 3 + 1], vpw[gc * 3 + 2] };
					let e1 = float3 { p1.x - p0.x, p1.y - p0.y, p1.z - p0.z };
					let e2 = float3 { p2.x - p0.x, p2.y - p0.y, p2.z - p0.z };
					let cr = float3 { e1.y * e2.z - e1.z * e2.y, e1.z * e2.x - e1.x * e2.z, e1.x * e2.y - e1.y * e2.x };
					let cl = sqrt((cr.x * cr.x + cr.y * cr.y + cr.z * cr.z) as real);
					if cl >= 1e-12 {
						let nn = linalg::unit3(cr);
						let ct = float3 { (p0.x + p1.x + p2.x) / 3.0, (p0.y + p1.y + p2.y) / 3.0, (p0.z + p1.z + p2.z) / 3.0 };
						let vd = linalg::unit3(float3 { cam_eye.x - ct.x, cam_eye.y - ct.y, cam_eye.z - ct.z });
						facing = abs(nn.x * vd.x + nn.y * vd.y + nn.z * vd.z);
					}
				}
				let minx = min(min(ax, bx), cx) as real;
				let maxx = max(max(ax, bx), cx) as real;
				let miny = min(min(ay, by), cy) as real;
				let maxy = max(max(ay, by), cy) as real;
				let x0 = max(0, floor(minx - 0.5) as int);
				let x1 = min(tw - 1, ceil(maxx - 0.5) as int);
				let y0 = max(0, floor(miny - 0.5) as int);
				let y1 = min(th - 1, ceil(maxy - 0.5) as int);
				let oa = ga * gltf::VERTEX_FLOATS;
				let ob = gb * gltf::VERTEX_FLOATS;
				let oc = gc * gltf::VERTEX_FLOATS;
				for y in y0..y1 + 1 {
					for x in x0..x1 + 1 {
						let qx = (x as f32) + 0.5;
						let qy = (y as f32) + 0.5;
						let w0 = ((cx - bx) * (qy - by) - (cy - by) * (qx - bx)) / area;
						let w1 = ((ax - cx) * (qy - cy) - (ay - cy) * (qx - cx)) / area;
						let w2 = 1.0 - w0 - w1;
						if w0 < 0.0 || w1 < 0.0 || w2 < 0.0 { continue; }
						let z = w0 * vz[ga] + w1 * vz[gb] + w2 * vz[gc];
						let i = y * tw + x;
						if z >= zb[i] { continue; }
						if img >= 0 {
							let u = w0 * gltf::verts[oa + 6] + w1 * gltf::verts[ob + 6] + w2 * gltf::verts[oc + 6];
							let v = w0 * gltf::verts[oa + 7] + w1 * gltf::verts[ob + 7] + w2 * gltf::verts[oc + 7];
							if gltf::pixels[texel(img, u, v) + 3] >= 128 {
								zb[i] = z;
								hit_img[i] = img;
								hit_u[i] = u;
								hit_v[i] = v;
								hit_f[i] = facing;
							}
						} else {
							zb[i] = z;
						}
					}
				}
			}
		}
	}
}
fn texel(img int, u f32, v f32) int {
	let im = gltf::images[img];
	let w = im.width as real;
	let h = im.height as real;
	let fu = (u as real) - floor(u as real);
	let fv = (v as real) - floor(v as real);
	let x = clamp(floor(fu * w), 0.0, w - 1.0) as int;
	let y = clamp(floor(fv * h), 0.0, h - 1.0) as int;
	im.pixels.first + (y * im.width + x) * 4
}
fn lin(c f32) f32 {
	let v = (c as real) / 255.0;
	(if v <= 0.04045 { v / 12.92 } else { pow((v + 0.055) / 1.055, 2.4) }) as f32
}
fn enc(l f32) f32 {
	let v = l as real;
	(255.0 * (if v <= 0.0031308 { v * 12.92 } else { 1.055 * pow(v, 1.0 / 2.4) - 0.055 })) as f32
}
var pf_v int[>..];
var pf_p int[>..];
fn pf_used(img int) bool {
	for m in gltf::materials.len {
		let t = gltf::materials[m].base_tex.texture;
		if t >= 0 && gltf::textures[t].image == img { return true; }
	}
	return false;
}
fn pf_std(img int) f32 {
	let im = gltf::images[img];
	let px = gltf::image_pixels(img);
	let n = im.width * im.height;
	var s = 0.0;
	var s2 = 0.0;
	var c = 0;
	var i = 0;
	while i < n {
		let l = (0.299 * (px[i * 4] as real) + 0.587 * (px[i * 4 + 1] as real) + 0.114 * (px[i * 4 + 2] as real)) / 255.0;
		s += l;
		s2 += l * l;
		c++;
		i += 7;
	}
	if c == 0 { return 0.0; }
	let mean = s / (c as real);
	let v = max(s2 / (c as real) - mean * mean, 0.0);
	sqrt(v) as f32
}
fn pf_apply(img int, du f32, dv f32, ds f32) {
	for m in gltf::materials.len {
		let t = gltf::materials[m].base_tex.texture;
		if t >= 0 && gltf::textures[t].image == img {
			gltf::materials[m].base_tex.o = float2 { du, dv };
			gltf::materials[m].base_tex.m = float4 { 1.0 + ds, 0.0, 0.0, 1.0 + ds };
		}
	}
}
fn pf_cost(img int, du f32, dv f32, ds f32) f32 {
	pf_apply(img, du, dv, ds);
	var curv = -1;
	var sum = 0.0;
	for q in pf_p.len {
		if pf_v[q] != curv {
			curv = pf_v[q];
			use_view(curv);
			shot(cam_eye, cam_look);
		}
		let i = pf_p[q];
		sum += de2000(lab(at(tpx, i, 0), at(tpx, i, 1), at(tpx, i, 2)), lab(at(rpx, i, 0), at(rpx, i, 1), at(rpx, i, 2))) as real;
	}
	(sum / (pf_p.len as real)) as f32
}
fn pf_bake(img int, du f32, dv f32, ds f32) {
	let im = gltf::images[img];
	let w = im.width;
	let h = im.height;
	let wr = w as real;
	let hr = h as real;
	let src = gltf::image_pixels(img);
	var cp byte[>..] = [];
	cp.resize(w * h * 4, 0);
	for y in h {
		for x in w {
			let fu = (((x as real) + 0.5) / wr) * (1.0 + (ds as real)) + (du as real);
			let fv = (((y as real) + 0.5) / hr) * (1.0 + (ds as real)) + (dv as real);
			let u = fu - floor(fu);
			let v = fv - floor(fv);
			let fx = u * wr - 0.5;
			let fy = v * hr - 0.5;
			let x0r = floor(fx);
			let y0r = floor(fy);
			let ax = fx - x0r;
			let ay = fy - y0r;
			let x0 = (x0r as int) % w;
			let x1 = (x0 + 1) % w;
			let y0 = (y0r as int) % h;
			let y1 = (y0 + 1) % h;
			for c in 4 {
				let p00 = src[(y0 * w + x0) * 4 + c] as real;
				let p10 = src[(y0 * w + x1) * 4 + c] as real;
				let p01 = src[(y1 * w + x0) * 4 + c] as real;
				let p11 = src[(y1 * w + x1) * 4 + c] as real;
				let val = (p00 * (1.0 - ax) + p10 * ax) * (1.0 - ay) + (p01 * (1.0 - ax) + p11 * ax) * ay;
				cp[(y * w + x) * 4 + c] = clamp(round(val), 0.0, 255.0) as byte;
			}
		}
	}
	for i in w * h * 4 {
		gltf::pixels[im.pixels.first + i] = cp[i];
	}
	img_changed[img] = 1;
	if img < s3d::tex_srgb.len {
		if s3d::tex_srgb[img].id != 0 {
			gfx::update_texture(s3d::tex_srgb[img], gltf::image_pixels(img));
			gfx::generate_mips(s3d::tex_srgb[img]);
		}
	}
}
fn pattern_fit() {
	if img_changed.len < gltf::images.len { img_changed.resize(gltf::images.len, 0); }
	let lims f32[3] = [0.15, 0.15, 0.1];
	let steps f32[3] = [0.02, 0.007, 0.002];
	let n = tw * th;
	for img in gltf::images.len {
		if !pf_used(img) { continue; }
		if pf_std(img) <= 0.08 { continue; }
		pf_v.clear();
		pf_p.clear();
		for k in nview {
			use_view(k);
			shot(cam_eye, cam_look);
			raster();
			for i in n {
				if hit_img[i] == img && tmask[i] == 1.0 && rmask[i] == 1.0 {
					pf_v.push(k);
					pf_p.push(i);
				}
			}
		}
		if pf_p.len < 2000 { continue; }
		var p f32[3] = [0.0, 0.0, 0.0];
		var best = pf_cost(img, 0.0, 0.0, 0.0);
		let before = best;
		for st in steps {
			for j in 3 {
				var rep = 0;
				var go = true;
				while go && rep < 7 {
					go = false;
					rep++;
					for sgn in 2 {
						let sg f32 = if sgn == 0 { 1.0 } else { -1.0 };
						var q = p;
						q[j] += sg * st;
						if abs(q[j]) > lims[j] { continue; }
						let c = pf_cost(img, q[0], q[1], q[2]);
						if c < best {
							best = c;
							p = q;
							go = true;
							break;
						}
					}
				}
			}
		}
		pf_apply(img, 0.0, 0.0, 0.0);
		var o byte[>..] = [];
		format(o, "pattern ", img, " du ");
		f4(o, p[0]);
		format(o, " dv ");
		f4(o, p[1]);
		format(o, " ds ");
		f4(o, p[2]);
		format(o, " de ");
		f4(o, before);
		format(o, " -> ");
		f4(o, best);
		print(o);
		if p[0] != 0.0 || p[1] != 0.0 || p[2] != 0.0 {
			pf_bake(img, p[0], p[1], p[2]);
		}
	}
}
fn view_gain() {
	if nview < 2 { return; }
	let n = tw * th;
	for k in 1..nview {
		if v_fix[k] { continue; }
		use_view(k);
		shot(cam_eye, cam_look);
		var ts real[3] = [0.0, 0.0, 0.0];
		var rs real[3] = [0.0, 0.0, 0.0];
		var cnt = 0;
		for i in n {
			if tmask[i] == 1.0 && rmask[i] == 1.0 {
				cnt++;
				for c in 3 {
					ts[c] += lin(at(tpx, i, c)) as real;
					rs[c] += lin(at(rpx, i, c)) as real;
				}
			}
		}
		if cnt < 2000 { continue; }
		var g f32[3] = [1.0, 1.0, 1.0];
		for c in 3 {
			g[c] = clamp(rs[c] / max(ts[c], 1e-9), 0.5, 2.0) as f32;
		}
		let base = k * n * 4;
		for i in n {
			for c in 3 {
				let o = base + i * 4 + c;
				let l = clamp(lin(v_px[o] as f32) * g[c], 0.0, 1.0);
				v_px[o] = clamp(round(enc(l) as real), 0.0, 255.0) as byte;
			}
		}
		var o byte[>..] = [];
		format(o, "gain ", k, " ");
		f4(o, g[0]);
		format(o, " ");
		f4(o, g[1]);
		format(o, " ");
		f4(o, g[2]);
		print(o);
	}
}
var mat_changed = false;
var mf_r0 f32[>..];
var mf_n0 f32[>..];
fn mf_apply(img int, fr f32, fnn f32) {
	for m in gltf::materials.len {
		let t = gltf::materials[m].base_tex.texture;
		if t >= 0 && gltf::textures[t].image == img {
			gltf::materials[m].roughness = if fr == 1.0 { mf_r0[m] } else { clamp(mf_r0[m] * fr, 0.04, 1.0) };
			gltf::materials[m].normal_scale = mf_n0[m] * fnn;
		}
	}
}
fn mf_eval() f32 {
	var curv = -1;
	var sum = 0.0;
	for q in pf_p.len {
		if pf_v[q] != curv {
			curv = pf_v[q];
			use_view(curv);
			shot(cam_eye, cam_look);
		}
		let i = pf_p[q];
		sum += de2000(lab(at(tpx, i, 0), at(tpx, i, 1), at(tpx, i, 2)), lab(at(rpx, i, 0), at(rpx, i, 1), at(rpx, i, 2))) as real;
	}
	(sum / (pf_p.len as real)) as f32
}
fn material_fit() {
	let nm = gltf::materials.len;
	mf_r0.clear();
	mf_n0.clear();
	for m in nm {
		mf_r0.push(gltf::materials[m].roughness);
		mf_n0.push(gltf::materials[m].normal_scale);
	}
	let n = tw * th;
	for img in gltf::images.len {
		if !pf_used(img) { continue; }
		pf_v.clear();
		pf_p.clear();
		for k in nview {
			use_view(k);
			shot(cam_eye, cam_look);
			raster();
			for i in n {
				if hit_img[i] == img && tmask[i] == 1.0 && rmask[i] == 1.0 {
					pf_v.push(k);
					pf_p.push(i);
				}
			}
		}
		if pf_p.len < 2000 { continue; }
		var p f32[2] = [1.0, 1.0];
		mf_apply(img, 1.0, 1.0);
		var best = mf_eval();
		let before = best;
		for pass in 2 {
			let sf f32 = if pass == 0 { 1.3 } else { 1.1 };
			let sn f32 = if pass == 0 { 0.3 } else { 0.1 };
			for j in 2 {
				var rep = 0;
				var go = true;
				while go && rep < 7 {
					go = false;
					rep++;
					for sgn in 2 {
						var q = p;
						if j == 0 {
							q[0] = if sgn == 0 { p[0] * sf } else { p[0] / sf };
						} else {
							q[1] = if sgn == 0 { p[1] + sn } else { p[1] - sn };
						}
						if q[0] < 0.7 || q[0] > 1.4 || q[1] < 0.0 || q[1] > 2.0 { continue; }
						mf_apply(img, q[0], q[1]);
						let c = mf_eval();
						if c < best {
							best = c;
							p = q;
							go = true;
							break;
						}
					}
				}
			}
		}
		mf_apply(img, p[0], p[1]);
		if p[0] != 1.0 || p[1] != 1.0 { mat_changed = true; }
		var rr f32 = 0.0;
		var nn f32 = 0.0;
		var found = false;
		for m in nm {
			let t = gltf::materials[m].base_tex.texture;
			if !found && t >= 0 && gltf::textures[t].image == img {
				found = true;
				rr = gltf::materials[m].roughness;
				nn = gltf::materials[m].normal_scale;
			}
		}
		var o byte[>..] = [];
		format(o, "material ", img, " rough ");
		f4(o, rr);
		format(o, " nscale ");
		f4(o, nn);
		format(o, " de ");
		f4(o, before);
		format(o, " -> ");
		f4(o, best);
		print(o);
	}
}
fn pg_ratio(i int) float3 {
	let tr = lin(at(tpx, i, 0));
	let tg = lin(at(tpx, i, 1));
	let tb = lin(at(tpx, i, 2));
	let rr = lin(at(rpx, i, 0));
	let rg = lin(at(rpx, i, 1));
	let rb = lin(at(rpx, i, 2));
	let r0 = clamp((tr + 0.004) / (rr + 0.004), 0.25, 4.0);
	let g0 = clamp((tg + 0.004) / (rg + 0.004), 0.25, 4.0);
	let b0 = clamp((tb + 0.004) / (rb + 0.004), 0.25, 4.0);
	let yt = 0.2126 * tr + 0.7152 * tg + 0.0722 * tb;
	let yr = 0.2126 * rr + 0.7152 * rg + 0.0722 * rb;
	let lr = clamp((yt + 0.004) / (yr + 0.004), 0.25, 4.0);
	float3 {
		lr * sq(clamp(r0 / lr, 0.5, 2.0)),
		lr * sq(clamp(g0 / lr, 0.5, 2.0)),
		lr * sq(clamp(b0 / lr, 0.5, 2.0))
	}
}
fn pg_lum(i int) f32 {
	0.2126 * lin(at(tpx, i, 0)) + 0.7152 * lin(at(tpx, i, 1)) + 0.0722 * lin(at(tpx, i, 2))
}
fn pg_edge(i int) bool {
	let x = i % tw;
	let y = i / tw;
	if x == 0 || y == 0 || x == tw - 1 || y == th - 1 { return true; }
	let e = abs(pg_lum(i - 1) - pg_lum(i + 1)) + abs(pg_lum(i - tw) - pg_lum(i + tw));
	e > 0.15
}
fn pg_integral(src real[:], out real[>..]&) {
	let w1 = tw + 1;
	out.clear();
	out.resize(w1 * (th + 1), 0.0);
	for y in th {
		for x in tw {
			out[(y + 1) * w1 + x + 1] = src[y * tw + x] + out[y * w1 + x + 1] + out[(y + 1) * w1 + x] - out[y * w1 + x];
		}
	}
}
fn pg_box(ig real[:], x0 int, y0 int, x1 int, y1 int) real {
	let w1 = tw + 1;
	ig[y1 * w1 + x1] - ig[y0 * w1 + x1] - ig[y1 * w1 + x0] + ig[y0 * w1 + x0]
}
fn paint_gather() {
	raster();
	let n = tw * th;
	let detail = cur != 0 && !v_fix[cur];
	for i in n {
		let im = hit_img[i];
		if im >= 0 && g_off[im] < 0 {
			let img = gltf::images[im];
			let gw = (img.width + pcell - 1) / pcell;
			let gh = (img.height + pcell - 1) / pcell;
			g_off[im] = g_r.len;
			g_w[im] = gw;
			g_r.resize(g_r.len + gw * gh, 0.0);
			g_g.resize(g_g.len + gw * gh, 0.0);
			g_b.resize(g_b.len + gw * gh, 0.0);
			g_c.resize(g_c.len + gw * gh, 0);
		}
	}
	var ok byte[>..] = [];
	ok.resize(n, 0);
	var rat float3[>..] = [];
	rat.resize(n, float3 { 1.0, 1.0, 1.0 });
	for i in n {
		if tmask[i] != 1.0 || rmask[i] != 1.0 || hit_img[i] < 0 { continue; }
		if hit_f[i] < 0.5 { continue; }
		let tx = texel(hit_img[i], hit_u[i], hit_v[i]);
		if gltf::pixels[tx + 3] < 230 { continue; }
		let x = i % tw;
		let y = i / tw;
		var same = true;
		for dy in -2..3 {
			for dx in -2..3 {
				let xx = x + dx;
				let yy = y + dy;
				if xx >= 0 && xx < tw && yy >= 0 && yy < th {
					if hit_img[yy * tw + xx] != hit_img[i] { same = false; }
				}
			}
		}
		if !same { continue; }
		if pcell == 1 && pg_edge(i) { continue; }
		ok[i] = 1;
		rat[i] = pg_ratio(i);
	}
	var ir real[>..] = [];
	var ig real[>..] = [];
	var ib real[>..] = [];
	var ic real[>..] = [];
	if detail {
		var sr real[>..] = [];
		var sg real[>..] = [];
		var sb real[>..] = [];
		var sc real[>..] = [];
		sr.resize(n, 0.0);
		sg.resize(n, 0.0);
		sb.resize(n, 0.0);
		sc.resize(n, 0.0);
		for i in n {
			if ok[i] != 0 {
				sr[i] = rat[i].x as real;
				sg[i] = rat[i].y as real;
				sb[i] = rat[i].z as real;
				sc[i] = 1.0;
			}
		}
		pg_integral(sr, ir);
		pg_integral(sg, ig);
		pg_integral(sb, ib);
		pg_integral(sc, ic);
	}
	for i in n {
		if ok[i] == 0 { continue; }
		var r = rat[i];
		if detail {
			let x = i % tw;
			let y = i / tw;
			let x0 = max(0, x - 15);
			let y0 = max(0, y - 15);
			let x1 = min(tw - 1, x + 15) + 1;
			let y1 = min(th - 1, y + 15) + 1;
			let c = pg_box(ic, x0, y0, x1, y1);
			if c < 50.0 { continue; }
			let mr = (pg_box(ir, x0, y0, x1, y1) / c) as f32;
			let mg = (pg_box(ig, x0, y0, x1, y1) / c) as f32;
			let mb = (pg_box(ib, x0, y0, x1, y1) / c) as f32;
			r = float3 { clamp(r.x / mr, 0.5, 2.0), clamp(r.y / mg, 0.5, 2.0), clamp(r.z / mb, 0.5, 2.0) };
		}
		let im = hit_img[i];
		let img = gltf::images[im];
		let gw = g_w[im];
		let gh = (img.height + pcell - 1) / pcell;
		let u = hit_u[i] as real;
		let v = hit_v[i] as real;
		let fu = u - floor(u);
		let fv = v - floor(v);
		let cx = clamp(floor(fu * (img.width as real) / (pcell as real)) as int, 0, gw - 1);
		let cy = clamp(floor(fv * (img.height as real) / (pcell as real)) as int, 0, gh - 1);
		let ci = g_off[im] + cy * gw + cx;
		let wt = pow(hit_f[i] as real, 7.0) * (if v_fix[cur] { 4.0 } else { 1.0 });
		let cw = max(1, round(wt * 16.0) as int);
		let cwf = cw as f32;
		g_r[ci] += r.x * cwf;
		g_g[ci] += r.y * cwf;
		g_b[ci] += r.z * cwf;
		g_c[ci] += cw;
	}
}
var g_abs byte[>..];
fn paint(fine bool) int {
	let ni = gltf::images.len;
	g_off.clear();
	g_off.resize(ni, -1);
	g_w.clear();
	g_w.resize(ni, 0);
	g_r.clear();
	g_g.clear();
	g_b.clear();
	g_c.clear();
	g_abs.clear();
	img_changed.clear();
	img_changed.resize(ni, 0);
	for pass in 2 {
		for k in nview {
			if fine && !v_fix[k] { continue; }
			let absv = k == 0 || v_fix[k];
			if (pass == 0) != absv { continue; }
			use_view(k);
			shot(cam_eye, cam_look);
			var o_r f32[>..] = [];
			var o_g f32[>..] = [];
			var o_b f32[>..] = [];
			var o_c int[>..] = [];
			o_r.append(g_r);
			o_g.append(g_g);
			o_b.append(g_b);
			o_c.append(g_c);
			let old = o_c.len;
			paint_gather();
			g_abs.resize(g_c.len, 0);
			for i in g_c.len {
				let before = if i < old { o_c[i] } else { 0 };
				if absv {
					if g_c[i] != before { g_abs[i] = 1; }
				} else if g_abs[i] != 0 {
					if i < old {
						g_r[i] = o_r[i];
						g_g[i] = o_g[i];
						g_b[i] = o_b[i];
						g_c[i] = o_c[i];
					} else {
						g_r[i] = 0.0;
						g_g[i] = 0.0;
						g_b[i] = 0.0;
						g_c[i] = 0;
					}
				}
			}
		}
	}
	var changed = 0;
	let dxs int[4] = [1, -1, 0, 0];
	let dys int[4] = [0, 0, 1, -1];
	for im in ni {
		if g_off[im] < 0 { continue; }
		let img = gltf::images[im];
		let gw = g_w[im];
		let gh = (img.height + pcell - 1) / pcell;
		let off = g_off[im];
		let cells = gw * gh;
		var sl f32[>..] = [];
		var sg f32[>..] = [];
		var sb f32[>..] = [];
		var ss f32[>..] = [];
		sl.resize(cells, 0.0);
		sg.resize(cells, 0.0);
		sb.resize(cells, 0.0);
		ss.resize(cells, 0.0);
		for i in cells {
			let c = g_c[off + i];
			if c > 0 {
				let cf = c as f32;
				sl[i] = log((g_r[off + i] / cf) as real) as f32;
				sg[i] = log((g_g[off + i] / cf) as real) as f32;
				sb[i] = log((g_b[off + i] / cf) as real) as f32;
				ss[i] = 1.0;
			}
		}
		for round in 7 {
			var nl f32[>..] = [];
			var ng f32[>..] = [];
			var nb f32[>..] = [];
			var ns f32[>..] = [];
			nl.append(sl);
			ng.append(sg);
			nb.append(sb);
			ns.append(ss);
			for cy in gh {
				for cx in gw {
					let i = cy * gw + cx;
					if g_c[off + i] != 0 { continue; }
					var al f32 = 0.0;
					var ag f32 = 0.0;
					var ab f32 = 0.0;
					var as_ f32 = 0.0;
					var cnt = 0;
					for d in 4 {
						let x = cx + dxs[d];
						let y = cy + dys[d];
						if x < 0 || y < 0 || x >= gw || y >= gh { continue; }
						let j = y * gw + x;
						if ss[j] > 0.0 {
							al += ss[j] * sl[j];
							ag += ss[j] * sg[j];
							ab += ss[j] * sb[j];
							as_ += ss[j];
							cnt++;
						}
					}
					if cnt > 0 {
						nl[i] = al / as_;
						ng[i] = ag / as_;
						nb[i] = ab / as_;
						ns[i] = 0.7 * as_ / (cnt as f32);
					}
				}
			}
			for i in cells {
				sl[i] = nl[i];
				sg[i] = ng[i];
				sb[i] = nb[i];
				ss[i] = ns[i];
			}
		}
		for cy in gh {
			for cx in gw {
				let i = cy * gw + cx;
				let s = ss[i];
				if s <= 0.01 { continue; }
				changed++;
				var fk f32[3] = [1.0, 1.0, 1.0];
				fk[0] = exp((0.8 * s * sl[i]) as real) as f32;
				fk[1] = exp((0.8 * s * sg[i]) as real) as f32;
				fk[2] = exp((0.8 * s * sb[i]) as real) as f32;
				let x1 = min(img.width, (cx + 1) * pcell);
				let y1 = min(img.height, (cy + 1) * pcell);
				for y in cy * pcell..y1 {
					for x in cx * pcell..x1 {
						let o = img.pixels.first + (y * img.width + x) * 4;
						for c in 3 {
							let l = clamp(lin(gltf::pixels[o + c] as f32) * fk[c], 0.0, 1.0);
							gltf::pixels[o + c] = clamp(round(enc(l) as real), 0.0, 255.0) as byte;
						}
					}
				}
				img_changed[im] = 1;
			}
		}
	}
	for im in ni {
		if img_changed[im] == 0 { continue; }
		if im < s3d::tex_srgb.len {
			if s3d::tex_srgb[im].id != 0 {
				gfx::update_texture(s3d::tex_srgb[im], gltf::image_pixels(im));
				gfx::generate_mips(s3d::tex_srgb[im]);
			}
		}
	}
	return changed;
}
var pose_t float3[>..];
var pose_r linalg::Quat[>..];
var pose_s float3[>..];
fn f4(out byte[>..]&, v f32) {
	format_flt(out, v as real, 4);
}
fn fl(out byte[>..]&, v f32) {
	out.push(' ');
	format_flt(out, v as real, 6);
}
fn qconj(q linalg::Quat) linalg::Quat {
	linalg::Quat { -q.x, -q.y, -q.z, q.w }
}
fn sq(v f32) f32 {
	sqrt(v as real) as f32
}
fn col(m gfx::mat4, x f32, y f32, z f32) float3 {
	let o = linalg::point(m, float3 { 0.0, 0.0, 0.0 });
	let p = linalg::point(m, float3 { x, y, z });
	linalg::unit3(float3 { p.x - o.x, p.y - o.y, p.z - o.z })
}
fn mquat(m gfx::mat4) linalg::Quat {
	let c0 = col(m, 1.0, 0.0, 0.0);
	let c1 = col(m, 0.0, 1.0, 0.0);
	let c2 = col(m, 0.0, 0.0, 1.0);
	let m00 = c0.x;
	let m10 = c0.y;
	let m20 = c0.z;
	let m01 = c1.x;
	let m11 = c1.y;
	let m21 = c1.z;
	let m02 = c2.x;
	let m12 = c2.y;
	let m22 = c2.z;
	let tr = m00 + m11 + m22;
	if tr > 0.0 {
		let s = sq(tr + 1.0) * 2.0;
		return linalg::Quat { (m21 - m12) / s, (m02 - m20) / s, (m10 - m01) / s, 0.25 * s };
	}
	if m00 > m11 && m00 > m22 {
		let s = sq(1.0 + m00 - m11 - m22) * 2.0;
		return linalg::Quat { 0.25 * s, (m01 + m10) / s, (m02 + m20) / s, (m21 - m12) / s };
	}
	if m11 > m22 {
		let s = sq(1.0 + m11 - m00 - m22) * 2.0;
		return linalg::Quat { (m01 + m10) / s, 0.25 * s, (m12 + m21) / s, (m02 - m20) / s };
	}
	let s = sq(1.0 + m22 - m00 - m11) * 2.0;
	return linalg::Quat { (m02 + m20) / s, (m12 + m21) / s, 0.25 * s, (m10 - m01) / s };
}
fn angle_of(node int) f32 {
	var a f32 = 0.0;
	for k in pose_n.len { if pose_n[k] == node { a = pose_a[k]; } }
	a
}
fn turn(node int, ang f32) {
	let n = gltf::nodes[node];
	let p = n.parent;
	var axis = float3 { 0.0, 0.0, 1.0 };
	if p >= 0 {
		axis = linalg::unit3(linalg::qrotate(qconj(mquat(motion::world[p])), float3 { 0.0, 0.0, 1.0 }));
	}
	let r = linalg::qnorm(linalg::qmul(linalg::qaxis(axis, ang), n.r));
	s3d::set_node(item, node, n.t, r, n.s);
	var k = -1;
	for i in pose_n.len { if pose_n[i] == node { k = i; } }
	if k >= 0 {
		pose_a[k] = ang;
		pose_t[k] = n.t;
		pose_r[k] = r;
		pose_s[k] = n.s;
	} else {
		pose_n.push(node);
		pose_a.push(ang);
		pose_t.push(n.t);
		pose_r.push(r);
		pose_s.push(n.s);
	}
}
fn score() f32 {
	if nview == 0 { return 0.0; }
	var total f32 = 0.0;
	for k in nview {
		use_view(k);
		shot(cam_eye, cam_look);
		var inter f32 = 0.0;
		var uni f32 = 0.0;
		for i in tw * th {
			inter += min(tmask[i], rmask[i]);
			uni += max(tmask[i], rmask[i]);
		}
		let v f32 = if uni > 0.0 { inter / uni } else { 0.0 };
		total += v;
	}
	total / (nview as f32)
}
fn joint_name(i int) const byte[:] {
	match i {
		0 => "upperarm_l",
		1 => "upperarm_r",
		2 => "lowerarm_l",
		3 => "lowerarm_r",
		4 => "thigh_l",
		5 => "thigh_r",
		6 => "calf_l",
		_ => "calf_r",
	}
}
fn pose_fit() {
	fast = true;
	s3d::pose(item);
	let steps f32[5] = [0.28, 0.14, 0.07, 0.035, 0.014];
	for pass in 2 {
		for j in 8 {
			let node = gltf::find_node(asset, joint_name(j));
			if node < 0 { continue; }
			var a0 = angle_of(node);
			var best = score();
			for st in steps {
				turn(node, a0 + st);
				let s1 = score();
				turn(node, a0 - st);
				let s2 = score();
				if s1 > best && s1 >= s2 {
					a0 += st;
					best = s1;
				} else if s2 > best {
					a0 -= st;
					best = s2;
				}
				turn(node, a0);
			}
		}
	}
	fast = false;
	var o byte[>..] = [];
	format(o, "pose");
	for j in 8 {
		let node = gltf::find_node(asset, joint_name(j));
		if node < 0 { continue; }
		format(o, " ", joint_name(j), " ");
		f4(o, angle_of(node));
	}
	print(o);
}
fn save_pose(path const byte[:]) {
	var o byte[>..] = [];
	for k in pose_n.len {
		var nm const byte[:] = "";
		for j in 8 {
			if gltf::find_node(asset, joint_name(j)) == pose_n[k] { nm = joint_name(j); }
		}
		o.append(nm);
		fl(o, pose_t[k].x);
		fl(o, pose_t[k].y);
		fl(o, pose_t[k].z);
		fl(o, pose_r[k].x);
		fl(o, pose_r[k].y);
		fl(o, pose_r[k].z);
		fl(o, pose_r[k].w);
		fl(o, pose_s[k].x);
		fl(o, pose_s[k].y);
		fl(o, pose_s[k].z);
		o.push('\n');
	}
	write_file(path, o);
}
fn tm_at(px int, py int) f32 {
	if px < 0 || py < 0 || px >= tw || py >= th { return 0.0; }
	tmask[py * tw + px]
}
fn sm_at(px int, py int) f32 {
	sm[clamp(py, 0, th - 1) * tw + clamp(px, 0, tw - 1)]
}
fn shape_gather() {
	shot(cam_eye, cam_look);
	raster();
	let n = tw * th;
	sm.clear();
	sm.resize(n, 0.0);
	for y in th {
		for x in tw {
			var s f32 = 0.0;
			var c = 0;
			for dy in -2..3 {
				for dx in -2..3 {
					let xx = x + dx;
					let yy = y + dy;
					if xx >= 0 && xx < tw && yy >= 0 && yy < th {
						s += rmask[yy * tw + xx];
						c++;
					}
				}
			}
			sm[y * tw + x] = s / (c as f32);
		}
	}
	let wpp = (2.0 * (v_d[cur] as real) * tan((fov as real) / 2.0) / (th as real)) as f32;
	let rv = right_of(cur);
	for g in vx.len {
		if vw[g] <= 0.0 { continue; }
		let px = floor(vx[g] as real) as int;
		let py = floor(vy[g] as real) as int;
		if px < 0 || py < 0 || px >= tw || py >= th { continue; }
		let i = py * tw + px;
		if vz[g] > zb[i] + 0.0005 { continue; }
		if rmask[i] < 0.5 { continue; }
		var edge = false;
		for dy in -2..3 {
			for dx in -2..3 {
				let xx = px + dx;
				let yy = py + dy;
				if xx >= 0 && xx < tw && yy >= 0 && yy < th {
					if rmask[yy * tw + xx] < 0.5 { edge = true; }
				}
			}
		}
		if !edge { continue; }
		let gx = (sm_at(px + 1, py) - sm_at(px - 1, py)) / 2.0;
		let gy = (sm_at(px, py + 1) - sm_at(px, py - 1)) / 2.0;
		let gl = sq(gx * gx + gy * gy);
		if gl < 0.01 { continue; }
		let nx = -gx / gl;
		let ny = -gy / gl;
		let inside = tm_at(px, py) >= 0.5;
		var offset f32 = 0.0;
		var found = false;
		var s = 1;
		while s <= 40 && !found {
			let qx = floor((vx[g] + nx * (s as f32)) as real) as int;
			let qy = floor((vy[g] + ny * (s as f32)) as real) as int;
			let t = tm_at(qx, qy);
			if inside {
				if t < 0.5 {
					offset = (s as f32) - 0.5;
					found = true;
				}
			} else {
				if t >= 0.5 {
					offset = 0.5 - (s as f32);
					found = true;
				}
			}
			s++;
		}
		if !found { continue; }
		let k = 0.7 * offset * wpp;
		let wm = float3 { rv.x * nx * k, (rv.y * nx - ny) * k, rv.z * nx * k };
		let o = g * gltf::VERTEX_FLOATS;
		c_p.push(float3 { gltf::verts[o], gltf::verts[o + 1], gltf::verts[o + 2] });
		c_m.push(linalg::qrotate(vrot[g], wm));
	}
}
fn shape_fit(round int) int {
	c_p.clear();
	c_m.clear();
	for k in nview {
		if v_fix[k] { continue; }
		use_view(k);
		shape_gather();
	}
	let sigma real = 0.035;
	let r3 = (3.0 * sigma) * (3.0 * sigma);
	let den = 2.0 * sigma * sigma;
	let nc = c_p.len;
	let am = gltf::assets[asset].meshes;
	for mi in am.first..am.first + am.count {
		let mesh = gltf::meshes[mi];
		for pi in mesh.prims.count {
			let prim = gltf::prims[mesh.prims.first + pi];
			for v in prim.vcount {
				let o = (prim.vfirst + v) * gltf::VERTEX_FLOATS;
				let px = gltf::verts[o];
				let py = gltf::verts[o + 1];
				let pz = gltf::verts[o + 2];
				var sw real = 0.0;
				var mx real = 0.0;
				var my real = 0.0;
				var mz real = 0.0;
				for c in nc {
					let dx = (px - c_p[c].x) as real;
					let dy = (py - c_p[c].y) as real;
					let dz = (pz - c_p[c].z) as real;
					let d2 = dx * dx + dy * dy + dz * dz;
					if d2 > r3 { continue; }
					let w = exp(-d2 / den);
					sw += w;
					mx += w * (c_m[c].x as real);
					my += w * (c_m[c].y as real);
					mz += w * (c_m[c].z as real);
				}
				if sw > 0.0 {
					let dv = max(sw, 1.0);
					gltf::verts[o] = px + (mx / dv) as f32;
					gltf::verts[o + 1] = py + (my / dv) as f32;
					gltf::verts[o + 2] = pz + (mz / dv) as f32;
				}
			}
		}
	}
	s3d::uploaded_verts = -2;
	shape_changed = true;
	return nc;
}
fn set_lights() {
	let ca = atan2((cam_eye.x - cam_look.x) as real, (cam_eye.z - cam_look.z) as real) as f32;
	let cs = cos(ca as real) as f32;
	let sn = sin(ca as real) as f32;
	fn rot(x f32, y f32, z f32) float3 {
		float3 { x * cs + z * sn, y, -x * sn + z * cs }
	}
	let k = 2.2 * key_k;
	s3d::sun = s3d::Sun { to_sun: linalg::unit3(rot(0.35 + sun_az, 0.8 + sun_el, 1.0)), rgb: float3 { k, k, k }, shadows: true, shadow_far: 10.0, map_size: 2048 };
	s3d::lights.clear();
	let fl = 260.0 * fill_k;
	s3d::add_light(rot(-14.0, 7.0, 14.0), float3 { fl, fl, fl }, 1000.0);
	s3d::sky.ambient = amb_k;
}
fn tone() f32 {
	var total f32 = 0.0;
	var cnt = 0;
	for k in nview {
		if !(k == 0 || v_fix[k]) { continue; }
		use_view(k);
		shot(cam_eye, cam_look);
		var sum f32 = 0.0;
		var c = 0;
		for i in tw * th {
			if tmask[i] == 1.0 && rmask[i] == 1.0 {
				sum += de2000(lab(at(tpx, i, 0), at(tpx, i, 1), at(tpx, i, 2)), lab(at(rpx, i, 0), at(rpx, i, 1), at(rpx, i, 2)));
				c++;
			}
		}
		let v f32 = if c > 0 { sum / (c as f32) } else { 1000.0 };
		total += v;
		cnt++;
	}
	if cnt == 0 { return 0.0; }
	total / (cnt as f32)
}
fn lf_get(k int) f32 {
	match k {
		0 => key_k,
		1 => fill_k,
		2 => amb_k,
		3 => sun_az,
		_ => sun_el,
	}
}
fn lf_set(k int, v f32) {
	match k {
		0 => { key_k = v; },
		1 => { fill_k = v; },
		2 => { amb_k = v; },
		3 => { sun_az = v; },
		_ => { sun_el = v; },
	}
}
fn light_fit() {
	fast = true;
	set_lights();
	var best = tone();
	for pass in 3 {
		for k in 5 {
			for s in 2 {
				let old = lf_get(k);
				var up f32 = old;
				var dn f32 = old;
				if k < 3 {
					let m f32 = if s == 0 { 1.25 } else { 1.1 };
					up = old * m;
					dn = old / m;
				} else {
					let m f32 = if s == 0 { 0.2 } else { 0.07 };
					up = old + m;
					dn = old - m;
				}
				lf_set(k, up);
				set_lights();
				let t1 = tone();
				if t1 < best {
					best = t1;
				} else {
					lf_set(k, dn);
					set_lights();
					let t2 = tone();
					if t2 < best {
						best = t2;
					} else {
						lf_set(k, old);
					}
				}
			}
		}
	}
	fast = false;
	set_lights();
	var o byte[>..] = [];
	format(o, "light key ");
	f4(o, key_k);
	format(o, " fill ");
	f4(o, fill_k);
	format(o, " amb ");
	f4(o, amb_k);
	format(o, " az ");
	f4(o, sun_az);
	format(o, " el ");
	f4(o, sun_el);
	print(o);
}
fn emit(d json::Doc&, n int, out byte[>..]&) {
	json::format_node(out, d, n);
}
fn export_glb(src const byte[:], out const byte[:], prefix const byte[:]) {
	var data byte[>..] = [];
	if !read_file(src, data) { return; }
	fn rd(p int) int {
		(data[p] as int) + (data[p + 1] as int) * 256 + (data[p + 2] as int) * 65536 + (data[p + 3] as int) * 16777216
	}
	let jl = rd(12);
	let bin0 = 20 + jl + 8;
	var d = json::Doc {};
	let pr, perr = json::parse(data[20..20 + jl], d);
	let root = 0;
	fn ni(n int) int {
		var tmp byte[>..] = [];
		json::format_node(tmp, d, n);
		let v, ok = parse_flt(tmp);
		v as int
	}
	fn mi(n int, key const byte[:], def int) int {
		let m = json::member(d, n, key);
		if m < 0 { def } else { ni(m) }
	}
	fn cnt_of(n int) int {
		if n < 0 { return 0; }
		var c = 0;
		json::each(d, n) { e =>
			c += 1;
		};
		c
	}
	fn is_jpeg(n int) bool {
		if n < 0 { return false; }
		var tmp byte[>..] = [];
		json::format_node(tmp, d, n);
		tmp == "\"image/jpeg\""
	}
	let bvs = json::member(d, root, "bufferViews");
	let accs = json::member(d, root, "accessors");
	let imgs = json::member(d, root, "images");
	let mats = json::member(d, root, "materials");
	let ms = json::member(d, root, "meshes");
	let nbv = cnt_of(bvs);
	let nacc = cnt_of(accs);
	let nimg = cnt_of(imgs);
	let nmat = cnt_of(mats);
	fn chg(k int) bool {
		let g = gltf::assets[asset].images.first + k;
		g < img_changed.len && img_changed[g] != 0
	}
	var used bool[>..] = [];
	used.resize(nbv, false);
	for a in nacc {
		let b = mi(json::element(d, accs, a), "bufferView", -1);
		if b >= 0 && b < nbv { used[b] = true; }
	}
	for k in nimg {
		if chg(k) { continue; }
		let b = mi(json::element(d, imgs, k), "bufferView", -1);
		if b >= 0 && b < nbv { used[b] = true; }
	}
	var nb byte[>..] = [];
	for z in 4 { nb.push(0); }
	var nvoff int[>..] = [];
	for i in nbv {
		if !used[i] {
			nvoff.push(0);
			continue;
		}
		let bv = json::element(d, bvs, i);
		let off = mi(bv, "byteOffset", 0);
		let ln = mi(bv, "byteLength", 0);
		nvoff.push(nb.len);
		nb.append(data[bin0 + off..bin0 + off + ln]);
		while nb.len % 4 != 0 { nb.push(0); }
	}
	var ioff int[>..] = [];
	var ilen int[>..] = [];
	var ijpg bool[>..] = [];
	var iview int[>..] = [];
	var newn = 0;
	for k in nimg {
		ioff.push(0);
		ilen.push(0);
		ijpg.push(false);
		iview.push(-1);
		if !chg(k) { continue; }
		let g = gltf::assets[asset].images.first + k;
		let mt = json::member(d, json::element(d, imgs, k), "mimeType");
		let isj = is_jpeg(mt);
		var bytes byte[>..] = [];
		if isj {
			let im = gltf::images[g];
			codec_jpeg_enc::encode(gltf::image_pixels(g), im.width, im.height, 92, bytes);
		} else {
			var pth byte[>..] = [];
			format(pth, prefix, "_tex", g, ".png");
			read_file(pth, bytes);
		}
		ioff[k] = nb.len;
		ilen[k] = bytes.len;
		ijpg[k] = isj;
		iview[k] = nbv + newn;
		newn++;
		nb.append(bytes);
		while nb.len % 4 != 0 { nb.push(0); }
	}
	var amin float3[>..] = [];
	var amax float3[>..] = [];
	var ahas bool[>..] = [];
	amin.resize(nacc, float3 { 0.0, 0.0, 0.0 });
	amax.resize(nacc, float3 { 0.0, 0.0, 0.0 });
	ahas.resize(nacc, false);
	if shape_changed && ms >= 0 {
		for k in cnt_of(ms) {
			let jm = json::element(d, ms, k);
			let mesh = gltf::meshes[gltf::assets[asset].meshes.first + k];
			let jps = json::member(d, jm, "primitives");
			if jps < 0 { continue; }
			for pj in mesh.prims.count {
				let prim = gltf::prims[mesh.prims.first + pj];
				let jp = json::element(d, jps, pj);
				let att = json::member(d, jp, "attributes");
				if att < 0 { continue; }
				let pa = json::member(d, att, "POSITION");
				if pa < 0 { continue; }
				let ai = ni(pa);
				let acc = json::element(d, accs, ai);
				let cnt = mi(acc, "count", 0);
				if cnt != prim.vcount || cnt == 0 { continue; }
				let bi = mi(acc, "bufferView", -1);
				if bi < 0 { continue; }
				let bv = json::element(d, bvs, bi);
				let stride = mi(bv, "byteStride", 12);
				let base = nvoff[bi] + mi(acc, "byteOffset", 0);
				var mn f32[3] = [1e30, 1e30, 1e30];
				var mx f32[3] = [-1e30, -1e30, -1e30];
				for v in cnt {
					let o = (prim.vfirst + v) * gltf::VERTEX_FLOATS;
					for c in 3 {
						let x = gltf::verts[o + c];
						var fb f32[1] = [x];
						let bb = bytes_of(fb);
						for q in 4 { nb[base + v * stride + c * 4 + q] = bb[q]; }
						mn[c] = min(mn[c], x);
						mx[c] = max(mx[c], x);
					}
				}
				amin[ai] = float3 { mn[0], mn[1], mn[2] };
				amax[ai] = float3 { mx[0], mx[1], mx[2] };
				ahas[ai] = true;
			}
		}
	}
	var js byte[>..] = [];
	fn emit_num_obj(n int, key const byte[:], val f32) {
		js.push('{');
		var first = true;
		var seen = false;
		json::each(d, n) { c =>
			let nm = json::name_of(d, c);
			if !first { js.push(','); }
			first = false;
			json::format_key(js, nm);
			if nm == key {
				json::format_number(js, val as real);
				seen = true;
			} else {
				json::format_node(js, d, c);
			}
		};
		if !seen {
			if !first { js.push(','); }
			json::format_key(js, key);
			json::format_number(js, val as real);
		}
		js.push('}');
	}
	fn emit_vec3(v float3) {
		js.push('[');
		json::format_number(js, v.x as real);
		js.push(',');
		json::format_number(js, v.y as real);
		js.push(',');
		json::format_number(js, v.z as real);
		js.push(']');
	}
	fn emit_bvs() {
		js.push('[');
		var wrote = 0;
		for i in nbv {
			if wrote > 0 { js.push(','); }
			wrote++;
			if !used[i] {
				format(js, "{\"buffer\":0,\"byteOffset\":0,\"byteLength\":4}");
				continue;
			}
			let bv = json::element(d, bvs, i);
			js.push('{');
			format(js, "\"byteOffset\":", nvoff[i]);
			json::each(d, bv) { c =>
				let nm = json::name_of(d, c);
				if nm != "byteOffset" {
					js.push(',');
					json::format_key(js, nm);
					json::format_node(js, d, c);
				}
			};
			js.push('}');
		}
		for k in nimg {
			if iview[k] < 0 { continue; }
			if wrote > 0 { js.push(','); }
			wrote++;
			format(js, "{\"buffer\":0,\"byteOffset\":", ioff[k], ",\"byteLength\":", ilen[k], "}");
		}
		js.push(']');
	}
	fn emit_accs() {
		js.push('[');
		for a in nacc {
			if a > 0 { js.push(','); }
			let acc = json::element(d, accs, a);
			if !ahas[a] {
				json::format_node(js, d, acc);
				continue;
			}
			js.push('{');
			var first = true;
			json::each(d, acc) { c =>
				let nm = json::name_of(d, c);
				if !first { js.push(','); }
				first = false;
				json::format_key(js, nm);
				if nm == "min" {
					emit_vec3(amin[a]);
				} else if nm == "max" {
					emit_vec3(amax[a]);
				} else {
					json::format_node(js, d, c);
				}
			};
			js.push('}');
		}
		js.push(']');
	}
	fn emit_imgs() {
		js.push('[');
		for k in nimg {
			if k > 0 { js.push(','); }
			let im = json::element(d, imgs, k);
			if iview[k] < 0 {
				json::format_node(js, d, im);
				continue;
			}
			format(js, "{\"bufferView\":", iview[k], ",\"mimeType\":");
			json::format_string(js, if ijpg[k] { "image/jpeg" } else { "image/png" });
			format(js, ",\"name\":");
			let nm = json::member(d, im, "name");
			if nm >= 0 {
				json::format_node(js, d, nm);
			} else {
				json::format_string(js, "");
			}
			js.push('}');
		}
		js.push(']');
	}
	fn emit_mats() {
		js.push('[');
		for k in nmat {
			if k > 0 { js.push(','); }
			let mt = json::element(d, mats, k);
			if !mat_changed {
				json::format_node(js, d, mt);
				continue;
			}
			let gm = gltf::materials[gltf::assets[asset].materials.first + k];
			js.push('{');
			var first = true;
			var seen = false;
			json::each(d, mt) { c =>
				let nm = json::name_of(d, c);
				if !first { js.push(','); }
				first = false;
				json::format_key(js, nm);
				if nm == "pbrMetallicRoughness" {
					seen = true;
					emit_num_obj(c, "roughnessFactor", gm.roughness);
				} else if nm == "normalTexture" {
					emit_num_obj(c, "scale", gm.normal_scale);
				} else {
					json::format_node(js, d, c);
				}
			};
			if !seen {
				if !first { js.push(','); }
				format(js, "\"pbrMetallicRoughness\":{\"roughnessFactor\":");
				json::format_number(js, gm.roughness as real);
				js.push('}');
			}
			js.push('}');
		}
		js.push(']');
	}
	js.push('{');
	var firstm = true;
	json::each(d, root) { c =>
		let nm = json::name_of(d, c);
		if !firstm { js.push(','); }
		firstm = false;
		json::format_key(js, nm);
		if nm == "bufferViews" {
			emit_bvs();
		} else if nm == "images" {
			emit_imgs();
		} else if nm == "accessors" {
			emit_accs();
		} else if nm == "materials" {
			emit_mats();
		} else if nm == "buffers" {
			format(js, "[{\"byteLength\":", nb.len, "}]");
		} else {
			json::format_node(js, d, c);
		}
	};
	js.push('}');
	while js.len % 4 != 0 { js.push(' '); }
	var o byte[>..] = [];
	fn w32(v int) {
		var x = v;
		for q in 4 {
			o.push((x % 256) as byte);
			x /= 256;
		}
	}
	let total = 12 + 8 + js.len + 8 + nb.len;
	o.append("glTF");
	w32(2);
	w32(total);
	w32(js.len);
	o.append("JSON");
	o.append(js);
	w32(nb.len);
	o.append("BIN");
	o.push(0);
	o.append(nb);
	write_file(out, o);
	print("glb ", out);
}
fn report(tag const byte[:], save bool, prefix const byte[:]) {
	var heat byte[>..] = [];
	var si f32 = 0.0;
	var ss f32 = 0.0;
	var sd f32 = 0.0;
	var sg f32 = 0.0;
	for k in nview {
		use_view(k);
		shot(cam_eye, cam_look);
		let iou, ssim, de, good = metrics(heat);
		si += iou;
		ss += ssim;
		sd += de;
		sg += good;
		var o byte[>..] = [];
		format(o, tag, " v", k, " iou ");
		f4(o, iou);
		format(o, " ssim ");
		f4(o, ssim);
		format(o, " de ");
		f4(o, de);
		format(o, " good ");
		f4(o, good);
		format(o, " cam ");
		f4(o, v_cx[k]);
		format(o, " ");
		f4(o, v_cy[k]);
		format(o, " ");
		f4(o, v_d[k]);
		print(o);
		if save {
			var p1 byte[>..] = [];
			format(p1, prefix, "_v", k, "_render.png");
			let s1 = gfx::Shot { w: tw, h: th, pf: 376840196, px: rpx };
			gfx::save_shot(s1, p1);
			var p2 byte[>..] = [];
			format(p2, prefix, "_v", k, "_heat.png");
			let s2 = gfx::Shot { w: tw, h: th, pf: 376840196, px: heat };
			gfx::save_shot(s2, p2);
			var side byte[>..] = [];
			for y in th {
				side.append(tpx[y * tw * 4..(y + 1) * tw * 4]);
				side.append(rpx[y * tw * 4..(y + 1) * tw * 4]);
				side.append(heat[y * tw * 4..(y + 1) * tw * 4]);
			}
			var p3 byte[>..] = [];
			format(p3, prefix, "_v", k, "_side.png");
			let s3 = gfx::Shot { w: 3 * tw, h: th, pf: 376840196, px: side };
			gfx::save_shot(s3, p3);
		}
	}
	let n = if nview > 0 { nview as f32 } else { 1.0 };
	var m byte[>..] = [];
	format(m, tag, " mean iou ");
	f4(m, si / n);
	format(m, " ssim ");
	f4(m, ss / n);
	format(m, " de ");
	f4(m, sd / n);
	format(m, " good ");
	f4(m, sg / n);
	print(m);
}
fn env_get(name const byte[:], out byte[>..]&) bool {
	var data byte[>..] = [];
	if !read_file("/proc/self/environ", data) { return false; }
	let entries = split(data, 0);
	for e in entries {
		if e.len > name.len && e[..name.len] == name && e[name.len] == '=' {
			out.append(e[name.len + 1..]);
			return true;
		}
	}
	return false;
}
fn env_on(name const byte[:]) bool {
	var v byte[>..] = [];
	env_get(name, v)
}
fn env_off(name const byte[:]) bool {
	var v byte[>..] = [];
	if !env_get(name, v) { return false; }
	v == "0"
}
var saved_img int[>..];
fn accum() {
	if saved_img.len < img_changed.len { saved_img.resize(img_changed.len, 0); }
	for i in img_changed.len {
		if img_changed[i] != 0 { saved_img[i] = 1; }
	}
}
fn env_is(name const byte[:], val const byte[:]) bool {
	var v byte[>..] = [];
	if !env_get(name, v) { return false; }
	v == val
}
fn main() {
	let a = args();
	if a.len < 4 {
		print("usage: fit model.glb targets prefix [pose]");
		return;
	}
	let targets = split(a[2], ',');
	for t in targets {
		if nview >= 7 { break; }
		let fields = split(t, ':');
		var path const byte[:] = "";
		var yaw f32 = 0.0;
		var nf = 0;
		var dd f32 = 3.2;
		var cyy f32 = 0.85;
		var cxx f32 = 0.0;
		for w, j in fields {
			nf = j + 1;
			if j == 0 {
				path = w;
			} else if j == 1 {
				yaw = num(w);
			} else if j == 2 {
				dd = num(w);
			} else if j == 3 {
				cyy = num(w);
			} else if j == 4 {
				cxx = num(w);
			}
		}
		let fixed = nf >= 3;
		var data byte[>..] = [];
		if !read_file(path, data) {
			print("target failed ", path);
			continue;
		}
		tpx.clear();
		let w, h, ok = codec_png::decode(data, tpx);
		if !ok {
			print("target failed ", path);
			continue;
		}
		if nview == 0 {
			tw = w;
			th = h;
		} else if w != tw || h != th {
			print("target size differs, skipped ", path);
			continue;
		}
		tmask.clear();
		tmask.resize(tw * th, 1.0);
		gray_bg();
		v_px.append(tpx);
		v_mask.append(tmask);
		v_bg.push(bg);
		v_yaw.push(((yaw as real) * PI / 180.0) as f32);
		v_d.push(dd);
		v_cy.push(cyy);
		v_cx.push(cxx);
		v_fix.push(fixed);
		nview++;
	}
	if nview == 0 {
		print("no targets");
		return;
	}
	if env_on("FIT_MASK") {
		for k in nview {
			use_view(k);
			var px byte[>..] = [];
			var share f32 = 0.0;
			for i in tw * th {
				let on = tmask[i] >= 0.5;
				let v byte = if on { 255 } else { 0 };
				if on { share += 1.0; }
				px.push(v);
				px.push(v);
				px.push(v);
				px.push(255);
			}
			var p byte[>..] = [];
			format(p, a[3], "_v", k, "_mask.png");
			let s = gfx::Shot { w: tw, h: th, pf: 376840196, px: px };
			gfx::save_shot(s, p);
			var o byte[>..] = [];
			format(o, "mask v", k, " ");
			f4(o, share / ((tw * th) as f32));
			print(o);
		}
		return;
	}
	rmask.resize(tw * th, 0.0);
	if !gfx::open_headless(tw, th) {
		print("gpu: skipped (no device: ", gfx::error(), ")");
		return;
	}
	asset = gltf::load(a[1]);
	if asset < 0 {
		print("load failed: ", gltf::error());
		return;
	}
	item = s3d::add(asset);
	s3d::place(item, gfx::mat4_identity);
	if a.len > 4 { load_pose(a[4]); }
	s3d::sky = s3d::Sky { zenith: float3 { 0.6, 0.6, 0.6 }, horizon: float3 { 0.55, 0.55, 0.55 }, ground: float3 { 0.3, 0.3, 0.3 }, ambient: 1.0, draw: false };
	set_lights();
	s3d::look.bloom = 0.0;
	s3d::look.desaturate = 0.0;
	s3d::look.curve = 1;
	s3d::init(2 * tw, 2 * th);
	big = gfx::render_target(2 * tw, 2 * th, gfx::RGBA8);
	s3d::place(item, gfx::translate(float3 { 0.0, -1000.0, 0.0 }));
	s3d::view = s3d::Camera { eye: float3 { 0.0, 0.85, 3.2 }, target: float3 { 0.0, 0.85, 0.0 }, up: float3 { 0.0, 1.0, 0.0 }, fov_y: fov, near: 0.05, far: 100.0 };
	s3d::render(big);
	s3d::render(big);
	s3d::render(big);
	let cpx = gfx::read_pixels(big);
	clear_c = float3 { cpx[0] as f32, cpx[1] as f32, cpx[2] as f32 };
	print("clear ", clear_c.x, " ", clear_c.y, " ", clear_c.z);
	s3d::place(item, gfx::mat4_identity);
	for k in nview {
		if !cam_fit(k, 7) {
			print("empty view ", k);
			return;
		}
	}
	if !env_off("FIT_POSE") {
		pose_fit();
		for k in nview {
			let ok = cam_fit(k, 3);
		}
		var pp byte[>..] = [];
		format(pp, a[3], "_pose.txt");
		save_pose(pp);
	}
	if env_is("FIT_SHAPE", "1") {
		for r in 4 {
			let c = shape_fit(r);
			for k in nview {
				let ok = cam_fit(k, 3);
			}
			var tg byte[>..] = [];
			format(tg, "shape", r);
			report(tg, false, a[3]);
		}
	}
	if !env_off("FIT_LIGHT") { light_fit(); }
	report("fit", false, a[3]);
	if !env_off("FIT_GAIN") { view_gain(); }
	if !env_off("FIT_MATERIAL") { material_fit(); }
	if !env_off("FIT_PATTERN") {
		if img_changed.len < gltf::images.len { img_changed.resize(gltf::images.len, 0); }
		pattern_fit();
		accum();
	}
	if !env_off("FIT_PAINT") {
		for r in 4 {
			let c = paint(false);
			accum();
			var tg byte[>..] = [];
			format(tg, "paint", r);
			report(tg, false, a[3]);
		}
		var anyfix = false;
		for k in nview {
			if v_fix[k] { anyfix = true; }
		}
		if anyfix {
			pcell = 1;
			for r in 4 {
				let c = paint(true);
				accum();
				var tg byte[>..] = [];
				format(tg, "fine", r);
				report(tg, false, a[3]);
			}
			pcell = 4;
		}
	}
	var nsaved = 0;
	for img in saved_img.len {
		if saved_img[img] == 0 { continue; }
		let im = gltf::images[img];
		var p byte[>..] = [];
		format(p, a[3], "_tex", img, ".png");
		let s = gfx::Shot { w: im.width, h: im.height, pf: 376840196, px: gltf::image_pixels(img) };
		gfx::save_shot(s, p);
		nsaved++;
	}
	if nsaved > 0 || shape_changed || mat_changed {
		img_changed.clear();
		for i in saved_img.len { img_changed.push(saved_img[i]); }
		var op byte[>..] = [];
		format(op, a[3], ".glb");
		export_glb(a[1], op, a[3]);
	}
	report("final", true, a[3]);
}
