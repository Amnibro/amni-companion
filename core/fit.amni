var vy f32[>..];
var vz f32[>..];
var vw f32[>..];
var vis bool[>..];
var vrot linalg::Quat[>..];
var sm f32[>..];
var pose_n int[>..];
var pose_a f32[>..];
var img_changed int[>..];
var key_k f32 = 1.0;
var fill_k f32 = 1.0;
var amb_k f32 = 1.0;
var sun_az f32 = 0.0;
var sun_el f32 = 0.0;
var clear_c = float3 { 0.0, 0.0, 0.0 };
var item = -1;
var asset = -1;
var big = gfx::Texture { id: 0, .. };
var fov f32 = 0.5;
fn num(s const byte[:]) f32 {
	let v, ok = parse_flt(s);
	v as f32
}
fn at(px const byte[:], i int, c int) f32 {
	px[i * 4 + c] as f32
}
fn gray_bg() {
	let n = tw * th;
	if n == 0 { return; }
	var cr f32[>..] = [];
	var cg f32[>..] = [];
	var cb f32[>..] = [];
	for i in n {
		let x = i % tw;
		let y = i / tw;
		if x == 0 || x == tw - 1 || y == 0 || y == th - 1 {
			cr.push(at(tpx, i, 0));
			cg.push(at(tpx, i, 1));
			cb.push(at(tpx, i, 2));
		}
	}
	sort(cr) { a, b => a < b };
	sort(cg) { a, b => a < b };
	sort(cb) { a, b => a < b };
	bg = float3 { cr[cr.len / 2], cg[cg.len / 2], cb[cb.len / 2] };
	var smo float3[>..] = [];
	smo.resize(n, float3 { 0.0, 0.0, 0.0 });
	for y in th {
		for x in tw {
			var s0 f32 = 0.0;
			var s1 f32 = 0.0;
			var s2 f32 = 0.0;
			for dy in -2..3 {
				for dx in -2..3 {
					let j = clamp(y + dy, 0, th - 1) * tw + clamp(x + dx, 0, tw - 1);
					s0 += at(tpx, j, 0);
					s1 += at(tpx, j, 1);
					s2 += at(tpx, j, 2);
				}
			}
			smo[y * tw + x] = float3 { s0 / 25.0, s1 / 25.0, s2 / 25.0 };
		}
	}
	if tmask.len != n { tmask.resize(n, 1.0); }
	for i in n { tmask[i] = 1.0; }
	var seen byte[>..] = [];
	seen.resize(n, 0);
	var st int[>..<] = [];
	fn joins(i int, from int) bool {
		let p = smo[i];
		let q = smo[from];
		let dq = max(max(abs(p.x - q.x), abs(p.y - q.y)), abs(p.z - q.z));
		let db = max(max(abs(p.x - bg.x), abs(p.y - bg.y)), abs(p.z - bg.z));
		let sat = max(max(p.x, p.y), p.z) - min(min(p.x, p.y), p.z);
		dq <= 4.0 && db <= 48.0 && sat <= 20.0
	}
	for i in n {
		let x = i % tw;
		let y = i / tw;
		if x == 0 || x == tw - 1 || y == 0 || y == th - 1 {
			if seen[i] == 0 && joins(i, i) {
				seen[i] = 1;
				st.push(i);
			}
		}
	}
	let dxs int[4] = [1, -1, 0, 0];
	let dys int[4] = [0, 0, 1, -1];
	while st.len > 0 {
		let i = st.pop();
		tmask[i] = 0.0;
		let x = i % tw;
		let y = i / tw;
		for d in 4 {
			let nx = x + dxs[d];
			let ny = y + dys[d];
			if nx < 0 || ny < 0 || nx >= tw || ny >= th { continue; }
			let j = ny * tw + nx;
			if seen[j] != 0 { continue; }
			if joins(j, i) {
				seen[j] = 1;
				st.push(j);
			}
		}
	}
}
fn right_of(k int) float3 {
	let y = v_yaw[k] as real;
	float3 { cos(y) as f32, 0.0, (-sin(y)) as f32 }
}
fn fwd_of(k int) float3 {
	let y = v_yaw[k] as real;
	float3 { sin(y) as f32, 0.0, cos(y) as f32 }
}
fn use_view(k int) {
	cur = k;
	let n = tw * th;
	tpx.clear();
	tpx.append(v_px[k * n * 4..(k + 1) * n * 4]);
	tmask.clear();
	tmask.append(v_mask[k * n..(k + 1) * n]);
	bg = v_bg[k];
	let r = right_of(k);
	let f = fwd_of(k);
	cam_look = float3 { r.x * v_cx[k], r.y * v_cx[k] + v_cy[k], r.z * v_cx[k] };
	cam_eye = float3 { cam_look.x + f.x * v_d[k], cam_look.y + f.y * v_d[k], cam_look.z + f.z * v_d[k] };
	set_lights();
}
fn cam_fit(k int, iters int) bool {
	use_view(k);
	if v_fix[k] { return true; }
	let ty0, ty1, tcx = bbox(tmask);
	if ty1 <= ty0 { return false; }
	for i in iters {
		shot(cam_eye, cam_look);
		let my0, my1, mcx = bbox(rmask);
		if my1 <= my0 { return false; }
		let wpp = (2.0 * (v_d[k] as real) * tan((fov as real) / 2.0) / (th as real)) as f32;
		v_cy[k] -= ((((my0 + my1) as f32) - ((ty0 + ty1) as f32)) / 2.0) * wpp;
		v_cx[k] += (mcx - tcx) * wpp;
		v_d[k] *= ((my1 - my0) as f32) / ((ty1 - ty0) as f32);
		use_view(k);
	}
	return true;
}
fn load_pose(path const byte[:]) {
	var data byte[>..] = [];
	if !read_file(path, data) { return; }
	let lines = split(data, '\n');
	for ln in lines {
		let t = trim(ln);
		if t.len == 0 { continue; }
		let fields = split(t, ' ');
		var name const byte[:] = "";
		var vals f32[..10] = [];
		for w, k in fields {
			if k == 0 { name = w; } else if vals.len < 10 { vals.push(num(w)); }
		}
		if vals.len < 10 { continue; }
		let node = gltf::find_node(asset, name);
		if node >= 0 {
			s3d::set_node(item, node, float3 { vals[0], vals[1], vals[2] }, linalg::Quat { vals[3], vals[4], vals[5], vals[6] }, float3 { vals[7], vals[8], vals[9] });
		}
	}
}
fn shot(eye float3, look float3) {
	s3d::view = s3d::Camera { eye: eye, target: look, up: float3 { 0.0, 1.0, 0.0 }, fov_y: fov, near: 0.05, far: 100.0 };
	if fast {
		s3d::render(big);
	} else {
		s3d::render(big);
		s3d::render(big);
		s3d::render(big);
	}
	let px = gfx::read_pixels(big);
	let n = tw * th;
	rmask.resize(n, 0.0);
	rpx.resize(n * 4, 0);
	let bw = tw * 2;
	for y in th {
		for x in tw {
			var cnt = 0;
			var s0 f32 = 0.0;
			var s1 f32 = 0.0;
			var s2 f32 = 0.0;
			for v in 2 {
				for u in 2 {
					let bi = ((2 * y + v) * bw + 2 * x + u) * 4;
					let r = px[bi] as f32;
					let g = px[bi + 1] as f32;
					let b = px[bi + 2] as f32;
					let empty = abs(r - clear_c.x) <= 1.0 && abs(g - clear_c.y) <= 1.0 && abs(b - clear_c.z) <= 1.0;
					if empty {
						s0 += bg.x;
						s1 += bg.y;
						s2 += bg.z;
					} else {
						cnt++;
						s0 += r;
						s1 += g;
						s2 += b;
					}
				}
			}
			let i = y * tw + x;
			rmask[i] = (cnt as f32) / 4.0;
			rpx[i * 4] = clamp(round((s0 / 4.0) as real), 0.0, 255.0) as byte;
			rpx[i * 4 + 1] = clamp(round((s1 / 4.0) as real), 0.0, 255.0) as byte;
			rpx[i * 4 + 2] = clamp(round((s2 / 4.0) as real), 0.0, 255.0) as byte;
			rpx[i * 4 + 3] = 255;
		}
	}
}
fn bbox(m const f32[:]) int, int, f32 {
	var y0 = -1;
	var y1 = -1;
	var sx f32 = 0.0;
	var n = 0;
	for y in th {
		for x in tw {
			if m[y * tw + x] >= 0.5 {
				if y0 < 0 { y0 = y; }
				y1 = y;
				sx += x as f32;
				n++;
			}
		}
	}
	if n == 0 { return 0, 0, 0.0; }
	return y0, y1, sx / (n as f32);
}
fn srgb_lin(c f32) real {
	let v = (c as real) / 255.0;
	if v <= 0.04045 { v / 12.92 } else { pow((v + 0.055) / 1.055, 2.4) }
}
fn lab_f(t real) real {
	if t > 0.008856 { pow(t, 1.0 / 3.0) } else { 7.787 * t + 16.0 / 116.0 }
}
fn lab(r f32, g f32, b f32) float3 {
	let lr = srgb_lin(r);
	let lg = srgb_lin(g);
	let lb = srgb_lin(b);
	let x = (0.4124564 * lr + 0.3575761 * lg + 0.1804375 * lb) / 0.95047;
	let y = 0.2126729 * lr + 0.7151522 * lg + 0.0721750 * lb;
	let z = (0.0193339 * lr + 0.1191920 * lg + 0.9503041 * lb) / 1.08883;
	let fx = lab_f(x);
	let fy = lab_f(y);
	let fz = lab_f(z);
	float3 { (116.0 * fy - 16.0) as f32, (500.0 * (fx - fy)) as f32, (200.0 * (fy - fz)) as f32 }
}
fn de2000(p float3, q float3) f32 {
	let l1 = p.x as real;
	let a1 = p.y as real;
	let b1 = p.z as real;
	let l2 = q.x as real;
	let a2 = q.y as real;
	let b2 = q.z as real;
	let rad = PI / 180.0;
	let c1 = sqrt(a1 * a1 + b1 * b1);
	let c2 = sqrt(a2 * a2 + b2 * b2);
	let cb = (c1 + c2) / 2.0;
	let cb7 = pow(cb, 7.0);
	let p25 = pow(25.0, 7.0);
	let g = 0.5 * (1.0 - sqrt(cb7 / (cb7 + p25)));
	let ap1 = (1.0 + g) * a1;
	let ap2 = (1.0 + g) * a2;
	let cp1 = sqrt(ap1 * ap1 + b1 * b1);
	let cp2 = sqrt(ap2 * ap2 + b2 * b2);
	let hp1 = if ap1 == 0.0 && b1 == 0.0 { 0.0 } else { let h = atan2(b1, ap1) / rad; if h < 0.0 { h + 360.0 } else { h } };
	let hp2 = if ap2 == 0.0 && b2 == 0.0 { 0.0 } else { let h = atan2(b2, ap2) / rad; if h < 0.0 { h + 360.0 } else { h } };
	let dl = l2 - l1;
	let dc = cp2 - cp1;
	var dh = 0.0;
	if cp1 * cp2 != 0.0 {
		dh = hp2 - hp1;
		if dh > 180.0 { dh -= 360.0; } else if dh < -180.0 { dh += 360.0; }
	}
	let dhh = 2.0 * sqrt(cp1 * cp2) * sin(dh * rad / 2.0);
	let lbar = (l1 + l2) / 2.0;
	let cbar = (cp1 + cp2) / 2.0;
	let hbar = if cp1 * cp2 == 0.0 { hp1 + hp2 } else if abs(hp1 - hp2) <= 180.0 { (hp1 + hp2) / 2.0 } else if hp1 + hp2 < 360.0 { (hp1 + hp2 + 360.0) / 2.0 } else { (hp1 + hp2 - 360.0) / 2.0 };
	let t = 1.0 - 0.17 * cos((hbar - 30.0) * rad) + 0.24 * cos(2.0 * hbar * rad) + 0.32 * cos((3.0 * hbar + 6.0) * rad) - 0.20 * cos((4.0 * hbar - 63.0) * rad);
	let hh = (hbar - 275.0) / 25.0;
	let dtheta = 30.0 * exp(-(hh * hh));
	let cbar7 = pow(cbar, 7.0);
	let rc = 2.0 * sqrt(cbar7 / (cbar7 + p25));
	let lm = (lbar - 50.0) * (lbar - 50.0);
	let sl = 1.0 + 0.015 * lm / sqrt(20.0 + lm);
	let sc = 1.0 + 0.045 * cbar;
	let sh = 1.0 + 0.015 * cbar * t;
	let rt = -sin(2.0 * dtheta * rad) * rc;
	let x1 = dl / sl;
	let x2 = dc / sc;
	let x3 = dhh / sh;
	sqrt(x1 * x1 + x2 * x2 + x3 * x3 + rt * x2 * x3) as f32
}
fn metrics(heat byte[>..]&) f32, f32, f32, f32 {
	let n = tw * th;
	heat.resize(n * 4, 0);
	var inter f32 = 0.0;
	var uni f32 = 0.0;
	var sumd f32 = 0.0;
	var cnt = 0;
	var good = 0;
	var lt f32[>..] = [];
	var lr f32[>..] = [];
	lt.resize(n, 0.0);
	lr.resize(n, 0.0);
	var x0 = tw;
	var x1 = -1;
	var y0 = th;
	var y1 = -1;
	for i in n {
		let tm = tmask[i];
		let rm = rmask[i];
		inter += min(tm, rm);
		uni += max(tm, rm);
		lt[i] = 0.299 * at(tpx, i, 0) + 0.587 * at(tpx, i, 1) + 0.114 * at(tpx, i, 2);
		lr[i] = 0.299 * at(rpx, i, 0) + 0.587 * at(rpx, i, 1) + 0.114 * at(rpx, i, 2);
		if max(tm, rm) > 0.0 {
			let x = i % tw;
			let y = i / tw;
			x0 = min(x0, x);
			x1 = max(x1, x);
			y0 = min(y0, y);
			y1 = max(y1, y);
			let d = de2000(lab(at(tpx, i, 0), at(tpx, i, 1), at(tpx, i, 2)), lab(at(rpx, i, 0), at(rpx, i, 1), at(rpx, i, 2)));
			sumd += d;
			cnt++;
			if d < 3.0 { good++; }
			heat[i * 4] = (min(d / 10.0, 1.0) * 255.0) as byte;
			heat[i * 4 + 1] = (clamp((d - 10.0) / 10.0, 0.0, 1.0) * 255.0) as byte;
			heat[i * 4 + 2] = (clamp((d - 10.0) / 10.0, 0.0, 1.0) * 255.0) as byte;
			heat[i * 4 + 3] = 255;
		} else {
			heat[i * 4] = tpx[i * 4] / 4;
			heat[i * 4 + 1] = tpx[i * 4 + 1] / 4;
			heat[i * 4 + 2] = tpx[i * 4 + 2] / 4;
			heat[i * 4 + 3] = 255;
		}
	}
	let c1 = 6.5025;
	let c2 = 58.5225;
	var ssum = 0.0;
	var wc = 0;
	var wy = y0;
	while wy + 7 <= y1 + 1 {
		var wx = x0;
		while wx + 7 <= x1 + 1 {
			var sx = 0.0;
			var sy = 0.0;
			var sxx = 0.0;
			var syy = 0.0;
			var sxy = 0.0;
			var has = false;
			for v in 7 {
				for u in 7 {
					let i = (wy + v) * tw + wx + u;
					let a = lt[i] as real;
					let b = lr[i] as real;
					sx += a;
					sy += b;
					sxx += a * a;
					syy += b * b;
					sxy += a * b;
					if max(tmask[i], rmask[i]) > 0.0 { has = true; }
				}
			}
			if has {
				let mx = sx / 49.0;
				let my = sy / 49.0;
				let vx = sxx / 49.0 - mx * mx;
				let vy = syy / 49.0 - my * my;
				let cxy = sxy / 49.0 - mx * my;
				ssum += ((2.0 * mx * my + c1) * (2.0 * cxy + c2)) / ((mx * mx + my * my + c1) * (vx + vy + c2));
				wc++;
			}
			wx += 2;
		}
		wy += 2;
	}
	let iou = if uni > 0.0 { inter / uni } else { 0.0 };
	let ssim = if wc > 0 { (ssum / (wc as real)) as f32 } else { 0.0 };
	let de = if cnt > 0 { sumd / (cnt as f32) } else { 0.0 };
	let gs = if cnt > 0 { (good as f32) / (cnt as f32) } else { 0.0 };
	return iou, ssim, de, gs;
}
var vpw f32[>..];
fn project() {
	s3d::pose(item);
	let nv = gltf::verts.len / gltf::VERTEX_FLOATS;
	vx.clear();
	vy.clear();
	vz.clear();
	vw.clear();
	vpw.clear();
	vrot.clear();
	vx.resize(nv, 0.0);
	vy.resize(nv, 0.0);
	vz.resize(nv, 0.0);
	vw.resize(nv, 0.0);
	vpw.resize(nv * 3, 0.0);
	vrot.resize(nv, linalg::Quat { 0.0, 0.0, 0.0, 1.0 });
	let view = gfx::look_at(cam_eye, cam_look, float3 { 0.0, 1.0, 0.0 });
	let tf = tan((fov as real) / 2.0) as f32;
	let aspect = (tw as f32) / (th as f32);
	let zn f32 = 0.05;
	let zf f32 = 100.0;
	let za = (zf + zn) / (zn - zf);
	let zc = 2.0 * zf * zn / (zn - zf);
	let an = gltf::assets[asset].nodes;
	for n in an.first..an.first + an.count {
		let mi = gltf::nodes[n].mesh;
		if mi < 0 { continue; }
		let skin = gltf::nodes[n].skin;
		if skin >= 0 { motion::joints(skin, pal); }
		let mesh = gltf::meshes[mi];
		for pi in mesh.prims.count {
			let prim = gltf::prims[mesh.prims.first + pi];
			for v in prim.vcount {
				let g = prim.vfirst + v;
				let o = g * gltf::VERTEX_FLOATS;
				let pos = float3 { gltf::verts[o], gltf::verts[o + 1], gltf::verts[o + 2] };
				var wp = float3 { 0.0, 0.0, 0.0 };
				if skin >= 0 {
					var bestw f32 = -1.0;
					var bestj = 0;
					for c in 4 {
						let wt = gltf::verts[o + 22 + c];
						let j = gltf::verts[o + 18 + c] as int;
						let q = linalg::point(pal[j], pos);
						wp = float3 { wp.x + wt * q.x, wp.y + wt * q.y, wp.z + wt * q.z };
						if wt > bestw {
							bestw = wt;
							bestj = j;
						}
					}
					vrot[g] = qconj(mquat(pal[bestj]));
				} else {
					wp = linalg::point(motion::world[n], pos);
					vrot[g] = qconj(mquat(motion::world[n]));
				}
				vpw[g * 3] = wp.x;
				vpw[g * 3 + 1] = wp.y;
				vpw[g * 3 + 2] = wp.z;
				let q = linalg::point(view, wp);
				let cx = q.x / (aspect * tf);
				let cy = q.y / tf;
				let cz = za * q.z + zc;
				let cw = -q.z;
				vw[g] = cw;
				if cw > 0.0 {
					vx[g] = (cx / cw * 0.5 + 0.5) * (tw as f32);
					vy[g] = (0.5 - cy / cw * 0.5) * (th as f32);
					vz[g] = cz / cw;
				}
			}
		}
	}
}
var hit_f f32[>..];
fn rz_tri(g0 int, g1 int, g2 int, mat int, img int) {
	if vw[g0] <= 0.0 || vw[g1] <= 0.0 || vw[g2] <= 0.0 { return; }
	let x0 = vx[g0];
	let y0 = vy[g0];
	let x1 = vx[g1];
	let y1 = vy[g1];
	let x2 = vx[g2];
	let y2 = vy[g2];
	let area = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0);
	if area == 0.0 { return; }
	let ix0 = clamp(ceil((min(min(x0, x1), x2) as real) - 0.5), 0.0, ((tw - 1) as real)) as int;
	let ix1 = clamp(floor((max(max(x0, x1), x2) as real) - 0.5), 0.0, ((tw - 1) as real)) as int;
	let iy0 = clamp(ceil((min(min(y0, y1), y2) as real) - 0.5), 0.0, ((th - 1) as real)) as int;
	let iy1 = clamp(floor((max(max(y0, y1), y2) as real) - 0.5), 0.0, ((th - 1) as real)) as int;
	var facing f32 = 0.0;
	var u0 f32 = 0.0;
	var v0 f32 = 0.0;
	var u1 f32 = 0.0;
	var v1 f32 = 0.0;
	var u2 f32 = 0.0;
	var v2 f32 = 0.0;
	var bt = default<gltf::Material>();
	if img >= 0 {
		bt = gltf::materials[mat];
		let o0 = g0 * gltf::VERTEX_FLOATS;
		let o1 = g1 * gltf::VERTEX_FLOATS;
		let o2 = g2 * gltf::VERTEX_FLOATS;
		u0 = gltf::verts[o0 + 6];
		v0 = gltf::verts[o0 + 7];
		u1 = gltf::verts[o1 + 6];
		v1 = gltf::verts[o1 + 7];
		u2 = gltf::verts[o2 + 6];
		v2 = gltf::verts[o2 + 7];
		let a = float3 { vpw[g0 * 3], vpw[g0 * 3 + 1], vpw[g0 * 3 + 2] };
		let b = float3 { vpw[g1 * 3], vpw[g1 * 3 + 1], vpw[g1 * 3 + 2] };
		let c = float3 { vpw[g2 * 3], vpw[g2 * 3 + 1], vpw[g2 * 3 + 2] };
		let e1 = float3 { b.x - a.x, b.y - a.y, b.z - a.z };
		let e2 = float3 { c.x - a.x, c.y - a.y, c.z - a.z };
		let cr = float3 { e1.y * e2.z - e1.z * e2.y, e1.z * e2.x - e1.x * e2.z, e1.x * e2.y - e1.y * e2.x };
		let cl = sq(cr.x * cr.x + cr.y * cr.y + cr.z * cr.z);
		if cl >= 1e-12 {
			let tv = float3 { cam_eye.x - (a.x + b.x + c.x) / 3.0, cam_eye.y - (a.y + b.y + c.y) / 3.0, cam_eye.z - (a.z + b.z + c.z) / 3.0 };
			let tl = sq(tv.x * tv.x + tv.y * tv.y + tv.z * tv.z);
			if tl > 0.0 {
				facing = abs((cr.x * tv.x + cr.y * tv.y + cr.z * tv.z) / (cl * tl));
			}
		}
	}
	for py in iy0..iy1 + 1 {
		for px in ix0..ix1 + 1 {
			let cx = (px as f32) + 0.5;
			let cy = (py as f32) + 0.5;
			let w0 = ((x1 - cx) * (y2 - cy) - (x2 - cx) * (y1 - cy)) / area;
			let w1 = ((x2 - cx) * (y0 - cy) - (x0 - cx) * (y2 - cy)) / area;
			let w2 = 1.0 - w0 - w1;
			if w0 < 0.0 || w1 < 0.0 || w2 < 0.0 { continue; }
			let z = w0 * vz[g0] + w1 * vz[g1] + w2 * vz[g2];
			let i = py * tw + px;
			if z >= zb[i] { continue; }
			if img < 0 {
				zb[i] = z;
				continue;
			}
			let p0 = w0 / vw[g0];
			let p1 = w1 / vw[g1];
			let p2 = w2 / vw[g2];
			let ps = p0 + p1 + p2;
			let uu = (p0 * u0 + p1 * u1 + p2 * u2) / ps;
			let vv = (p0 * v0 + p1 * v1 + p2 * v2) / ps;
			let tu = bt.base_tex.m.x * uu + bt.base_tex.m.y * vv + bt.base_tex.o.x;
			let tvv = bt.base_tex.m.z * uu + bt.base_tex.m.w * vv + bt.base_tex.o.y;
			if gltf::pixels[texel(img, tu, tvv) + 3] < 128 { continue; }
			zb[i] = z;
			hit_img[i] = img;
			hit_u[i] = tu;
			hit_v[i] = tvv;
			hit_f[i] = facing;
		}
	}
}
fn raster() {
	project();
	let n = tw * th;
	hit_img.clear();
	hit_img.resize(n, -1);
	hit_u.clear();
	hit_u.resize(n, 0.0);
	hit_v.clear();
	hit_v.resize(n, 0.0);
	hit_f.clear();
	hit_f.resize(n, 0.0);
	zb.clear();
	zb.resize(n, 1e30);
	let an = gltf::assets[asset].nodes;
	for pass in 2 {
		for nd in an.first..an.first + an.count {
			let mi = gltf::nodes[nd].mesh;
			if mi < 0 { continue; }
			let mesh = gltf::meshes[mi];
			for pi in mesh.prims.count {
				let prim = gltf::prims[mesh.prims.first + pi];
				var img = -1;
				if prim.material >= 0 {
					let tx = gltf::materials[prim.material].base_tex.texture;
					if tx >= 0 { img = gltf::textures[tx].image; }
				}
				if (pass == 0) != (img < 0) { continue; }
				for t in prim.icount / 3 {
					let g0 = prim.vfirst + gltf::indices[prim.ifirst + 3 * t];
					let g1 = prim.vfirst + gltf::indices[prim.ifirst + 3 * t + 1];
					let g2 = prim.vfirst + gltf::indices[prim.ifirst + 3 * t + 2];
					rz_tri(g0, g1, g2, prim.material, img);
				}
			}
		}
	}
}
fn texel(img int, u f32, v f32) int {
	let im = gltf::images[img];
	let w = im.width as real;
	let h = im.height as real;
	let fu = (u as real) - floor(u as real);
	let fv = (v as real) - floor(v as real);
	let x = clamp(floor(fu * w), 0.0, w - 1.0) as int;
	let y = clamp(floor(fv * h), 0.0, h - 1.0) as int;
	im.pixels.first + (y * im.width + x) * 4
}
fn lin(c f32) f32 {
	let v = (c as real) / 255.0;
	(if v <= 0.04045 { v / 12.92 } else { pow((v + 0.055) / 1.055, 2.4) }) as f32
}
fn enc(l f32) f32 {
	let v = l as real;
	(255.0 * (if v <= 0.0031308 { v * 12.92 } else { 1.055 * pow(v, 1.0 / 2.4) - 0.055 })) as f32
}
var pf_v int[>..];
var pf_p int[>..];
fn pf_used(img int) bool {
	for m in gltf::materials.len {
		let t = gltf::materials[m].base_tex.texture;
		if t >= 0 && gltf::textures[t].image == img { return true; }
	}
	return false;
}
fn pf_std(img int) f32 {
	let im = gltf::images[img];
	let px = gltf::image_pixels(img);
	let n = im.width * im.height;
	var s = 0.0;
	var s2 = 0.0;
	var c = 0;
	var i = 0;
	while i < n {
		let l = (0.299 * (px[i * 4] as real) + 0.587 * (px[i * 4 + 1] as real) + 0.114 * (px[i * 4 + 2] as real)) / 255.0;
		s += l;
		s2 += l * l;
		c++;
		i += 7;
	}
	if c == 0 { return 0.0; }
	let mean = s / (c as real);
	let v = max(s2 / (c as real) - mean * mean, 0.0);
	sqrt(v) as f32
}
fn pf_apply(img int, du f32, dv f32, ds f32) {
	for m in gltf::materials.len {
		let t = gltf::materials[m].base_tex.texture;
		if t >= 0 && gltf::textures[t].image == img {
			gltf::materials[m].base_tex.o = float2 { du, dv };
			gltf::materials[m].base_tex.m = float4 { 1.0 + ds, 0.0, 0.0, 1.0 + ds };
		}
	}
}
fn pf_cost(img int, du f32, dv f32, ds f32) f32 {
	pf_apply(img, du, dv, ds);
	var curv = -1;
	var sum = 0.0;
	for q in pf_p.len {
		if pf_v[q] != curv {
			curv = pf_v[q];
			use_view(curv);
			shot(cam_eye, cam_look);
		}
		let i = pf_p[q];
		sum += de2000(lab(at(tpx, i, 0), at(tpx, i, 1), at(tpx, i, 2)), lab(at(rpx, i, 0), at(rpx, i, 1), at(rpx, i, 2))) as real;
	}
	(sum / (pf_p.len as real)) as f32
}
fn pf_bake(img int, du f32, dv f32, ds f32) {
	let im = gltf::images[img];
	let w = im.width;
	let h = im.height;
	let wr = w as real;
	let hr = h as real;
	let src = gltf::image_pixels(img);
	var cp byte[>..] = [];
	cp.resize(w * h * 4, 0);
	for y in h {
		for x in w {
			let fu = (((x as real) + 0.5) / wr) * (1.0 + (ds as real)) + (du as real);
			let fv = (((y as real) + 0.5) / hr) * (1.0 + (ds as real)) + (dv as real);
			let u = fu - floor(fu);
			let v = fv - floor(fv);
			let fx = u * wr - 0.5;
			let fy = v * hr - 0.5;
			let x0r = floor(fx);
			let y0r = floor(fy);
			let ax = fx - x0r;
			let ay = fy - y0r;
			let x0 = (x0r as int) % w;
			let x1 = (x0 + 1) % w;
			let y0 = (y0r as int) % h;
			let y1 = (y0 + 1) % h;
			for c in 4 {
				let p00 = src[(y0 * w + x0) * 4 + c] as real;
				let p10 = src[(y0 * w + x1) * 4 + c] as real;
				let p01 = src[(y1 * w + x0) * 4 + c] as real;
				let p11 = src[(y1 * w + x1) * 4 + c] as real;
				let val = (p00 * (1.0 - ax) + p10 * ax) * (1.0 - ay) + (p01 * (1.0 - ax) + p11 * ax) * ay;
				cp[(y * w + x) * 4 + c] = clamp(round(val), 0.0, 255.0) as byte;
			}
		}
	}
	for i in w * h * 4 {
		gltf::pixels[im.pixels.first + i] = cp[i];
	}
	img_changed[img] = 1;
	if img < s3d::tex_srgb.len {
		if s3d::tex_srgb[img].id != 0 {
			gfx::update_texture(s3d::tex_srgb[img], gltf::image_pixels(img));
			gfx::generate_mips(s3d::tex_srgb[img]);
		}
	}
}
fn pattern_fit() {
	if img_changed.len < gltf::images.len { img_changed.resize(gltf::images.len, 0); }
	let lims f32[3] = [0.15, 0.15, 0.1];
	let steps f32[3] = [0.02, 0.007, 0.002];
	let n = tw * th;
	for img in gltf::images.len {
		if !pf_used(img) { continue; }
		if pf_std(img) <= 0.08 { continue; }
		pf_v.clear();
		pf_p.clear();
		for k in nview {
			use_view(k);
			shot(cam_eye, cam_look);
			raster();
			for i in n {
				if hit_img[i] == img && tmask[i] == 1.0 && rmask[i] == 1.0 {
					pf_v.push(k);
					pf_p.push(i);
				}
			}
		}
		if pf_p.len < 2000 { continue; }
		var p f32[3] = [0.0, 0.0, 0.0];
		var best = pf_cost(img, 0.0, 0.0, 0.0);
		let before = best;
		for st in steps {
			for j in 3 {
				var rep = 0;
				var go = true;
				while go && rep < 7 {
					go = false;
					rep++;
					for sgn in 2 {
						let sg f32 = if sgn == 0 { 1.0 } else { -1.0 };
						var q = p;
						q[j] += sg * st;
						if abs(q[j]) > lims[j] { continue; }
						let c = pf_cost(img, q[0], q[1], q[2]);
						if c < best {
							best = c;
							p = q;
							go = true;
							break;
						}
					}
				}
			}
		}
		pf_apply(img, 0.0, 0.0, 0.0);
		var o byte[>..] = [];
		format(o, "pattern ", img, " du ");
		f4(o, p[0]);
		format(o, " dv ");
		f4(o, p[1]);
		format(o, " ds ");
		f4(o, p[2]);
		format(o, " de ");
		f4(o, before);
		format(o, " -> ");
		f4(o, best);
		print(o);
		if p[0] != 0.0 || p[1] != 0.0 || p[2] != 0.0 {
			pf_bake(img, p[0], p[1], p[2]);
		}
	}
}
fn view_gain() {
	if nview < 2 { return; }
	let n = tw * th;
	for k in 1..nview {
		if v_fix[k] { continue; }
		use_view(k);
		shot(cam_eye, cam_look);
		var ts real[3] = [0.0, 0.0, 0.0];
		var rs real[3] = [0.0, 0.0, 0.0];
		var cnt = 0;
		for i in n {
			if tmask[i] == 1.0 && rmask[i] == 1.0 {
				cnt++;
				for c in 3 {
					ts[c] += lin(at(tpx, i, c)) as real;
					rs[c] += lin(at(rpx, i, c)) as real;
				}
			}
		}
		if cnt < 2000 { continue; }
		var g f32[3] = [1.0, 1.0, 1.0];
		for c in 3 {
			g[c] = clamp(rs[c] / max(ts[c], 1e-9), 0.5, 2.0) as f32;
		}
		let base = k * n * 4;
		for i in n {
			for c in 3 {
				let o = base + i * 4 + c;
				let l = clamp(lin(v_px[o] as f32) * g[c], 0.0, 1.0);
				v_px[o] = clamp(round(enc(l) as real), 0.0, 255.0) as byte;
			}
		}
		var o byte[>..] = [];
		format(o, "gain ", k, " ");
		f4(o, g[0]);
		format(o, " ");
		f4(o, g[1]);
		format(o, " ");
		f4(o, g[2]);
		print(o);
	}
}
var tc int[768];
var tone_on = false;
fn lutv(i int) int {
	(i * 255 + 16) / 32
}
fn build_lut() {
	var px byte[>..] = [];
	for b in 33 {
		for g in 33 {
			for r in 33 {
				px.push(tc[lutv(r)] as byte);
				px.push(tc[256 + lutv(g)] as byte);
				px.push(tc[512 + lutv(b)] as byte);
				px.push(255);
			}
		}
	}
	s3d::set_lut(px, 33);
}
fn tone_fit() {
	let before = tone();
	let tc0 = tc;
	let on0 = tone_on;
	let cc0 = clear_c;
	var hist int[>..] = [];
	hist.resize(3 * 256 * 256, 0);
	let n = tw * th;
	for k in nview {
		if !(k == 0 || v_fix[k]) { continue; }
		use_view(k);
		shot(cam_eye, cam_look);
		for i in n {
			if tmask[i] == 1.0 && rmask[i] == 1.0 {
				for c in 3 {
					let r = rpx[i * 4 + c] as int;
					let t = tpx[i * 4 + c] as int;
					hist[(c * 256 + r) * 256 + t] += 1;
				}
			}
		}
	}
	for c in 3 {
		var nm real[256] = [0.0; 256];
		var set bool[256] = [false; 256];
		for b in 256 {
			var tmp int[256] = [0; 256];
			var total = 0;
			for r in max(0, b - 2)..min(255, b + 2) + 1 {
				for t in 256 {
					let h = hist[(c * 256 + r) * 256 + t];
					tmp[t] += h;
					total += h;
				}
			}
			if total >= 30 {
				var cum = 0;
				var med = 0;
				var found = false;
				for t in 256 {
					cum += tmp[t];
					if !found && cum > total / 2 {
						med = t;
						found = true;
					}
				}
				nm[b] = med as real;
				set[b] = true;
			}
		}
		var any = false;
		for b in 256 { if set[b] { any = true; } }
		if !any {
			for b in 256 { nm[b] = b as real; }
		} else {
			var res real[256] = [0.0; 256];
			for b in 256 {
				if set[b] {
					res[b] = nm[b];
					continue;
				}
				var lo = -1;
				var hi = -1;
				var j = b - 1;
				while j >= 0 && lo < 0 {
					if set[j] { lo = j; }
					j--;
				}
				j = b + 1;
				while j < 256 && hi < 0 {
					if set[j] { hi = j; }
					j++;
				}
				if lo >= 0 && hi >= 0 {
					let f = ((b - lo) as real) / ((hi - lo) as real);
					res[b] = nm[lo] + (nm[hi] - nm[lo]) * f;
				} else if lo >= 0 {
					res[b] = nm[lo];
				} else {
					res[b] = nm[hi];
				}
			}
			nm = res;
		}
		for b in 1..256 {
			if nm[b] < nm[b - 1] { nm[b] = nm[b - 1]; }
		}
		for x in 256 {
			let old = tc[256 * c + x];
			tc[256 * c + x] = clamp(round(nm[old]), 0.0, 255.0) as int;
		}
	}
	build_lut();
	s3d::look.lut = 1.0;
	tone_on = true;
	learn_clear();
	let after = tone();
	if !(after < before) {
		tc = tc0;
		tone_on = on0;
		clear_c = cc0;
		if tone_on {
			build_lut();
		} else {
			s3d::look.lut = 0.0;
		}
		print("tone rejected");
	}
	var o byte[>..] = [];
	format(o, "tone");
	for c in 3 {
		format(o, " ", tc[256 * c + 32], " ", tc[256 * c + 128], " ", tc[256 * c + 224]);
	}
	print(o);
}
var mat_changed = false;
var mf_m int[>..];
var mf_r0 f32[>..];
var mf_n0 f32[>..];
var mf_s0 float3[>..];
fn mf_cost() f32 {
	var curv = -1;
	var sum = 0.0;
	for q in pf_p.len {
		if pf_v[q] != curv {
			curv = pf_v[q];
			use_view(curv);
			shot(cam_eye, cam_look);
		}
		let i = pf_p[q];
		sum += de2000(lab(at(tpx, i, 0), at(tpx, i, 1), at(tpx, i, 2)), lab(at(rpx, i, 0), at(rpx, i, 1), at(rpx, i, 2))) as real;
	}
	(sum / (pf_p.len as real)) as f32
}
fn mf_apply(fr f32, fnv f32, fs f32) {
	for i in mf_m.len {
		let m = mf_m[i];
		let s = mf_s0[i];
		gltf::materials[m].roughness = clamp(mf_r0[i] * fr, 0.04, 1.0);
		gltf::materials[m].normal_scale = mf_n0[i] * fnv;
		gltf::materials[m].sheen = float3 { s.x * fs, s.y * fs, s.z * fs };
	}
}
fn material_fit() {
	let n = tw * th;
	let mst f32[2] = [1.3, 1.1];
	let ast f32[2] = [0.3, 0.1];
	for img in gltf::images.len {
		mf_m.clear();
		mf_r0.clear();
		mf_n0.clear();
		mf_s0.clear();
		for m in gltf::materials.len {
			let t = gltf::materials[m].base_tex.texture;
			if t >= 0 && gltf::textures[t].image == img {
				mf_m.push(m);
				mf_r0.push(gltf::materials[m].roughness);
				mf_n0.push(gltf::materials[m].normal_scale);
				mf_s0.push(gltf::materials[m].sheen);
			}
		}
		if mf_m.len == 0 { continue; }
		pf_v.clear();
		pf_p.clear();
		for k in nview {
			use_view(k);
			shot(cam_eye, cam_look);
			raster();
			for i in n {
				if hit_img[i] == img && tmask[i] == 1.0 && rmask[i] == 1.0 {
					pf_v.push(k);
					pf_p.push(i);
				}
			}
		}
		if pf_p.len < 2000 { continue; }
		var hs = false;
		for i in mf_s0.len {
			let s = mf_s0[i];
			if s.x != 0.0 || s.y != 0.0 || s.z != 0.0 { hs = true; }
		}
		var p f32[3] = [1.0, 1.0, 1.0];
		mf_apply(1.0, 1.0, 1.0);
		let before = mf_cost();
		var best = before;
		for pass in 2 {
			for j in 3 {
				if j == 2 && !hs { continue; }
				var rep = 0;
				var go = true;
				while go && rep < 7 {
					go = false;
					rep++;
					for sgn in 2 {
						let up = sgn == 0;
						var q = p;
						if j == 0 {
							q[0] = if up { p[0] * mst[pass] } else { p[0] / mst[pass] };
							if q[0] < 0.7 - 0.000001 || q[0] > 1.4 + 0.000001 { continue; }
						} else {
							q[j] = if up { p[j] + ast[pass] } else { p[j] - ast[pass] };
							if q[j] < 0.0 || q[j] > 2.0 { continue; }
						}
						mf_apply(q[0], q[1], q[2]);
						let c = mf_cost();
						if c < best {
							best = c;
							p = q;
							go = true;
							break;
						}
					}
				}
			}
		}
		mf_apply(p[0], p[1], p[2]);
		if p[0] != 1.0 || p[1] != 1.0 || p[2] != 1.0 { mat_changed = true; }
		var o byte[>..] = [];
		format(o, "material ", img, " rough ");
		f4(o, gltf::materials[mf_m[0]].roughness);
		format(o, " nscale ");
		f4(o, gltf::materials[mf_m[0]].normal_scale);
		format(o, " sheen ");
		f4(o, p[2]);
		format(o, " de ");
		f4(o, before);
		format(o, " -> ");
		f4(o, best);
		print(o);
	}
}
var untiled bool[>..];
var ut_u int[>..];
var ut_v int[>..];
fn untile() {
	let ni = gltf::images.len;
	if img_changed.len < ni { img_changed.resize(ni, 0); }
	if untiled.len < ni { untiled.resize(ni, false); }
	if ut_u.len < ni { ut_u.resize(ni, 1); }
	if ut_v.len < ni { ut_v.resize(ni, 1); }
	let am = gltf::assets[asset].materials;
	let ms = gltf::assets[asset].meshes;
	for img in ni {
		if untiled[img] { continue; }
		var mat = -1;
		var cnt = 0;
		for m in gltf::materials.len {
			let t = gltf::materials[m].base_tex.texture;
			if t >= 0 && gltf::textures[t].image == img {
				cnt++;
				mat = m;
			}
		}
		if cnt != 1 { continue; }
		if mat < am.first || mat >= am.first + am.count { continue; }
		var trefs = 0;
		for t in gltf::textures.len {
			if gltf::textures[t].image == img { trefs++; }
		}
		if trefs != 1 { continue; }
		let bt = gltf::materials[mat].base_tex;
		if bt.m.x != 1.0 || bt.m.y != 0.0 || bt.m.z != 0.0 || bt.m.w != 1.0 || bt.o.x != 0.0 || bt.o.y != 0.0 { continue; }
		var maxu f32 = 0.0;
		var maxv f32 = 0.0;
		var bad = false;
		for mi in ms.first..ms.first + ms.count {
			let mesh = gltf::meshes[mi];
			for pi in mesh.prims.count {
				let prim = gltf::prims[mesh.prims.first + pi];
				if prim.material != mat { continue; }
				for v in prim.vcount {
					let o = (prim.vfirst + v) * gltf::VERTEX_FLOATS;
					let u = gltf::verts[o + 6];
					let w = gltf::verts[o + 7];
					maxu = max(maxu, u);
					maxv = max(maxv, w);
					if u < -0.001 || w < -0.001 { bad = true; }
				}
			}
		}
		if bad { continue; }
		let nu = max(1, ceil((maxu as real) - 0.001) as int);
		let nv = max(1, ceil((maxv as real) - 0.001) as int);
		if nu == 1 && nv == 1 { continue; }
		let im = gltf::images[img];
		if nu * im.width > 4096 || nv * im.height > 4096 { continue; }
		gltf::need_pixels(img);
		var old byte[>..] = [];
		old.append(gltf::image_pixels(img));
		let nw = nu * im.width;
		let nh = nv * im.height;
		let first = gltf::pixels.len;
		for y in nh {
			let sy = y % im.height;
			for x in nw {
				let so = (sy * im.width + x % im.width) * 4;
				for c in 4 {
					gltf::pixels.push(old[so + c]);
				}
			}
		}
		gltf::images[img] = gltf::Image { width: nw, height: nh, pixels: gltf::Span { first: first, count: nw * nh * 4 }, ok: true, .. };
		if img < s3d::tex_srgb.len {
			s3d::tex_srgb[img] = gfx::Texture { id: 0, .. };
		}
		gltf::materials[mat].base_tex.m = float4 { 1.0 / (nu as f32), 0.0, 0.0, 1.0 / (nv as f32) };
		gltf::materials[mat].base_tex.o = float2 { 0.0, 0.0 };
		img_changed[img] = 1;
		untiled[img] = true;
		ut_u[img] = nu;
		ut_v[img] = nv;
		print("untile ", img, " ", nu, "x", nv);
	}
}
fn pg_ratio(i int) float3 {
	let tr = lin(at(tpx, i, 0));
	let tg = lin(at(tpx, i, 1));
	let tb = lin(at(tpx, i, 2));
	let rr = lin(at(rpx, i, 0));
	let rg = lin(at(rpx, i, 1));
	let rb = lin(at(rpx, i, 2));
	let r0 = clamp((tr + 0.004) / (rr + 0.004), 0.25, 4.0);
	let g0 = clamp((tg + 0.004) / (rg + 0.004), 0.25, 4.0);
	let b0 = clamp((tb + 0.004) / (rb + 0.004), 0.25, 4.0);
	let yt = 0.2126 * tr + 0.7152 * tg + 0.0722 * tb;
	let yr = 0.2126 * rr + 0.7152 * rg + 0.0722 * rb;
	let lr = clamp((yt + 0.004) / (yr + 0.004), 0.25, 4.0);
	float3 {
		lr * sq(clamp(r0 / lr, 0.5, 2.0)),
		lr * sq(clamp(g0 / lr, 0.5, 2.0)),
		lr * sq(clamp(b0 / lr, 0.5, 2.0))
	}
}
fn pg_lum(i int) f32 {
	0.2126 * lin(at(tpx, i, 0)) + 0.7152 * lin(at(tpx, i, 1)) + 0.0722 * lin(at(tpx, i, 2))
}
fn pg_edge(i int) bool {
	let x = i % tw;
	let y = i / tw;
	if x == 0 || y == 0 || x == tw - 1 || y == th - 1 { return true; }
	let e = abs(pg_lum(i - 1) - pg_lum(i + 1)) + abs(pg_lum(i - tw) - pg_lum(i + tw));
	e > 0.15
}
fn pg_integral(src real[:], out real[>..]&) {
	let w1 = tw + 1;
	out.clear();
	out.resize(w1 * (th + 1), 0.0);
	for y in th {
		for x in tw {
			out[(y + 1) * w1 + x + 1] = src[y * tw + x] + out[y * w1 + x + 1] + out[(y + 1) * w1 + x] - out[y * w1 + x];
		}
	}
}
fn pg_box(ig real[:], x0 int, y0 int, x1 int, y1 int) real {
	let w1 = tw + 1;
	ig[y1 * w1 + x1] - ig[y0 * w1 + x1] - ig[y1 * w1 + x0] + ig[y0 * w1 + x0]
}
fn paint_gather() {
	raster();
	let n = tw * th;
	let detail = cur != 0 && !v_fix[cur];
	for i in n {
		let im = hit_img[i];
		if im >= 0 && g_off[im] < 0 {
			let img = gltf::images[im];
			let gw = (img.width + pcell - 1) / pcell;
			let gh = (img.height + pcell - 1) / pcell;
			g_off[im] = g_r.len;
			g_w[im] = gw;
			g_r.resize(g_r.len + gw * gh, 0.0);
			g_g.resize(g_g.len + gw * gh, 0.0);
			g_b.resize(g_b.len + gw * gh, 0.0);
			g_c.resize(g_c.len + gw * gh, 0);
		}
	}
	var ok byte[>..] = [];
	ok.resize(n, 0);
	var rat float3[>..] = [];
	rat.resize(n, float3 { 1.0, 1.0, 1.0 });
	for i in n {
		if tmask[i] != 1.0 || rmask[i] != 1.0 || hit_img[i] < 0 { continue; }
		if hit_f[i] < 0.5 { continue; }
		let tx = texel(hit_img[i], hit_u[i], hit_v[i]);
		if gltf::pixels[tx + 3] < 230 { continue; }
		let x = i % tw;
		let y = i / tw;
		var same = true;
		for dy in -2..3 {
			for dx in -2..3 {
				let xx = x + dx;
				let yy = y + dy;
				if xx >= 0 && xx < tw && yy >= 0 && yy < th {
					if hit_img[yy * tw + xx] != hit_img[i] { same = false; }
				}
			}
		}
		if !same { continue; }
		if pcell == 1 && pg_edge(i) { continue; }
		ok[i] = 1;
		rat[i] = pg_ratio(i);
	}
	var ir real[>..] = [];
	var ig real[>..] = [];
	var ib real[>..] = [];
	var ic real[>..] = [];
	if detail {
		var sr real[>..] = [];
		var sg real[>..] = [];
		var sb real[>..] = [];
		var sc real[>..] = [];
		sr.resize(n, 0.0);
		sg.resize(n, 0.0);
		sb.resize(n, 0.0);
		sc.resize(n, 0.0);
		for i in n {
			if ok[i] != 0 {
				sr[i] = rat[i].x as real;
				sg[i] = rat[i].y as real;
				sb[i] = rat[i].z as real;
				sc[i] = 1.0;
			}
		}
		pg_integral(sr, ir);
		pg_integral(sg, ig);
		pg_integral(sb, ib);
		pg_integral(sc, ic);
	}
	for i in n {
		if ok[i] == 0 { continue; }
		var r = rat[i];
		if detail {
			let x = i % tw;
			let y = i / tw;
			let x0 = max(0, x - 15);
			let y0 = max(0, y - 15);
			let x1 = min(tw - 1, x + 15) + 1;
			let y1 = min(th - 1, y + 15) + 1;
			let c = pg_box(ic, x0, y0, x1, y1);
			if c < 50.0 { continue; }
			let mr = (pg_box(ir, x0, y0, x1, y1) / c) as f32;
			let mg = (pg_box(ig, x0, y0, x1, y1) / c) as f32;
			let mb = (pg_box(ib, x0, y0, x1, y1) / c) as f32;
			r = float3 { clamp(r.x / mr, 0.5, 2.0), clamp(r.y / mg, 0.5, 2.0), clamp(r.z / mb, 0.5, 2.0) };
		}
		let im = hit_img[i];
		let img = gltf::images[im];
		let gw = g_w[im];
		let gh = (img.height + pcell - 1) / pcell;
		let u = hit_u[i] as real;
		let v = hit_v[i] as real;
		let fu = u - floor(u);
		let fv = v - floor(v);
		let cx = clamp(floor(fu * (img.width as real) / (pcell as real)) as int, 0, gw - 1);
		let cy = clamp(floor(fv * (img.height as real) / (pcell as real)) as int, 0, gh - 1);
		let ci = g_off[im] + cy * gw + cx;
		let wt = pow(hit_f[i] as real, 7.0) * (if v_fix[cur] { 4.0 } else { 1.0 });
		let cw = max(1, round(wt * 16.0) as int);
		let cwf = cw as f32;
		g_r[ci] += r.x * cwf;
		g_g[ci] += r.y * cwf;
		g_b[ci] += r.z * cwf;
		g_c[ci] += cw;
	}
}
var g_abs byte[>..];
fn paint(fine bool) int {
	let ni = gltf::images.len;
	g_off.clear();
	g_off.resize(ni, -1);
	g_w.clear();
	g_w.resize(ni, 0);
	g_r.clear();
	g_g.clear();
	g_b.clear();
	g_c.clear();
	g_abs.clear();
	img_changed.clear();
	img_changed.resize(ni, 0);
	var sr f32[>..] = [];
	var sg f32[>..] = [];
	var sb f32[>..] = [];
	var sc int[>..] = [];
	var old = 0;
	fn restore(i int) {
		if i < old {
			g_r[i] = sr[i];
			g_g[i] = sg[i];
			g_b[i] = sb[i];
			g_c[i] = sc[i];
		} else {
			g_r[i] = 0.0;
			g_g[i] = 0.0;
			g_b[i] = 0.0;
			g_c[i] = 0;
		}
	}
	for pass in 2 {
		for k in nview {
			let absk = k == 0 || v_fix[k];
			if fine && !absk { continue; }
			if (pass == 0) != absk { continue; }
			use_view(k);
			shot(cam_eye, cam_look);
			sr.clear();
			sg.clear();
			sb.clear();
			sc.clear();
			sr.append(g_r);
			sg.append(g_g);
			sb.append(g_b);
			sc.append(g_c);
			old = g_c.len;
			paint_gather();
			if g_abs.len < g_c.len { g_abs.resize(g_c.len, 0); }
			if !absk {
				for i in g_c.len {
					if g_abs[i] != 0 { restore(i); }
				}
			} else if fine && k == 0 {
				for im in ni {
					if g_off[im] < 0 { continue; }
					let ut = im < untiled.len && untiled[im];
					if ut { continue; }
					let gh = (gltf::images[im].height + pcell - 1) / pcell;
					for i in g_off[im]..g_off[im] + g_w[im] * gh { restore(i); }
				}
			}
			if absk {
				for i in g_c.len {
					let before = if i < old { sc[i] } else { 0 };
					if g_c[i] != before { g_abs[i] = 1; }
				}
			}
		}
	}
	var changed = 0;
	let dxs int[4] = [1, -1, 0, 0];
	let dys int[4] = [0, 0, 1, -1];
	for im in ni {
		if g_off[im] < 0 { continue; }
		let img = gltf::images[im];
		let gw = g_w[im];
		let gh = (img.height + pcell - 1) / pcell;
		let cells = gw * gh;
		let off = g_off[im];
		var lr f32[>..] = [];
		var lg f32[>..] = [];
		var lb f32[>..] = [];
		var st f32[>..] = [];
		lr.resize(cells, 0.0);
		lg.resize(cells, 0.0);
		lb.resize(cells, 0.0);
		st.resize(cells, 0.0);
		for c in cells {
			let cn = g_c[off + c];
			if cn > 0 {
				let cf = cn as f32;
				lr[c] = log((g_r[off + c] / cf) as real) as f32;
				lg[c] = log((g_g[off + c] / cf) as real) as f32;
				lb[c] = log((g_b[off + c] / cf) as real) as f32;
				st[c] = 1.0;
			}
		}
		for round in 7 {
			var nr f32[>..] = [];
			var ng f32[>..] = [];
			var nb f32[>..] = [];
			var ns f32[>..] = [];
			nr.append(lr);
			ng.append(lg);
			nb.append(lb);
			ns.append(st);
			for cy in gh {
				for cx in gw {
					let c = cy * gw + cx;
					if g_c[off + c] > 0 { continue; }
					var sw f32 = 0.0;
					var ar f32 = 0.0;
					var ag f32 = 0.0;
					var ab f32 = 0.0;
					var cnt = 0;
					for d in 4 {
						let x = cx + dxs[d];
						let y = cy + dys[d];
						if x < 0 || y < 0 || x >= gw || y >= gh { continue; }
						let j = y * gw + x;
						if st[j] > 0.0 {
							sw += st[j];
							ar += st[j] * lr[j];
							ag += st[j] * lg[j];
							ab += st[j] * lb[j];
							cnt++;
						}
					}
					if cnt > 0 {
						nr[c] = ar / sw;
						ng[c] = ag / sw;
						nb[c] = ab / sw;
						ns[c] = 0.7 * sw / (cnt as f32);
					}
				}
			}
			lr.clear();
			lg.clear();
			lb.clear();
			st.clear();
			lr.append(nr);
			lg.append(ng);
			lb.append(nb);
			st.append(ns);
		}
		gltf::need_pixels(im);
		var any = false;
		for cy in gh {
			for cx in gw {
				let c = cy * gw + cx;
				let s = st[c];
				if s <= 0.01 { continue; }
				changed++;
				any = true;
				let f0 = exp((0.8 * s * lr[c]) as real) as f32;
				let f1 = exp((0.8 * s * lg[c]) as real) as f32;
				let f2 = exp((0.8 * s * lb[c]) as real) as f32;
				let fs f32[3] = [f0, f1, f2];
				for ty in cy * pcell..min((cy + 1) * pcell, img.height) {
					for tx in cx * pcell..min((cx + 1) * pcell, img.width) {
						let o = img.pixels.first + (ty * img.width + tx) * 4;
						for ch in 3 {
							let l = clamp(lin(gltf::pixels[o + ch] as f32) * fs[ch], 0.0, 1.0);
							gltf::pixels[o + ch] = clamp(round(enc(l) as real), 0.0, 255.0) as byte;
						}
					}
				}
			}
		}
		if any { img_changed[im] = 1; }
	}
	for im in ni {
		if img_changed[im] != 0 && im < s3d::tex_srgb.len {
			if s3d::tex_srgb[im].id != 0 {
				gfx::update_texture(s3d::tex_srgb[im], gltf::image_pixels(im));
				gfx::generate_mips(s3d::tex_srgb[im]);
			}
		}
	}
	return changed;
}
var pose_t float3[>..];
var pose_r linalg::Quat[>..];
var pose_s float3[>..];
fn f4(out byte[>..]&, v f32) {
	format_flt(out, v as real, 4);
}
fn fl(out byte[>..]&, v f32) {
	out.push(' ');
	format_flt(out, v as real, 6);
}
fn qconj(q linalg::Quat) linalg::Quat {
	linalg::Quat { -q.x, -q.y, -q.z, q.w }
}
fn sq(v f32) f32 {
	sqrt(v as real) as f32
}
fn col(m gfx::mat4, x f32, y f32, z f32) float3 {
	let o = linalg::point(m, float3 { 0.0, 0.0, 0.0 });
	let p = linalg::point(m, float3 { x, y, z });
	linalg::unit3(float3 { p.x - o.x, p.y - o.y, p.z - o.z })
}
fn mquat(m gfx::mat4) linalg::Quat {
	let c0 = col(m, 1.0, 0.0, 0.0);
	let c1 = col(m, 0.0, 1.0, 0.0);
	let c2 = col(m, 0.0, 0.0, 1.0);
	let m00 = c0.x;
	let m10 = c0.y;
	let m20 = c0.z;
	let m01 = c1.x;
	let m11 = c1.y;
	let m21 = c1.z;
	let m02 = c2.x;
	let m12 = c2.y;
	let m22 = c2.z;
	let tr = m00 + m11 + m22;
	if tr > 0.0 {
		let s = sq(tr + 1.0) * 2.0;
		return linalg::Quat { (m21 - m12) / s, (m02 - m20) / s, (m10 - m01) / s, 0.25 * s };
	}
	if m00 > m11 && m00 > m22 {
		let s = sq(1.0 + m00 - m11 - m22) * 2.0;
		return linalg::Quat { 0.25 * s, (m01 + m10) / s, (m02 + m20) / s, (m21 - m12) / s };
	}
	if m11 > m22 {
		let s = sq(1.0 + m11 - m00 - m22) * 2.0;
		return linalg::Quat { (m01 + m10) / s, 0.25 * s, (m12 + m21) / s, (m02 - m20) / s };
	}
	let s = sq(1.0 + m22 - m00 - m11) * 2.0;
	return linalg::Quat { (m02 + m20) / s, (m12 + m21) / s, 0.25 * s, (m10 - m01) / s };
}
fn angle_of(node int) f32 {
	var a f32 = 0.0;
	for k in pose_n.len { if pose_n[k] == node { a = pose_a[k]; } }
	a
}
fn turn(node int, ang f32) {
	let n = gltf::nodes[node];
	let p = n.parent;
	var axis = float3 { 0.0, 0.0, 1.0 };
	if p >= 0 {
		axis = linalg::unit3(linalg::qrotate(qconj(mquat(motion::world[p])), float3 { 0.0, 0.0, 1.0 }));
	}
	let r = linalg::qnorm(linalg::qmul(linalg::qaxis(axis, ang), n.r));
	s3d::set_node(item, node, n.t, r, n.s);
	var k = -1;
	for i in pose_n.len { if pose_n[i] == node { k = i; } }
	if k >= 0 {
		pose_a[k] = ang;
		pose_t[k] = n.t;
		pose_r[k] = r;
		pose_s[k] = n.s;
	} else {
		pose_n.push(node);
		pose_a.push(ang);
		pose_t.push(n.t);
		pose_r.push(r);
		pose_s.push(n.s);
	}
}
fn score() f32 {
	if nview == 0 { return 0.0; }
	var total f32 = 0.0;
	for k in nview {
		use_view(k);
		shot(cam_eye, cam_look);
		var inter f32 = 0.0;
		var uni f32 = 0.0;
		for i in tw * th {
			inter += min(tmask[i], rmask[i]);
			uni += max(tmask[i], rmask[i]);
		}
		let v f32 = if uni > 0.0 { inter / uni } else { 0.0 };
		total += v;
	}
	total / (nview as f32)
}
fn joint_name(i int) const byte[:] {
	match i {
		0 => "upperarm_l",
		1 => "upperarm_r",
		2 => "lowerarm_l",
		3 => "lowerarm_r",
		4 => "thigh_l",
		5 => "thigh_r",
		6 => "calf_l",
		_ => "calf_r",
	}
}
fn pose_fit() {
	fast = true;
	s3d::pose(item);
	let steps f32[5] = [0.28, 0.14, 0.07, 0.035, 0.014];
	for pass in 2 {
		for j in 8 {
			let node = gltf::find_node(asset, joint_name(j));
			if node < 0 { continue; }
			var a0 = angle_of(node);
			var best = score();
			for st in steps {
				turn(node, a0 + st);
				let s1 = score();
				turn(node, a0 - st);
				let s2 = score();
				if s1 > best && s1 >= s2 {
					a0 += st;
					best = s1;
				} else if s2 > best {
					a0 -= st;
					best = s2;
				}
				turn(node, a0);
			}
		}
	}
	fast = false;
	var o byte[>..] = [];
	format(o, "pose");
	for j in 8 {
		let node = gltf::find_node(asset, joint_name(j));
		if node < 0 { continue; }
		format(o, " ", joint_name(j), " ");
		f4(o, angle_of(node));
	}
	print(o);
}
fn save_pose(path const byte[:]) {
	var o byte[>..] = [];
	for k in pose_n.len {
		var nm const byte[:] = "";
		for j in 8 {
			if gltf::find_node(asset, joint_name(j)) == pose_n[k] { nm = joint_name(j); }
		}
		o.append(nm);
		fl(o, pose_t[k].x);
		fl(o, pose_t[k].y);
		fl(o, pose_t[k].z);
		fl(o, pose_r[k].x);
		fl(o, pose_r[k].y);
		fl(o, pose_r[k].z);
		fl(o, pose_r[k].w);
		fl(o, pose_s[k].x);
		fl(o, pose_s[k].y);
		fl(o, pose_s[k].z);
		o.push('\n');
	}
	write_file(path, o);
}
fn tm_at(px int, py int) f32 {
	if px < 0 || py < 0 || px >= tw || py >= th { return 0.0; }
	tmask[py * tw + px]
}
fn sm_at(px int, py int) f32 {
	sm[clamp(py, 0, th - 1) * tw + clamp(px, 0, tw - 1)]
}
fn shape_gather() {
	shot(cam_eye, cam_look);
	raster();
	let n = tw * th;
	sm.clear();
	sm.resize(n, 0.0);
	for y in th {
		for x in tw {
			var s f32 = 0.0;
			var c = 0;
			for dy in -2..3 {
				for dx in -2..3 {
					let xx = x + dx;
					let yy = y + dy;
					if xx >= 0 && xx < tw && yy >= 0 && yy < th {
						s += rmask[yy * tw + xx];
						c++;
					}
				}
			}
			sm[y * tw + x] = s / (c as f32);
		}
	}
	let wpp = (2.0 * (v_d[cur] as real) * tan((fov as real) / 2.0) / (th as real)) as f32;
	let rv = right_of(cur);
	for g in vx.len {
		if vw[g] <= 0.0 { continue; }
		let px = floor(vx[g] as real) as int;
		let py = floor(vy[g] as real) as int;
		if px < 0 || py < 0 || px >= tw || py >= th { continue; }
		let i = py * tw + px;
		if vz[g] > zb[i] + 0.0005 { continue; }
		if rmask[i] < 0.5 { continue; }
		var edge = false;
		for dy in -2..3 {
			for dx in -2..3 {
				let xx = px + dx;
				let yy = py + dy;
				if xx >= 0 && xx < tw && yy >= 0 && yy < th {
					if rmask[yy * tw + xx] < 0.5 { edge = true; }
				}
			}
		}
		if !edge { continue; }
		let gx = (sm_at(px + 1, py) - sm_at(px - 1, py)) / 2.0;
		let gy = (sm_at(px, py + 1) - sm_at(px, py - 1)) / 2.0;
		let gl = sq(gx * gx + gy * gy);
		if gl < 0.01 { continue; }
		let nx = -gx / gl;
		let ny = -gy / gl;
		let inside = tm_at(px, py) >= 0.5;
		var offset f32 = 0.0;
		var found = false;
		var s = 1;
		while s <= 40 && !found {
			let qx = floor((vx[g] + nx * (s as f32)) as real) as int;
			let qy = floor((vy[g] + ny * (s as f32)) as real) as int;
			let t = tm_at(qx, qy);
			if inside {
				if t < 0.5 {
					offset = (s as f32) - 0.5;
					found = true;
				}
			} else {
				if t >= 0.5 {
					offset = 0.5 - (s as f32);
					found = true;
				}
			}
			s++;
		}
		if !found { continue; }
		let k = 0.7 * offset * wpp;
		let wm = float3 { rv.x * nx * k, (rv.y * nx - ny) * k, rv.z * nx * k };
		let o = g * gltf::VERTEX_FLOATS;
		c_p.push(float3 { gltf::verts[o], gltf::verts[o + 1], gltf::verts[o + 2] });
		c_m.push(linalg::qrotate(vrot[g], wm));
	}
}
fn shape_fit(round int) int {
	c_p.clear();
	c_m.clear();
	for k in nview {
		if v_fix[k] { continue; }
		use_view(k);
		shape_gather();
	}
	let sigma real = 0.035;
	let r3 = (3.0 * sigma) * (3.0 * sigma);
	let den = 2.0 * sigma * sigma;
	let nc = c_p.len;
	let am = gltf::assets[asset].meshes;
	for mi in am.first..am.first + am.count {
		let mesh = gltf::meshes[mi];
		for pi in mesh.prims.count {
			let prim = gltf::prims[mesh.prims.first + pi];
			for v in prim.vcount {
				let o = (prim.vfirst + v) * gltf::VERTEX_FLOATS;
				let px = gltf::verts[o];
				let py = gltf::verts[o + 1];
				let pz = gltf::verts[o + 2];
				var sw real = 0.0;
				var mx real = 0.0;
				var my real = 0.0;
				var mz real = 0.0;
				for c in nc {
					let dx = (px - c_p[c].x) as real;
					let dy = (py - c_p[c].y) as real;
					let dz = (pz - c_p[c].z) as real;
					let d2 = dx * dx + dy * dy + dz * dz;
					if d2 > r3 { continue; }
					let w = exp(-d2 / den);
					sw += w;
					mx += w * (c_m[c].x as real);
					my += w * (c_m[c].y as real);
					mz += w * (c_m[c].z as real);
				}
				if sw > 0.0 {
					let dv = max(sw, 1.0);
					gltf::verts[o] = px + (mx / dv) as f32;
					gltf::verts[o + 1] = py + (my / dv) as f32;
					gltf::verts[o + 2] = pz + (mz / dv) as f32;
				}
			}
		}
	}
	s3d::uploaded_verts = -2;
	shape_changed = true;
	return nc;
}
fn set_lights() {
	let ca = atan2((cam_eye.x - cam_look.x) as real, (cam_eye.z - cam_look.z) as real) as f32;
	let cs = cos(ca as real) as f32;
	let sn = sin(ca as real) as f32;
	fn rot(x f32, y f32, z f32) float3 {
		float3 { x * cs + z * sn, y, -x * sn + z * cs }
	}
	let k = 2.2 * key_k;
	s3d::sun = s3d::Sun { to_sun: linalg::unit3(rot(0.35 + sun_az, 0.8 + sun_el, 1.0)), rgb: float3 { k, k, k }, shadows: true, shadow_far: 10.0, map_size: 2048 };
	s3d::lights.clear();
	let fl = 260.0 * fill_k;
	s3d::add_light(rot(-14.0, 7.0, 14.0), float3 { fl, fl, fl }, 1000.0);
	s3d::sky.ambient = amb_k;
}
fn tone() f32 {
	var total f32 = 0.0;
	var cnt = 0;
	for k in nview {
		if !(k == 0 || v_fix[k]) { continue; }
		use_view(k);
		shot(cam_eye, cam_look);
		var sum f32 = 0.0;
		var c = 0;
		for i in tw * th {
			if tmask[i] == 1.0 && rmask[i] == 1.0 {
				sum += de2000(lab(at(tpx, i, 0), at(tpx, i, 1), at(tpx, i, 2)), lab(at(rpx, i, 0), at(rpx, i, 1), at(rpx, i, 2)));
				c++;
			}
		}
		let v f32 = if c > 0 { sum / (c as f32) } else { 1000.0 };
		total += v;
		cnt++;
	}
	if cnt == 0 { return 0.0; }
	total / (cnt as f32)
}
fn lf_get(k int) f32 {
	match k {
		0 => key_k,
		1 => fill_k,
		2 => amb_k,
		3 => sun_az,
		_ => sun_el,
	}
}
fn lf_set(k int, v f32) {
	match k {
		0 => { key_k = v; },
		1 => { fill_k = v; },
		2 => { amb_k = v; },
		3 => { sun_az = v; },
		_ => { sun_el = v; },
	}
}
fn light_fit() {
	fast = true;
	set_lights();
	var best = tone();
	for pass in 3 {
		for k in 5 {
			for s in 2 {
				let old = lf_get(k);
				var up f32 = old;
				var dn f32 = old;
				if k < 3 {
					let m f32 = if s == 0 { 1.25 } else { 1.1 };
					up = old * m;
					dn = old / m;
				} else {
					let m f32 = if s == 0 { 0.2 } else { 0.07 };
					up = old + m;
					dn = old - m;
				}
				lf_set(k, up);
				set_lights();
				let t1 = tone();
				if t1 < best {
					best = t1;
				} else {
					lf_set(k, dn);
					set_lights();
					let t2 = tone();
					if t2 < best {
						best = t2;
					} else {
						lf_set(k, old);
					}
				}
			}
		}
	}
	fast = false;
	set_lights();
	var o byte[>..] = [];
	format(o, "light key ");
	f4(o, key_k);
	format(o, " fill ");
	f4(o, fill_k);
	format(o, " amb ");
	f4(o, amb_k);
	format(o, " az ");
	f4(o, sun_az);
	format(o, " el ");
	f4(o, sun_el);
	print(o);
}
fn emit(d json::Doc&, n int, out byte[>..]&) {
	json::format_node(out, d, n);
}
var eg_off int[>..];
var eg_dead bool[>..];
var eg_ioff int[>..];
var eg_ilen int[>..];
var eg_ijpg bool[>..];
var eg_ivw int[>..];
var eg_aflag bool[>..];
var eg_amin float3[>..];
var eg_amax float3[>..];
fn eg_u32(b const byte[:], at int) int {
	(b[at] as int) + (b[at + 1] as int) * 256 + (b[at + 2] as int) * 65536 + (b[at + 3] as int) * 16777216
}
fn eg_p32(o byte[>..]&, v int) {
	o.push((v % 256) as byte);
	o.push(((v / 256) % 256) as byte);
	o.push(((v / 65536) % 256) as byte);
	o.push(((v / 16777216) % 256) as byte);
}
fn eg_pad(o byte[>..]&) {
	while o.len % 4 != 0 { o.push(0); }
}
fn eg_int(d json::Doc&, n int, key const byte[:], def int) int {
	let m = json::member(d, n, key);
	if m < 0 { return def; }
	var t byte[>..] = [];
	emit(d, m, t);
	let v, ok = parse_flt(t);
	if !ok { return def; }
	v as int
}
fn eg_count(d json::Doc&, n int) int {
	var i = 0;
	while json::element(d, n, i) >= 0 { i++; }
	i
}
fn eg_k(o byte[>..]&, first bool&, name const byte[:]) {
	if !first { o.push(','); }
	first = false;
	json::format_key(o, name);
}
fn eg_num(o byte[>..]&, v f32) {
	json::format_number(o, v as real);
}
fn eg_f3(o byte[>..]&, a float3) {
	o.push('[');
	eg_num(o, a.x);
	o.push(',');
	eg_num(o, a.y);
	o.push(',');
	eg_num(o, a.z);
	o.push(']');
}
fn eg_tt(o byte[>..]&, nu int, nv int) {
	o.append("\"KHR_texture_transform\":{\"scale\":[");
	eg_num(o, 1.0 / (nu as f32));
	o.push(',');
	eg_num(o, 1.0 / (nv as f32));
	o.append("]}");
}
fn eg_bext(d json::Doc&, n int, o byte[>..]&, nu int, nv int) {
	o.push('{');
	var first = true;
	json::each(d, n) { c =>
		let nm = json::name_of(d, c);
		if nm != "KHR_texture_transform" {
			eg_k(o, first, nm);
			emit(d, c, o);
		}
	};
	if !first { o.push(','); }
	eg_tt(o, nu, nv);
	o.push('}');
}
fn eg_bct(d json::Doc&, n int, o byte[>..]&, nu int, nv int) {
	o.push('{');
	var first = true;
	var seen = false;
	json::each(d, n) { c =>
		let nm = json::name_of(d, c);
		eg_k(o, first, nm);
		if nm == "extensions" {
			eg_bext(d, c, o, nu, nv);
			seen = true;
		} else {
			emit(d, c, o);
		}
	};
	if !seen {
		eg_k(o, first, "extensions");
		o.push('{');
		eg_tt(o, nu, nv);
		o.push('}');
	}
	o.push('}');
}
fn eg_pbr(d json::Doc&, n int, o byte[>..]&, gm int, ut bool, nu int, nv int) {
	o.push('{');
	var first = true;
	var seen = false;
	json::each(d, n) { c =>
		let nm = json::name_of(d, c);
		eg_k(o, first, nm);
		if nm == "roughnessFactor" && mat_changed {
			eg_num(o, gltf::materials[gm].roughness);
			seen = true;
		} else if nm == "baseColorTexture" && ut {
			eg_bct(d, c, o, nu, nv);
		} else {
			emit(d, c, o);
		}
	};
	if mat_changed && !seen {
		eg_k(o, first, "roughnessFactor");
		eg_num(o, gltf::materials[gm].roughness);
	}
	o.push('}');
}
fn eg_normal(d json::Doc&, n int, o byte[>..]&, gm int) {
	o.push('{');
	var first = true;
	var seen = false;
	json::each(d, n) { c =>
		let nm = json::name_of(d, c);
		eg_k(o, first, nm);
		if nm == "scale" {
			eg_num(o, gltf::materials[gm].normal_scale);
			seen = true;
		} else {
			emit(d, c, o);
		}
	};
	if !seen {
		eg_k(o, first, "scale");
		eg_num(o, gltf::materials[gm].normal_scale);
	}
	o.push('}');
}
fn eg_sheen(d json::Doc&, n int, o byte[>..]&, gm int) {
	o.push('{');
	var first = true;
	var seen = false;
	json::each(d, n) { c =>
		let nm = json::name_of(d, c);
		eg_k(o, first, nm);
		if nm == "sheenColorFactor" {
			eg_f3(o, gltf::materials[gm].sheen);
			seen = true;
		} else {
			emit(d, c, o);
		}
	};
	if !seen {
		eg_k(o, first, "sheenColorFactor");
		eg_f3(o, gltf::materials[gm].sheen);
	}
	o.push('}');
}
fn eg_mext(d json::Doc&, n int, o byte[>..]&, gm int) {
	o.push('{');
	var first = true;
	json::each(d, n) { c =>
		let nm = json::name_of(d, c);
		eg_k(o, first, nm);
		if nm == "KHR_materials_sheen" {
			eg_sheen(d, c, o, gm);
		} else {
			emit(d, c, o);
		}
	};
	o.push('}');
}
fn eg_mat(d json::Doc&, n int, o byte[>..]&, gm int) {
	let mt = gltf::materials[gm];
	var ut = false;
	var nu = 1;
	var nv = 1;
	if mt.base_tex.texture >= 0 {
		let im = gltf::textures[mt.base_tex.texture].image;
		if im >= 0 && im < untiled.len && untiled[im] {
			ut = true;
			nu = ut_u[im];
			nv = ut_v[im];
		}
	}
	o.push('{');
	var first = true;
	json::each(d, n) { c =>
		let nm = json::name_of(d, c);
		eg_k(o, first, nm);
		if nm == "pbrMetallicRoughness" {
			eg_pbr(d, c, o, gm, ut, nu, nv);
		} else if nm == "normalTexture" && mat_changed {
			eg_normal(d, c, o, gm);
		} else if nm == "extensions" && mat_changed {
			eg_mext(d, c, o, gm);
		} else {
			emit(d, c, o);
		}
	};
	o.push('}');
}
fn eg_mats(d json::Doc&, n int, o byte[>..]&, mfirst int) {
	o.push('[');
	var i = 0;
	while json::element(d, n, i) >= 0 {
		if i > 0 { o.push(','); }
		eg_mat(d, json::element(d, n, i), o, mfirst + i);
		i++;
	}
	o.push(']');
}
fn eg_acc(d json::Doc&, n int, o byte[>..]&, ai int) {
	o.push('{');
	var first = true;
	var smin = false;
	var smax = false;
	json::each(d, n) { c =>
		let nm = json::name_of(d, c);
		eg_k(o, first, nm);
		if nm == "min" {
			eg_f3(o, eg_amin[ai]);
			smin = true;
		} else if nm == "max" {
			eg_f3(o, eg_amax[ai]);
			smax = true;
		} else {
			emit(d, c, o);
		}
	};
	if !smin {
		eg_k(o, first, "min");
		eg_f3(o, eg_amin[ai]);
	}
	if !smax {
		eg_k(o, first, "max");
		eg_f3(o, eg_amax[ai]);
	}
	o.push('}');
}
fn eg_accs(d json::Doc&, n int, o byte[>..]&) {
	o.push('[');
	var i = 0;
	while json::element(d, n, i) >= 0 {
		if i > 0 { o.push(','); }
		let an = json::element(d, n, i);
		if i < eg_aflag.len && eg_aflag[i] {
			eg_acc(d, an, o, i);
		} else {
			emit(d, an, o);
		}
		i++;
	}
	o.push(']');
}
fn eg_views(d json::Doc&, n int, o byte[>..]&, nbv int) {
	o.push('[');
	for v in nbv {
		if v > 0 { o.push(','); }
		let bn = json::element(d, n, v);
		if eg_dead[v] {
			o.append("{\"buffer\":0,\"byteOffset\":0,\"byteLength\":4}");
			continue;
		}
		o.push('{');
		var first = true;
		var seen = false;
		json::each(d, bn) { c =>
			let nm = json::name_of(d, c);
			eg_k(o, first, nm);
			if nm == "byteOffset" {
				format(o, eg_off[v]);
				seen = true;
			} else {
				emit(d, c, o);
			}
		};
		if !seen {
			eg_k(o, first, "byteOffset");
			format(o, eg_off[v]);
		}
		o.push('}');
	}
	for k in eg_ivw.len {
		if eg_ivw[k] >= 0 {
			o.push(',');
			format(o, "{\"buffer\":0,\"byteOffset\":", eg_ioff[k], ",\"byteLength\":", eg_ilen[k], "}");
		}
	}
	o.push(']');
}
fn eg_images(d json::Doc&, n int, o byte[>..]&, nim int) {
	o.push('[');
	for k in nim {
		if k > 0 { o.push(','); }
		let node = json::element(d, n, k);
		if eg_ivw[k] >= 0 {
			format(o, "{\"bufferView\":", eg_ivw[k], ",\"mimeType\":");
			if eg_ijpg[k] { o.append("\"image/jpeg\""); } else { o.append("\"image/png\""); }
			o.append(",\"name\":");
			let nm = json::member(d, node, "name");
			if nm >= 0 { emit(d, nm, o); } else { o.append("\"\""); }
			o.push('}');
		} else {
			emit(d, node, o);
		}
	}
	o.push(']');
}
fn export_glb(src const byte[:], out const byte[:], prefix const byte[:]) {
	var data byte[>..] = [];
	if !read_file(src, data) { return; }
	if data.len < 28 { return; }
	let jl = eg_u32(data, 12);
	let bl = eg_u32(data, 20 + jl);
	let bstart = 28 + jl;
	let js = data[20..20 + jl];
	let bin = data[bstart..min(bstart + bl, data.len)];
	var d = json::Doc {};
	let root, perr = json::parse(js, d);
	if root < 0 { return; }
	let bvs = json::member(d, 0, "bufferViews");
	let ims = json::member(d, 0, "images");
	let accs = json::member(d, 0, "accessors");
	let mshs = json::member(d, 0, "meshes");
	let nbv = if bvs >= 0 { eg_count(d, bvs) } else { 0 };
	let nim = if ims >= 0 { eg_count(d, ims) } else { 0 };
	let nacc = if accs >= 0 { eg_count(d, accs) } else { 0 };
	let ifirst = gltf::assets[asset].images.first;
	fn chg(k int) bool {
		let g = ifirst + k;
		g < img_changed.len && img_changed[g] != 0
	}
	var live bool[>..] = [];
	var chref bool[>..] = [];
	live.resize(nbv, false);
	chref.resize(nbv, false);
	for i in nacc {
		let bv = eg_int(d, json::element(d, accs, i), "bufferView", -1);
		if bv >= 0 && bv < nbv { live[bv] = true; }
	}
	for k in nim {
		let bv = eg_int(d, json::element(d, ims, k), "bufferView", -1);
		if bv >= 0 && bv < nbv {
			if chg(k) { chref[bv] = true; } else { live[bv] = true; }
		}
	}
	eg_dead.clear();
	eg_dead.resize(nbv, false);
	for v in nbv { eg_dead[v] = chref[v] && !live[v]; }
	var nb byte[>..] = [];
	for i in 4 { nb.push(0); }
	eg_off.clear();
	eg_off.resize(nbv, 0);
	for v in nbv {
		if eg_dead[v] { continue; }
		let bn = json::element(d, bvs, v);
		let off = eg_int(d, bn, "byteOffset", 0);
		let len = eg_int(d, bn, "byteLength", 0);
		eg_off[v] = nb.len;
		if off >= 0 && len >= 0 && off + len <= bin.len { nb.append(bin[off..off + len]); }
		eg_pad(nb);
	}
	eg_ivw.clear();
	eg_ivw.resize(nim, -1);
	eg_ioff.clear();
	eg_ioff.resize(nim, 0);
	eg_ilen.clear();
	eg_ilen.resize(nim, 0);
	eg_ijpg.clear();
	eg_ijpg.resize(nim, false);
	var added = 0;
	for k in nim {
		if !chg(k) { continue; }
		let g = ifirst + k;
		let node = json::element(d, ims, k);
		var jpg = false;
		let mm = json::member(d, node, "mimeType");
		if mm >= 0 {
			var mt byte[>..] = [];
			emit(d, mm, mt);
			jpg = mt == "\"image/jpeg\"";
		}
		var bytes byte[>..] = [];
		if jpg {
			let im = gltf::images[g];
			codec_jpeg_enc::encode(gltf::image_pixels(g), im.width, im.height, 92, bytes);
		} else {
			var pth byte[>..] = [];
			format(pth, prefix, "_tex", g, ".png");
			read_file(pth, bytes);
		}
		eg_ioff[k] = nb.len;
		eg_ilen[k] = bytes.len;
		eg_ijpg[k] = jpg;
		eg_ivw[k] = nbv + added;
		added++;
		nb.append(bytes);
		eg_pad(nb);
	}
	eg_aflag.clear();
	eg_aflag.resize(nacc, false);
	eg_amin.clear();
	eg_amin.resize(nacc, float3 { 0.0, 0.0, 0.0 });
	eg_amax.clear();
	eg_amax.resize(nacc, float3 { 0.0, 0.0, 0.0 });
	if shape_changed && mshs >= 0 {
		let mf = gltf::assets[asset].meshes.first;
		for k in eg_count(d, mshs) {
			let mn = json::element(d, mshs, k);
			let prs = json::member(d, mn, "primitives");
			if prs < 0 { continue; }
			let mesh = gltf::meshes[mf + k];
			for j in mesh.prims.count {
				let pn = json::element(d, prs, j);
				if pn < 0 { continue; }
				let at = json::member(d, pn, "attributes");
				if at < 0 { continue; }
				let ai = eg_int(d, at, "POSITION", -1);
				if ai < 0 || ai >= nacc { continue; }
				let an = json::element(d, accs, ai);
				let bv = eg_int(d, an, "bufferView", -1);
				if bv < 0 || bv >= nbv { continue; }
				let bn = json::element(d, bvs, bv);
				let base = eg_off[bv] + eg_int(d, an, "byteOffset", 0);
				let stride = eg_int(d, bn, "byteStride", 12);
				let cnt = eg_int(d, an, "count", 0);
				let prim = gltf::prims[mesh.prims.first + j];
				if cnt != prim.vcount || cnt == 0 { continue; }
				var lo = float3 { 0.0, 0.0, 0.0 };
				var hi = float3 { 0.0, 0.0, 0.0 };
				for v in cnt {
					let o = (prim.vfirst + v) * gltf::VERTEX_FLOATS;
					let x = gltf::verts[o];
					let y = gltf::verts[o + 1];
					let z = gltf::verts[o + 2];
					let fa f32[3] = [x, y, z];
					let bb = bytes_of(fa);
					let p = base + v * stride;
					if p >= 0 && p + 12 <= nb.len {
						for q in 12 { nb[p + q] = bb[q]; }
					}
					if v == 0 {
						lo = float3 { x, y, z };
						hi = float3 { x, y, z };
					} else {
						lo = float3 { min(lo.x, x), min(lo.y, y), min(lo.z, z) };
						hi = float3 { max(hi.x, x), max(hi.y, y), max(hi.z, z) };
					}
				}
				eg_aflag[ai] = true;
				eg_amin[ai] = lo;
				eg_amax[ai] = hi;
			}
		}
	}
	eg_pad(nb);
	let mfirst = gltf::assets[asset].materials.first;
	var jo byte[>..] = [];
	jo.push('{');
	var first = true;
	json::each(d, 0) { c =>
		let nm = json::name_of(d, c);
		eg_k(jo, first, nm);
		if nm == "buffers" {
			format(jo, "[{\"byteLength\":", nb.len, "}]");
		} else if nm == "bufferViews" {
			eg_views(d, c, jo, nbv);
		} else if nm == "images" {
			eg_images(d, c, jo, nim);
		} else if nm == "accessors" && shape_changed {
			eg_accs(d, c, jo);
		} else if nm == "materials" {
			eg_mats(d, c, jo, mfirst);
		} else {
			emit(d, c, jo);
		}
	};
	jo.push('}');
	while jo.len % 4 != 0 { jo.push(' '); }
	var fo byte[>..] = [];
	let total = 12 + 8 + jo.len + 8 + nb.len;
	fo.append("glTF");
	eg_p32(fo, 2);
	eg_p32(fo, total);
	eg_p32(fo, jo.len);
	fo.append("JSON");
	fo.append(jo);
	eg_p32(fo, nb.len);
	fo.append("BIN");
	fo.push(0);
	fo.append(nb);
	write_file(out, fo);
	print("glb ", out);
}
fn report(tag const byte[:], save bool, prefix const byte[:]) {
	var si f32 = 0.0;
	var ss f32 = 0.0;
	var sd f32 = 0.0;
	var sg f32 = 0.0;
	for k in nview {
		use_view(k);
		shot(cam_eye, cam_look);
		var heat byte[>..] = [];
		let iou, ssim, de, good = metrics(heat);
		si += iou;
		ss += ssim;
		sd += de;
		sg += good;
		var o byte[>..] = [];
		format(o, tag, " v", k, " iou ");
		f4(o, iou);
		format(o, " ssim ");
		f4(o, ssim);
		format(o, " de ");
		f4(o, de);
		format(o, " good ");
		f4(o, good);
		format(o, " cam ");
		f4(o, v_cx[k]);
		format(o, " ");
		f4(o, v_cy[k]);
		format(o, " ");
		f4(o, v_d[k]);
		print(o);
		if save {
			raster();
			let ng = gltf::images.len + 1;
			var gcnt int[>..] = [];
			var ggood int[>..] = [];
			var gsum f32[>..] = [];
			gcnt.resize(ng, 0);
			ggood.resize(ng, 0);
			gsum.resize(ng, 0.0);
			var total = 0;
			for i in tw * th {
				if tmask[i] == 1.0 && rmask[i] == 1.0 {
					let g = hit_img[i] + 1;
					let d = de2000(lab(at(tpx, i, 0), at(tpx, i, 1), at(tpx, i, 2)), lab(at(rpx, i, 0), at(rpx, i, 1), at(rpx, i, 2)));
					gcnt[g] += 1;
					gsum[g] += d;
					if d < 3.0 { ggood[g] += 1; }
					total++;
				}
			}
			var loss f32[>..] = [];
			loss.resize(ng, 0.0);
			var order int[>..] = [];
			for g in ng {
				if gcnt[g] >= 200 {
					let share = (gcnt[g] as f32) / (total as f32);
					let gd = (ggood[g] as f32) / (gcnt[g] as f32);
					loss[g] = share * (1.0 - gd);
					order.push(g);
				}
			}
			sort(order) { a, b => loss[a] > loss[b] };
			for g in order {
				let img = g - 1;
				let share = (gcnt[g] as f32) / (total as f32);
				let gd = (ggood[g] as f32) / (gcnt[g] as f32);
				var q byte[>..] = [];
				format(q, "part v", k, " img ", img, " ");
				if img >= 0 {
					format(q, "img", img);
				} else {
					q.append("other");
				}
				format(q, " share ");
				f4(q, share);
				format(q, " de ");
				f4(q, gsum[g] / (gcnt[g] as f32));
				format(q, " good ");
				f4(q, gd);
				format(q, " loss ");
				f4(q, loss[g]);
				print(q);
			}
			var p1 byte[>..] = [];
			format(p1, prefix, "_v", k, "_render.png");
			gfx::save_shot(gfx::Shot { w: tw, h: th, pf: 376840196, px: rpx }, p1);
			var p2 byte[>..] = [];
			format(p2, prefix, "_v", k, "_heat.png");
			gfx::save_shot(gfx::Shot { w: tw, h: th, pf: 376840196, px: heat }, p2);
			var side byte[>..] = [];
			side.resize(3 * tw * th * 4, 0);
			for y in th {
				for x in tw {
					for c in 4 {
						let s = (y * tw + x) * 4 + c;
						side[(y * 3 * tw + x) * 4 + c] = tpx[s];
						side[(y * 3 * tw + tw + x) * 4 + c] = rpx[s];
						side[(y * 3 * tw + 2 * tw + x) * 4 + c] = heat[s];
					}
				}
			}
			var p3 byte[>..] = [];
			format(p3, prefix, "_v", k, "_side.png");
			gfx::save_shot(gfx::Shot { w: 3 * tw, h: th, pf: 376840196, px: side }, p3);
		}
	}
	let nv = if nview > 0 { nview as f32 } else { 1.0 };
	var m byte[>..] = [];
	format(m, tag, " mean iou ");
	f4(m, si / nv);
	format(m, " ssim ");
	f4(m, ss / nv);
	format(m, " de ");
	f4(m, sd / nv);
	format(m, " good ");
	f4(m, sg / nv);
	print(m);
}
fn env_get(name const byte[:], out byte[>..]&) bool {
	var data byte[>..] = [];
	if !read_file("/proc/self/environ", data) { return false; }
	let entries = split(data, 0);
	for e in entries {
		if e.len > name.len && e[..name.len] == name && e[name.len] == '=' {
			out.append(e[name.len + 1..]);
			return true;
		}
	}
	return false;
}
fn env_on(name const byte[:]) bool {
	var v byte[>..] = [];
	env_get(name, v)
}
fn env_off(name const byte[:]) bool {
	var v byte[>..] = [];
	if !env_get(name, v) { return false; }
	v == "0"
}
fn env_is(name const byte[:], val const byte[:]) bool {
	var v byte[>..] = [];
	if !env_get(name, v) { return false; }
	v == val
}
fn learn_clear() {
	s3d::place(item, gfx::translate(float3 { 0.0, -1000.0, 0.0 }));
	s3d::view = s3d::Camera { eye: float3 { 0.0, 0.85, 3.2 }, target: float3 { 0.0, 0.85, 0.0 }, up: float3 { 0.0, 1.0, 0.0 }, fov_y: fov, near: 0.05, far: 100.0 };
	s3d::render(big);
	s3d::render(big);
	s3d::render(big);
	let px = gfx::read_pixels(big);
	clear_c = float3 { px[0] as f32, px[1] as f32, px[2] as f32 };
	print("clear ", clear_c.x, " ", clear_c.y, " ", clear_c.z);
	s3d::place(item, gfx::mat4_identity);
}
fn main() {
	let a = args();
	if a.len < 4 {
		print("usage: fit model.glb targets prefix [pose]");
		return;
	}
	for tgt in split(a[2], ',') {
		if nview >= 7 { break; }
		var path const byte[:] = "";
		var yaw f32 = 0.0;
		var dd f32 = 3.2;
		var cyy f32 = 0.85;
		var cxx f32 = 0.0;
		var fixed = false;
		let parts = split(tgt, ':');
		for w, k in parts {
			if k == 0 {
				path = w;
			} else if k == 1 {
				yaw = num(w);
			} else {
				fixed = true;
				if k == 2 {
					dd = num(w);
				} else if k == 3 {
					cyy = num(w);
				} else if k == 4 {
					cxx = num(w);
				}
			}
		}
		var data byte[>..] = [];
		if !read_file(path, data) {
			print("target failed ", path);
			continue;
		}
		tpx.clear();
		let w, h, ok = codec_png::decode(data, tpx);
		if !ok {
			print("target failed ", path);
			continue;
		}
		if nview == 0 {
			tw = w;
			th = h;
		} else if w != tw || h != th {
			print("target size differs, skipped ", path);
			continue;
		}
		tmask.resize(tw * th, 1.0);
		gray_bg();
		v_px.append(tpx);
		v_mask.append(tmask);
		v_bg.push(bg);
		v_yaw.push(((yaw as real) * PI / 180.0) as f32);
		v_d.push(dd);
		v_cy.push(cyy);
		v_cx.push(cxx);
		v_fix.push(fixed);
		nview++;
	}
	if nview == 0 {
		print("no targets");
		return;
	}
	let n = tw * th;
	if env_on("FIT_MASK") {
		for k in nview {
			var m byte[>..] = [];
			m.resize(n * 4, 0);
			var cnt = 0;
			for i in n {
				var v byte = 0;
				if v_mask[k * n + i] == 1.0 {
					v = 255;
					cnt++;
				}
				m[i * 4] = v;
				m[i * 4 + 1] = v;
				m[i * 4 + 2] = v;
				m[i * 4 + 3] = 255;
			}
			var p byte[>..] = [];
			format(p, a[3], "_v", k, "_mask.png");
			gfx::save_shot(gfx::Shot { w: tw, h: th, pf: 376840196, px: m }, p);
			var o byte[>..] = [];
			format(o, "mask v", k, " ");
			f4(o, (cnt as f32) / (n as f32));
			print(o);
		}
		return;
	}
	rmask.resize(n, 0.0);
	if !gfx::open_headless(tw, th) {
		print("gpu: skipped (no device: ", gfx::error(), ")");
		return;
	}
	asset = gltf::load(a[1]);
	if asset < 0 {
		print("load failed: ", gltf::error());
		return;
	}
	if !env_off("FIT_LOOK") { look_setup(asset); }
	item = s3d::add(asset);
	s3d::place(item, gfx::mat4_identity);
	if a.len > 4 { load_pose(a[4]); }
	s3d::sky = s3d::Sky { zenith: float3 { 0.6, 0.6, 0.6 }, horizon: float3 { 0.55, 0.55, 0.55 }, ground: float3 { 0.3, 0.3, 0.3 }, ambient: 1.0, draw: false };
	set_lights();
	s3d::look.bloom = 0.0;
	s3d::look.desaturate = 0.0;
	s3d::look.curve = 1;
	s3d::init(2 * tw, 2 * th);
	big = gfx::render_target(2 * tw, 2 * th, gfx::RGBA8);
	learn_clear();
	for k in nview {
		if !cam_fit(k, 7) {
			print("empty view ", k);
			return;
		}
	}
	if !env_off("FIT_POSE") {
		pose_fit();
		for k in nview { cam_fit(k, 3); }
		var pp byte[>..] = [];
		format(pp, a[3], "_pose.txt");
		save_pose(pp);
	}
	if env_is("FIT_SHAPE", "1") {
		for r in 4 {
			shape_fit(r);
			for k in nview { cam_fit(k, 3); }
			var tg byte[>..] = [];
			format(tg, "shape", r);
			report(tg, false, a[3]);
		}
	}
	if !env_off("FIT_LIGHT") { light_fit(); }
	report("fit", false, a[3]);
	if !env_off("FIT_TONE") && !env_is("FIT_TONE", "post") {
		tone_fit();
		report("tone", false, a[3]);
	}
	if !env_off("FIT_GAIN") { view_gain(); }
	if !env_off("FIT_MATERIAL") { material_fit(); }
	if img_changed.len < gltf::images.len { img_changed.resize(gltf::images.len, 0); }
	if !env_off("FIT_PATTERN") { pattern_fit(); }
	if !env_off("FIT_UNTILE") { untile(); }
	if !env_off("FIT_PAINT") {
		for r in 4 {
			paint(false);
			var tg byte[>..] = [];
			format(tg, "paint", r);
			report(tg, false, a[3]);
		}
		if !env_off("FIT_TONE") {
			tone_fit();
			report("tone2", false, a[3]);
		}
		var anyfix = false;
		for k in nview { if v_fix[k] { anyfix = true; } }
		if anyfix {
			pcell = 1;
			for r in 4 {
				paint(true);
				var tg byte[>..] = [];
				format(tg, "fine", r);
				report(tg, false, a[3]);
			}
			pcell = 4;
		}
	}
	var saved = 0;
	for im in gltf::images.len {
		if im < img_changed.len && img_changed[im] != 0 {
			let info = gltf::images[im];
			var px byte[>..] = [];
			px.append(gltf::image_pixels(im));
			var p byte[>..] = [];
			format(p, a[3], "_tex", im, ".png");
			gfx::save_shot(gfx::Shot { w: info.width, h: info.height, pf: 376840196, px: px }, p);
			saved++;
		}
	}
	if saved > 0 || shape_changed || mat_changed {
		var op byte[>..] = [];
		format(op, a[3], ".glb");
		export_glb(a[1], op, a[3]);
	}
	if tone_on {
		var o byte[>..] = [];
		o.append("LUT_3D_SIZE 33\n");
		for b in 33 {
			for g in 33 {
				for r in 33 {
					format_flt(o, (tc[lutv(r)] as real) / 255.0, 6);
					o.push(' ');
					format_flt(o, (tc[256 + lutv(g)] as real) / 255.0, 6);
					o.push(' ');
					format_flt(o, (tc[512 + lutv(b)] as real) / 255.0, 6);
					o.push('\n');
				}
			}
		}
		var cp byte[>..] = [];
		format(cp, a[3], ".cube");
		write_file(cp, o);
		print("cube ", cp);
	}
	report("final", true, a[3]);
}
