import os;
import binary;
import gfx;
import math;
import gfx.linalg;
import gfx.gltf;
import gfx.motion;
import gfx.scene3d;
struct HairU {
	view_proj gfx::mat4,
	view gfx::mat4,
	proj gfx::mat4,
	size float4,
	cam float4,
	to_sun float4,
	sun_rgb float4,
	hair float4,
	sky float4,
	params float4,
	look float4,
	light_vp gfx::mat4,
	light float4,
	shadow_vp gfx::mat4,
	mel float4,
	pl float4[8],
	shape float4
}
fn mel_of(c float3, bn f32) float2 {
	let x real = bn;
	let d = 5.969 - 0.215 * x + 2.532 * x * x - 10.73 * x * x * x + 5.574 * x * x * x * x + 0.245 * x * x * x * x * x;
	let lx = log(max(c.x as real, 0.001)) / d;
	let ly = log(max(c.y as real, 0.001)) / d;
	let lz = log(max(c.z as real, 0.001)) / d;
	let s0 = lx * lx;
	let s1 = ly * ly;
	let s2 = lz * lz;
	let a0 = 0.419;
	let a1 = 0.697;
	let a2 = 1.37;
	let b0 = 0.187;
	let b1 = 0.4;
	let b2 = 1.05;
	let a11 = a0 * a0 + a1 * a1 + a2 * a2;
	let a12 = a0 * b0 + a1 * b1 + a2 * b2;
	let a22 = b0 * b0 + b1 * b1 + b2 * b2;
	let r1 = s0 * a0 + s1 * a1 + s2 * a2;
	let r2 = s0 * b0 + s1 * b1 + s2 * b2;
	let det = a11 * a22 - a12 * a12;
	var e = (r1 * a22 - r2 * a12) / det;
	var p = (a11 * r2 - a12 * r1) / det;
	if e < 0.0 {
		e = 0.0;
		p = max(r2 / a22, 0.0);
	} else if p < 0.0 {
		p = 0.0;
		e = max(r1 / a11, 0.0);
	}
	float2 { e as f32, p as f32 }
}
var on = false;
var hair_top f32 = 0.0;
var hair_col = float3 { 0.58, 0.38, 0.14 };
var guides = 0;
var parts = 0;
var cells = 0;
var sdf_done = false;
var sim_reset = true;
var probe_ask = false;
var probe_v f32[>..] = [];
var hm_prev = gfx::mat4_identity;
var part_node int[>..] = [];
var part_ib gfx::mat4[>..] = [];
var simv float4[>..] = [];
var tgt gfx::Buffer = default<gfx::Buffer>();
var st gfx::Buffer = default<gfx::Buffer>();
var gd gfx::Buffer = default<gfx::Buffer>();
var simb gfx::Buffer = default<gfx::Buffer>();
var sdfb gfx::Buffer = default<gfx::Buffer>();
var trib gfx::Buffer = default<gfx::Buffer>();
var statb gfx::Buffer = default<gfx::Buffer>();
var sim_p gfx::ComputePipeline = default<gfx::ComputePipeline>();
var sdf_p gfx::ComputePipeline = default<gfx::ComputePipeline>();
var w = 0;
var h = 0;
var spc = 96;
var points = 0;
var segments = 0;
var center = float3 { 0.0, 0.0, 0.0 };
var bones = 0;
var bone_node int[>..] = [];
var mats gfx::mat4[>..] = [];
var pts gfx::Buffer = default<gfx::Buffer>();
var rest gfx::Buffer = default<gfx::Buffer>();
var skin gfx::Buffer = default<gfx::Buffer>();
var matsb gfx::Buffer = default<gfx::Buffer>();
var segs gfx::Buffer = default<gfx::Buffer>();
var front gfx::Buffer = default<gfx::Buffer>();
var acc gfx::Buffer = default<gfx::Buffer>();
var lfront gfx::Buffer = default<gfx::Buffer>();
var lacc gfx::Buffer = default<gfx::Buffer>();
var hairt gfx::Texture = default<gfx::Texture>();
var smp gfx::Sampler = default<gfx::Sampler>();
var comp gfx::Pipeline = default<gfx::Pipeline>();
var clear_p gfx::ComputePipeline = default<gfx::ComputePipeline>();
var raster_p gfx::ComputePipeline = default<gfx::ComputePipeline>();
var resolve_p gfx::ComputePipeline = default<gfx::ComputePipeline>();
var skin_p gfx::ComputePipeline = default<gfx::ComputePipeline>();
fn hair_size(nw int, nh int) {
	w = nw;
	h = nh;
	let rw = gfx::BUFFER_COMPUTE_WRITE | gfx::BUFFER_COMPUTE_READ;
	front = gfx::buffer(rw, nw * nh * 4, []);
	acc = gfx::buffer(rw, nw * nh * 64, []);
	hairt = gfx::texture(gfx::TextureDesc { format: gfx::RGBA16F, usage: gfx::SAMPLED | gfx::COMPUTE_WRITE, width: nw as i32, height: nh as i32 });
}
fn hair_open(path const byte[:], nw int, nh int, strands int) bool {
	var data byte[>..] = [];
	if !read_file(path, data) { return false; }
	return hair_load(data, nw, nh, strands);
}
fn hair_load(data const byte[:], nw int, nh int, strands int) bool {
	let np = binary::gather(data, 8, 4) as int;
	let ns = binary::gather(data, 12, 4) as int;
	points = np;
	segments = ns;
	spc = strands;
	let rw = gfx::BUFFER_COMPUTE_READ | gfx::BUFFER_COMPUTE_WRITE;
	pts = gfx::buffer(rw, points * 48, data[16..16 + points * 48]);
	tgt = gfx::buffer(rw, points * 48, data[16..16 + points * 48]);
	st = gfx::buffer(rw, points * 32, []);
	let sb = 16 + points * 48;
	segs = gfx::buffer(gfx::BUFFER_COMPUTE_READ, segments * 16, data[sb..sb + segments * 16]);
	bones = 0;
	bone_node.clear();
	var k = sb + segments * 16;
	if data[3] == 51 {
		let e = sb + segments * 16;
		bones = binary::gather(data, e, 4) as int;
		for i in bones {
			bone_node.push(binary::gather(data, e + 4 + i * 4, 4) as int);
		}
		k = e + 4 + bones * 4;
	}
	if bones > 0 {
		rest = gfx::buffer(gfx::BUFFER_COMPUTE_READ, points * 48, data[16..16 + points * 48]);
		skin = gfx::buffer(gfx::BUFFER_COMPUTE_READ, points * 16, data[k..k + points * 16]);
		mats.clear();
		mats.resize(bones, gfx::mat4_identity);
		matsb = gfx::buffer(gfx::BUFFER_COMPUTE_READ, bones * 64, []);
		skin_p = gfx::compute_pipeline(embed_shader("shaders/strand_skin.comp"));
	}
	var top f32 = -1e9;
	var sx f32 = 0.0;
	var sy f32 = 0.0;
	var sz f32 = 0.0;
	for p in points {
		let at = 16 + p * 48;
		let px = binary::f32_from_bits(binary::gather(data, at, 4) as! u32);
		let py = binary::f32_from_bits(binary::gather(data, at + 4, 4) as! u32);
		let pz = binary::f32_from_bits(binary::gather(data, at + 8, 4) as! u32);
		if py > top { top = py; }
		sx += px;
		sy += py;
		sz += pz;
	}
	if points > 0 {
		hair_top = top;
		let fp = points as f32;
		center = float3 { sx / fp, sy / fp, sz / fp };
	}
	lfront = gfx::buffer(rw, 512 * 512 * 4, []);
	lacc = gfx::buffer(rw, 512 * 512 * 64, []);
	smp = gfx::sampler(gfx::NEAREST, gfx::CLAMP);
	comp = gfx::pipeline(embed_shader("shaders/strand_comp.vert"), embed_shader("shaders/strand_comp.frag"), gfx::PipelineDesc { blend: gfx::BLEND_PREMULTIPLIED });
	clear_p = gfx::compute_pipeline(embed_shader("shaders/strand_clear.comp"));
	raster_p = gfx::compute_pipeline(embed_shader("shaders/strand_raster.comp"));
	resolve_p = gfx::compute_pipeline(embed_shader("shaders/strand_resolve.comp"));
	var gl i32[>..] = [];
	var prevg = -1;
	for s in segments {
		let at = sb + s * 16;
		let pi = binary::gather(data, at, 4) as int;
		let gn = binary::gather(data, at + 4, 4) as int;
		if s == 0 || gn != prevg {
			gl.push(pi as i32);
			gl.push(2);
			gl.push(0);
			gl.push(0);
		} else {
			gl[gl.len - 3] += 1;
		}
		prevg = gn;
	}
	let ng = gl.len / 4;
	if bones > 0 {
		for g in ng {
			let first = gl[4 * g] as int;
			let cnt = gl[4 * g + 1] as int;
			var skinned = false;
			for q in first..first + cnt {
				let wa = binary::f32_from_bits(binary::gather(data, k + q * 16 + 8, 4) as! u32);
				let wb = binary::f32_from_bits(binary::gather(data, k + q * 16 + 12, 4) as! u32);
				if wa + wb > 0.001 { skinned = true; }
			}
			if skinned { gl[4 * g + 2] = 1; }
		}
	}
	guides = ng;
	gd = gfx::buffer(gfx::BUFFER_COMPUTE_READ, guides * 16, bytes_of(gl));
	statb = gfx::buffer(rw, guides * 16, []);
	simb = gfx::buffer(gfx::BUFFER_COMPUTE_READ, 120 * 16, []);
	simv.clear();
	simv.resize(120, float4 { 0.0, 0.0, 0.0, 0.0 });
	probe_v.clear();
	probe_v.resize(8, 0.0);
	sim_p = gfx::compute_pipeline(embed_shader("shaders/strand_sim.comp"));
	sdf_p = gfx::compute_pipeline(embed_shader("shaders/strand_sdf.comp"));
	sdfb = gfx::buffer(rw, 16, []);
	trib = gfx::buffer(rw, 16, []);
	hair_size(nw, nh);
	on = true;
	return true;
}
fn skin_joint(sk int, node int) int {
	let cnt = gltf::skins[sk].joints.count as int;
	let first = gltf::skins[sk].joints.first as int;
	for k in cnt {
		if gltf::ints[first + k] == node { return k; }
	}
	-1
}
fn tri_owner(v0 int, v1 int, v2 int) int {
	var js int[>..] = [];
	var ws f32[>..] = [];
	for i in 3 {
		let v = if i == 0 { v0 } else if i == 1 { v1 } else { v2 };
		for c in 4 {
			let j = gltf::verts[v * gltf::VERTEX_FLOATS + 18 + c] as int;
			let w = gltf::verts[v * gltf::VERTEX_FLOATS + 22 + c];
			var at = -1;
			for e in js.len {
				if js[e] == j { at = e; }
			}
			if at >= 0 {
				ws[at] += w;
			} else {
				js.push(j);
				ws.push(w);
			}
		}
	}
	var best = -1;
	var bw f32 = 0.0;
	for e in js.len {
		if best < 0 || ws[e] > bw {
			best = e;
			bw = ws[e];
		}
	}
	if best < 0 { -1 } else { js[best] }
}
fn tri_box_hit(tl const float4[:], k int, lo float3, hi float3) bool {
	let a = tl[3 * k];
	let b = tl[3 * k + 1];
	let c = tl[3 * k + 2];
	let margin = 0.035;
	let minx = min(a.x, min(b.x, c.x)) - margin;
	let miny = min(a.y, min(b.y, c.y)) - margin;
	let minz = min(a.z, min(b.z, c.z)) - margin;
	let maxx = max(a.x, max(b.x, c.x)) + margin;
	let maxy = max(a.y, max(b.y, c.y)) + margin;
	let maxz = max(a.z, max(b.z, c.z)) + margin;
	minx <= hi.x && maxx >= lo.x && miny <= hi.y && maxy >= lo.y && minz <= hi.z && maxz >= lo.z
}
var card_node = -1;
var card_mesh = -1;
fn hair_find_cards(asset int) bool {
	let n0 = gltf::assets[asset].nodes.first as int;
	let nc = gltf::assets[asset].nodes.count as int;
	var found = -1;
	for n in n0..n0 + nc {
		if found < 0 && gltf::nodes[n].mesh >= 0 {
			let m = gltf::nodes[n].mesh as int;
			if gltf::text_of(gltf::meshes[m].name) == "hair" { found = n; }
		}
	}
	if found < 0 { return false; }
	let mesh = gltf::nodes[found].mesh as int;
	let pr = gltf::prims[gltf::meshes[mesh].prims.first as int];
	let vc = pr.vcount as int;
	let vf = pr.vfirst as int;
	let ifst = pr.ifirst as int;
	if vc < 4 || vc % 2 != 0 || pr.icount < 6 { return false; }
	let want = [0, 1, 2, 1, 3, 2];
	for i in 6 {
		if gltf::indices[ifst + i] as int != want[i] { return false; }
	}
	for k in vc / 2 {
		let va = gltf::verts[(vf + 2 * k) * gltf::VERTEX_FLOATS + gltf::AT_UV0 + 1];
		let vb = gltf::verts[(vf + 2 * k + 1) * gltf::VERTEX_FLOATS + gltf::AT_UV0 + 1];
		if abs(va - vb) >= 0.0001 { return false; }
	}
	card_node = found;
	card_mesh = mesh;
	return true;
}
fn hair_card_data(asset int, data byte[>..]&) bool {
	data.clear();
	if card_node < 0 { return false; }
	let pr = gltf::prims[gltf::meshes[card_mesh].prims.first as int];
	let n = card_node;
	let vf = pr.vfirst as int;
	let vc = pr.vcount as int;
	let npairs = vc / 2;
	let sk = gltf::nodes[n].skin as int;
	var hj = -1;
	if sk >= 0 {
		let hn = gltf::find_node(asset, "head") as int;
		if hn >= 0 { hj = skin_joint(sk, hn); }
	}
	fn pos(v int) float3 {
		float3 { gltf::verts[v * gltf::VERTEX_FLOATS + gltf::AT_POS], gltf::verts[v * gltf::VERTEX_FLOATS + gltf::AT_POS + 1], gltf::verts[v * gltf::VERTEX_FLOATS + gltf::AT_POS + 2] }
	}
	fn uvv(k int) f32 {
		gltf::verts[(vf + 2 * k) * gltf::VERTEX_FLOATS + gltf::AT_UV0 + 1]
	}
	fn cen(k int) float3 {
		(pos(vf + 2 * k) + pos(vf + 2 * k + 1)) * 0.5
	}
	fn red(v int) f32 {
		gltf::verts[v * gltf::VERTEX_FLOATS + gltf::AT_COL]
	}
	var bj int[>..] = [];
	var bn i32[>..] = [];
	if sk >= 0 {
		for v in vf..vf + vc {
			for c in 4 {
				let j = gltf::verts[v * gltf::VERTEX_FLOATS + gltf::AT_JOINT + c] as int;
				let wt = gltf::verts[v * gltf::VERTEX_FLOATS + gltf::AT_WEIGHT + c];
				if wt > 0.01 && j != hj && bj.len < 64 {
					var seen = false;
					for b in bj.len {
						if bj[b] == j { seen = true; }
					}
					if !seen {
						bj.push(j);
						let nd = gltf::ints[gltf::skins[sk].joints.first as int + j] as int - gltf::assets[asset].nodes.first as int;
						bn.push(nd as i32);
					}
				}
			}
		}
	}
	var starts int[>..] = [];
	for k in npairs {
		if k == 0 || uvv(k) < uvv(k - 1) { starts.push(k); }
	}
	var pf f32[>..] = [];
	var ki i32[>..] = [];
	var kw f32[>..] = [];
	var sg i32[>..] = [];
	var cards = 0;
	for ci in starts.len {
		let a = starts[ci];
		let e = if ci + 1 < starts.len { starts[ci + 1] } else { npairs };
		if e - a >= 2 {
			let base = pf.len / 12;
			for k in a..e {
				let l = vf + 2 * k;
				let r = l + 1;
				let c = cen(k);
				let sd = (pos(r) - pos(l)) * 0.5;
				let k0 = max(k - 1, a);
				let k1 = min(k + 1, e - 1);
				let tg = cen(k1) - cen(k0);
				let cx = tg.y * sd.z - tg.z * sd.y;
				let cy = tg.z * sd.x - tg.x * sd.z;
				let cz = tg.x * sd.y - tg.y * sd.x;
				let nm = linalg::unit3(float3 { cx, cy, cz });
				let t = (uvv(k) - uvv(a)) / max(uvv(e - 1) - uvv(a), 0.000001);
				let occ = (red(l) + red(r)) * 0.5;
				pf.push(c.x);
				pf.push(c.y);
				pf.push(c.z);
				pf.push(occ);
				pf.push(sd.x);
				pf.push(sd.y);
				pf.push(sd.z);
				pf.push(t);
				pf.push(nm.x);
				pf.push(nm.y);
				pf.push(nm.z);
				pf.push(0.0);
				var b0 = 0;
				var w0 f32 = 0.0;
				var b1 = 0;
				var w1 f32 = 0.0;
				for b in bj.len {
					var s f32 = 0.0;
					for q in 2 {
						let v = if q == 0 { l } else { r };
						for c4 in 4 {
							let j = gltf::verts[v * gltf::VERTEX_FLOATS + gltf::AT_JOINT + c4] as int;
							if j == bj[b] { s += gltf::verts[v * gltf::VERTEX_FLOATS + gltf::AT_WEIGHT + c4] * 0.5; }
						}
					}
					if s > w0 {
						b1 = b0;
						w1 = w0;
						b0 = b;
						w0 = s;
					} else if s > w1 {
						b1 = b;
						w1 = s;
					}
				}
				ki.push(b0 as i32);
				ki.push(b1 as i32);
				kw.push(w0);
				kw.push(w1);
				if k < e - 1 {
					sg.push((base + k - a) as i32);
					sg.push(cards as i32);
					sg.push(0);
					sg.push(0);
				}
			}
			cards += 1;
		}
	}
	let np = pf.len / 12;
	let ns = sg.len / 4;
	var hdr i32[>..] = [];
	hdr.push(cards as i32);
	hdr.push(np as i32);
	hdr.push(ns as i32);
	data.append("HMG3");
	data.append(bytes_of(hdr));
	data.append(bytes_of(pf));
	data.append(bytes_of(sg));
	var bl i32[>..] = [];
	bl.push(bn.len as i32);
	for i in bn.len { bl.push(bn[i]); }
	data.append(bytes_of(bl));
	var sf f32[>..] = [];
	for p in np {
		sf.push(binary::f32_from_bits(ki[2 * p] as u32));
		sf.push(binary::f32_from_bits(ki[2 * p + 1] as u32));
		sf.push(kw[2 * p]);
		sf.push(kw[2 * p + 1]);
	}
	data.append(bytes_of(sf));
	print("hair cards: ", cards, " guides, ", np, " points, ", bn.len, " bones");
	return true;
}
fn hair_cards(asset int, nw int, nh int, strands int) bool {
	var data byte[>..] = [];
	if !hair_card_data(asset, data) { return false; }
	return hair_load(data, nw, nh, strands);
}
fn hair_body(asset int) {
	if !on { return; }
	let n0 = gltf::assets[asset].nodes.first as int;
	let nc = gltf::assets[asset].nodes.count as int;
	let sn = gltf::find_node(asset, "skin") as int;
	if sn < 0 || gltf::nodes[sn].mesh < 0 || gltf::nodes[sn].skin < 0 { return; }
	let sk = gltf::nodes[sn].skin as int;
	part_node.clear();
	part_ib.clear();
	var pj int[>..] = [];
	let names = ["head", "neck_01", "spine_03", "spine_02", "clavicle_l", "clavicle_r", "upperarm_l", "upperarm_r"];
	for name in names {
		let nd = gltf::find_node(asset, name) as int;
		if nd >= 0 {
			let k = skin_joint(sk, nd);
			if k >= 0 {
				part_node.push(nd);
				part_ib.push(gltf::matrices[gltf::skins[sk].inverse_binds.first as int + k]);
				pj.push(k);
			}
		}
	}
	parts = part_node.len;
	var lo float3[>..] = [];
	var hi float3[>..] = [];
	for p in parts {
		lo.push(float3 { 1e9, 1e9, 1e9 });
		hi.push(float3 { -1e9, -1e9, -1e9 });
	}
	fn pos(v int) float3 {
		float3 { gltf::verts[v * gltf::VERTEX_FLOATS], gltf::verts[v * gltf::VERTEX_FLOATS + 1], gltf::verts[v * gltf::VERTEX_FLOATS + 2] }
	}
	fn grow(ow int, q float3) {
		let l = lo[ow];
		let u = hi[ow];
		lo[ow] = float3 { min(l.x, q.x), min(l.y, q.y), min(l.z, q.z) };
		hi[ow] = float3 { max(u.x, q.x), max(u.y, q.y), max(u.z, q.z) };
	}
	var all float4[>..] = [];
	for n in n0..n0 + nc {
		if gltf::nodes[n].mesh >= 0 && gltf::nodes[n].skin == sk as i32 {
			let m = gltf::nodes[n].mesh as int;
			let mn = gltf::text_of(gltf::meshes[m].name);
			if mn == "skin" || mn == "face" || mn == "scalp" || mn == "tank" {
				let pf0 = gltf::meshes[m].prims.first as int;
				let pc0 = gltf::meshes[m].prims.count as int;
				for q in pf0..pf0 + pc0 {
					let pr = gltf::prims[q];
					let vf = pr.vfirst as int;
					let ifst = pr.ifirst as int;
					for t in pr.icount as int / 3 {
						let v0 = vf + gltf::indices[ifst + 3 * t] as int;
						let v1 = vf + gltf::indices[ifst + 3 * t + 1] as int;
						let v2 = vf + gltf::indices[ifst + 3 * t + 2] as int;
						let pa = pos(v0);
						let pb = pos(v1);
						let pc = pos(v2);
						let j = tri_owner(v0, v1, v2);
						var ow = -1;
						for i in pj.len {
							if pj[i] == j { ow = i; }
						}
						all.push(float4 { pa.x, pa.y, pa.z, ow as f32 });
						all.push(float4 { pb.x, pb.y, pb.z, 0.0 });
						all.push(float4 { pc.x, pc.y, pc.z, 0.0 });
						if ow >= 0 {
							grow(ow, pa);
							grow(ow, pb);
							grow(ow, pc);
						}
					}
				}
			}
		}
	}
	var tl float4[>..] = [];
	cells = 0;
	for p in parts {
		let o = 20 + 12 * p;
		var a = float3 { 0.0, 0.0, 0.0 };
		var cell f32 = 0.007;
		var gx = 2;
		var gy = 2;
		var gz = 2;
		var t0 = tl.len / 3;
		if lo[p].x < hi[p].x {
			a = lo[p] - float3 { 0.035, 0.035, 0.035 };
			let b = hi[p] + float3 { 0.035, 0.035, 0.035 };
			let sz = b - a;
			cell = max(0.007, max(sz.x, max(sz.y, sz.z)) / 63.0);
			gx = (sz.x / cell) as int + 2;
			gy = (sz.y / cell) as int + 2;
			gz = (sz.z / cell) as int + 2;
			t0 = tl.len / 3;
			for k in all.len / 3 {
				if tri_box_hit(all[..], k, a, b) {
					tl.push(all[3 * k]);
					tl.push(all[3 * k + 1]);
					tl.push(all[3 * k + 2]);
				}
			}
		}
		simv[o] = float4 { a.x, a.y, a.z, cell };
		simv[o + 1] = float4 { gx as f32, gy as f32, gz as f32, cells as f32 };
		simv[o + 2] = float4 { t0 as f32, (tl.len / 3 - t0) as f32, 0.0, 0.0 };
		cells += gx * gy * gz;
	}
	let mf = gltf::assets[asset].meshes.first as int;
	let mc = gltf::assets[asset].meshes.count as int;
	var done = false;
	for m in mf..mf + mc {
		if !done && gltf::text_of(gltf::meshes[m].name) == "hair" {
			done = true;
			let mat = gltf::prims[gltf::meshes[m].prims.first as int].material as int;
			if mat >= 0 {
				let bc = gltf::materials[mat].base;
				hair_col = float3 { bc.x, bc.y, bc.z };
			}
		}
	}
	simv[8].w = parts as f32;
	simv[14] = float4 { cells as f32, 0.0005, 0.004, 1.0 };
	trib = gfx::buffer(gfx::BUFFER_COMPUTE_READ, max(tl.len, 1) * 16, bytes_of(tl));
	sdfb = gfx::buffer(gfx::BUFFER_COMPUTE_READ | gfx::BUFFER_COMPUTE_WRITE, max(cells, 1) * 8, []);
	sdf_done = false;
	print("hair body: ", parts, " parts, ", cells, " cells, ", tl.len / 3, " triangles");
}
fn hair_probe(k int) f32 {
	probe_ask = true;
	if k >= 0 && k < 8 && k < probe_v.len { probe_v[k] } else { 0.0 }
}
fn hair_bone(i int) int {
	bone_node[i]
}
fn hair_pose(i int, m gfx::mat4) {
	if i >= 0 && i < bones { mats[i] = m; }
}
fn hair_draw(model gfx::mat4, dt f32) {
	if !on { return; }
	let im = linalg::inverse(model);
	var u = default<HairU>();
	u.view_proj = gfx::mul(s3d::view_proj_nj, model);
	u.view = gfx::mul(s3d::view_mat, model);
	u.proj = s3d::proj_mat;
	u.size = float4 { w as f32, h as f32, spc as f32, segments as f32 };
	let e = linalg::point(im, s3d::view.eye);
	u.cam = float4 { e.x, e.y, e.z, 0.7 };
	let t = gfx::mul(im, float4 { s3d::sun.to_sun.x, s3d::sun.to_sun.y, s3d::sun.to_sun.z, 0.0 });
	let ld = linalg::unit3(float3 { t.x, t.y, t.z });
	u.to_sun = float4 { ld.x, ld.y, ld.z, 0.0 };
	u.sun_rgb = float4 { s3d::sun.rgb.x, s3d::sun.rgb.y, s3d::sun.rgb.z, 0.0 };
	u.hair = float4 { hair_col.x, hair_col.y, hair_col.z, 0.42 };
	let m = mel_of(hair_col, 0.3);
	let nl = min(s3d::lights.len, 4);
	u.mel = float4 { m.x, m.y, 0.3, nl as f32 };
	for i in nl {
		let lp = linalg::point(im, s3d::lights[i].pos);
		let lc = s3d::lights[i].rgb;
		u.pl[2 * i] = float4 { lp.x, lp.y, lp.z, s3d::lights[i].range };
		u.pl[2 * i + 1] = float4 { lc.x, lc.y, lc.z, 0.0 };
	}
	u.sky = float4 { 0.12, 0.13, 0.15, 40.0 };
	u.params = float4 { 0.004, 1.7, 0.004, 0.00007 };
	u.look = float4 { 1.0, 1.0, 0.0, 0.7 };
	u.shape = float4 { hair_top, center.z, 0.0035, 0.0 };
	u.light_vp = gfx::mul(gfx::perspective(0.24, 1.0, 2.0, 4.0), gfx::look_at(center + ld * 3.0, center, float3 { 0.0, 1.0, 0.0 }));
	u.light = float4 { 512.0, 512.0, 0.35, (256.0 / tan(0.12)) as f32 };
	u.shadow_vp = gfx::mul(s3d::cascade_vp[0], model);
	fn raster(rw0 gfx::Buffer, rw1 gfx::Buffer, ro0 gfx::Buffer, ro1 gfx::Buffer, mode int) {
		gfx::begin_compute([rw0, rw1]);
		gfx::bind(raster_p);
		u.look.z = mode as f32;
		gfx::uniforms(gfx::COMPUTE, 0, u);
		gfx::bind_texture(gfx::COMPUTE, 0, s3d::nd_target(), smp);
		gfx::bind_texture(gfx::COMPUTE, 1, s3d::shadow_map, smp);
		gfx::bind_storage_buffer(gfx::COMPUTE, 0, pts);
		gfx::bind_storage_buffer(gfx::COMPUTE, 1, segs);
		gfx::bind_storage_buffer(gfx::COMPUTE, 2, ro0);
		gfx::bind_storage_buffer(gfx::COMPUTE, 3, ro1);
		gfx::dispatch((segments + 63) / 64, spc, 1);
		gfx::end_compute();
	}
	if bones > 0 {
		gfx::update_buffer(matsb, 0, bytes_of(mats)[..bones * 64]);
		gfx::begin_compute([tgt]);
		gfx::bind(skin_p);
		u.size.w = points as f32;
		gfx::uniforms(gfx::COMPUTE, 0, u);
		gfx::bind_storage_buffer(gfx::COMPUTE, 0, rest);
		gfx::bind_storage_buffer(gfx::COMPUTE, 1, skin);
		gfx::bind_storage_buffer(gfx::COMPUTE, 2, matsb);
		gfx::dispatch((points + 63) / 64, 1, 1);
		gfx::end_compute();
		u.size.w = segments as f32;
	}
	let mdx = model.c3.x - hm_prev.c3.x;
	let mdy = model.c3.y - hm_prev.c3.y;
	let mdz = model.c3.z - hm_prev.c3.z;
	let reset = sim_reset || dt <= 0.0 || mdx * mdx + mdy * mdy + mdz * mdz > 0.25;
	if reset { hm_prev = model; }
	var carry = gfx::mat4_identity;
	let de = gfx::mul(model, linalg::inverse(hm_prev));
	let cs real = ((de.c0.x + de.c1.y + de.c2.z - 1.0) / 2.0) as real;
	let ang = acos(clamp(cs, -1.0, 1.0)) as f32;
	let ax = float3 { de.c1.z - de.c2.y, de.c2.x - de.c0.z, de.c0.y - de.c1.x };
	if !reset && ang > 0.2 {
		let k = 1.0 - 0.2 / ang;
		let axl2 = ax.x * ax.x + ax.y * ax.y + ax.z * ax.z;
		let qe = linalg::qaxis(if axl2 > 0.000001 { linalg::unit3(ax) } else { float3 { 0.0, 1.0, 0.0 } }, ang * k);
		let c = float3 { hm_prev.c3.x, hm_prev.c3.y, hm_prev.c3.z };
		let mv = float3 { (model.c3.x - c.x) * k, (model.c3.y - c.y) * k, (model.c3.z - c.z) * k };
		carry = gfx::mul(gfx::translate(c + mv), gfx::mul(linalg::qmatrix(qe), gfx::translate(float3 { -c.x, -c.y, -c.z })));
	}
	hm_prev = gfx::mul(carry, hm_prev);
	simv[116] = carry.c0;
	simv[117] = carry.c1;
	simv[118] = carry.c2;
	simv[119] = carry.c3;
	simv[0] = model.c0;
	simv[1] = model.c1;
	simv[2] = model.c2;
	simv[3] = model.c3;
	simv[4] = im.c0;
	simv[5] = im.c1;
	simv[6] = im.c2;
	simv[7] = im.c3;
	simv[8] = float4 { dt, if reset { 1.0 } else { 0.0 }, 0.0, parts as f32 };
	simv[9] = float4 { 0.0, -9.81, 0.0, guides as f32 };
	simv[10] = hm_prev.c0;
	simv[11] = hm_prev.c1;
	simv[12] = hm_prev.c2;
	simv[13] = hm_prev.c3;
	simv[15] = float4 { 0.012, 0.35, 0.08, 0.5 };
	simv[16] = float4 { 0.5, 0.9, 0.0, 0.02 };
	simv[17] = float4 { 0.007, hair_top - 0.07, hair_top - 0.02, 0.0 };
	for p in parts {
		let o = 20 + 12 * p;
		let mp = gfx::mul(motion::world[part_node[p]], part_ib[p]);
		let imp = linalg::inverse(mp);
		simv[o + 3] = imp.c0;
		simv[o + 4] = imp.c1;
		simv[o + 5] = imp.c2;
		simv[o + 6] = imp.c3;
		simv[o + 7] = mp.c0;
		simv[o + 8] = mp.c1;
		simv[o + 9] = mp.c2;
		simv[o + 10] = mp.c3;
	}
	gfx::update_buffer(simb, 0, bytes_of(simv));
	if !sdf_done && cells > 0 {
		gfx::begin_compute([sdfb]);
		gfx::bind(sdf_p);
		gfx::bind_storage_buffer(gfx::COMPUTE, 0, trib);
		gfx::bind_storage_buffer(gfx::COMPUTE, 1, simb);
		gfx::dispatch((cells + 63) / 64, 1, 1);
		gfx::end_compute();
		sdf_done = true;
	}
	gfx::begin_compute([st, pts, statb]);
	gfx::bind(sim_p);
	gfx::bind_storage_buffer(gfx::COMPUTE, 0, tgt);
	gfx::bind_storage_buffer(gfx::COMPUTE, 1, gd);
	gfx::bind_storage_buffer(gfx::COMPUTE, 2, simb);
	gfx::bind_storage_buffer(gfx::COMPUTE, 3, sdfb);
	gfx::dispatch((guides + 63) / 64, 1, 1);
	gfx::end_compute();
	sim_reset = false;
	hm_prev = model;
	if probe_ask {
		var raw byte[>..] = [];
		raw.resize(guides * 16, 0);
		gfx::read_buffer(statb, 0, raw[..]);
		var s0 real = 0.0;
		var s1 real = 0.0;
		var s2 real = 0.0;
		var mx real = 0.0;
		var s3 real = 0.0;
		for g in guides {
			let at = g * 16;
			s0 += binary::gather(raw, at, 4) as real;
			s1 += binary::gather(raw, at + 4, 4) as real;
			let d2 = binary::gather(raw, at + 8, 4) as real;
			s2 += d2;
			if d2 > mx { mx = d2; }
			s3 += (binary::gather(raw, at + 12, 4) as real) - 1000000000.0;
		}
		let gn = max(guides, 1) as real;
		probe_v[0] = s0 as f32;
		probe_v[1] = s1 as f32;
		probe_v[2] = (s2 / gn / 1000.0) as f32;
		probe_v[3] = (mx / 1000.0) as f32;
		probe_v[4] = (s3 / gn / 1000.0) as f32;
		probe_v[5] += 1.0;
		probe_v[6] = guides as f32;
		probe_ask = false;
	}
	gfx::begin_compute([front, acc]);
	gfx::bind(clear_p);
	u.look.z = 0.0;
	gfx::uniforms(gfx::COMPUTE, 0, u);
	gfx::dispatch((w * h + 63) / 64, 1, 1);
	gfx::end_compute();
	gfx::begin_compute([lfront, lacc]);
	gfx::bind(clear_p);
	u.look.z = 2.0;
	gfx::uniforms(gfx::COMPUTE, 0, u);
	gfx::dispatch((512 * 512 + 63) / 64, 1, 1);
	gfx::end_compute();
	raster(lfront, lacc, front, acc, 2);
	raster(lfront, lacc, front, acc, 3);
	raster(front, acc, lfront, lacc, 0);
	raster(front, acc, lfront, lacc, 1);
	gfx::begin_compute([], [hairt]);
	gfx::bind(resolve_p);
	u.look.z = 1.0;
	gfx::uniforms(gfx::COMPUTE, 0, u);
	gfx::bind_storage_buffer(gfx::COMPUTE, 0, acc);
	gfx::dispatch((w + 7) / 8, (h + 7) / 8, 1);
	gfx::end_compute();
	if gfx::begin_pass(gfx::PassDesc { color: [s3d::hdr_target(), gfx::Texture{0}, gfx::Texture{0}, gfx::Texture{0}], clear_color: false, .. }) {
		gfx::bind(comp);
		gfx::bind_texture(gfx::FRAGMENT, 0, hairt, smp);
		gfx::draw(3);
		gfx::end_pass();
	}
}
