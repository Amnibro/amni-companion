import os;
import binary;
import gfx;
import math;
import gfx.linalg;
import gfx.gltf;
import gfx.motion;
import gfx.scene3d;
struct HairU {
	view_proj gfx::mat4,
	view gfx::mat4,
	proj gfx::mat4,
	size float4,
	cam float4,
	to_sun float4,
	sun_rgb float4,
	hair float4,
	sky float4,
	params float4,
	look float4,
	light_vp gfx::mat4,
	light float4,
	shadow_vp gfx::mat4,
}
var on = false;
var w = 0;
var h = 0;
var spc = 96;
var points = 0;
var segments = 0;
var center = float3 { 0.0, 0.0, 0.0 };
var bones = 0;
var bone_node int[>..];
var mats gfx::mat4[>..];
var pts = default<gfx::Buffer>();
var rest = default<gfx::Buffer>();
var skin = default<gfx::Buffer>();
var matsb = default<gfx::Buffer>();
var segs = default<gfx::Buffer>();
var front = default<gfx::Buffer>();
var acc = default<gfx::Buffer>();
var lfront = default<gfx::Buffer>();
var lacc = default<gfx::Buffer>();
var hairt = default<gfx::Texture>();
var smp = default<gfx::Sampler>();
var comp = default<gfx::Pipeline>();
var clear_p = default<gfx::ComputePipeline>();
var raster_p = default<gfx::ComputePipeline>();
var resolve_p = default<gfx::ComputePipeline>();
var skin_p = default<gfx::ComputePipeline>();
fn hair_size(nw int, nh int) {
	w = nw;
	h = nh;
	let rw = gfx::BUFFER_COMPUTE_WRITE | gfx::BUFFER_COMPUTE_READ;
	front = gfx::buffer(rw, nw * nh * 4, []);
	acc = gfx::buffer(rw, nw * nh * 64, []);
	hairt = gfx::texture(gfx::TextureDesc { format: gfx::RGBA16F, usage: gfx::SAMPLED | gfx::COMPUTE_WRITE, width: nw as i32, height: nh as i32 });
}
fn hair_open(path const byte[:], nw int, nh int, strands int) bool {
	var data byte[>..] = [];
	if !read_file(path, data) { return false; }
	points = binary::gather(data, 8, 4) as int;
	segments = binary::gather(data, 12, 4) as int;
	spc = strands;
	let seg_at = 16 + points * 48;
	var k = 0;
	if data[3] == 51 {
		bones = binary::gather(data, seg_at + segments * 16, 4) as int;
		let e = seg_at + segments * 16;
		for i in bones {
			bone_node.push(binary::gather(data, e + 4 + i * 4, 4) as int);
		}
		k = e + 4 + bones * 4;
	}
	pts = gfx::buffer(gfx::BUFFER_COMPUTE_READ | gfx::BUFFER_COMPUTE_WRITE, points * 48, data[16..16 + points * 48]);
	segs = gfx::buffer(gfx::BUFFER_COMPUTE_READ, segments * 16, data[seg_at..seg_at + segments * 16]);
	if bones > 0 {
		rest = gfx::buffer(gfx::BUFFER_COMPUTE_READ, points * 48, data[16..16 + points * 48]);
		skin = gfx::buffer(gfx::BUFFER_COMPUTE_READ, points * 16, data[k..k + points * 16]);
		mats.resize(bones, gfx::mat4_identity);
		matsb = gfx::buffer(gfx::BUFFER_COMPUTE_READ, bones * 64, []);
		skin_p = gfx::compute_pipeline(embed_shader("shaders/strand_skin.comp"));
	}
	var sx f32 = 0.0;
	var sy f32 = 0.0;
	var sz f32 = 0.0;
	for i in points {
		let at = 16 + i * 48;
		sx += binary::f32_from_bits(binary::gather(data, at, 4) as! u32);
		sy += binary::f32_from_bits(binary::gather(data, at + 4, 4) as! u32);
		sz += binary::f32_from_bits(binary::gather(data, at + 8, 4) as! u32);
	}
	if points > 0 {
		let n = points as f32;
		center = float3 { sx / n, sy / n, sz / n };
	}
	let rw = gfx::BUFFER_COMPUTE_WRITE | gfx::BUFFER_COMPUTE_READ;
	lfront = gfx::buffer(rw, 512 * 512 * 4, []);
	lacc = gfx::buffer(rw, 512 * 512 * 64, []);
	smp = gfx::sampler(gfx::NEAREST, gfx::CLAMP);
	comp = gfx::pipeline(embed_shader("shaders/strand_comp.vert"), embed_shader("shaders/strand_comp.frag"), gfx::PipelineDesc { blend: gfx::BLEND_PREMULTIPLIED });
	clear_p = gfx::compute_pipeline(embed_shader("shaders/strand_clear.comp"));
	raster_p = gfx::compute_pipeline(embed_shader("shaders/strand_raster.comp"));
	resolve_p = gfx::compute_pipeline(embed_shader("shaders/strand_resolve.comp"));
	hair_size(nw, nh);
	on = true;
	return true;
}
fn hair_bone(i int) int {
	bone_node[i]
}
fn hair_pose(i int, m gfx::mat4) {
	if i >= 0 && i < bones { mats[i] = m; }
}
fn hair_draw(model gfx::mat4) {
	if !on { return; }
	let im = linalg::inverse(model);
	var u = default<HairU>();
	u.view_proj = gfx::mul(s3d::view_proj_nj, model);
	u.view = gfx::mul(s3d::view_mat, model);
	u.proj = s3d::proj_mat;
	u.size = float4 { w as f32, h as f32, spc as f32, segments as f32 };
	let e = linalg::point(im, s3d::view.eye);
	u.cam = float4 { e.x, e.y, e.z, 0.7 };
	let t = gfx::mul(im, float4 { s3d::sun.to_sun.x, s3d::sun.to_sun.y, s3d::sun.to_sun.z, 0.0 });
	let ld = linalg::unit3(float3 { t.x, t.y, t.z });
	u.to_sun = float4 { ld.x, ld.y, ld.z, 0.0 };
	u.sun_rgb = float4 { s3d::sun.rgb.x, s3d::sun.rgb.y, s3d::sun.rgb.z, 0.0 };
	u.hair = float4 { 0.58, 0.38, 0.14, 0.42 };
	u.sky = float4 { 0.12, 0.13, 0.15, 40.0 };
	u.params = float4 { 0.004, 1.7, 0.004, 0.00007 };
	u.look = float4 { 1.0, 6.0, 0.0, 0.7 };
	u.light_vp = gfx::mul(gfx::perspective(0.24, 1.0, 2.0, 4.0), gfx::look_at(center + ld * 3.0, center, float3 { 0.0, 1.0, 0.0 }));
	u.light = float4 { 512.0 as f32, 512.0 as f32, 0.35 as f32, (256.0 / tan(0.12)) as f32 };
	u.shadow_vp = gfx::mul(s3d::cascade_vp[0], model);
	fn raster(rw0 gfx::Buffer, rw1 gfx::Buffer, ro0 gfx::Buffer, ro1 gfx::Buffer, mode int) {
		gfx::begin_compute([rw0, rw1]);
		gfx::bind(raster_p);
		u.look.z = mode as f32;
		gfx::uniforms(gfx::COMPUTE, 0, u);
		gfx::bind_texture(gfx::COMPUTE, 0, s3d::nd_target(), smp);
		gfx::bind_texture(gfx::COMPUTE, 1, s3d::shadow_map, smp);
		gfx::bind_storage_buffer(gfx::COMPUTE, 0, pts);
		gfx::bind_storage_buffer(gfx::COMPUTE, 1, segs);
		gfx::bind_storage_buffer(gfx::COMPUTE, 2, ro0);
		gfx::bind_storage_buffer(gfx::COMPUTE, 3, ro1);
		gfx::dispatch((segments + 63) / 64, spc, 1);
		gfx::end_compute();
	}
	if bones > 0 {
		gfx::update_buffer(matsb, 0, bytes_of(mats)[..bones * 64]);
		gfx::begin_compute([pts]);
		gfx::bind(skin_p);
		u.size.w = points as f32;
		gfx::uniforms(gfx::COMPUTE, 0, u);
		gfx::bind_storage_buffer(gfx::COMPUTE, 0, rest);
		gfx::bind_storage_buffer(gfx::COMPUTE, 1, skin);
		gfx::bind_storage_buffer(gfx::COMPUTE, 2, matsb);
		gfx::dispatch((points + 63) / 64, 1, 1);
		gfx::end_compute();
		u.size.w = segments as f32;
	}
	gfx::begin_compute([front, acc]);
	gfx::bind(clear_p);
	u.look.z = 0.0;
	gfx::uniforms(gfx::COMPUTE, 0, u);
	gfx::dispatch((w * h + 63) / 64, 1, 1);
	gfx::end_compute();
	gfx::begin_compute([lfront, lacc]);
	gfx::bind(clear_p);
	u.look.z = 2.0;
	gfx::uniforms(gfx::COMPUTE, 0, u);
	gfx::dispatch((512 * 512 + 63) / 64, 1, 1);
	gfx::end_compute();
	raster(lfront, lacc, front, acc, 2);
	raster(lfront, lacc, front, acc, 3);
	raster(front, acc, lfront, lacc, 0);
	raster(front, acc, lfront, lacc, 1);
	gfx::begin_compute([], [hairt]);
	gfx::bind(resolve_p);
	u.look.z = 1.0;
	gfx::uniforms(gfx::COMPUTE, 0, u);
	gfx::bind_storage_buffer(gfx::COMPUTE, 0, acc);
	gfx::dispatch((w + 7) / 8, (h + 7) / 8, 1);
	gfx::end_compute();
	if gfx::begin_pass(gfx::PassDesc { color: [s3d::hdr_target(), gfx::Texture{0}, gfx::Texture{0}, gfx::Texture{0}], clear_color: false, .. }) {
		gfx::bind(comp);
		gfx::bind_texture(gfx::FRAGMENT, 0, hairt, smp);
		gfx::draw(3);
		gfx::end_pass();
	}
}
