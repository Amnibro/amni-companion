layout(local_size_x = 8, local_size_y = 8) in;
#include "strand_common.glsl"
layout(set = 0, binding = 0) uniform sampler2D tex_bg;
layout(std430, set = 0, binding = 1) readonly buffer Acc { uint acc[]; };
layout(set = 1, binding = 0, rgba8) uniform writeonly image2D out_img;
vec3 srgb(vec3 x) { return mix(x * 12.92, 1.055 * pow(x, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), x)); }
void main() {
	ivec2 px = ivec2(gl_GlobalInvocationID.xy);
	if (px.x >= int(size.x) || px.y >= int(size.y)) return;
	uint pi = uint(px.y) * uint(size.x) + uint(px.x);
	vec3 C = vec3(0.0);
	float T = 1.0;
	for (uint k = 0u; k < 4u; k++) {
		uint o = (pi * 4u + k) * 4u;
		float cov = float(acc[o + 3u]) / 4096.0;
		if (cov <= 0.0) continue;
		vec3 col = vec3(float(acc[o]), float(acc[o + 1u]), float(acc[o + 2u])) / 4096.0 / cov;
		float a = 1.0 - exp(-cov);
		C += T * a * col;
		T *= 1.0 - a;
	}
	vec4 bg = texelFetch(tex_bg, px, 0);
	vec3 h = C / max(1.0 - T, 1e-4) * look.x;
	float wt = look.y;
	vec3 tm = h * (1.0 + h / (wt * wt)) / (1.0 + h);
	imageStore(out_img, px, vec4(bg.rgb * T + srgb(clamp(tm, 0.0, 1.0)) * (1.0 - T), 1.0));
}
